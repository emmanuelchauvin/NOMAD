 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Base Strategy: Best-Fit (minimize post_residual). 
    // We start with the base score = post_residual.
    
    // 2. Penalty for creating "Dead Space" (Harmonic classes).
    // If post_residual is small but not zero, it's often better to have left it larger
    // for future items. We penalize small residuals that cannot fit the next item.
    if next_item_size > 0 && post_residual < next_item_size && post_residual > 0 {
        score += 50.0 - (post_residual as f64 * 0.5);
    }

    // 3. New Bin Thresholding:
    // If this is a new bin (bin_residual == bin_capacity), set a threshold.
    // We only open a new bin if the current best existing bin creates a very poor fit
    // (e.g., post_residual is very small and inefficient).
    if bin_residual == bin_capacity {
        // Base cost to open a new bin is high to encourage filling existing ones.
        score = 45.0; 
        
        // If the mean residual of existing bins is already very low, we are running out of
        // space across the board; opening a new bin is less penalized.
        if mean_residual < 15.0 {
            score -= 10.0;
        }
    }

    // 4. Lookahead optimization (Harmonic coupling):
    // If the current item completes a bin (post_residual == 0), this is usually excellent.
    if post_residual == 0 {
        score -= 20.0;
    }

    // 5. Fitting Constraint:
    // If this is the ONLY bin that can fit the item, we force a preference unless
    // the fit is extremely poor (e.g., leaving a tiny sliver).
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        if post_residual > 5 {
            score -= 30.0;
        }
    }

    // 6. Progress weighting:
    // As we near the end of the stream, prioritize closing bins over opening new ones.
    let progress = step_index as f64 / total_items as f64;
    if progress > 0.8 && bin_residual == bin_capacity {
        score += 40.0;
    }

    score
}
