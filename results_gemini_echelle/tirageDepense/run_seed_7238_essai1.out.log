 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Best-Fit Penalty: Minimize post_residual (Best Fit)
    // We favor bins that leave the smallest residual space.
    score += post_residual as f64 * 0.5;

    // 2. Harmonic Class Logic: Penalize "unusable" small gaps
    // If residual is small but >= next_item_size, it's a "fragmentation trap".
    if next_item_size > 0 {
        if post_residual < next_item_size && post_residual > 0 {
            score += 45.0; // Heavy penalty for creating a gap that can't fit the next item
        } else if post_residual >= next_item_size && post_residual < (next_item_size + 10) {
            score -= 20.0; // Reward creating a perfect fit for the next item
        }
    }

    // 3. New Bin Thresholding: 
    // If bin_residual == bin_capacity, this is the "New Bin" candidate.
    // We only open a new bin if the current mean_residual is too high, 
    // suggesting we are wasting space in existing bins.
    if bin_residual == bin_capacity {
        if open_bins_count == 0 {
            score = -100.0; // Must open first bin
        } else {
            // Only open a new bin if the average empty space is large,
            // otherwise prefer stuffing existing bins to maintain density.
            score = 50.0 + (mean_residual * 0.8);
        }
    }

    // 4. Fitting Constraint:
    // If this is the only bin that can fit the item, prioritize it heavily.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 60.0;
    }

    // 5. Lookahead progression:
    // As the stream nears the end, become more aggressive about filling bins (Best-Fit).
    let progress = step_index as f64 / total_items as f64;
    score += progress * 10.0;

    score
}
