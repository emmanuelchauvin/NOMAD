 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Best-Fit logic: Penalize large post_residuals (wasted space)
    // We want post_residual to be as close to 0 as possible.
    score += post_residual as f64 * 1.5;

    // 2. Harmonic/Modulo logic: Reward placements that leave "round" residuals 
    // often useful for fitting standard item sizes (often multiples of 5 or 10).
    score -= ((post_residual % 10) as f64) * 0.5;

    // 3. Lookahead coupling: If the next item fits into the current post_residual, 
    // prioritize this bin heavily to create a "perfect pair".
    if next_item_size > 0 && next_item_size <= post_residual {
        score -= (next_item_size as f64) * 2.5;
        // Reward creating an exact empty bin (post_residual == next_item_size)
        if post_residual == next_item_size {
            score -= 50.0;
        }
    }

    // 4. Thresholding: If fitting_bins_count is 1, we are at a "last chance" state.
    // Avoid opening a new bin unless the current fit is extremely poor (post_residual > 40).
    if bin_residual == bin_capacity {
        if fitting_bins_count > 0 {
            // Heavily penalize opening a new bin if an existing one is available.
            score += 60.0;
        } else {
            // If no bins fit, we must open a new one; normalize score.
            score = 10.0;
        }
    } else {
        // Dynamic penalty for filling bins that deviate significantly from the mean
        // to encourage balancing bin fullness.
        score += (post_residual as f64 - mean_residual).abs() * 0.2;
    }

    // 5. Progression scaling: As we reach the end of the stream, prioritize 
    // packing density over long-term bin spreading.
    let progress = step_index as f64 / total_items as f64;
    score -= progress * 5.0;

    score
}
