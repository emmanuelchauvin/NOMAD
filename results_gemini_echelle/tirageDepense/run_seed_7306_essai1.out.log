 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. If this is a new bin (bin_residual == bin_capacity)
    if bin_residual == bin_capacity {
        // Penalty for opening a new bin is high, unless it's the only option or the stream is early
        let progress = step_index as f64 / total_items as f64;
        score += 25.0 * (1.0 - progress);
        
        // If next item exists, penalize new bin if next item could fit well elsewhere
        if next_item_size > 0 && (bin_capacity - next_item_size) < 20 {
            score += 15.0;
        }
    } else {
        // 2. Best-Fit Decreasing logic with Harmonic refinement
        // Penalize small residuals that cannot fit common item sizes (10..40 range)
        if post_residual > 0 && post_residual < 20 {
            score += 30.0;
        }

        // 3. Lookahead Harmonic coupling
        // If the next item is large, prioritize keeping space available
        if next_item_size > 60 && post_residual < next_item_size {
            score += 20.0;
        }

        // 4. Reward alignment with common divisors (e.g., 25, 33, 50)
        // This encourages "clean" bin states that leave large contiguous chunks
        let rem_mod = post_residual % 25;
        if rem_mod == 0 {
            score -= 5.0;
        }

        // 5. If this is the last chance for this item (fitting_bins_count == 1)
        // Reduce penalty to ensure it gets placed rather than opening a new bin
        if fitting_bins_count == 1 {
            score -= 10.0;
        }
    }

    // 6. Global pressure: if many bins are open, penalize small residuals more aggressively
    score += (open_bins_count as f64) * 0.5;

    score
}
