 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Exact fit reward: Strongest signal to minimize fragmentation.
    if post_residual == 0 {
        score -= 200.0;
    }

    // 2. Lookahead optimization: If next item fits in the remaining space, reward this bin.
    if next_item_size > 0 && post_residual >= next_item_size {
        score -= 150.0;
        // Reward tighter alignment for lookahead
        score -= (post_residual - next_item_size) as f64 * 0.5;
    }

    // 3. Harmonic class awareness: Penalize small "dead" spaces (1-9) that are unlikely to accommodate 
    // future items (given the 10-80 distribution), unless it's an exact fit.
    if post_residual > 0 && post_residual < 10 {
        score += 80.0;
    }

    // 4. Fitting constraints: If this is the only bin that can fit the item, prioritize it.
    if fitting_bins_count == 1 {
        score -= 300.0;
    }

    // 5. New Bin threshold: If bin is empty, apply a base cost to discourage opening new bins 
    // unless the fit quality in existing bins is poor.
    if bin_residual == bin_capacity {
        score += 45.0; 
        // Adjust new-bin penalty based on progress: open more freely early, be conservative later.
        let progress = step_index as f64 / total_items as f64;
        score += progress * 50.0;
    }

    // 6. Distribution balancing: Penalize bins that deviate significantly from the mean residual.
    // This encourages filling bins somewhat uniformly to avoid "orphan" bins.
    let residual_diff = (post_residual as f64 - mean_residual).abs();
    score += residual_diff * 0.2;

    score
}
