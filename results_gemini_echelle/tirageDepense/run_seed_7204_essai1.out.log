 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Best-Fit Penalty: Penalize large post_residuals to favor tight packing.
    // However, if the post_residual is exactly 0, it is a perfect fit, so we reward it heavily.
    if post_residual == 0 {
        score -= 500.0;
    }

    // 2. Lookahead Integration: If the next item fits into the current post_residual, 
    // we prioritize this bin to prepare for a "combo" placement.
    if next_item_size > 0 && post_residual >= next_item_size {
        score -= 200.0 + (post_residual - next_item_size) as f64 * 0.5;
    }

    // 3. New Bin Thresholding: Penalize opening a new bin unless the current 
    // fitting options are extremely poor (i.e., they result in high post_residuals).
    if bin_residual == bin_capacity {
        if fitting_bins_count > 0 {
            // Only open a new bin if the current open bins are very full (mean_residual is tiny)
            // or if we are forced to create a bad fit elsewhere.
            score += 150.0 + (mean_residual * 2.0);
        } else {
            score -= 100.0; // Necessary to open when no other options exist.
        }
    }

    // 4. Scarcity/Efficiency weighting: If we have many open bins, penalize opening more.
    score += (open_bins_count as f64) * 5.0;

    // 5. Progression adjustment: As the stream nears the end, be more aggressive
    // about utilizing existing space to avoid leaving trailing items in new bins.
    let progress = step_index as f64 / total_items as f64;
    score -= progress * 50.0;

    score
}
