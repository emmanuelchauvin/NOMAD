 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Best-Fit Penalty: Penalize large post_residuals (leaving too much wasted space).
    // This naturally favors Best-Fit behavior.
    score += (post_residual as f64) * 0.5;

    // 2. Lookahead Matching (The "Aggressive" factor):
    // If the next item fits perfectly into the post_residual, reward this bin heavily.
    if next_item_size > 0 && post_residual >= next_item_size {
        let diff = (post_residual - next_item_size) as f64;
        // Reward small gaps after the next item is placed
        score -= (100.0 - diff) * 2.5;
    }

    // 3. Last-Chance Mitigation:
    // If this is the only bin that can fit the current item, avoid opening a new one.
    if fitting_bins_count == 1 && bin_residual >= item_size {
        score -= 500.0;
    }

    // 4. New Bin Thresholding:
    // If evaluating an empty bin, add a significant cost to discourage opening it 
    // unless the fit in existing bins is truly abysmal.
    if bin_residual == bin_capacity {
        score += 85.0;
    }

    // 5. Global Balance:
    // Penalize bins that deviate significantly from the mean residual of all open bins.
    // This encourages "leveling" the residuals across the set of bins.
    let residual_deviation = (bin_residual as f64 - mean_residual).abs();
    score += residual_deviation * 0.2;

    // 6. Stream progression normalization:
    // As we approach the end of the stream, prioritize closing bins (lower post_residual).
    let progress = step_index as f64 / total_items as f64;
    score += progress * (post_residual as f64) * 0.5;

    score
}
