 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Penalty for creating "dead space": small residuals that are unlikely to fit future items.
    // We target residuals that are multiples of common item sizes (harmonic logic).
    if post_residual > 0 {
        let residual_penalty = (post_residual as f64 % 25.0).powi(2);
        score += residual_penalty;
    }

    // Lookahead logic: if next_item_size is large, favor bins that can accommodate it.
    // If post_residual is too small to fit the next item, we penalize it.
    if next_item_size > 0 && post_residual < next_item_size {
        score += 50.0;
    }

    // Encourage filling bins that are already partially filled (Best Fit variant).
    // Penalize opening new bins unless the current bins are very poorly suited.
    if bin_residual == bin_capacity {
        if open_bins_count > 0 {
            // High threshold to open a new bin; only do it if the mean residual is very high.
            score += 40.0 + (mean_residual * 0.5);
        }
    } else {
        // Reward bins that bring the residual closer to 0 (Perfect Fit).
        score -= (100.0 - post_residual as f64) * 0.1;
    }

    // If this is the last chance to fit an item in an existing bin, prioritize it strongly.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 30.0;
    }

    // Factor in progress: as the stream nears the end, be more aggressive about closing bins.
    let progress = step_index as f64 / total_items as f64;
    score += progress * 10.0;

    score
}
