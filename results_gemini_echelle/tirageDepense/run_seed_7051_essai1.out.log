 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Best-Fit Penalty: Penalize large post_residuals to favor tight packing.
    // However, heavily penalize post_residuals that are too small to fit common items (10-30 range).
    if post_residual > 0 && post_residual < 20 {
        score += 45.0; 
    }

    // 2. Lookahead Logic: If the next item can fit in the current post_residual, reward this bin.
    if next_item_size > 0 && post_residual >= next_item_size {
        score -= 30.0;
    }

    // 3. Harmonic/Modulo Logic: Favor residuals that are multiples of 25 (common packing alignment).
    if post_residual % 25 == 0 {
        score -= 10.0;
    }

    // 4. Thresholding: If this is the only fitting bin, prioritize it strongly to avoid opening a new bin.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 50.0;
    }

    // 5. New Bin Control: Make opening a new bin expensive unless the residuals of existing bins are poor.
    if bin_residual == bin_capacity {
        // Only consider a new bin if the mean residual of existing bins is already very tight.
        score += 25.0 + (mean_residual * 0.5);
    }

    // 6. Progression scaling: As we reach the end of the stream, prioritize closing bins over opening new ones.
    let progress = step_index as f64 / total_items as f64;
    if bin_residual == bin_capacity {
        score += (progress * 40.0);
    }

    score
}
