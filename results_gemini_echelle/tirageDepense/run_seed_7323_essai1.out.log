 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Harmonic Penalty: Heavily penalize residuals that are small but non-zero (fragmentation)
    // We prefer post_residual to be exactly 0 (perfect fit) or >= next_item_size.
    if post_residual > 0 && post_residual < next_item_size {
        score += 50.0 + (next_item_size - post_residual) as f64 * 2.0;
    }

    // 2. New Bin Threshold: If we are forced to open a new bin, apply a base cost.
    // We only open a new bin if the score is lower than any existing bin's score.
    if bin_residual == bin_capacity {
        score += 35.0; 
    }

    // 3. Harmonic Class Logic: Reward residuals that match common item size multiples (e.g., 20, 25, 33, 50).
    // This creates "bins" of capacity that are more likely to accommodate future items.
    let harmonic_alignment = (post_residual % 20 == 0) as i32 * 5 
                           + (post_residual % 25 == 0) as i32 * 5;
    score -= harmonic_alignment as f64;

    // 4. Density Balancing: If we have many open bins, penalize creating more by increasing the score.
    // This forces the algorithm to consolidate items into existing bins when the count is high.
    if open_bins_count > 0 {
        score += (open_bins_count as f64) * 0.5;
    }

    // 5. Lookahead Efficiency: If the current item fits perfectly (post_residual == 0), 
    // heavily reward it.
    if post_residual == 0 {
        score -= 20.0;
    }

    // 6. Final adjustment for fitting_bins_count: 
    // If only one bin can fit this item, we should favor it to avoid opening a new bin prematurely.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 15.0;
    }

    score
}
