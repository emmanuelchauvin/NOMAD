 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items as f64;
    let post = post_residual as f64;
    
    // Base score: prioritize Best Fit (lower post_residual is better)
    let mut score = post;

    // Penalty for creating "dead space": small residuals that are unlikely to fit future items.
    // We penalize values below the expected next item size, scaled by progress to be more aggressive later.
    if post > 0.0 && post < (next_item_size as f64 * 0.8) {
        score += (next_item_size as f64 - post).powf(1.5) * (1.0 + progress);
    }

    // Heuristic: If this is the only bin that fits, we are forced to take it. 
    // Otherwise, penalize opening a new bin (bin_residual == bin_capacity) 
    // unless the current average residual is already very high.
    if bin_residual == bin_capacity {
        if fitting_bins_count > 0 {
            // Heavily penalize opening a new bin if other options exist
            score += 100.0 * (1.0 - progress);
        } else {
            // Opening a new bin is necessary; normalize the cost
            score = 50.0;
        }
    }

    // Reward bins that bring the bin closer to the global mean residual to keep packing density uniform
    let deviation = (post - mean_residual).abs();
    score += deviation * 0.25;

    // Lookahead coupling: If next_item_size is large, avoid small post_residuals 
    // that would force a new bin for the next item.
    if next_item_size > 0 {
        let fit_margin = post - (next_item_size as f64);
        if fit_margin < 0.0 {
            score += (fit_margin.abs()) * 0.5;
        }
    }

    score
}
