 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items as f64;
    let is_new_bin = bin_residual == bin_capacity;
    
    // Base score is the post-residual (Best Fit principle)
    let mut score = post_residual as f64;

    // Penalty for opening a new bin: scales with progress to encourage tighter packing early 
    // and flexibility near the end of the stream.
    if is_new_bin {
        score += 25.0 * (1.0 - progress * 0.5);
        // If we have many open bins, penalize opening a new one heavily
        score += (open_bins_count as f64) * 2.0;
    }

    // Lookahead logic: if next_item_size is large, favor bins that can accommodate it.
    // If post_residual is too small to fit next_item_size, we penalize it.
    if next_item_size > 0 && (post_residual < next_item_size) {
        score += (next_item_size as f64 - post_residual as f64).powf(1.2);
    }

    // Heuristic: If we are down to the last bin that fits, prioritize it unless 
    // it results in a very fragmented space (highly negative post_residual effect).
    if fitting_bins_count == 1 && !is_new_bin {
        score -= 15.0;
    }

    // Coupling: If the post_residual is very small (near perfect fit), 
    // reward it exponentially to fill bins completely.
    if post_residual < 10 {
        score -= (10 - post_residual) as f64 * 5.0;
    }

    // Penalty for leaving the bin with a residual that is hard to fill (e.g., < 10)
    // unless it is exactly 0.
    if post_residual > 0 && post_residual < 10 {
        score += 12.0;
    }

    score
}
