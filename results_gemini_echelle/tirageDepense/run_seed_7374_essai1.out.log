 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Penalty for creating 'dead space' that cannot fit common small items (e.g., < 20)
    if post_residual > 0 && post_residual < 20 {
        score += 45.0;
    }

    // Encourage Best-Fit by rewarding bins that reach near-zero residuals
    if post_residual == 0 {
        score -= 50.0;
    } else if post_residual < 10 {
        score -= 20.0;
    }

    // Lookahead logic: if next_item_size fits in the post_residual, prioritize this bin
    if next_item_size > 0 && post_residual >= next_item_size {
        score -= 30.0;
        // Further refine: favor bins that leave just enough for the next item
        if post_residual - next_item_size < 10 {
            score -= 15.0;
        }
    }

    // Harmonic class logic: penalize bins that leave space which is a bad fraction of capacity
    // We want to avoid residuals that are hard to fill (e.g., 30-50 range)
    if post_residual > 30 && post_residual < 60 {
        score += 25.0;
    }

    // If this is a new bin (bin_residual == bin_capacity), penalize it 
    // unless it is the only option (fitting_bins_count == 0)
    if bin_residual == bin_capacity {
        if fitting_bins_count > 0 {
            score += 65.0;
        } else {
            score -= 10.0; // Minimal cost to open a new bin if necessary
        }
    }

    // Progression scaling: as we approach the end, be more aggressive with packing
    let progress = step_index as f64 / total_items as f64;
    score += progress * 10.0;

    score
}
