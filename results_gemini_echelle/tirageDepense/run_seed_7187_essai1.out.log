 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Perfect Fit Reward: Strongly prioritize zero-residual bins to maximize packing density.
    if post_residual == 0 {
        score -= 500.0;
    }

    // 2. Harmonic Class Logic: Penalize "fragile" residuals that are too small to fit common small-to-medium items (e.g., < 20).
    if post_residual > 0 && post_residual < 20 {
        score += 80.0;
    }

    // 3. Lookahead Synergy: If the next item fits into the current post_residual, reward this bin heavily.
    if next_item_size > 0 && post_residual >= next_item_size {
        score -= 150.0;
    }

    // 4. New Bin Constraint: If this is the only bin that fits, we are forced to take it unless it's a terrible fit.
    // If we are considering opening a brand new bin (bin_residual == bin_capacity), penalize it 
    // unless the mean_residual of existing bins is already very low (indicating they are "full").
    if bin_residual == bin_capacity {
        if open_bins_count > 0 && mean_residual > 25.0 {
            score += 120.0;
        } else {
            score += 300.0; // High penalty for opening new bins prematurely
        }
    }

    // 5. Overflow avoidance: If we are nearing the end of the stream, prioritize finishing existing bins.
    let progress = step_index as f64 / total_items as f64;
    if progress > 0.8 && post_residual < 15 {
        score -= 50.0;
    }

    // 6. Harmonic Modulo Coupling: Favor bins that align with common item size distributions (e.g., multiples of 25).
    let alignment = (post_residual % 25) as f64;
    score += alignment * 0.5;

    score
}
