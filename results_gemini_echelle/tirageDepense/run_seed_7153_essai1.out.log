 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    // Base score is the remaining space (Best Fit principle)
    let mut score = post_residual as f64;

    // Penalty for creating a "fragmented" bin: if the post_residual is too small to fit any common future item
    // (assuming 20 as a reasonable lower bound for small items), penalize heavily.
    if post_residual > 0 && post_residual < 20 {
        score += 40.0;
    }

    // Lookahead logic: if the next item fits perfectly into this post_residual, highly reward this bin.
    if next_item_size > 0 && post_residual >= next_item_size {
        let diff = (post_residual - next_item_size) as f64;
        // Reward perfect fit (diff == 0) and near-perfect fit
        score -= (50.0 / (1.0 + diff)) + 25.0;
    }

    // If this is the only bin that can fit the current item, prioritize it to avoid new bin creation
    if fitting_bins_count == 1 && bin_residual >= item_size {
        score -= 60.0;
    }

    // New bin logic: Only open a new bin if the current mean_residual is very high (lots of wasted space)
    // or if we are early in the stream.
    if bin_residual == bin_capacity {
        let progress = step_index as f64 / total_items as f64;
        // Penalize new bin creation based on existing open bins and mean waste
        score += (open_bins_count as f64 * 5.0) + (mean_residual * 0.5) + (progress * 20.0);
    }

    // Favor bins that bring the bin_residual closer to the global mean_residual to keep space uniform
    let deviation = (post_residual as f64 - mean_residual).abs();
    score += deviation * 0.1;

    score
}
