 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Base Strategy: Best-Fit (minimize post_residual). 
    // New bin penalty: if we aren't forced to open a new bin, penalize the new bin heavily.
    if bin_residual == bin_capacity && open_bins_count > 0 {
        score += 45.0; 
    }

    // 2. Lookahead Coupling: If next_item_size is known, favor bins that leave enough room for it.
    // Specifically, if post_residual is slightly less than next_item_size, it's a "bad" fit.
    if next_item_size > 0 {
        if post_residual < next_item_size && post_residual >= 10 {
            // Penalize bins that create a "dead" gap that cannot fit the next item
            score += (next_item_size - post_residual) as f64 * 1.5;
        } else if post_residual >= next_item_size {
            // Reward bins that perfectly accommodate the predicted next item
            score -= (1.0 - (post_residual - next_item_size) as f64 / bin_capacity as f64) * 10.0;
        }
    }

    // 3. Global Context: Balance bin utilization against mean_residual
    // If the current bin is significantly emptier than the average, we prefer filling it to keep the average tight.
    let residual_delta = bin_residual as f64 - mean_residual;
    if residual_delta > 0.0 {
        score -= residual_delta * 0.2;
    }

    // 4. Scarcity Constraint: If this is the only bin that can fit the item, prioritize it.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 50.0;
    }

    // 5. Progression Weighting: As the stream nears the end, prioritize tightest fits (Best Fit).
    let progress = step_index as f64 / total_items as f64;
    score += progress * (post_residual as f64 * 0.5);

    score
}
