 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items as f64;
    let is_new_bin = bin_residual == bin_capacity;
    
    // Base score is the post_residual (Best Fit principle)
    let mut score = post_residual as f64;

    // Penalty for opening a new bin: higher as we approach the end of the stream
    if is_new_bin {
        if fitting_bins_count > 0 {
            // Discourage new bin if we have options, scaled by progress
            score += 150.0 * (1.0 - progress * 0.5);
        }
        // Penalize new bin based on the scarcity of open bins
        score += (open_bins_count as f64 * 2.0);
    } else {
        // Evaluate fit quality: prefer bins that leave little space (Best Fit)
        // Adjust for lookahead: if next item is large, prefer bins that can accommodate it
        if next_item_size > 0 {
            if post_residual >= next_item_size {
                score -= 25.0; // Reward bin that can fit the next item
            } else if post_residual > 0 && post_residual < 20 {
                score += 40.0; // Penalize creating "dead space" too small for most items
            }
        }
        
        // Influence of global state: if current bin residual is significantly 
        // worse than the mean, penalize it to force consolidation
        if bin_residual as f64 > mean_residual + 10.0 {
            score += 10.0;
        }
        
        // If this is the last chance for this item, prioritize it heavily
        if fitting_bins_count == 1 {
            score -= 50.0;
        }
    }

    // Dynamic balancing: as stream progresses, prioritize tightest packing
    score += (post_residual as f64) * progress;

    score
}
