 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Harmonic Penalty: Penalize post_residuals that are small but non-zero (fragments)
    // We favor perfect fits (post_residual == 0) heavily.
    if post_residual == 0 {
        score -= 500.0;
    } else if post_residual < 10 {
        // Punish "slivers" that are too small to fit common items
        score += 250.0 / (post_residual as f64 + 1.0);
    }

    // 2. Lookahead Coupling: If next_item_size is known, try to keep space for it
    if next_item_size > 0 {
        if post_residual >= next_item_size {
            // Reward bins that can accommodate the next item
            score -= 150.0;
        } else if post_residual > 0 {
            // Penalize bin if it blocks the next item from fitting here
            score += 100.0;
        }
    }

    // 3. Global Bin Management: Avoid opening a new bin if possible
    let is_new_bin = bin_residual == bin_capacity;
    if is_new_bin {
        // High barrier to entry: only open a new bin if the mean_residual of existing bins
        // is already very tight or if no other bin can fit the item well.
        score += 120.0 + (mean_residual * 2.0);
    }

    // 4. Harmonic Density: Favor bins that align with item size thresholds
    // Using modulo to encourage filling bins to "harmonic" capacity levels (e.g., 25, 33, 50)
    let harmonic_alignment = (bin_capacity - post_residual) % 25;
    score += harmonic_alignment as f64 * 0.5;

    // 5. Progression Scaling: As we near the end of the stream, be more aggressive with packing
    let progress = step_index as f64 / total_items as f64;
    score -= progress * 50.0;

    score
}
