 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Dead Space Penalty: If the post_residual is small (1..9), it creates "slivers" 
    // that are unusable for future items (min size 10). Penalize heavily.
    if post_residual > 0 && post_residual < 10 {
        score += 500.0 / (post_residual as f64);
    }

    // 2. Lookahead Synergy: If the next item fits into the remaining space, favor this bin.
    if next_item_size > 0 && next_item_size <= post_residual {
        score -= 200.0;
    }

    // 3. Open Bin Pressure: If we have many open bins, penalize opening a new one.
    // If fitting_bins_count is 0, we are evaluating the "New Bin" option.
    if fitting_bins_count == 0 {
        score += (open_bins_count as f64) * 15.0;
    } else {
        // If we have options, prefer bins that are closer to the mean residual to keep
        // the packing density uniform across active bins.
        let diff = (post_residual as f64 - mean_residual).abs();
        score += diff * 0.5;
    }

    // 4. Tightness Reward: Favor bins that result in a perfectly filled bin (0 residual).
    if post_residual == 0 {
        score -= 300.0;
    }

    // 5. Progression Scaling: As we reach the end of the stream, prioritize 
    // closing bins over opening new ones.
    let progress = step_index as f64 / total_items as f64;
    if fitting_bins_count == 0 {
        score += progress * 100.0;
    }

    score
}
