 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Best-Fit Penalty: Penalize large post_residuals to keep bins tightly packed.
    // 2. Lookahead Synergy: If post_residual can accommodate the next item, reward this bin.
    if next_item_size > 0 {
        if post_residual >= next_item_size {
            score -= (next_item_size as f64) * 0.8;
        } else {
            // Penalty if the current placement leaves a gap that creates "orphan" space
            // smaller than the expected average item size (implicitly ~30-40).
            if post_residual > 0 && post_residual < 20 {
                score += 45.0;
            }
        }
    }

    // 3. Last Chance Logic: If this is the only bin that fits the item, make it highly attractive.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 50.0;
    }

    // 4. New Bin Threshold: If we are considering a new bin (bin_residual == bin_capacity),
    // apply a penalty based on how many bins are already open to discourage fragmentation.
    if bin_residual == bin_capacity {
        score += (open_bins_count as f64) * 1.5;
        // If we have plenty of open bins, opening a new one is very expensive.
        if open_bins_count > 5 {
            score += 40.0;
        }
    }

    // 5. Mean Residual Alignment: If this bin's post_residual is close to the global mean,
    // it suggests consistent filling; otherwise, penalize deviation.
    let residual_diff = (post_residual as f64 - mean_residual).abs();
    score += residual_diff * 0.1;

    score
}
