 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Harmonic Penalty: Heavily penalize residuals that are small but non-zero (fragments)
    // if they cannot accommodate common item sizes.
    if post_residual > 0 && post_residual < 20 {
        score += 45.0;
    }

    // 2. Lookahead Logic: If next item exists, favor bins that can accommodate it.
    // If current bin can fit the next item after the current one, reward this bin.
    if next_item_size > 0 && post_residual >= next_item_size {
        score -= 25.0;
    }

    // 3. New Bin Thresholding: Discourage opening new bins unless the current 
    // fit is extremely poor (Best-Fit approximation).
    if bin_residual == bin_capacity {
        if fitting_bins_count > 0 {
            // Strong penalty for opening a new bin if an existing one is available
            score += 60.0;
        } else {
            // Neutral score for forced new bin
            score = 10.0;
        }
    }

    // 4. Harmonic Alignment: Prefer bins with residuals that are multiples of 
    // common item sizes (e.g., 20, 25, 33, 50) to minimize fragmentation.
    let remainder = post_residual % 25;
    if remainder == 0 {
        score -= 10.0;
    }

    // 5. Global State Balancing: If we have many open bins, prioritize closing gaps.
    // Scale by the ratio of current progression to favor tighter packing later.
    let progress = step_index as f64 / total_items as f64;
    score += (open_bins_count as f64) * 2.0 * progress;

    // 6. Mean Residual Correction: Avoid bins that deviate significantly from 
    // the average filling level to maintain bin homogeneity.
    let deviation = (post_residual as f64 - mean_residual).abs();
    score += deviation * 0.1;

    score
}
