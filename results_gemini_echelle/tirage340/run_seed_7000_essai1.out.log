 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;
    let progress = step_index as f64 / total_items as f64;

    // Penalty for creating a bin that is "too empty" early on, 
    // but favor keeping the bin as tight as possible (Best Fit).
    // If post_residual is 0, we found a perfect fit, maximize reward.
    if post_residual == 0 {
        score -= 500.0;
    }

    // Penalty for creating a new bin if we have other options.
    if bin_residual == bin_capacity && open_bins_count > 0 {
        score += 150.0 * (1.0 - progress);
    }

    // Lookahead logic: if next_item_size is large, avoid leaving a residual
    // that is just slightly too small to fit the next item.
    if next_item_size > 0 {
        if post_residual < next_item_size && post_residual >= 10 {
            // This is a "fragmentation" trap. Penalize heavily.
            score += 80.0;
        } else if post_residual >= next_item_size {
            // This is a "synergy" opportunity. Reward.
            score -= 40.0;
        }
    }

    // Use mean_residual to balance the load across open bins.
    // If this bin is already emptier than the average, we prefer filling it.
    if (bin_residual as f64) > mean_residual {
        score -= 20.0;
    }

    // If fitting_bins_count is 1, this is the only bin that can take the item.
    // We should be more lenient with the resulting residual.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 30.0;
    }

    // Final scaling: favor bins that result in small residuals (Best Fit)
    // but weight it against the remaining capacity of the bin set.
    score += (post_residual as f64) * 0.5;

    score
}
