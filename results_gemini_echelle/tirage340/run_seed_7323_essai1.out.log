 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Best-Fit Penalty: Minimize post_residual, but heavily penalize values that 
    // are too small to fit any common future item (creating "dead space").
    // We favor post_residual values that are either 0 or large enough to accommodate next_item_size.
    if post_residual > 0 && post_residual < next_item_size {
        score += 50.0 + (next_item_size - post_residual) as f64;
    }

    // 2. Lookahead Synergy: Reward placements where the remaining space exactly fits the next item.
    if next_item_size > 0 && post_residual == next_item_size {
        score -= 40.0;
    }

    // 3. Fragmentation Control: If this is the last bin that can fit the item, 
    // and the post_residual is awkward, penalize it to force a new bin if necessary.
    if fitting_bins_count == 1 && post_residual > 0 && post_residual < 20 {
        score += 25.0;
    }

    // 4. Global Load Balancing: Avoid creating bins with residuals significantly 
    // lower than the current mean_residual, as this leads to many fragmented bins.
    if (post_residual as f64) < mean_residual * 0.5 {
        score += 15.0;
    }

    // 5. New Bin Logic: If this is a new bin (bin_residual == bin_capacity),
    // only choose it if the current open bins are highly inefficient.
    if bin_residual == bin_capacity {
        if open_bins_count == 0 {
            score = -100.0; // Must open if empty
        } else {
            // Only open a new bin if the mean residual of existing bins is already very tight
            // or if we have too many bins and need to pack larger items better.
            score = 45.0 + (mean_residual * 0.5);
        }
    }

    // 6. Progress Scaling: As we approach the end of the stream, prioritize 
    // filling existing bins over opening new ones.
    let progress = step_index as f64 / total_items as f64;
    if bin_residual == bin_capacity {
        score += progress * 100.0;
    }

    score
}
