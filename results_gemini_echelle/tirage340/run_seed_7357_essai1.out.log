 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items as f64;
    let is_new_bin = bin_residual == bin_capacity;
    
    // Base score is the post-placement residual (Best Fit principle)
    // We want to minimize post_residual (tight packing)
    let mut score = post_residual as f64;

    // Penalty for opening a new bin prematurely
    if is_new_bin {
        if fitting_bins_count > 0 {
            // Heavily penalize opening a new bin if other bins can fit the item
            score += 150.0 + (50.0 * (1.0 - progress));
        } else {
            // If no other bins fit, normalizing the cost of a new bin
            score += 20.0;
        }
    } else {
        // Encourage filling bins that are already "fragmented" (low residual)
        // vs bins that are "open" (high residual) to maximize future capacity
        score += (bin_residual as f64 - mean_residual).abs() * 0.5;
        
        // Lookahead heuristic: If the next item is large, favor bins that 
        // will have enough space left for it (or minimize waste if it won't fit)
        if next_item_size > 0 {
            if post_residual >= next_item_size {
                score -= 30.0; // Reward bin that can accommodate the next item
            } else if post_residual > 0 && post_residual < 20 {
                score += 40.0; // Penalize creating "dead space" that likely won't fit future items
            }
        }
    }

    // Dynamic constraint: As the stream progresses, become more aggressive 
    // about packing tightly to avoid straggler items at the end
    if progress > 0.8 {
        score += post_residual as f64 * 2.0;
    }

    score
}
