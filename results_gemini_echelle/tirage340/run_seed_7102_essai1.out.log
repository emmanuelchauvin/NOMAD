 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items as f64;
    let post = post_residual as f64;
    
    // Base score is the residual space remaining (Best Fit principle).
    let mut score = post;

    // Penalty for creating "dead zones": if the residual is too small to fit typical future items,
    // we penalize it. We use the next_item_size to dynamically adjust the threshold.
    if post > 0.0 && post < next_item_size as f64 {
        score += (next_item_size as f64 - post).powi(2) * 0.5;
    }

    // Dynamic Lookahead Coupling:
    // If we are late in the stream, favor tighter packing (lower post_residual) to close bins.
    // Early in the stream, allow slightly more loose packing to keep bins available for larger items.
    score += (1.0 - progress) * (bin_capacity as f64 - post) * 0.1;

    // Penalty for opening new bins:
    // If this is a new bin (bin_residual == bin_capacity), apply a heavy penalty
    // unless the number of fitting bins is extremely low or the current bin is inefficient.
    if bin_residual == bin_capacity {
        score += 25.0 + (open_bins_count as f64 * 0.5);
    }

    // Global Efficiency Correction:
    // If the mean residual of open bins is high, we are being too wasteful.
    // Heavily penalize placements that increase the mean residual further.
    if post > mean_residual {
        score += (post - mean_residual) * 2.0;
    }

    // If this is the only bin that can fit the item, prioritize it to avoid opening a new bin.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 15.0;
    }

    score
}
