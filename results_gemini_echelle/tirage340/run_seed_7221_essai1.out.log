 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;
    let progress = step_index as f64 / total_items as f64;
    let is_new_bin = bin_residual == bin_capacity;

    if is_new_bin {
        // Penalty for opening a new bin is weighted by how much space is left in existing bins.
        // If many bins have plenty of space, opening a new one is expensive.
        score = 25.0 + (mean_residual * 0.5);
    } else {
        // Best Fit Decreasing logic: minimize post_residual.
        // Reward placements that leave a residual capable of fitting the next item (Lookahead).
        if next_item_size > 0 {
            if post_residual >= next_item_size {
                score -= 15.0;
            } else if post_residual > 0 {
                // If the next item won't fit, punish small residuals (fragmentation) 
                // but reward filling the bin tightly.
                score += (post_residual as f64).powf(1.5);
            }
        }

        // Global state awareness: If we are near the end of the stream, 
        // prioritize closing bins (lower residual) over saving space for future items.
        if progress > 0.8 {
            score -= (bin_capacity - post_residual) as f64 * 0.2;
        }

        // Penalty for creating "orphan" bins that are hard to fill.
        if post_residual < 15 && post_residual > 0 {
            score += 10.0;
        }
    }

    // Encourage using bins that are already partially filled rather than spreading 
    // across many bins, unless the fit is extremely poor.
    score += (open_bins_count as f64) * 0.1;

    score
}
