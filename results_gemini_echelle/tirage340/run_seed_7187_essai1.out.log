 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    // Heuristic #211: Harmonic Residual Optimization
    // Targets the minimization of "orphan" space by favoring residuals that are 
    // multiples of common item sizes and penalizing gaps that prevent future packing.
    
    let mut score = post_residual as f64;

    // 1. Harmonic Penalty: Penalize residuals that are too small to fit typical items (10-30)
    // but large enough to waste space.
    if post_residual > 0 && post_residual < 20 {
        score += 45.0;
    }

    // 2. Lookahead Coupling: If next_item_size exists, favor residuals that accommodate it.
    // If post_residual is exactly next_item_size, it's a perfect fit (score reduction).
    if next_item_size > 0 {
        if post_residual == next_item_size {
            score -= 30.0;
        } else if post_residual > next_item_size {
            score -= 10.0;
        } else {
            // Penalty for stranding the next item
            score += 25.0;
        }
    }

    // 3. New Bin Thresholding: Prevent opening new bins unless the current fit is catastrophic.
    if bin_residual == bin_capacity {
        // Only open a new bin if we have many open bins already or if fitting_bins_count is low
        if open_bins_count > 5 {
            score += 20.0;
        } else {
            score += 55.0; // Strong resistance against opening new bins
        }
    }

    // 4. Mean Residual Balancing: Avoid bins that deviate significantly from the global mean
    let deviation = (post_residual as f64 - mean_residual).abs();
    score += deviation * 0.5;

    // 5. Harmonic Class Logic: Favor residuals that are multiples of 25 (common capacity fraction)
    if post_residual % 25 == 0 {
        score -= 15.0;
    }

    // 6. Progression Scaling: As the stream nears the end, prioritize filling existing bins
    let progress = step_index as f64 / total_items as f64;
    score += progress * 10.0;

    score
}
