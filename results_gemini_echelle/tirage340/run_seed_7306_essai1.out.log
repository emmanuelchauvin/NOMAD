 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Best-Fit logic: penalize large post_residuals to keep bins tightly packed.
    // We add a slight weight to discourage wasted space.
    score += (post_residual as f64) * 0.5;

    // 2. Lookahead mechanism: If the next item fits perfectly into this post_residual, 
    // strongly reward this bin choice (negative score).
    if next_item_size > 0 && post_residual >= next_item_size {
        let fit_diff = (post_residual - next_item_size) as f64;
        // Reward small gaps after placing the next item (perfect fit = 0 gap)
        score -= (100.0 - fit_diff) * 2.0;
    }

    // 3. Last-chance penalty: If this is the only bin that can fit the current item, 
    // but the resulting post_residual is very large (inefficient), penalize it 
    // to potentially trigger a new bin if the distribution allows.
    if fitting_bins_count == 1 && post_residual > 40 {
        score += 50.0;
    }

    // 4. Global balance: If the current bin is significantly emptier than the average,
    // penalize it to encourage consolidating items into fuller bins.
    if (bin_residual as f64) > mean_residual {
        score += 10.0;
    }

    // 5. New bin handling: A brand new bin (bin_residual == bin_capacity) 
    // should only be opened if no existing bin provides a "good" fit.
    // We calibrate the new bin base cost to be high to favor existing bins.
    if bin_residual == bin_capacity {
        score += 65.0; 
        // Penalize new bins more as we approach the end of the stream 
        // to avoid fragmentation.
        score += (step_index as f64 / total_items as f64) * 20.0;
    }

    score
}
