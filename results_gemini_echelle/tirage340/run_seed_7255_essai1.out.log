 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items as f64;
    let post = post_residual as f64;
    
    // Base heuristic: Minimize post_residual (Best Fit).
    // Penalize large empty spaces that are unlikely to accommodate future items.
    let mut score = post * post;

    // Lookahead coupling: If a next item exists, penalize post_residual 
    // that makes it impossible to fit the next item.
    if next_item_size > 0 {
        if post < next_item_size as f64 {
            score += 5000.0 * (1.0 - progress);
        }
    }

    // Dynamic density pressure: As the stream progresses, 
    // favor bins that align with the current mean residual to maintain bin uniformity.
    let residual_diff = (post - mean_residual).abs();
    score += residual_diff * 10.0 * (1.0 - progress);

    // New Bin Logic:
    // If this is a new bin (bin_residual == bin_capacity), calculate the cost of opening it.
    // We only open a new bin if the 'fitting' options are all 'poor' (high post_residual).
    if bin_residual == bin_capacity {
        // High penalty for opening a new bin early, but reduce penalty as we near the end of the stream
        // to ensure we don't end up with many half-full bins at the very end.
        score = 2500.0 + (progress * 1500.0);
    } else {
        // If it's not a new bin, we provide a bonus for being a tight fit.
        // We subtract a weight based on how many other bins could fit the item.
        // If fitting_bins_count is 1, this is a "last chance" bin; prioritize it.
        if fitting_bins_count == 1 {
            score -= 2000.0;
        }
    }

    score
}
