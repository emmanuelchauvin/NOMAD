 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items as f64;
    
    // Base score: Favor tighter fits (Best Fit principle).
    let mut score = post_residual as f64;

    // Penalty for opening a new bin if we have fitting alternatives.
    if bin_residual == bin_capacity && fitting_bins_count > 0 {
        score += 45.0 + (progress * 20.0);
    }

    // Lookahead logic: If the next item fits into the current post_residual, 
    // prioritize this bin to maximize bin utilization.
    if next_item_size > 0 && post_residual >= next_item_size {
        score -= 15.0;
    }

    // Dynamic penalty for "orphan" space: If the post_residual is too small to 
    // hold typical items (assuming 25 as a rough threshold for small items), 
    // penalize this bin to avoid creating fragmented dead space.
    if post_residual < 25 && post_residual > 0 {
        score += (25.0 - post_residual as f64) * 0.8;
    }

    // Global state awareness: If the mean residual of currently open bins is high,
    // we are likely wasting space. Encourage filling the most empty bins first.
    if (bin_residual as f64) > mean_residual {
        score -= 5.0;
    }

    // End-of-stream pressure: As we approach the end, prioritize closing bins
    // by packing as tightly as possible, ignoring the "new bin" threshold.
    if progress > 0.8 {
        score -= (bin_capacity - post_residual) as f64 * 0.1;
    }

    score
}
