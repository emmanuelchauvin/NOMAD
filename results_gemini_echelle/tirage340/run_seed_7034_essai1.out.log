 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    // Start with the basic Best-Fit objective: minimize remaining space.
    let mut score = post_residual as f64;

    // 1. Penalize creating "fragmented" bins that are hard to fill later.
    // If post_residual is small but > 0, it's often a "dead zone".
    if post_residual > 0 && post_residual < 20 {
        score += 25.0;
    }

    // 2. Lookahead matching: reward bins where the post_residual can fit the next item.
    if next_item_size > 0 {
        if post_residual >= next_item_size {
            score -= 40.0;
        } else if post_residual > 0 {
            // Penalize if the current placement prevents the next item from fitting here.
            score += 15.0;
        }
    }

    // 3. Pressure to consolidate: if we have many open bins, penalize opening new ones.
    // fitting_bins_count == 0 implies this is a new bin.
    if fitting_bins_count == 0 {
        score += 60.0 * (1.0 - (step_index as f64 / total_items as f64).powf(0.5));
    }

    // 4. Global balance: if current bin is significantly worse than the mean, penalize it.
    if (post_residual as f64) > mean_residual + 10.0 {
        score += 10.0;
    }

    // 5. Last chance urgency: if this is the only bin that fits, prioritize it heavily.
    if fitting_bins_count == 1 && post_residual < 10 {
        score -= 50.0;
    }

    score
}
