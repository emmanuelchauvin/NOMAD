 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    // Objective: Minimize score.
    // Strategy: Balance Best-Fit (minimizing post_residual) with a penalty for creating 
    // "unusable" small gaps (fragmentation) and a lookahead bias to save space for larger future items.
    
    let mut score = post_residual as f64;
    
    // 1. Penalize creating small, unusable gaps (1..9). These are "dead zones" for the given item range.
    if post_residual > 0 && post_residual < 10 {
        score += 50.0 - (post_residual as f64 * 5.0);
    }

    // 2. Lookahead optimization: If next_item_size is large, avoid leaving small residuals.
    if next_item_size > 0 {
        if post_residual > 0 && post_residual < next_item_size {
            // Penalize bins that cannot accommodate the next item when they otherwise could have.
            score += (next_item_size - post_residual) as f64 * 1.5;
        }
    }

    // 3. Global state: If we are late in the stream, prioritize closing bins (lower mean_residual).
    let progress = step_index as f64 / total_items as f64;
    if progress > 0.8 {
        score -= (bin_capacity - post_residual) as f64 * 0.5;
    }

    // 4. New Bin Logic: Discourage opening a new bin unless the current fit is extremely poor.
    // We treat the "new bin" candidate (bin_residual == bin_capacity) with a base penalty.
    if bin_residual == bin_capacity {
        // Only open a new bin if the average residual is already high, 
        // meaning existing bins are already poorly utilized.
        score = 45.0 + (mean_residual * 0.5);
    } else {
        // Encourage using existing bins by reducing their score slightly.
        score -= 5.0;
    }

    // 5. Tie-breaker: If fitting_bins_count is low, we are running out of options.
    if fitting_bins_count <= 2 {
        score -= 10.0;
    }

    score
}
