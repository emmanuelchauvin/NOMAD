 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let is_new_bin = bin_residual == bin_capacity;
    let progress = step_index as f64 / total_items as f64;
    let mut score = post_residual as f64;

    // 1. Refined New Bin Penalty: Stricter gating to force reuse of existing bins.
    if is_new_bin {
        let density_bias = (mean_residual / bin_capacity as f64) * 72.0;
        score += 185.0 + (open_bins_count as f64 * 5.2) + density_bias + (progress * 95.0);
    } else {
        // 2. High-Density Reward: Emphasize perfect fits and near-perfect residual gaps.
        if post_residual == 0 {
            score -= 245.0;
        } else if post_residual < 8 {
            score -= 115.0 + (8.0 - post_residual as f64) * 18.0;
        }
    }

    // 3. Lookahead Optimization: Non-linear reward for future-proofing.
    if next_item_size > 0 {
        if post_residual >= next_item_size {
            let space_after_next = post_residual - next_item_size;
            // Reward bins that leave a "sweet spot" (low residual) after the next item.
            score -= 155.0 + (if space_after_next == 0 { 95.0 } else if space_after_next < 12 { 55.0 } else { 0.0 });
        } else if post_residual > 0 {
            // Penalize stranding space that is useless for the immediate next item.
            score += 125.0 * (1.0 - (post_residual as f64 / next_item_size as f64).powf(0.85));
        }
    }

    // 4. Fragmentation Control: Targeted suppression of "Dead Zones" (slivers).
    // Shifted center to target tighter residual gaps (8-18) to avoid stranded small items.
    if post_residual >= 4 && post_residual <= 20 {
        score += 125.0 * (1.0 - (post_residual as f64 - 12.0).abs() / 8.0);
    }

    // 5. Dynamic Mean Deviation: Coupling mean_residual with progress to tighten packing.
    if mean_residual > 0.0 {
        score += (post_residual as f64 - mean_residual).abs() * (0.95 + progress * 2.0);
    }

    // 6. Scarcity Constraint: Force consolidation when options are limited.
    if fitting_bins_count <= 2 && !is_new_bin {
        score -= 225.0;
    }

    // 7. Temporal Pressure: Progressive tightening of the packing constraint.
    score += (progress.powf(2.5)) * 240.0;

    // 8. Residual normalization: Logarithmic penalty for large remaining capacities to favor compact bins.
    // Increased exponent to punish large residuals more aggressively as the bin nears capacity exhaustion.
    score += (post_residual as f64 / bin_capacity as f64).powf(1.4) * 45.0;

    score
}
