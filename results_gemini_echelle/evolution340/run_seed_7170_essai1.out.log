 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    // Base cost: prioritize tighter packing, amplified by post_residual
    let mut score = (post_residual as f64) * 2.15;

    // 1. High-Precision Consolidation: Reward near-perfect fits aggressively
    if post_residual == 0 {
        score -= 920.0;
    } else if post_residual < 12 {
        score -= 680.0 / (post_residual as f64 + 0.15);
    }

    // 2. Adaptive Lookahead: Calculate synergy with next item
    if next_item_size > 0 {
        let fit_diff = post_residual as i32 - next_item_size as i32;
        if fit_diff == 0 {
            score -= 780.0;
        } else if fit_diff > 0 {
            // Reward keeping space for the next item, heavily penalize creating tiny unusable gaps
            let efficiency_gain = 1.0 - (fit_diff as f64 / bin_capacity as f64).powf(0.35);
            score -= 520.0 * efficiency_gain;
            if fit_diff < 5 { score += 200.0; } // Penalty for creating "sliver" gaps
        } else {
            // Penalize blocking the next item significantly if the item is large
            score += 650.0 * (1.0 - (post_residual as f64 / next_item_size as f64).clamp(0.0, 1.0));
        }
    }

    // 3. New Bin Gatekeeping: Dynamic penalty based on progress and current utilization
    if bin_residual == bin_capacity {
        let progress = step_index as f64 / total_items as f64;
        let mut new_bin_cost = 450.0 - (progress * 150.0);
        
        if fitting_bins_count > 0 {
            // Exponentially increase penalty to avoid opening new bins when space is available
            new_bin_cost += (fitting_bins_count as f64).powf(1.95) * 220.0;
        }
        
        if mean_residual > (bin_capacity as f64 * 0.12) {
            new_bin_cost += 400.0;
        }
        score += new_bin_cost;
    }

    // 4. Utilization Pressure: Favor deep filling of existing bins
    let used_ratio = (bin_capacity - bin_residual) as f64 / bin_capacity as f64;
    score -= 580.0 * used_ratio.powf(4.2);

    // 5. Fragmentation Mitigation: Penalize "unusable" gap zones
    let residual_ratio = post_residual as f64 / bin_capacity as f64;
    if residual_ratio > 0.03 && residual_ratio < 0.18 {
        // Penalize the "dead zone" where residual is too small for common items but too large to ignore
        score += 480.0 * (1.0 - (residual_ratio - 0.10).abs() * 10.0);
    }

    // 6. Global Entropy Constraint: Improved scaling
    if open_bins_count > 4 {
        let density = (mean_residual / bin_capacity as f64).clamp(0.05, 0.4);
        let expected_bins = (step_index as f64 * density).max(4.0);
        if (open_bins_count as f64) > expected_bins {
            score += 350.0 * ((open_bins_count as f64) / expected_bins).powf(2.5);
        }
    }

    score
}
