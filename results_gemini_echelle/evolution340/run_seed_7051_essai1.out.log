        }
    } else {
        let utilization = (bin_capacity - bin_residual) as f64 / bin_capacity as f64;
        if utilization > 0.55 {
            score -= 65.0 * utilization;
        }
        
        // If only one bin fits, prioritize it, but strongly penalize creating a sliver.
        if fitting_bins_count == 1 {
