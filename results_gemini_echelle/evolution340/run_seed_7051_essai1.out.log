                score += 120.0;
            } else {
                score -= 130.0;
            }
        }
    }

    // Global optimization: Dynamic phase-shifting.
    if progress > 0.85 {
        // Aggressively minimize remaining capacity in the final stages.
        score += (post_residual as f64).powf(1.25) * 8.0;
    } else {
        // Use a weighted variance penalty to balance filling efficiency vs flexibility.
        // Penalty is tighter to force better mean convergence.
        score += (post_residual as f64 - mean_residual).abs() * 0.55 * (1.0 - progress);
    }

    // Final sanity check: favor smaller residuals more aggressively when bin count is high
    if open_bins_count > 50 {
