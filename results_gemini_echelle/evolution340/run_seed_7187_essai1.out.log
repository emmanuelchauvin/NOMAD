 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;
    let progress = step_index as f64 / total_items as f64;
    let is_new_bin = bin_residual == bin_capacity;

    // 1. Refined Residual Penalty: Avoid the "Dead Zone" (1-22)
    // Adjusted to be more aggressive in late-stage packing to prevent stranded small items
    if post_residual > 0 && post_residual <= 22 {
        score += 58.0 + (progress * 35.0);
    }

    // 2. Adaptive Lookahead Synergy
    // Heavily reward bins that perfectly accommodate the next item to minimize future fragmentation
    if next_item_size > 0 {
        if post_residual == 0 {
            score -= 35.0;
        } else if post_residual >= next_item_size {
            let slack = (post_residual - next_item_size) as f64;
            // Non-linear reward for high-precision packing
            score -= 28.0 * (1.0 - (slack / bin_capacity as f64).powf(0.7));
        } else if !is_new_bin {
            // Penalty for stranding the next item in an existing bin
            score += 55.0 * (1.0 - (progress * 0.5));
        }
    }

    // 3. New Bin Thresholding
    // Increased dynamic cost of new bins based on current packing density
    if is_new_bin {
        let density_factor = 1.0 - (mean_residual / bin_capacity as f64);
        let open_penalty = 75.0 + (open_bins_count as f64 * 5.5) + (progress * 65.0) + (density_factor * 40.0);
        score += open_penalty;
    }

    // 4. Fragmentation Avoidance
    // If only one bin fits, prioritize it heavily to avoid opening a new bin unnecessarily
    if fitting_bins_count == 1 && !is_new_bin {
        score -= 95.0;
    }

    // 5. Mean Residual Calibration
    // Reward bins that pull the system toward the mean residual, reducing variance
    if (bin_residual as f64) < mean_residual {
        score -= 12.0;
    }
    
    // Tight-fit reward for bins nearing completion
    if post_residual < 8 && post_residual > 0 {
        score -= 18.0;
    }

    // 6. Entropy dampening: discourage picking the same bin if it is very empty
    // unless necessary, to keep "fresher" bins open for potential large items
    if !is_new_bin && bin_residual > (bin_capacity * 3 / 4) {
        score += 15.0 * progress;
    }

    score
}
