 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    // Base cost: exponential penalty on post_residual to favor tightest-fit (Best-Fit)
    // Slightly increased exponent to sharpen the distinction between tight and loose fits
    let mut score = (post_residual as f64).powf(1.26);

    // 1. Lookahead Optimization: Refined geometric weighting
    // Improved coupling: reward bins that leave space for next item, while penalizing large gaps
    if next_item_size > 0 {
        if post_residual >= next_item_size {
