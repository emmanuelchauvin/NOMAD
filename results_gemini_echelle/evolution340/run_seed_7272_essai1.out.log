    // Tighten the cost of opening a new bin to force better utilization of current bins
    if bin_residual == bin_capacity {
        let progress = step_index as f64 / total_items as f64;
        // Increased base cost to open new bins to force consolidation
        score += 98.0 + (mean_residual * 1.25) - (progress * 85.0);
    }

    // 5. Global Density & Entropy
    // Heavier weight on fill ratio to promote consolidation
    let fill_ratio = 1.0 - (bin_residual as f64 / bin_capacity as f64);
    score -= fill_ratio * 55.0;
    // Non-linear penalty for excessive open bin count to prevent high-entropy state
    score += (open_bins_count as f64).powf(1.2) * 11.0;

