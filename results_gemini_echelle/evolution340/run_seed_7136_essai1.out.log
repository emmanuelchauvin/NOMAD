        // Added a log factor to scale penalty with total_items to prevent early bin sprawl
        let base_penalty = 128.0 + (open_bins_count as f64 * 0.95) + (progress * 55.0) + (fitting_bins_count as f64 * 12.0);
        score = base_penalty;
        
        // If we are in the late-game, make opening a new bin prohibitively expensive
