 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;
    let progress = step_index as f64 / total_items as f64;
    let is_new_bin = bin_residual == bin_capacity;

    // 1. Refined Fragment Mitigation: Focus on high-risk dead zones (1-32)
    if post_residual > 0 && post_residual <= 32 {
        score += 145.0 - (post_residual as f64 * 2.1);
    }

    // 2. Predictive Lookahead: Non-linear reward for perfect fit
    if next_item_size > 0 {
        if next_item_size <= post_residual {
            let tightness = (post_residual - next_item_size) as f64;
            score -= (150.0 - tightness * 4.5).max(0.0);
        } else if post_residual > 0 {
            // Penalty for creating gaps that cannot accommodate the next item
            score += 72.0 * (1.0 + (next_item_size - post_residual) as f64 / bin_capacity as f64).min(2.5);
        }
    }

    // 3. Dynamic Thresholding: Stricter gate for new bin creation using residual density
    if is_new_bin {
        if fitting_bins_count == 0 {
            score = -50.0;
        } else {
            // Delay new bin creation by weighting mean_residual against local progress
            score = 140.0 + (mean_residual * 2.8) - (progress * 135.0);
        }
    } else {
        // 4. Tightness Bias: Increased penalty for leaving excessive residual
        score += (bin_capacity - bin_residual) as f64 * 0.95;
    }

    // 5. Late Game Compaction: Aggressive closing of gaps
    if progress > 0.35 {
        let late_factor = (progress - 0.35) / 0.65;
        score -= (bin_capacity - post_residual) as f64 * 2.5 * late_factor;
        score += post_residual as f64 * late_factor * 4.2;
    }

    // 6. Adaptive Congestion Control: Adjusted target_bins for higher density
    let target_bins = (total_items as f64 / (bin_capacity as f64 * 0.0195)).max(12.0);
    if open_bins_count as f64 > target_bins {
        let congestion_ratio = (open_bins_count as f64 / target_bins).min(8.0);
        score += post_residual as f64 * congestion_ratio * 4.0;
    }
    
    // 7. Small Item Consolidation: Target large bin residuals for small items
    if item_size < 18 {
        let residual_pct = bin_residual as f64 / bin_capacity as f64;
