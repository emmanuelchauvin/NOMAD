 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    // Start with a base score favoring tighter fits, recalibrated for higher precision.
    let mut score = post_residual as f64 * 0.82;

    // 1. Adaptive Fragmentation & Lookahead Coupling:
    // Penalize gaps that are unusable for the immediate next item, scaled by bin density.
    if post_residual > 0 && post_residual < next_item_size {
        let urgency = (next_item_size - post_residual) as f64;
        let density_weight = 1.0 + (open_bins_count as f64 / (total_items as f64 / 750.0 + 1.2));
        let availability_factor = if fitting_bins_count > 1 { 0.42 } else { 3.2 };
        score += urgency * density_weight * availability_factor;
    }

    // 2. Bin Lifecycle & Pressure Management:
    // Increased penalty for opening new bins when existing bins can take the item.
    if bin_residual == bin_capacity {
        let progress = step_index as f64 / total_items as f64;
        let base_cost = 82.0 + (progress * 45.0);
        
        if fitting_bins_count > 0 {
            // Non-linear penalty for opening new bins while existing capacity exists.
            score += base_cost + (fitting_bins_count as f64).powf(1.15) * 35.0;
        } else {
            score += base_cost * 0.18;
        }
    }

    // 3. Dynamic Residual Balancing:
    // Shift target residual to favor tighter packing; penalize deviations from mean.
    let target_residual = mean_residual * 0.38; 
    let fullness_ratio = (bin_capacity - bin_residual) as f64 / bin_capacity as f64;
    if (post_residual as f64) > target_residual {
        score += (post_residual as f64 - target_residual).powf(1.25) * (0.8 + fullness_ratio);
    } else {
        score -= (target_residual - post_residual as f64).powf(0.85) * 0.45;
    }

    // 4. Harmonic Fit & Geometric Rewards:
    // Aggressive rewards for near-perfect fits to minimize total wasted space.
    if post_residual == 0 {
        score -= 85.0;
    } else if post_residual <= 2 {
        score -= 42.0;
    } else if post_residual <= 5 {
        score -= 18.0;
    }

    // 5. Global Entropy Control:
    // Penalty for proliferation of open bins; reward bins with higher utilization.
    score += (open_bins_count as f64).powf(1.38) * 1.15;
    score -= (bin_capacity - bin_residual) as f64 * 0.18;

    // 6. Lookahead & Fragmentation Prevention:
    // If next_item_size is large, prioritize bins that create space for it.
    if next_item_size > 45 {
        if bin_residual < next_item_size {
            score += 65.0; 
        } else if post_residual < 10 {
            score -= 50.0;
        }
    } else if next_item_size < 12 && post_residual > 70 {
        // Prevent wasting high-capacity bins on tiny items.
        score += 25.0;
    }

    score
}
