 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let post_res = post_residual as f64;
    let cap = bin_capacity as f64;
    let is_new_bin = bin_residual == bin_capacity;
    let progress = step_index as f64 / total_items as f64;

    // Baseline: prioritize minimal residual space with higher weight on post_residual.
    let mut score = post_res * 0.98;

    // Lookahead: Focus on preventing the "dead zone" where post_residual
    // is smaller than the next item size but larger than zero.
    if next_item_size > 0 && post_res > 0.0 {
        if post_res < next_item_size as f64 {
            let gap_waste = next_item_size as f64 - post_res;
            score += gap_waste.powf(2.4) * (26.0 + (1.0 - progress) * 16.0);
        } else if post_res < (next_item_size as f64 * 1.5) {
            score += 16.0;
        }
    }

    // New Bin Gatekeeping:
    // Stricter barrier to opening new bins when current ones can fit the item.
    if is_new_bin {
        if fitting_bins_count > 0 {
            let fragmentation_pressure = (open_bins_count as f64).powf(1.7) * 1.8 + (mean_residual * 2.8) + (progress * 200.0);
            score += 260.0 + fragmentation_pressure;
        } else {
            score -= 180.0; 
        }
    }

    // Residual Homogenization:
    // Penalize deviation from mean_residual to prevent sparse bin distributions.
    if !is_new_bin {
        let deviation = (post_res - mean_residual).abs();
        score += deviation * 1.45;
        
        if post_res > mean_residual {
            score += (post_res - mean_residual) * 1.25;
        }
    }

    // Density Consolidation:
    // Non-linear penalty for low fill ratios.
    let fill_ratio = 1.0 - (post_res / cap);
    score += (1.0 - fill_ratio).powf(5.0) * (110.0 + progress * 120.0);

    // Global Fragmentation Control:
    // Penalize count of open bins with a higher exponent to force deeper packing.
    score += (open_bins_count as f64).powf(2.0) * 8.0;

    // Tight Fit Reward:
    // Stronger reward for near-perfect utilization.
    if post_res == 0.0 {
        score -= 150.0;
    } else if post_res < (cap * 0.20) {
        score -= 90.0 * (1.0 - (post_res / (cap * 0.20))).powf(1.5);
    }

    // Micro-Gap Suppression:
    // Harshly penalize small gaps that are likely to remain empty.
    if !is_new_bin && post_res > 0.0 && post_res < (mean_residual * 0.6) {
        score += 75.0;
    }

    // Dynamic Variance Bias:
    // Shift target residual to favor tighter packing as the stream progresses.
    let target_residual = cap * (0.01 + (0.01 * progress));
    score += (mean_residual - target_residual).abs() * 1.8;

    score
}
