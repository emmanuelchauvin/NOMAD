 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    // Base score: non-linear penalty on post_residual to favor tightest fit
    // Refined exponent to 1.38 to further penalize large gaps
    let mut score = (post_residual as f64).powf(1.38);

    // 1. Predictive Lookahead:
    // Focus on minimizing "leftover" potential for the next_item_size
    if next_item_size > 0 {
        if post_residual == next_item_size {
            score -= 105.0; 
        } else if post_residual > next_item_size {
            // Reward gaps that allow the next item plus a minimal buffer
            score += (post_residual as f64 - next_item_size as f64).powf(0.88) * 0.52;
        } else {
            // Increased penalty for stranding a gap smaller than the next item
            score += (next_item_size - post_residual) as f64 * 7.2;
        }
    }

    // 2. Adaptive New-Bin Thresholding:
    if bin_residual == bin_capacity {
        let progress = step_index as f64 / total_items as f64;
        // Stricter barrier to opening new bins; dynamic threshold based on stream phase
        let threshold = 14.0 + (open_bins_count as f64 * 0.12) - (progress * 8.0);
        if mean_residual < threshold {
            score -= 22.0; 
        } else {
            score += 195.0; // Increased penalty for opening new bins
        }
    } else {
        // 3. Density Balancing:
        // Stronger bias toward near-perfect fills
        if post_residual == 0 {
            score -= 98.0;
        } else if post_residual < 6 {
            score -= 65.0 - (post_residual as f64 * 6.0);
        }
    }

    // 4. Fitting Pressure:
    // Force the use of the only viable bin to avoid premature bin opening
    if fitting_bins_count == 1 && bin_residual >= item_size {
        score -= 320.0;
    }

    // 5. Harmonic Alignment:
    // Reward residuals that keep bin capacity modular (favors 25/50/75/100)
    if post_residual % 25 == 0 {
        score -= 40.0;
    } else if post_residual % 10 == 0 {
        score -= 15.0;
    }

    // 6. Terminal Phase: 
    // Aggressive consolidation in the final 15% of the stream.
    let progress = step_index as f64 / total_items as f64;
    if progress > 0.85 {
        score -= (progress * 150.0);
        if bin_residual == bin_capacity {
            score += 750.0; // Near-prohibitive cost to open new bins at the end
        }
    }

    // 7. Global State Normalization:
    // Penalty for proliferation of open bins, scaled by current bin utilization
    score += (open_bins_count as f64 / (total_items as f64 / 400.0 + 1.0)) * 5.8;

    // 8. Mean Residual Correction:
    // Prevent significant deviation from average bin density to ensure uniform packing
    if bin_residual != bin_capacity {
        let deviation = (bin_residual as f64 - mean_residual).abs();
        score += deviation * 0.62;
    }

    score
}
