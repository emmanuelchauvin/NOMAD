 Logic Code       : pub fn score_bin(
    item_size: u32,
    bin_residual: u32,
    bin_capacity: u32,
    step_index: usize,
    total_items: usize,
    open_bins_count: usize,
    mean_residual: f64,
    next_item_size: u32,
    post_residual: u32,
    fitting_bins_count: usize,
) -> f64 {
    let progress = step_index as f64 / total_items as f64;
    let is_new_bin = bin_residual == bin_capacity;
    
    // Base score: prioritize smaller residuals (tight packing)
    // Shifted base weight to favor bin utilization more aggressively
    let mut score = post_residual as f64 * 1.15;

    // 1. Lookahead Synergy: Target specific residual ranges to accommodate next item
    if next_item_size > 0 {
        if post_residual == next_item_size {
            score -= 125.0; // Increased perfect fit reward
        } else if post_residual > next_item_size && post_residual < (next_item_size + 12) {
            score -= 55.0; // Increased "Good enough" fit reward
        } else if post_residual < next_item_size && post_residual > 0 {
            score += 50.0; // Increased penalty: stranded space
        }
    }

    // 2. Adaptive New-Bin Thresholding: 
    // Stricter barrier to prevent opening new bins when capacity exists
    if is_new_bin {
        if fitting_bins_count > 0 {
            score += 260.0 + (progress * 180.0) + (open_bins_count as f64 * 1.8);
        } else {
            score = 5.0 + (mean_residual * 0.08);
        }
    } else {
        // 3. Fragmentation Penalty: Target "Dead Zones" (1-22)
        // Increased penalty to prevent small unusable gaps
        if post_residual > 0 && post_residual < 22 {
            score += 75.0 + (progress * 40.0);
        }
        
        // 4. Scarcity Pressure: Force utilization of unique fits
        if fitting_bins_count == 1 {
            score -= 95.0 * (1.0 - progress * 0.05);
        }
        
        // 5. Residual Variance: Penalize large deviations from mean
        let deviation = (post_residual as f64 - mean_residual).abs();
        score += deviation * 0.85;
    }

    // 6. Tail-end consolidation: Force usage of existing bins when pool is low
    // Increased slope to drive compaction near completion
    if progress > 0.85 {
        score += (post_residual as f64) * 4.5;
    } else if progress > 0.50 {
        score += (post_residual as f64) * 0.6;
    }

    // 7. Small Item Logic: Force small items into fuller bins to preserve empty space
    // Specifically target bins that are nearing capacity to maximize density
    if !is_new_bin && item_size < 30 && (bin_capacity - bin_residual) < (bin_capacity / 3) {
        score -= 25.0;
    }

    // 8. Global Efficiency Bias: Reward high utilization bins
    // Increased weight of the utilization bonus
    score -= (bin_capacity - post_residual) as f64 * 0.08;

    score
}
