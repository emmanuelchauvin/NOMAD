 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let cap = bin_capacity as f64;
    let pr = post_residual;
    let prf = pr as f64;
    let mut score = prf;

    // Perfect / near-perfect fit rewards (borrowed strength).
    if pr == 0 {
        score -= 80.0;
    } else if pr <= 8 {
        score -= 24.0;
    } else {
        // Harmonic residuals (multiples of 10) are reusable by typical items.
        if pr % 10 == 0 {
            score -= 12.0;
        } else {
            score += (pr % 10) as f64 * 0.9;
        }
        // Large leftovers are flexible; small-medium leftovers are awkward.
        if pr as f64 > cap / 2.0 {
            score -= 8.0;
        } else if pr as f64 <= cap / 4.0 {
            score += 6.0;
        }
        if pr < 6 {
            score += 9.0; // unusable sliver
        }
    }

    // Tightness term from parent, softened.
    let tightness = 1.0 - prf / cap;
    score -= 25.0 * tightness * tightness;

    // Lookahead: exact next-item fit is very valuable.
    if next_item_size > 0 {
        if next_item_size == pr {
            score -= 40.0;
        } else if next_item_size <= pr {
            let slack = (pr - next_item_size) as f64;
            if slack <= 8.0 {
                score -= 16.0;
            } else if slack <= 20.0 {
                score -= 4.0;
            } else {
                score += slack * 0.18;
            }
            // Chain opportunity: remainder is harmonic.
            let chain = pr - next_item_size;
            if chain % 10 == 0 && chain > 0 {
                score -= 10.0;
            }
        } else {
            score += (next_item_size - pr) as f64 * 0.14;
        }
    }

    // Last-chance bin: use it rather than open a new one.
    if fitting_bins_count == 1 && bin_residual < bin_capacity {
        score -= 30.0;
    }

    // Consolidate loose space: prefer bins below mean residual.
    score += (prf - mean_residual) * 0.06;

    // Stream progression: tighten packing later in the stream.
    let progress = if total_items > 0 { step_index as f64 / total_items as f64 } else { 0.0 };
    score -= progress * 10.0 * tightness;

    // Many open bins: encourage closing them with tight fits.
    if open_bins_count > 4 {
        score -= 5.0 * tightness;
    } else if open_bins_count > 1 && bin_residual < bin_capacity {
        score -= 6.0 * (open_bins_count as f64).ln() * (mean_residual / cap);
    }

    // New-bin candidate handling.
    if bin_residual == bin_capacity {
        score += 27.0;
        if fitting_bins_count == 0 {
            score -= 130.0; // forced open
        } else if fitting_bins_count == 1 {
            score -= 12.0; // lean toward existing bin
        } else if open_bins_count > 6 {
            score -= 3.0; // fresh bin cheaper than fragmenting
        }
    }

    score
}
