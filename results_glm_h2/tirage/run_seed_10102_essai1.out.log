 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Reward tight fits (small dead space)
    if post_residual == 0 {
        score -= 60.0;
    } else if post_residual <= 5 {
        score -= 30.0;
    }

    // 2-step lookahead: strongly reward bins whose leftover matches the next item
    if next_item_size > 0 {
        let gap = (post_residual as i64 - next_item_size as i64).abs() as f64;
        score += gap * 0.8;
        if post_residual == next_item_size {
            score -= 40.0;
        }
        // Penalize leftovers that are too small for the next item (dead space)
        if post_residual < next_item_size && post_residual > 0 {
            score += 15.0;
        }
    }

    // Compare against mean residual: prefer bins below-average residual (tighter bins)
    score += (mean_residual - bin_residual as f64) * 0.5;

    // Last-chance bin: strongly favor using it to avoid opening a new bin
    if fitting_bins_count == 1 {
        score -= 25.0;
    }

    // New-bin candidate: only attractive when no open bin fits well
    if bin_residual == bin_capacity {
        // Base penalty so we prefer existing bins
        score += 20.0;
        // But if many bins are open and mean residual is low (fragmented),
        // opening a fresh bin becomes attractive
        if open_bins_count > 3 && mean_residual < 30.0 {
            score -= 35.0;
        }
        // Late in the stream, avoid spawning bins unnecessarily
        if total_items > 0 && (step_index as f64 / total_items as f64) > 0.8 {
            score += 25.0;
        }
    }

    // Slight penalty for very large leftovers that waste capacity
    if post_residual > 50 {
        score += (post_residual as f64 - 50.0) * 0.4;
    }

    score
}
