 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Strict dead-space avoidance: residuals below the minimum item size (1..=10)
    // are pure waste; penalize them super-linearly.
    if post_residual > 0 && post_residual < 10 {
        score += (10 - post_residual) as f64 * 12.0;
    }

    // Perfect fit reward.
    if post_residual == 0 {
        score -= 60.0;
    }

    // Tightness reward: fraction of the bin consumed by this placement.
    let fill_ratio = item_size as f64 / bin_capacity as f64;
    score -= fill_ratio * 25.0;

    // Penalize creating a residual that no plausible item can use later:
    // if post_residual < next_item_size, this bin's leftover is likely dead.
    if next_item_size > 0 && post_residual > 0 && post_residual < next_item_size {
        score += (next_item_size - post_residual) as f64 * 4.0;
    } else if next_item_size > 0 && post_residual >= next_item_size {
        score -= 8.0; // this bin can still serve the lookahead item
    }

    // Open-bin pressure: when many bins are open, prefer consolidating into
    // existing ones rather than opening more; when few are open, allow spreading.
    let pressure = (open_bins_count as f64).ln().max(0.0);
    score += pressure * 3.0;

    // Last-chance bonus: if this is the only bin that fits, strongly prefer it
    // over opening a new bin.
    if fitting_bins_count == 1 && bin_residual < bin_capacity {
        score -= 40.0;
    }

    // Deviation from mean residual: prefer bins that deviate from the mean
    // (reduces fragmentation diversity across bins).
    let dev = (bin_residual as f64 - mean_residual).abs();
    score += dev * 0.15;

    // Mild stream-progression term: later in the stream, be more conservative
    // with new bins (slight extra penalty on the empty-bin candidate).
    if bin_residual == bin_capacity {
        let progress = step_index as f64 / (total_items.max(1) as f64);
        score += 5.0 + progress * 10.0;
    }

    score
}
