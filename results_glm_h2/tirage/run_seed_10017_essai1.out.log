 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Strong base preference for tight fits.
    let fit_ratio = post_residual as f64 / bin_capacity as f64;
    score += 30.0 * fit_ratio * fit_ratio;

    // --- 2-step lookahead: reward bins whose post-residual matches the next item ---
    if next_item_size > 0 {
        let next = next_item_size as f64;
        if (post_residual as f64) >= next {
            // Next item fits here afterwards -> big reward proportional to match quality.
            let match_gap = (post_residual as f64 - next) / bin_capacity as f64;
            score -= 45.0 * (1.0 - match_gap);
        } else {
            // Next item cannot follow in this bin -> penalize, worse if residual is dead space.
            let dead = post_residual as f64 / bin_capacity as f64;
            score += 20.0 * dead;
        }
    }

    // Compare against mean residual: bins with residual near item_size are ideal targets.
    let mean_gap = (bin_residual as f64 - item_size as f64).abs();
    score += 0.25 * mean_gap;
    if (bin_residual as f64) < mean_residual - 5.0 {
        score -= 8.0; // tighter-than-average bin: use it before it becomes dead space
    }

    // Last-chance bonus: if this is the only fitting bin, avoid opening a new bin.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 25.0;
    }

    // New-bin candidate handling: only attractive when open bins fit poorly.
    let is_new_bin = bin_residual == bin_capacity;
    if is_new_bin {
        let best_alt = if next_item_size > 0 {
            (post_residual as f64).min(bin_capacity as f64)
        } else {
            bin_capacity as f64
        };
        // Penalize new bin mildly; big items prefer fresh bins though.
        let mut nb = 15.0;
        if item_size >= 50 {
            nb -= 18.0;
        }
        if next_item_size > 0 && item_size as f64 + next_item_size as f64 <= bin_capacity as f64 {
            nb -= 10.0; // new bin can host a clean pair
        }
        score = nb + best_alt * 0.1;
    }

    // Slight late-stream tightening: consolidate into fewer bins as stream ends.
    let progress = step_index as f64 / total_items.max(1) as f64;
    score += 5.0 * (1.0 - progress) * (open_bins_count as f64 / (open_bins_count as f64 + 5.0));

    score
}
