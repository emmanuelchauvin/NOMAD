 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Perfect fit reward: strongly favor bins that become (near-)empty.
    if post_residual == 0 {
        score -= 1000.0;
    } else if post_residual <= 2 {
        score -= 400.0;
    }

    // 2-step lookahead: if next item exactly fits the post-residual, big reward.
    if next_item_size > 0 {
        if next_item_size == post_residual {
            score -= 600.0;
        } else if next_item_size < post_residual {
            // Slack left after the hypothetical next placement.
            let after_next = post_residual - next_item_size;
            score -= 120.0 - (after_next as f64).min(60.0);
            if after_next == 0 {
                score -= 300.0;
            }
        } else {
            // Next item cannot fit here: penalize wasted lookahead potential.
            score += 40.0;
        }
    }

    // Relative to mean residual: prefer tighter-than-average bins.
    score -= (mean_residual - bin_residual as f64).clamp(-50.0, 50.0) * 2.0;

    // Last-chance bin: strongly prefer using the only fitting bin.
    if fitting_bins_count == 1 && bin_residual >= item_size {
        score -= 250.0;
    }

    // Penalize very small dead space that likely becomes unusable.
    if post_residual > 0 && post_residual < 10 {
        score += 60.0;
    }

    // Slight preference for keeping many bins consolidated as stream progresses.
    let progress = step_index as f64 / (total_items.max(1) as f64);
    score += (open_bins_count as f64).ln() * 5.0 * (1.0 - progress);

    score
}
