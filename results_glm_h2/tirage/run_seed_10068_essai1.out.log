 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Perfect fit bonus
    if post_residual == 0 {
        score -= 1000.0;
    }

    // 2-step lookahead: reward if next item fits exactly into post_residual
    if next_item_size > 0 {
        if post_residual == next_item_size {
            score -= 500.0;
        } else if post_residual >= next_item_size {
            // next item fits, leaving chain potential
            let chain_left = post_residual - next_item_size;
            score -= 150.0 - (chain_left as f64) * 0.5;
        } else {
            // next item won't fit here; penalize dead space proportional to gap
            let gap = next_item_size - post_residual;
            score += (gap as f64) * 0.8;
        }
    }

    // Penalize large post_residual relative to mean residual (wasteful fit)
    score += (post_residual as f64 - mean_residual).max(0.0) * 0.3;

    // Last-chance bin bonus: avoid opening a new bin when this is the only fitting bin
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 200.0;
    }

    // New-bin candidate: penalize opening a new bin unless current fit is poor
    if bin_residual == bin_capacity {
        // baseline penalty; reduced if item is large relative to capacity
        score += 120.0 - (item_size as f64 * 0.8);
        // but if next item is large too, opening fresh bin is attractive
        if next_item_size > 0 && post_residual >= next_item_size {
            score -= 60.0;
        }
    }

    // Slight preference for tighter bins as stream progresses
    let progress = step_index as f64 / total_items.max(1) as f64;
    score += (post_residual as f64 / bin_capacity as f64) * 20.0 * progress;

    score
}
