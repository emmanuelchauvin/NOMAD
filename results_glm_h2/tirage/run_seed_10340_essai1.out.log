 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Perfect fit bonus: strong reward for filling the bin exactly.
    if post_residual == 0 {
        score -= 1000.0;
    }

    // 2-step lookahead: if next item exactly fills the post_residual, big bonus.
    if next_item_size > 0 && next_item_size == post_residual {
        score -= 500.0;
    }

    // Partial lookahead: next item fits comfortably in leftover space.
    if next_item_size > 0 && next_item_size <= post_residual {
        score -= 30.0 + 0.5 * (post_residual - next_item_size) as f64;
    }

    // Dead space penalty: leftover space too small for any plausible item (min size 1..100 unknown,
    // penalize small-but-nonzero leftovers relative to mean residual).
    if post_residual > 0 {
        if next_item_size == 0 || next_item_size > post_residual {
            score += 20.0;
        }
        // Penalize leftovers well below the mean residual (fragmented bin).
        if (post_residual as f64) < mean_residual * 0.5 {
            score += 15.0;
        }
    }

    // Last-chance bonus: if this is the only fitting bin, strongly prefer using it
    // over opening a new bin (avoid bin proliferation).
    if fitting_bins_count == 1 {
        score -= 40.0;
    }

    // Prefer bins with tighter residual (best-fit core) modulated by stream progress.
    let progress = if total_items > 0 { step_index as f64 / total_items as f64 } else { 0.0 };
    score += 0.3 * (bin_residual as f64) * (0.5 + 0.5 * progress);

    // Early in the stream, allow opening new bins more freely to keep flexibility.
    if bin_residual == bin_capacity {
        score -= 25.0 * (1.0 - progress);
    }

    score
}
