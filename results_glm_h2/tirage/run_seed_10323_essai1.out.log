 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Strong reward for perfect or near-perfect fit (low post residual).
    if post_residual == 0 {
        score -= 500.0;
    } else if post_residual <= 5 {
        score -= 150.0;
    }

    // 2-step lookahead: if the next item exactly matches the post residual,
    // this placement is highly desirable.
    if next_item_size > 0 {
        let lookahead_gap = (post_residual as i64 - next_item_size as i64).abs();
        if lookahead_gap == 0 {
            score -= 300.0;
        } else if next_item_size as u32 <= post_residual {
            // next item still fits in this bin afterwards: reward proportionally
            score -= 40.0 + 0.5 * (post_residual as f64 - next_item_size as f64);
        } else {
            // next item would NOT fit here: penalize leftover dead space
            score += 0.6 * (next_item_size as f64 - post_residual as f64);
        }
    }

    // Penalize creating tiny unusable slivers relative to the smallest possible item.
    if post_residual > 0 && post_residual < 10 {
        score += 60.0;
    }

    // Last-chance bonus: if this is the only bin that can fit the item,
    // strongly prefer using it over opening a new bin.
    if fitting_bins_count == 1 && bin_residual >= item_size {
        score -= 80.0;
    }

    // New-bin candidate handling: an empty bin has huge residual; make it
    // attractive only when the item is large relative to capacity or all
    // fits are poor.
    if bin_residual == bin_capacity {
        let large_item = item_size as f64 / bin_capacity as f64;
        if large_item > 0.6 {
            score -= 70.0;
        } else {
            score += 30.0;
        }
        // prefer opening new bins early when few bins are open and mean residual is low
        if open_bins_count as f64 <= mean_residual / 10.0 {
            score -= 10.0;
        }
    }

    // Mild preference for bins tighter than the mean residual (best-fit bias).
    score += 0.3 * (mean_residual - bin_residual as f64);

    // Slight preference for older bins to encourage closing them out.
    let progress = step_index as f64 / (total_items.max(1) as f64);
    score -= 5.0 * progress;

    score
}
