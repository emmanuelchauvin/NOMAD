 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Exact fit bonus: reward near-perfect fills heavily.
    if post_residual == 0 {
        score -= 1000.0;
    } else if post_residual <= 5 {
        score -= 200.0;
    }

    // 2-step lookahead: does the leftover space match the next item?
    if next_item_size > 0 {
        let nxt = next_item_size as f64;
        if (post_residual as f64) >= nxt {
            // Leftover can host the next item: reward proportional to tightness.
            let tightness = 1.0 - ((post_residual as f64) - nxt) / (bin_capacity as f64);
            score -= 50.0 + 100.0 * tightness;
        } else {
            // Leftover is dead space for the next item: penalize dead space.
            score += 0.5 * ((post_residual as f64) - nxt).abs();
        }
    }

    // Relative-to-mean coupling: bins with residual far below mean are "special",
    // prefer filling them to consolidate waste.
    if (post_residual as f64) < mean_residual {
        score -= 10.0 * (mean_residual - post_residual as f64) / (bin_capacity as f64);
    }

    // Last-chance bin: if this is the only bin that fits, strongly prefer it
    // over opening a new bin (unless it's a terrible fit).
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 150.0;
    }

    // New-bin candidate: only attractive when current bin leaves very bad waste
    // relative to the next item, or stream is early with few open bins.
    if bin_residual == bin_capacity {
        // Mild default penalty so we prefer filling existing bins...
        score += 20.0;
        // ...but relax when open bins are fragmented (many bins, high mean residual).
        if open_bins_count > 3 && mean_residual > 30.0 {
            score -= 40.0;
        }
        // Early stream: opening bins is cheap and useful for future flexibility.
        if total_items > 0 && (step_index as f64) / (total_items as f64) < 0.2 {
            score -= 15.0;
        }
    }

    score
}
