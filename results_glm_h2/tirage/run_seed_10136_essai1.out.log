 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Perfect fit: huge reward
    if post_residual == 0 {
        score -= 1000.0;
    }

    // 2-step lookahead: if next item exactly fills post_residual, strong reward
    if next_item_size > 0 && next_item_size == post_residual {
        score -= 500.0;
    }
    // Next item fits in post_residual: mild reward proportional to tightness
    if next_item_size > 0 && next_item_size < post_residual {
        score -= 50.0 * (1.0 - (post_residual - next_item_size) as f64 / bin_capacity as f64);
    }
    // Next item would NOT fit here: penalize leaving a gap next item can't use
    if next_item_size > 0 && next_item_size > post_residual {
        score += 40.0;
    }

    // Penalize small unusable dead space relative to mean residual
    if post_residual > 0 && (post_residual as f64) < mean_residual * 0.5 {
        score += 30.0;
    }

    // Last-chance bin: reward using it to avoid opening a new bin
    if fitting_bins_count == 1 && bin_residual < bin_capacity {
        score -= 100.0;
    }

    // Early stream: prefer keeping residuals large (flexibility)
    let progress = step_index as f64 / total_items.max(1) as f64;
    score -= (1.0 - progress) * (post_residual as f64) * 0.5;

    // Slight preference for filling already-open bins vs opening new ones
    if bin_residual == bin_capacity {
        score += 25.0;
    }

    score
}
