 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Strict dead-space avoidance: residuals that no plausible item can use are toxic.
    let dead_threshold = if next_item_size > 0 { next_item_size } else { 10 };
    if post_residual < dead_threshold && post_residual > 0 {
        // Unusable sliver: penalize hard, scaled by how small the gap is.
        let tightness = (dead_threshold - post_residual) as f64 / dead_threshold as f64;
        score += 60.0 + 40.0 * tightness;
    }

    // Perfect fit is gold.
    if post_residual == 0 {
        score -= 80.0;
    } else if next_item_size > 0 && post_residual == next_item_size {
        // Sets up an exact fit for the lookahead item.
        score -= 50.0;
    } else if next_item_size > 0 && post_residual >= next_item_size {
        // Residual that can host the next item is valuable.
        score -= 15.0 * (post_residual as f64 / dead_threshold as f64).min(3.0);
    }

    // Large residual waste: leaving big gaps when item was small is fine (flexible),
    // but prefer tighter fills mildly: reward smaller post_residual generally.
    score += 0.05 * (post_residual as f64 - mean_residual).abs().signum()
        * (post_residual as f64 - mean_residual).abs();

    // Last chance: if this is the only fitting bin, strongly prefer using it
    // over opening a new bin.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 45.0;
    }

    // New-bin candidate: opening a bin is wasteful unless current fit is terrible.
    if bin_residual == bin_capacity {
        score += 30.0;
        // Less pressure to open new bins early in the stream.
        let progress = step_index as f64 / (total_items.max(1) as f64);
        score += 20.0 * (1.0 - progress);
    }

    // Open-bin pressure: many open bins -> consolidate into existing ones.
    score += 1.5 * open_bins_count as f64;

    score
}
