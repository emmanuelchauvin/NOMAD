 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Perfect fit reward
    if post_residual == 0 {
        score -= 1000.0;
    }

    // 2-step lookahead: reward when next item exactly fills the post residual
    if next_item_size > 0 {
        if next_item_size == post_residual {
            score -= 800.0;
        } else if next_item_size <= post_residual {
            // next item fits here; penalize leftover after that
            let next_left = post_residual - next_item_size;
            score -= 200.0 - next_left as f64;
        } else {
            // next item cannot use this residual: penalize small dead space
            let gap = (next_item_size - post_residual) as f64;
            score += gap * 0.5;
        }
    }

    // Relative to mean residual: prefer bins tighter than average
    score -= (mean_residual - post_residual as f64) * 0.3;

    // Last chance bin: strong reward to avoid opening a new bin
    if fitting_bins_count == 1 && bin_residual >= item_size {
        score -= 150.0;
    }

    // Penalize wasting a nearly-full bin's tight fit on a small item
    if item_size < bin_residual / 2 && bin_residual < 40 {
        score += 50.0;
    }

    // Late in stream: prefer using existing bins over opening new ones
    let progress = step_index as f64 / total_items as f64;
    if bin_residual == bin_capacity {
        // new-bin candidate: penalize more as stream progresses
        score += 30.0 + 60.0 * progress;
        if fitting_bins_count > 0 {
            score += 25.0;
        }
    }

    score
}
