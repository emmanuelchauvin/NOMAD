 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Perfect fit: overwhelming reward.
    if post_residual == 0 {
        score -= 1000.0;
    }

    // 2-step lookahead: reward if next item fits exactly into post_residual.
    if next_item_size > 0 {
        if post_residual == next_item_size {
            score -= 500.0;
        } else if post_residual >= next_item_size {
            // Next item fits, but leaves a gap; mildly reward proportional to fit tightness.
            let gap = (post_residual - next_item_size) as f64;
            score -= 40.0 * (1.0 - gap / bin_capacity as f64);
        } else {
            // Dead space: post_residual too small for next item.
            let dead = (next_item_size - post_residual) as f64;
            score += 15.0 * (dead / 100.0) * (dead / 100.0) * 100.0;
        }
    }

    // Relative-to-mean coupling: prefer bins with residuals below mean (tighter bins used first).
    score += 0.6 * (mean_residual - bin_residual as f64);

    // Last-chance bonus: if this is the only fitting bin, strongly favor using it.
    if fitting_bins_count == 1 {
        score -= 120.0;
    }

    // Penalize opening a new bin unless the item is large relative to capacity
    // (new-bin candidate has bin_residual == bin_capacity).
    if bin_residual == bin_capacity {
        let largeness = item_size as f64 / bin_capacity as f64;
        score += 90.0 * (1.0 - largeness);
    }

    // Stream progression: early on, be more willing to open bins (explore),
    // later, consolidate tightly.
    let progress = if total_items > 0 { step_index as f64 / total_items as f64 } else { 0.0 };
    if bin_residual == bin_capacity {
        score -= 50.0 * (1.0 - progress);
    } else {
        score += 20.0 * progress;
    }

    score
}
