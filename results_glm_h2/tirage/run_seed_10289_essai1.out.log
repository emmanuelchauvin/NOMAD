 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Reward perfect fits strongly
    if post_residual == 0 {
        score -= 1000.0;
    }

    // 2-step lookahead: reward bins whose post_residual can host the next item
    if next_item_size > 0 && post_residual >= next_item_size {
        score -= 200.0 + 0.5 * (post_residual - next_item_size) as f64;
    } else if next_item_size > 0 {
        // penalize dead space relative to next item
        score += 0.8 * (next_item_size as f64 - post_residual as f64);
    }

    // Compare against mean residual: prefer bins tighter than average
    score += 0.3 * (post_residual as f64 - mean_residual);

    // Last chance bin: strongly favor using it to avoid opening a new bin
    if fitting_bins_count == 1 {
        score -= 150.0;
    }

    // Penalize opening a new bin when open bins fit reasonably well
    if bin_residual == bin_capacity {
        score += 50.0;
        // but opening a new bin is attractive for large items into fresh space
        if item_size > bin_capacity / 2 {
            score -= 30.0;
        }
    }

    // Late in stream: consolidate, prefer tighter fits
    let progress = step_index as f64 / total_items.max(1) as f64;
    score *= 1.0 + 0.2 * progress;

    score
}
