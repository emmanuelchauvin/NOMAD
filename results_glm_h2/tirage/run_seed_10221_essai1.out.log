 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Perfect fit: strongly reward
    if post_residual == 0 {
        score -= 1000.0;
    }

    // Aggressive 2-step lookahead: if the NEXT item exactly matches post_residual,
    // this placement chains perfectly -> huge reward.
    if next_item_size > 0 {
        let diff = (post_residual as i64 - next_item_size as i64).abs() as f64;
        if post_residual == next_item_size {
            score -= 800.0;
        } else if post_residual >= next_item_size {
            // next item fits here afterward: reward closeness
            score -= 200.0 * (1.0 - diff / bin_capacity as f64);
        } else {
            // next item would NOT fit in the leftover: penalize dead space
            score += 50.0 + diff * 0.5;
        }
    }

    // Compare post_residual relative to mean residual of open bins:
    // leaving less than average residual is good (tight packing).
    score += 0.5 * (post_residual as f64 - mean_residual);

    // Last-chance bin: if this is the only bin that fits, avoid opening a new bin.
    if fitting_bins_count == 1 && bin_residual >= item_size {
        score -= 150.0;
    }

    // Penalize new-bin candidate (bin_residual == bin_capacity) unless the item
    // is very large relative to residual or no good fit exists.
    if bin_residual == bin_capacity {
        let tightness = item_size as f64 / bin_capacity as f64;
        if item_size > 50 {
            score -= 100.0 * tightness; // big items: fresh bin is fine
        } else {
            score += 120.0; // small items should try existing bins first
        }
    }

    // Small bonus for consolidating bins early in the stream (keep bin count low).
    let progress = step_index as f64 / total_items.max(1) as f64;
    score += 0.3 * open_bins_count as f64 * (1.0 - progress);

    score
}
