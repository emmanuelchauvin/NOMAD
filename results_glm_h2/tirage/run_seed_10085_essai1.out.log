 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Dead-space penalty: residuals too small for the smallest item (1) are fine,
    // but small gaps that likely cannot fit typical future items are waste.
    let progress = step_index as f64 / (total_items.max(1) as f64);
    let dead_threshold = 10.0 + 20.0 * (1.0 - progress);
    if post_residual > 0 && (post_residual as f64) < dead_threshold {
        score += 3.0 * (dead_threshold - post_residual as f64);
    }

    // Perfect or near-perfect fit reward.
    if post_residual == 0 {
        score -= 25.0;
    } else if post_residual <= 2 {
        score -= 12.0;
    }

    // Open-bin pressure: discourage scattering across many bins unless fit is tight.
    score += (open_bins_count as f64) * 0.35;

    // Last-chance bin: strongly favor using it to avoid opening a new bin.
    if fitting_bins_count == 1 && bin_residual < bin_capacity {
        score -= 8.0;
    }

    // Lookahead: reward residual that can still host the next item.
    if next_item_size > 0 {
        if (post_residual as f64) >= next_item_size as f64 {
            score -= 6.0;
        } else if next_item_size as f64 > post_residual as f64 && post_residual > 0 {
            score += 2.0 * (next_item_size as f64 - post_residual as f64).min(30.0);
        }
    }

    // Mean residual coupling: prefer bins below mean residual (tighter bins first).
    score += 0.15 * (mean_residual - bin_residual as f64);

    // New-bin candidate: only attractive when current item barely fits anywhere
    // or open bins are very tight; otherwise penalize opening a fresh bin.
    if bin_residual == bin_capacity {
        let tight = (mean_residual / bin_capacity as f64) < 0.35;
        if fitting_bins_count >= 1 && !tight {
            score += 15.0;
        } else {
            score -= 3.0;
        }
    }

    score
}
