                score -= 18.0 * (slack / cap) * remaining;
            }
            let dead = slack as u32;
            if dead > 0 && dead < item_size.min(next_item_size) {
                score += 185.0 * (dead as f64 / cap) * (0.4 + 0.6 * progress);
            }
            if dead >= 1 && dead <= 6 {
