 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;
    let progress = step_index as f64 / total_items as f64;

    // 1. Refined Fragmentation Penalty:
    // Increased penalty for slivers to prevent premature bin exhaustion.
    if post_residual > 0 {
        if post_residual < 28 {
            score += 265.0; 
        } else if post_residual < 52 {
            score += 28.0;
        } else if post_residual > 72 {
            score -= (post_residual as f64 * 0.92); 
        }
    }

    // 2. Predictive Lookahead Synergy:
    // Enhanced lookahead for next_item_size, favoring bins that leave space for the next item.
    if next_item_size > 0 {
        if post_residual >= next_item_size {
            score -= 125.0;
            let next_post = post_residual - next_item_size;
            if next_post % 25 == 0 {
                score -= 65.0;
            }
            if next_post > 0 && next_post < 22 {
                score += 110.0;
            }
        } else {
            score += 115.0 + (progress * 75.0) + (open_bins_count as f64 * 1.15);
        }
    }

    // 3. New Bin Thresholding:
    // Dynamic barrier for opening new bins, balancing current load vs future needs.
    if bin_residual == bin_capacity {
        if fitting_bins_count > 0 {
            score += 255.0 + (progress * 175.0) + (open_bins_count as f64 * 1.65); 
        } else {
            score -= 210.0;
        }
    } else {
        // 4. Density & Uniformity:
        // Bias toward deeper utilization when options are limited.
        if fitting_bins_count == 1 {
            score -= 175.0;
        }
        
        let deviation = (post_residual as f64 - mean_residual).abs();
        score += deviation * 0.75;
    }

    // 5. Harmonic Alignment:
    // Aligning residuals to common item size factors (20, 25, 33).
    if post_residual % 25 == 0 || post_residual % 20 == 0 || post_residual % 33 == 0 {
        score -= 55.0;
    }

    // 6. Aggressive Tail-End Compaction:
    // Accelerate packing in the final 25% of the stream.
    if progress > 0.75 {
        score -= (bin_capacity - bin_residual) as f64 * 1.15;
        // Penalize keeping many bins open late-game to force consolidation
        score += (open_bins_count as f64) * 18.0;
    }

    score
}
