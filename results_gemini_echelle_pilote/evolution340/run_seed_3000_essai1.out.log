 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    // Start with post_residual to favor tightest fit (Best-Fit)
    let mut score = post_residual as f64 * 1.02;

    // 1. Enhanced Fragmentation Penalty:
    // Targeted "dead zones" (1-21) to prevent slivers.
    if post_residual > 0 && post_residual <= 21 {
        score += 62.0 - (post_residual as f64 * 0.35);
    }

    // 2. Adaptive Lookahead:
    // Reward exact fits for the next item while penalizing "near-miss" slivers (1-18).
    if next_item_size > 0 && post_residual >= next_item_size {
        let remaining = post_residual - next_item_size;
        if remaining == 0 {
            score -= 55.0; 
        } else if remaining < 18 {
            score += 38.0; 
        } else {
            score -= (next_item_size as f64) * 0.95;
        }
    }

    // 3. Harmonic Modulo Pressure:
    // Focus on divisors of 100 and common bin sizes to maximize potential for future fits.
    if post_residual > 0 && (post_residual % 20 == 0 || post_residual % 25 == 0 || post_residual == 33 || post_residual == 50) {
        score -= 24.0;
    }

    // 4. Scarcity/Open Bin Control:
    // Aggressive prioritize existing bins when few are available to avoid premature new bin creation.
    if fitting_bins_count > 0 && fitting_bins_count <= 3 && bin_residual < bin_capacity {
        score -= 45.0 / (fitting_bins_count as f64);
    }

    // 5. New Bin Logic:
    // Non-linear penalty for new bins using stream progress and bin saturation.
    // Increased threshold for opening a new bin to force better utilization of existing ones.
    if bin_residual == bin_capacity {
        let progress = step_index as f64 / total_items as f64;
        score = 58.0 + (mean_residual * 0.7) + (progress * 55.0);
        
        // Dynamic penalty based on open bin count, scaling logarithmically to discourage dispersion.
        score += (open_bins_count as f64).ln() * 15.0;
    }

    // 6. Global Density Normalization:
    // Penalize deviation from the mean_residual to keep the bin landscape uniform.
    let residual_diff = (post_residual as f64 - mean_residual).abs();
    score += (residual_diff * 0.32).min(20.0);

    // 7. Small Item Aggregation:
    // Specifically target small items to fill existing gaps efficiently.
    if item_size < 15 && post_residual < 30 {
        score -= 18.0;
    }

    score
}
