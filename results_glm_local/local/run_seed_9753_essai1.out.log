    if post_residual as f64 >= bin_capacity as f64 * 0.5 { score -= 22.0 ; }
    if next_item_size > post_residual && post_residual > 0 && post_residual < 40 {
        score += (40 - post_residual) as f64 * 1.6 ;
    }
    if post_residual > 0 && next_item_size > 0 && post_residual % next_item_size == 0 && post_residual > next_item_size {
        score -= 55.0 ;
    }
