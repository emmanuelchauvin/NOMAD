            score += dead * 0.85 ;
        }
    }
    score += 0.32 * (post_residual as f64 - mean_residual) ;
    if post_residual > 0 && post_residual < 10 { score += 75.0 ; }
    let progress = if total_items > 0 { step_index as f64 / total_items as f64 } else { 0.0 } ;
    if post_residual > 0 && post_residual < 25 && next_item_size > post_residual {
        score += (25 - post_residual) as f64 * 2.2 ;
