 Logic Code       : pub fn score_bin (item_size : u32 , bin_residual : u32 , bin_capacity : u32 , step_index : usize , total_items : usize , open_bins_count : usize , mean_residual : f64 , next_item_size : u32 , post_residual : u32 , fitting_bins_count : usize) -> f64 {
    let cap = bin_capacity as f64 ;
    let progress = step_index as f64 / total_items . max (1) as f64 ;
    let pr = post_residual as f64 ;
    let norm_pr = pr / cap ;
    let mut score = pr * 0.80 + (norm_pr * norm_pr * (0.5 + 2.0 * progress) + norm_pr * (1.0 - progress)) * 0.20 ;
    if post_residual > 0 {
        if post_residual < 12 { score += (12 - post_residual) as f64 * 8.5 ; }
        if next_item_size > 0 {
            if post_residual < next_item_size {
                let miss = (next_item_size - post_residual) as f64 ;
                score += miss * 1.5 + 2.0 * (1.0 - progress) ;
            } else {
                let gap = (post_residual - next_item_size) as f64 ;
                let slack = gap / cap ;
                score -= 4.0 + 8.0 * (1.0 - slack) ;
                if gap > next_item_size as f64 { score -= 1.5 ; }
                if post_residual < (next_item_size + item_size) as f64 { score -= 3.0 ; }
            }
        }
        if fitting_bins_count <= 1 && post_residual < item_size / 2 { score += 6.0 ; }
        if fitting_bins_count <= 2 && norm_pr > 0.9 { score -= 3.0 * (norm_pr - 0.9) ; }
        if mean_residual > 0.0 && (pr - mean_residual) . abs () < cap * 0.05 { score -= 2.5 ; }
        if pr < mean_residual { score -= 2.0 ; }
        if fitting_bins_count == 1 && norm_pr > 0.5 { score -= 1.0 ; }
        if post_residual == item_size { score -= 6.0 ; }
        if post_residual < item_size && post_residual >= next_item_size as u32 { score += 1.5 ; }
    } else {
        score -= 25.0 ;
    }
    let mrn = mean_residual / cap ;
    if norm_pr < mrn * 0.5 { score += (mrn * 0.5 - norm_pr) * cap * 0.3 ; }
    if bin_residual == bin_capacity && norm_pr > 0.6 { score += 4.0 ; }
    score
}
