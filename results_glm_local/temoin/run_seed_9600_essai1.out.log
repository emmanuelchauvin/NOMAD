 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items.max(1) as f64;
    let pr = post_residual as f64;
    let cap = bin_capacity.max(1) as f64;
    let norm_pr = pr / cap;

    // Base: post-residual with sharpened dead-space penalty.
    let mut score = pr;
    let dead = norm_pr.powi(3) * 24.0 + norm_pr.powi(4) * 18.0;
    score -= dead;
    if norm_pr < 0.15 && post_residual > 0 {
        score += (0.15 - norm_pr) * 95.0 * (1.0 - progress);
    }

    // Progress coupling: early tight packing, later tolerance.
    score += pr * (0.5 + 0.5 * progress * progress) - 0.5 * pr;

    // Relative fit quality vs mean residual.
    let mr = mean_residual.max(0.0);
    let rel = pr / (mr + 1.0);
    score -= rel * rel * 10.0 * (1.0 - progress);

    // Lookahead chaining.
    if next_item_size > 0 {
        if next_item_size <= post_residual {
            let fits = (post_residual - next_item_size) as f64;
            score -= fits * 0.3 * (1.0 - progress);
            if fits <= 8.0 {
                score -= 35.0 * (1.0 - fits / 8.0);
            }
            let fit_ratio = next_item_size as f64 / pr.max(1.0);
            score -= 24.0 * fit_ratio * (1.0 - progress);
            let after_next = post_residual - next_item_size;
            if after_next > 0 && after_next < 12 {
                score -= 3.5 * (1.0 - after_next as f64 / 12.0) * (1.0 - progress);
            }
            if after_next >= item_size {
                score -= 10.0;
            }
            if after_next >= next_item_size {
                score -= 6.0 * (1.0 - progress);
            }
        } else {
            let gap = (next_item_size - post_residual) as f64;
            score += gap * gap * 0.02;
            if gap <= 5.0 {
                score += 10.0 * (1.0 - gap / 5.0) * (1.0 - progress);
            }
        }
    } else {
        score -= 35.0 * (1.0 - norm_pr);
    }

    // Tight-fill bonuses with exact-hit escalation.
    let fill = item_size as f64 / bin_residual.max(1) as f64;
    if fill > 0.9 {
        score -= 35.0 * (fill - 0.9) + 15.0;
    } else if fill > 0.75 {
        score -= 22.0 * (fill - 0.75);
    }
    let slack = (bin_residual as i64 - item_size as i64) as f64;
    if slack >= 0.0 && slack <= 3.0 {
        score -= 45.0 * (1.0 - slack / 3.0);
    }

    // Dead-residual band / perfect fill.
    if post_residual == 0 {
        score -= 150.0;
    } else if post_residual <= 8 {
        score += 60.0 * (1.0 - progress);
        if fitting_bins_count == 1 {
            score -= 60.0;
        }
    }

    // Last-chance preference.
    if fitting_bins_count == 1 {
        score -= 45.0 * (1.0 + progress);
    } else if fitting_bins_count > 2 {
        score += 2.0 * (fitting_bins_count as f64 - 2.0).sqrt();
    }

    // Mean-residual consolidation.
    let dev = mean_residual - pr;
    score -= 0.22 * dev.clamp(-50.0, 50.0);

    // Open-bin pressure, smooth.
    score += open_bins_count as f64 * (1.2 + 1.8 * progress);
    score += (open_bins_count as f64).powi(2) * 0.01 * (1.0 - progress);

    // Mid-band residual preference early.
    if norm_pr >= 0.25 && norm_pr <= 0.55 && progress < 0.5 {
        score -= 6.0 * (1.0 - progress);
    }

    // Fragmentation guard for small items.
    if item_size <= 15 && bin_residual > 60 && fitting_bins_count > 1 && progress < 0.7 {
        score += 10.0 * (1.0 - progress);
    }

    // Multi-fit competition term.
    if fitting_bins_count > 1 && post_residual > 0 {
        let demand = mean_residual.max(1.0);
        let match_q = 1.0 - ((pr - demand) / demand.max(20.0)).abs();
        score -= 8.0 * match_q * (1.0 - progress) * (1.0 - 1.0 / fitting_bins_count as f64);
    }

    // Endgame sweep: close bins aggressively.
    if progress > 0.85 {
        score += pr * 0.15;
        if post_residual == 0 {
            score -= 60.0 * (progress - 0.85) / 0.15;
        }
    }

    // Waste-aware residual bucket penalty.
    if post_residual > 0 && progress < 0.9 {
        let dead_zone = if post_residual < 24 { post_residual as f64 / 24.0 } else { 0.0 };
        score += 9.0 * dead_zone * (1.0 - progress);
        if post_residual >= 25 && post_residual <= 60 {
            score -= 5.0 * (1.0 - progress);
        }
    }

    // Residual-similarity tie-break: match running mean residual.
    if post_residual > 0 && mean_residual > 0.0 && fitting_bins_count > 1 {
        let sim = 1.0 - ((pr - mean_residual) / (mean_residual + 20.0)).abs().min(1.0);
        score -= 6.0 * sim * (1.0 - progress);
    }

    // Near-miss chain sharpening (hard): residuals barely too small for
    // the next item are the worst waste.
    if post_residual > 0 && next_item_size > 0 && post_residual < next_item_size {
        let miss = (next_item_size - post_residual) as f64;
        if miss <= 10.0 {
            score += 4.0 * (1.0 - miss / 10.0) * (1.0 - progress);
        }
        if miss <= 4.0 {
            score += 14.0 * (1.0 - miss / 4.0) * (1.0 - progress);
        }
    }

    // Pair-completion bonus.
    if next_item_size > 0 && next_item_size == post_residual {
        score -= 20.0 * (1.0 - progress);
        if progress > 0.5 {
            score -= 12.0 * progress;
        }
    }

    // Exact-fill lookahead.
    if next_item_size > 0 && post_residual > 0 {
        let near = (post_residual as i64 - next_item_size as i64).abs();
        if near <= 2 {
            score -= 18.0 * (1.0 - near as f64 / 2.0) * (1.0 - progress);
        }
    }

    // Residual-reuse probability shaping.
    if post_residual > 0 && progress < 0.85 {
        let reuse = (post_residual.min(100) as f64) / 100.0;
        score -= 8.0 * reuse * (1.0 - progress);
        if post_residual > 70 {
            score += 10.0 * (1.0 - progress) * ((post_residual as f64 - 70.0) / 30.0).min(1.0);
        }
    }

    // Two-item lookahead: chain of next item + mean demand nearly exhausts bin.
    if next_item_size > 0 && post_residual > 0 {
        let chain = next_item_size as f64 + mean_residual.max(0.0);
        if chain >= pr && chain - pr <= 12.0 {
            score -= 11.0 * (1.0 - (chain - pr) / 12.0) * (1.0 - progress);
        }
    }

    // Bin-closure momentum: reward near-exhausting fits.
    if post_residual > 0 && open_bins_count > 1 && item_size as f64 >= 0.85 * bin_residual as f64 {
        score -= 10.0 * (1.0 - progress) * (item_size as f64 / bin_residual.max(1) as f64);
    }

    // New-bin candidate gating.
    if bin_residual == bin_capacity {
        let crowding = 1.0 / (1.0 + (mean_residual / cap).exp());
        score += pr * 0.4;
        score -= 25.0 * crowding * (0.5 + progress);
        score -= 15.0 * progress * progress;
        if item_size > 65 && item_size as f64 > 0.85 * cap && progress < 0.4 {
            score -= 18.0;
        }
        if fitting_bins_count == 0 {
            score -= 150.0;
        }
        if progress > 0.6 {
            score += 25.0;
        }
        if item_size < 30 && mean_residual > 40.0 {
            score += 18.0 * (1.0 - progress);
        }
        if next_item_size > 0 {
            let pair = item_size as f64 + next_item_size as f64;
            if (cap - pair).abs() <= 6.0 {
                score -= 30.0 * (1.0 - progress);
            }
        }
        if next_item_size > 0 && fitting_bins_count > 0 {
            let fresh_res = (cap - item_size as f64 - next_item_size as f64).max(0.0);
            let existing_res = (mean_residual - item_size as f64).max(0.0);
            if fresh_res >= existing_res - 4.0 && fresh_res < next_item_size as f64 {
                score -= 12.0 * (1.0 - progress);
            }
            let fresh_full = (cap - item_size as f64).max(0.0);
            if fresh_full <= existing_res + 10.0 {
                score += 14.0 * (1.0 - progress);
            }
            if fresh_res <= 10.0 && existing_res > 20.0 {
                score -= 20.0 * (1.0 - progress);
            }
            let pair_left = cap - item_size as f64 - next_item_size as f64;
            if pair_left >= 0.0 && pair_left <= 4.0 {
                score -= 20.0 * (1.0 - progress);
            }
            if pair_left == 0.0 && mean_residual < item_size as f64 + next_item_size as f64 {
                score -= 26.0 * (1.0 - progress);
            }
        }
        if item_size as f64 >= cap * 0.55 {
            score -= 10.0 * (item_size as f64 / cap) * (1.0 - progress);
        }
        if item_size == bin_capacity {
            score -= 120.0;
        }
        // Fresh-bin gate: open fresh only when its post-fit residual
        // clearly dominates what any existing bin could leave.
        let fresh_after = (cap - item_size as f64).max(0.0);
        let best_existing_after = (mean_residual - item_size as f64).max(0.0);
        if fresh_after > best_existing_after + 8.0 {
            score -= 14.0 * (1.0 - progress);
        } else {
            score += 10.0 * (1.0 - progress);
        }
        // Consolidation pressure for small items late in the stream.
        if item_size < 40 && progress > 0.45 && fitting_bins_count > 0 {
            score += 22.0 * progress;
        }
        // Prefer fresh bin when existing bins would strand large residuals
        // but the item fits snugly fresh.
        if fitting_bins_count > 0 && item_size as f64 > 0.7 * cap {
            let snug = (cap - item_size as f64) <= 20.0;
            let stranded = mean_residual > item_size as f64 + 25.0;
            if snug && stranded {
                score -= 16.0 * (1.0 - progress);
            }
        }
    }

    // Residual-hoarding penalty.
    if post_residual > 0 && next_item_size > 0 && post_residual > next_item_size + 40 && progress < 0.8 {
        score += 6.0 * (1.0 - progress);
    }

    // Adaptive consolidation — late stream, close bins out.
    if progress > 0.7 && post_residual > 0 {
        score += pr * 0.25 * (progress - 0.7) / 0.3;
    }

    // Waste-rate coupling.
    if open_bins_count > 3 && mean_residual < 25.0 && post_residual > 0 {
        score += pr * 0.06;
    }

    // Triple-chain lookahead: post-residual after next item matches mean demand.
    if next_item_size > 0 && next_item_size <= post_residual {
        let after = post_residual - next_item_size;
        if (after as f64 - mean_residual).abs() <= 5.0 {
            score -= 9.0 * (1.0 - progress);
        }
    }

    // GEN 36 mutation: dead-space ratio U-curve — reward residuals in the
    // 30..=60 sweet spot, penalize stranded slivers and oversized leftovers.
    if post_residual > 0 && progress < 0.9 {
        let r = post_residual as f64;
        let sweet = ((r - 45.0).abs() / 28.0).min(1.0);
        score -= 9.5 * (1.0 - sweet) * (1.0 - progress);
        if r < 10 && r < next_item_size as f64 {
            score += 5.0 * (1.0 - progress);
        }
    }

    // GEN 36 mutation: granularity alignment — residuals that are multiples
    // of common item sizes are likelier to be reused later.
    if post_residual > 0 && post_residual % 5 == 0 && progress < 0.8 {
        score -= 4.0 * (1.0 - progress);
    }
    if post_residual % 10 == 0 && post_residual > 0 {
        score -= 5.0;
    }

    // GEN 36 mutation: large-item reservation — protect space for big next items.
    if next_item_size > 60 && post_residual > 0 && post_residual < next_item_size {
        score += 8.0 * (1.0 - progress);
    }

    // GEN 36 mutation: dead-space elimination sweep for tiny residuals.
    if post_residual > 0 && post_residual <= 12 && bin_residual > item_size {
        score += 16.0 * (1.0 - post_residual as f64 / 12.0) * (1.0 - progress);
    }

    // GEN 36 mutation: mid-residual dead-zone tightening around 40.
    if post_residual >= 30 && post_residual <= 50 && progress < 0.65 {
        score += 7.0 * (1.0 - progress) * (1.0 - ((post_residual as f64 - 40.0).abs() / 10.0));
    }

    // GEN 36 mutation: tightness-of-fit variance reduction.
    if post_residual > 0 && mean_residual > 0.0 {
        let spread = ((pr - mean_residual) / mean_residual).abs();
        score += 4.0 * spread.min(2.0) * progress;
    }

    score
}
