 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;
    let cap = bin_capacity as f64;
    let pr = post_residual as f64;
    let it = item_size as f64;
    let progress = step_index as f64 / total_items.max(1) as f64;
    let remaining = 1.0 - progress;

    // Sharpened residual classes (borrowed from best-known)
    if post_residual == 0 {
        score -= 1000.0;
    } else if post_residual <= 2 {
        score -= 66.0;
    } else if post_residual <= 5 {
        score -= 34.0;
    } else if post_residual <= 11 {
        score -= 17.0;
    } else if post_residual <= 17 {
        score -= 6.0;
    }

    // Two-step lookahead with divisibility bonuses
    if next_item_size > 0 {
        let nx = next_item_size as f64;
        if post_residual as u32 == next_item_size {
            score -= 90.0;
        } else if next_item_size < post_residual {
            let slack = (post_residual - next_item_size) as f64;
            score -= 42.0 * (1.0 - slack / cap);
            if post_residual % next_item_size <= 4 {
                score -= 24.0;
            }
            if post_residual >= 2 * next_item_size {
                score -= 14.0;
            }
            if post_residual >= 3 * next_item_size && next_item_size <= 15 {
                score -= 10.0;
            }
        } else {
            score += 12.5 * (1.0 - pr / cap) + (nx - pr) * 0.62;
        }
    } else {
        score += pr * 0.1;
    }

    // Tightness reward
    let tightness = (bin_residual as f64 - it) / cap;
    score -= (1.0 - tightness) * 21.0;

    // Last-chance bin
    if fitting_bins_count == 1 && bin_residual >= item_size {
        score -= 48.0;
    } else {
        score += fitting_bins_count as f64 * 0.35;
    }

    // New-bin candidate logic
    if bin_residual == bin_capacity {
        let pressure = open_bins_count as f64 / (1.0 + mean_residual / cap);
        score += 14.0 - 14.0 * progress - 3.0 * pressure.min(5.0);
        score -= 17.0 * (it / cap);
        if next_item_size > 0 && (next_item_size as f64) > mean_residual {
            score -= 13.5;
        }
        if it < 28.0 && open_bins_count > 3 {
            score += 14.5;
        }
        if progress > 0.7 && it < 50.0 {
            score += 11.5 * progress;
        }
        if next_item_size as f64 > 0.5 * cap {
            score += 7.5;
        }
        if next_item_size > 0 && it <= mean_residual {
            score += 5.5 * (1.0 - it / mean_residual);
        }
        if it < 40.0 && mean_residual > 0.0 && (mean_residual - it).abs() < 6.0 {
            score += 10.0;
        }
        if it < 15.0 && fitting_bins_count > 0 {
            score += 22.0;
        }
        if fitting_bins_count >= 3 && it < 0.35 * cap {
            score += 6.0 + 2.0 * fitting_bins_count as f64;
        }
        if mean_residual < 8.0 && it > mean_residual {
            score -= 8.0 * remaining;
        }
        if fitting_bins_count > 0 && mean_residual > 0.0 && (mean_residual - it).abs() <= 3.0 {
            score += 18.0;
        }
        if it > 0.6 * cap {
            score -= 9.0 * (0.5 + progress);
        }
        if open_bins_count > 12 && it > 0.7 * cap {
            score -= 6.0;
        }
        // Fresh bin for large items when residuals cannot chain with next item
        if it > 0.5 * cap && next_item_size > 0 && (next_item_size as f64) < mean_residual {
            score -= 10.0 * remaining;
        }
        // Dead-gap avoidance
        if next_item_size > 0 && fitting_bins_count > 0 && mean_residual > 0.0 {
            let nx = next_item_size as f64;
            let dead = (mean_residual - it).max(0.0);
            if dead > 0.0 && nx > dead {
                score -= (2.5 + 4.5 * remaining) * (dead / mean_residual.max(1.0));
            }
        }
        // Hoard roomy bins for larger future items
        if open_bins_count > 8 && it < 0.2 * cap && next_item_size as f64 > mean_residual {
            score += 5.0 * remaining;
        }
        // Large next item + small current item: keep fresh bins unfragmented
        if next_item_size > 0 && fitting_bins_count > 0
            && (next_item_size as f64) > mean_residual * 0.8
            && it < 0.25 * cap {
            score -= 7.0 * remaining;
        }
        // Early stream with big item
        if progress < 0.3 && it > 0.55 * cap && fitting_bins_count > 0 {
            score -= 6.0;
        }
        // Exact-fit forecast for a fresh bin
        if next_item_size > 0 && next_item_size <= 20 {
            let post_new = cap - it;
            if post_new >= next_item_size as f64
                && (post_new as u32) % next_item_size <= 3 {
                score -= 9.0 * remaining;
            }
        }
        // Small mean residual: consolidate into a fresh bin for medium items
        if mean_residual > 0.0 && mean_residual < it * 0.45 && it < 0.5 * cap
            && fitting_bins_count >= 2 {
            score -= 4.5 * remaining;
        }
    } else {
        // Tight specialization
        let drift = (bin_residual as f64 - mean_residual).abs();
        score += 0.095 * drift;
        if next_item_size > 0 && post_residual >= next_item_size && post_residual > 0 {
            score -= 9.5 * (1.0 - (post_residual - next_item_size) as f64 / cap);
        }
        if post_residual > 0 && post_residual <= 20 && post_residual >= next_item_size.min(20) {
            score -= 6.5;
        }
        let waste_ratio = pr / cap;
        score += 10.5 * waste_ratio * (0.4 + 0.6 * progress);
        if next_item_size > 0 && post_residual > 0 && post_residual < next_item_size {
            score += 6.5 * remaining * (1.0 - pr / cap);
        }
        if next_item_size > 0 && post_residual > next_item_size && post_residual % next_item_size == 0 {
            score -= 8.0;
        }
        if pr > 25.0 && pr < 0.45 * cap {
            score += 3.8 * waste_ratio * (0.5 + progress);
        }
        // Favor bins whose post-residual matches plausible future item sizes
        if post_residual > 0 && post_residual <= 100 && mean_residual > 0.0 {
            let align = 1.0 - ((pr - mean_residual).abs() / mean_residual).min(1.0);
            score -= 3.8 * align;
        }
        if next_item_size > 0 && post_residual as u32 == next_item_size {
            score -= 12.0 * remaining;
        }
        if post_residual >= 18 && post_residual <= 30 && progress > 0.5 {
            score += 4.5 * progress;
        }
        if bin_residual == item_size {
            score -= 15.0;
        }
        if bin_residual > item_size && bin_residual - item_size <= 2 {
            score -= 7.0;
        }
        if bin_residual > item_size && bin_residual - item_size == 1 {
            score -= 5.0;
        }
        if next_item_size > 0 && post_residual >= 2 * next_item_size && post_residual < 3 * next_item_size {
