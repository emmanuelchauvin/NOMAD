        }
        if post_residual > 0 && post_residual < 12 && post_residual < next_item_size {
            score += 8.0 * remaining;
        }
        if post_residual > 0 && post_residual <= 50 && (50 % post_residual.max(1)) <= 2 {
            score -= 5.0;
        }
        if post_residual > 0 && mean_residual > 0.0 && pr >= mean_residual * 0.9 {
            score -= 4.0 * remaining;
        }
        if bin_residual as f64 > 0.5 * cap && it < 0.3 * cap && fitting_bins_count > 1 {
            score += 5.0 * progress;
        }
        // Penalize residuals neither the next item nor mean item can use
        if post_residual > 0 && next_item_size > 0 && (next_item_size as f64) > pr
            && pr < mean_residual * 0.5 {
            score += 7.0 * remaining;
        }
        // Chainable fills: exact multiple of a small next item
        if next_item_size > 0 && post_residual > 0 && post_residual % next_item_size == 0 && next_item_size <= 12 {
            score -= 6.0 * remaining;
        }
        // Dead-space ratio penalty
        if post_residual > 0 && next_item_size > 0
            && post_residual < next_item_size
            && pr > mean_residual * 0.5 {
            score += 3.0 * remaining * (pr / mean_residual.max(1.0));
        }
        // Near-exact fills rewarded more when stream is long
        if post_residual > 0 && post_residual <= 6 && next_item_size > 0
            && (next_item_size as f64) >= pr {
            score -= 3.5 * (1.0 + remaining);
        }
        // Post-residual slightly above the mean but below the next item is a trap
        if post_residual > 0 && next_item_size > 0
            && pr > mean_residual
            && post_residual < next_item_size {
            score += 6.0 * remaining;
        }
        // Fragmentation pressure: prefer chain-start post-residuals
        if next_item_size > 0 && fitting_bins_count >= 2 && post_residual > 0 {
            let gap = (pr - next_item_size as f64).abs();
            score += gap * 0.55 * remaining;
        }
        // Protect prime real estate from oversized current items
        if next_item_size > 0 && post_residual >= 2 * next_item_size
            && next_item_size <= 15 && it > 0.4 * cap {
            score -= 4.0 * remaining;
        }
    }

    // Unusable tiny dead space
    if post_residual > 0 && post_residual < 9 {
        score += 19.5 + 8.0 * remaining;
    }

    // Mid-range dead zones unusable by the next item
    if post_residual > 11 && post_residual < 25 && next_item_size as u32 > post_residual {
        score += 9.0 * remaining;
    }

    score
}
