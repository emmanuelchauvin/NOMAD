 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;
    let progress = step_index as f64 / total_items.max(1) as f64;
    let pr = post_residual;
    let cap = (bin_capacity as f64).max(1.0);
    let frac = pr as f64 / cap;

    // Tight-fit rewards: perfect and near-perfect closures (amplified, extended).
    if pr == 0 {
        score -= 96.0;
    } else if pr <= 4 {
        score -= 58.0;
    } else if pr <= 8 {
        score -= 34.0;
    } else if pr <= 12 {
        score -= 18.0;
    } else if pr <= 18 {
        score -= 7.5;
    } else if pr <= 26 {
        score -= 2.0;
    } else if pr <= 34 {
        score += 3.0;
    }

    // Dead-space sliver classes.
    if pr > 0 && pr < 9 {
        score += 42.0;
    } else if pr < 18 {
        score += 13.0;
    } else if pr % 20 == 0 {
        score -= 20.0;
    } else if pr % 25 == 0 {
        score -= 10.0;
    }

    // Residual-fraction coupling.
    if frac > 0.5 {
        score += 13.5 * (frac - 0.5);
    } else if frac < 0.15 && pr > 0 {
        score -= 8.0 * (0.15 - frac) * 10.0;
    }

    // Dead-space ratio vs next item.
    if next_item_size > pr && pr > 0 {
        let dead_ratio = 1.0 - pr as f64 / (next_item_size as f64).max(1.0);
        score += 11.0 * dead_ratio * frac.max(0.2);
    }

    // Lookahead coupling with next item.
    if next_item_size > 0 {
        if next_item_size == pr {
            score -= 52.0;
        } else if next_item_size < pr {
            let slack = (pr - next_item_size) as f64;
            score -= 27.0 + slack.min(24.0);
        } else if next_item_size > pr && next_item_size <= bin_residual {
            score += 9.0;
        }
        let two_step = pr.saturating_sub(next_item_size);
        if next_item_size <= pr && (two_step % 10 == 0 || (two_step % 5 == 0 && two_step <= 20)) {
            score -= 18.0;
        }
        if next_item_size > pr && pr < 14 {
            score += 14.0;
        }
        if next_item_size > pr && pr >= 14 && (next_item_size - pr) <= 5 {
            score += 7.0;
        }
        let after = pr.saturating_sub(next_item_size);
        if after > 0 && after <= 8 {
            score -= 13.0;
        } else if after > 8 && after <= 16 {
            score -= 5.5;
        }
        if next_item_size > pr && next_item_size >= 45 && pr < 20 {
            score += 10.0;
        }
        if next_item_size >= 10 && next_item_size <= 40 && (pr as i64 - next_item_size as i64).abs() <= 2 && pr > 0 {
            score -= 9.0;
        }
        if next_item_size < pr && pr - next_item_size >= next_item_size / 2 {
            score -= 4.5;
        }
        if next_item_size > pr && pr >= 18 {
            score += 3.0 + 4.0 * progress;
        }
        // MUTATION: two-step lookahead — reward residuals that can host the next
        // item AND leave a useful remainder (>= 4) rather than a useless sliver.
        if next_item_size < pr {
            let rem = pr - next_item_size;
            if rem >= 4 && rem <= 16 {
                score -= 6.0 * (1.0 - rem as f64 / 16.0);
            }
        }
    }

    // Last-chance bin: strongly avoid opening a new bin when this is the only fit.
    if fitting_bins_count == 1 && bin_residual < bin_capacity {
        score -= 52.0;
    }

    // New-bin candidate logic.
    if bin_residual == bin_capacity {
        let poor_fit = pr > 24;
        let big_item = item_size >= 50;
        if poor_fit || big_item {
            score -= 30.0;
        } else {
            score += 52.0;
        }
        if next_item_size >= 60 {
            score -= 18.0;
        }
        if progress > 0.6 {
            score += 24.0 * progress;
        }
        if open_bins_count < 4 {
            score -= 9.0;
        }
        if item_size <= 20 && pr <= 20 {
            score += 16.0;
        }
        if progress > 0.75 && open_bins_count > 6 {
            score += 14.0;
        }
        if progress < 0.25 && open_bins_count <= 8 {
            score -= 6.0;
        }
        if item_size <= 10 && progress > 0.35 {
            score += 10.0;
        }
        if item_size >= next_item_size.saturating_sub(3) && item_size <= next_item_size + 3 && item_size >= 25 {
            score -= 7.0;
        }
        if item_size >= 30 && fitting_bins_count <= 2 {
            score -= 12.0;
        }
        if item_size >= 45 && next_item_size >= 45 && (item_size + next_item_size) as f64 <= cap {
            score -= 10.0;
        }
        // MUTATION: fresh-bin appeal when the item would leave an awkward residual
        // in every fitting open bin — approximate via mean_residual proximity.
        if item_size >= 25 && mean_residual > 0.0 && (mean_residual - item_size as f64).abs() < 4.0 {
            score -= 9.0;
        }
    }

    // Harmonic band match when multiple bins fit.
    if next_item_size > 0 && pr >= next_item_size && fitting_bins_count > 1 {
        score -= 6.0 + 3.0 * (1.0 - progress);
    }

    // Exact-fill drive.
    if pr == 0 && bin_residual < bin_capacity {
        score -= 20.0 + 15.0 * progress;
    }

    // Avoid awkward-middle residuals, scaled by how much next item misses.
    if pr >= 17 && pr <= 23 && next_item_size > pr {
        score += 8.0;
    }

    // MUTATION: penalize residuals that no plausible upcoming item can use —
    // residuals above the 60th-percentile-ish band when next item overshoots.
    if pr > 30 && next_item_size > pr {
        score += 0.25 * (pr - 30) as f64;
    }

    // Consolidation pressure.
    score -= 0.07 * mean_residual;

    // Progress-scaled tightening.
    score += (open_bins_count as f64) * 0.28;
    score *= 1.0 - 0.14 * progress;

    score
}
