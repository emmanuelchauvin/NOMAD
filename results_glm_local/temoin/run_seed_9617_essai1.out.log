 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let cap = bin_capacity as f64;
    let mut score = post_residual as f64;
    let pr = post_residual as f64;
    let progress = step_index as f64 / (total_items.max(1) as f64);

    // Capacity-relative dead-space bands with fine near-exact tiers.
    let fifth = bin_capacity / 5;
    let third = bin_capacity / 3;
    let tenth = bin_capacity / 10;
    let twentieth = bin_capacity / 20;
    let fortieth = bin_capacity / 40;
    if post_residual == 0 {
        score -= 36.0;
    } else if post_residual < fortieth {
        score += 6.0 + (fortieth - post_residual) as f64 * 0.03;
    } else if post_residual < twentieth {
        score += 12.0 + (twentieth - post_residual) as f64 * 0.04;
    } else if post_residual < tenth {
        score += 30.0 + (tenth - post_residual) as f64 * 0.05;
    } else if post_residual < fifth {
        score += 38.0 + (fifth - post_residual) as f64 * 0.07;
    } else if post_residual <= third {
        score += 4.0;
    } else if post_residual <= bin_capacity / 2 {
        score -= 3.0;
    } else {
        score -= 8.0;
    }

    // Divisibility rewards keep residuals reusable.
    if post_residual % 10 == 0 { score -= 3.0; }
    if post_residual % 20 == 0 { score -= 2.0; }
    if post_residual % 25 == 0 { score -= 1.5; }

    // Lookahead chain rewards with sharpened slack tiers.
    if next_item_size > 0 && post_residual >= next_item_size {
        let slack = (post_residual - next_item_size) as f64;
        if slack == 0.0 {
            score -= 32.0;
        } else if slack < cap * 0.1 {
            score -= 15.0;
        } else if slack < cap * 0.25 {
            score -= 7.0;
        } else {
            score -= slack * 0.17;
        }
    } else if next_item_size > 0 && post_residual > 0 {
        if post_residual >= fifth { score += 9.0; } else { score += 4.0; }
    } else {
        score += pr * 0.5;
    }

    // Last-chance bin: only fitting open bin -> strongly prefer it.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 16.0;
    }
    // Scarcity coupling.
    if fitting_bins_count >= 2 && bin_residual != bin_capacity {
        let scarcity = (open_bins_count as f64 - fitting_bins_count as f64).max(0.0);
        score -= scarcity * 0.48;
    }

    // New-bin candidate handling.
    if bin_residual == bin_capacity {
        score += 17.0 + 10.0 * progress;
        if item_size as f64 > cap * 0.7 {
            score -= 14.0;
        }
        if next_item_size > 0 && next_item_size + item_size <= bin_capacity {
            score -= 7.0;
            if post_residual >= next_item_size {
                score -= 10.0;
            }
        }
        if next_item_size > 0 && item_size + next_item_size == bin_capacity {
            score -= 11.0;
        }
        if next_item_size > 0 && post_residual > 0 && post_residual < next_item_size
            && post_residual < fifth && item_size + next_item_size > bin_capacity {
            score -= 10.0;
        }
        if fitting_bins_count >= 3 {
            score += 4.0 + fitting_bins_count as f64 * 0.55;
        }
        if open_bins_count as f64 * mean_residual > item_size as f64 * 2.0 {
            score += 3.0;
        }
        if item_size <= tenth && next_item_size > 0 {
            score += 5.0;
        }
        if item_size as f64 > cap * 0.85 && fitting_bins_count == 0 {
            score -= 6.0;
        }
        let sprawl = open_bins_count as f64 / (progress * total_items.max(1) as f64 + 1.0);
        if sprawl > 0.6 && item_size as f64 <= cap * 0.6 {
            score += 6.0 * (sprawl - 0.6).min(1.0);
        }
        if next_item_size > 0 && bin_capacity >= item_size + next_item_size {
            let fresh_left = bin_capacity - item_size - next_item_size;
            if fresh_left == 0 {
                score -= 15.0;
            } else if fresh_left <= twentieth {
                score -= 6.0;
            }
        }
        let fresh_left2 = bin_capacity.saturating_sub(item_size);
        if fresh_left2 % 10 == 0 { score -= 2.0; }
        if next_item_size > 0 && fitting_bins_count >= 1 && item_size as f64 <= cap * 0.5 {
            if mean_residual < cap * 0.12 {
                score -= 5.0;
            }
        }
        if next_item_size > 0 {
            let fresh_left3 = bin_capacity.saturating_sub(item_size);
            if fresh_left3 < next_item_size && mean_residual >= next_item_size as f64 {
                score += 4.0;
            }
        }
        if next_item_size > 0 && bin_capacity - item_size == next_item_size {
            score -= 8.0;
        }
        if fresh_left2 > 0 && fresh_left2 % 10 == 0 && fresh_left2 <= twentieth {
            score -= 4.0;
        }
        // Penalize opening a bin when fleet mean residual could absorb the item.
        if fitting_bins_count >= 1 && mean_residual >= item_size as f64 {
            score += 6.0;
        }
        // NEW: open-bin avoidance scales with how much total slack exists in the fleet.
        let fleet_slack = open_bins_count as f64 * mean_residual;
        let usable_slack = fitting_bins_count as f64 * mean_residual;
        if usable_slack > item_size as f64 * 1.5 {
            score += 2.0 + (usable_slack / item_size.max(1) as f64).min(3.0) * 1.5;
        }
        if fleet_slack > cap * (open_bins_count as f64) * 0.35 && item_size as f64 <= cap * 0.4 {
            score += 2.5;
        }
    }

    // Mean-residual deviation.
    let dev = bin_residual as f64 - mean_residual;
    if dev > 0.0 {
        score -= dev * 0.07;
    } else {
        score += (-dev) * 0.02;
    }

    if bin_residual % 10 == 0 && item_size % 10 == 0 && post_residual % 10 == 0 {
        score -= 1.0;
    }

    // Waste-forecast: unusable residual, stronger early.
    if post_residual > 0 && next_item_size > 0 && post_residual < next_item_size
        && post_residual < fifth {
        let horizon = 1.0 - progress;
        score += 5.0 + 4.5 * horizon;
    }

    // Global sprawl control.
    if open_bins_count as f64 > progress * total_items.max(1) as f64 * 0.55 {
        score += pr * 0.13;
        if next_item_size > 0 && post_residual > 0 && post_residual < next_item_size {
            score += 4.0;
        }
    }

    // Late-stream tightening.
    if step_index + 5 >= total_items {
        score += pr * 0.32;
    }

    // Size-matched pairing bonus.
    let complement = bin_residual.saturating_sub(item_size);
    if complement > 0 && complement <= twentieth {
        score -= 5.0;
    } else if complement > 0 && complement <= tenth {
        score -= 2.0;
    }

    // Large-item urgency.
    if item_size as f64 > cap * 0.5 && bin_residual != bin_capacity {
        score -= 3.0 + 3.0 * (item_size as f64 / cap);
    }

    // Two-item lookahead chain.
    if next_item_size > 0 && item_size + next_item_size <= bin_residual {
        let chain_slack = bin_residual - item_size - next_item_size;
        if chain_slack == 0 {
            score -= 20.0;
        } else if chain_slack <= twentieth {
            score -= 12.0;
        } else if chain_slack <= tenth {
            score -= 9.0;
        }
        let two_chain = item_size + 2 * next_item_size;
        if two_chain <= bin_residual {
            let slack2 = bin_residual - two_chain;
            if slack2 == 0 {
                score -= 8.0;
            } else if slack2 <= tenth {
                score -= 4.0;
            }
        }
    }

    // Residual-shape trap.
    if post_residual > 0 && post_residual < tenth {
        let horizon = 1.0 - progress;
        score += 2.0 + 3.0 * horizon;
    }

    if post_residual == 0 && next_item_size > 0 && item_size <= tenth {
        score -= 4.0;
    }

    if fitting_bins_count >= 2 && next_item_size > 0 && post_residual > 0 {
        let gap = (post_residual as f64 - next_item_size as f64).abs();
        if gap < cap * 0.05 {
            score -= 3.0;
        }
    }

    // Mid-band trap.
    if next_item_size > 0 && post_residual > third && post_residual <= bin_capacity / 2
        && post_residual < item_size + next_item_size {
        score += 3.0;
    }

    // Pair-closure bonus.
    if next_item_size > 0 && bin_residual >= item_size + next_item_size
        && bin_residual - item_size - next_item_size == 0 && bin_residual != bin_capacity {
        score -= 6.0;
    }

    // Adaptive tightness.
    if mean_residual < cap * 0.25 && bin_residual != bin_capacity {
        score += (cap * 0.25 - mean_residual) * 0.4;
    }

    // Residual-entropy steering.
    if next_item_size > 0 && next_item_size <= tenth && post_residual >= next_item_size {
        if post_residual % 5 == 0 { score -= 1.5; }
        if post_residual % next_item_size == 0 { score -= 2.5; }
    }

    // Dead-space ratio term: quadratic + cubic waste pressure (tuned upward mid-stream).
    if post_residual > 0 && bin_residual != bin_capacity {
        let waste_ratio = post_residual as f64 / cap;
        let horizon = 1.0 - progress;
        let mut waste = waste_ratio * waste_ratio * 13.5 * horizon
            + waste_ratio * waste_ratio * waste_ratio * 6.0 * horizon;
        if next_item_size > 0 && post_residual >= next_item_size {
            waste *= 0.5;
        }
        if progress > 0.15 && progress < 0.85 {
            waste *= 1.25;
        }
        score += waste;
    }

    // Residual-floor guard.
    if next_item_size > 0 && post_residual > next_item_size {
        let over = post_residual - next_item_size;
        if over > 0 && over <= 3 {
            score += 2.5;
        }
    }

    // Horizon-weighted fill-pressure (slightly stronger).
    if next_item_size > 0 && post_residual >= next_item_size && bin_residual != bin_capacity {
        let horizon = 1.0 - progress;
        let reach = (post_residual - next_item_size) as f64;
        score -= horizon * (2.5 + reach / cap * 4.5);
    }

    // Near-closure acceleration.
    if bin_residual != bin_capacity && post_residual > 0
        && post_residual <= bin_capacity / 8 && next_item_size > 0
        && next_item_size > post_residual {
        score += 3.0;
    }

    // Residual-entropy banding.
    if post_residual > 0 && bin_residual != bin_capacity {
        let band = (post_residual as f64 - mean_residual).abs();
        if band < cap * 0.08 {
            score -= 2.0 * (1.0 - band / (cap * 0.08));
        }
    }

    // Triple-chain probe.
    if next_item_size > 0 && post_residual >= next_item_size {
        let after_next = post_residual - next_item_size;
        if after_next >= next_item_size && after_next <= tenth {
            score -= 3.0;
        }
    }

    // Exact-fill sweep.
    if next_item_size > 0 && post_residual == next_item_size && bin_residual != bin_capacity {
        score -= 6.0 * (1.0 - progress);
    }

    // Fragmentation index.
    if post_residual > 0 && next_item_size > 0 && post_residual < next_item_size {
        score += (open_bins_count as f64).min(20.0) * 0.25;
    }

    // Dead-space delta coupling vs fleet average.
    if bin_residual != bin_capacity && open_bins_count > 0 {
        let avg_waste = mean_residual;
        let this_waste = post_residual as f64;
        if this_waste < avg_waste {
            score -= (avg_waste - this_waste) * 0.10 * (1.0 - progress);
        } else {
            score += (this_waste - avg_waste) * 0.06 * (1.0 - progress);
        }
    }

    // Large-item rescue.
    if item_size as f64 > cap * 0.6 && post_residual > 0 && post_residual <= twentieth
        && bin_residual != bin_capacity {
        score -= 5.0;
    }

    // Strand-ratio discount: residue under 15% of item is strong compaction.
    if bin_residual != bin_capacity && post_residual > 0 {
        let strand_ratio = post_residual as f64 / item_size.max(1) as f64;
        if strand_ratio < 0.15 {
            let mid = 1.0 - (progress - 0.5).abs() * 2.0;
            score -= (0.15 - strand_ratio) * item_size as f64 * 0.12 * (0.6 + 0.4 * mid);
        }
        // Quadratic strand penalty: residue fits next item once but not twice.
        if next_item_size > 0 && post_residual >= next_item_size {
            if post_residual < 2 * next_item_size {
                let dead = (post_residual - next_item_size) as f64;
                score += dead * 0.07 * (1.0 - progress);
            }
        }
    }

    // Residual-reusability forecast vs fleet mean.
    if bin_residual != bin_capacity && post_residual > 0
        && mean_residual > 0.0 && (post_residual as f64) >= mean_residual * 0.9 {
        score -= 2.0 * (1.0 - progress);
    }

    // Dead-space floor trap — residuals too small for the next item in
    // dense streams are near-certain waste; escalate with stream density.
    if post_residual > 0 && next_item_size > 0 && post_residual < next_item_size {
        let density = open_bins_count as f64 / (total_items.max(1) as f64).max(1.0);
        let dead_ratio = post_residual as f64 / next_item_size as f64;
        score += 3.0 * (1.0 - dead_ratio) * (0.5 + density.min(1.0));
    }

    // Perfect-split preference — balanced reuse for small items.
    if post_residual > 0 && post_residual * 2 == bin_residual && next_item_size > 0
        && next_item_size <= post_residual {
        score -= 3.5;
    }

    // NEW: residual absorption check — prefer bins whose leftover can be
    // absorbed by the fleet's average residual neighborhood, reducing
    // fragmentation of small reusable gaps.
    if post_residual > 0 && next_item_size > 0 && post_residual >= next_item_size {
        let fit_margin = post_residual as f64 - next_item_size as f64;
        if fit_margin > 0.0 && fit_margin < mean_residual * 0.5 {
            score += fit_margin * 0.12;
        }
    }

    // NEW: harvest pressure — when many bins are open with small residuals,
    // reward using the bin that most nearly empties itself (keeps fleet tidy).
    if bin_residual != bin_capacity && open_bins_count > 4 {
        let tidy = post_residual as f64 / cap;
        if tidy < 0.05 {
            score -= (0.05 - tidy) * cap * 0.9 * (0.5 + 0.5 * (1.0 - progress));
        }
    }

    score
}
