 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items.max(1) as f64;
    let cap = bin_capacity as f64;
    let pr = post_residual as f64;

    // Base: prefer tight fits (low post_residual), with non-linear sharpening.
    let mut score = pr * (1.0 + 0.8 * pr / cap) + 12.0 * (pr / cap).powi(3);

    // Smooth stream-progress coupling: early on, tolerate waste; later, tighten.
    score *= 1.0 - 0.35 * progress * (pr / cap);
    score -= 6.0 * progress * (1.0 - pr / cap).powi(2);

    // Penalize bins that are near-mean residuals (encourage residual diversity).
    let dev = (pr - mean_residual).abs() / cap;
    score += 4.0 * (1.0 - dev).powi(2);

    // Lookahead: reward leaving space for the next item; penalize otherwise.
    if next_item_size > 0 {
        let nxt = next_item_size as f64;
        let fits_next = pr >= nxt;
        if fits_next {
            score -= 5.0 * (1.0 - ((pr - nxt) / cap).abs());
        } else {
            score += 3.0 * (nxt - pr) / cap;
        }
    }

    // Last-chance bonus: strongly favor the only bin that fits.
    if fitting_bins_count == 1 && bin_residual < bin_capacity {
        score -= 10.0;
    }

    // Mild penalty for opening new bins when many bins already fit the item.
    if bin_residual == bin_capacity {
        score += 3.0 + 0.5 * fitting_bins_count as f64;
    }

    score
}
