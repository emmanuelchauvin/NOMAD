          "logic_code": "pub fn score_node(\n    job_cpu: u32,\n    job_ram: u32,\n    node_residual_cpu: u32,\n    node_residual_ram: u32,\n    node_capacity_cpu: u32,\n    node_capacity_ram: u32,\n    step_index: usize,\n    total_jobs: usize,\n    active_nodes_count: usize,\n    mean_cpu_residual: f64,\n    mean_ram_residual: f64,\n) -> f64 {\n    let cpu_norm = node_residual_cpu as f64 / node_capacity_cpu as f64;\n    let ram_norm = node_residual_ram as f64 / node_capacity_ram as f64;\n    let imbalance = (cpu_norm - ram_norm).abs();\n    let time_horizon = step_index as f64 / total_jobs as f64;\n\n    let cpu_score = cpu_norm * cpu_norm + 0.5 * time_horizon * cpu_norm * cpu_norm;\n    let ram_score = ram_norm * ram_norm - 0.25 * time_horizon * ram_norm * ram_norm;\n    let imbalance_penalty = if imbalance > 0.1 { 30.0 * (imbalance * imbalance) } else { 0.0 };\n    let active_nodes_factor = if active_nodes_count > 0 { active_nodes_count as f64 } else { 1.0 };\n    let node_utilization = (node_residual_cpu + node_residual_ram) as f64 / (node_capacity_cpu + node_capacity_ram) as f64;\n    let utilization_penalty = if node_utilization > 0.5 { 15.0 * node_utilization * node_utilization } else { 0.0 };\n    let time_weighted_imbalance = imbalance * time_horizon;\n\n    // Introduce non-linear conditionals and horizon-aware placement logic\n    let cpu_overload_penalty = if cpu_norm > 0.8 { 100.0 * (cpu_norm - 0.8) } else { 0.0 };\n    let ram_overload_penalty = if ram_norm > 0.8 { 100.0 * (ram_norm - 0.8) } else { 0.0 };\n    let time_dependent_utilization_penalty = if time_horizon < 0.5 { utilization_penalty * 2.0 } else { utilization_penalty };\n\n    let score = cpu_score + ram_score - imbalance_penalty - active_nodes_factor - cpu_overload_penalty - ram_overload_penalty - time_weighted_imbalance - time_dependent_utilization_penalty;\n\n    score\n}",
