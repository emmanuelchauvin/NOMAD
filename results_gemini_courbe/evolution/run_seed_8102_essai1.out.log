    else if post_residual % 20 == 0 { score -= 280.0; }
    else if post_residual % 25 == 0 { score -= 320.0; }
    else if post_residual % 33 == 0 { score -= 240.0; }

    // 5. Global Consolidation: Aggressive late-stage closure
    score -= progress.powf(8.2) * 800.0;

    // 6. Density Equilibrium: Penalize fragmentation at both tails
    if fill_ratio > 0.97 {
        score += 580.0; 
    } else if fill_ratio < 0.48 {
        score -= 490.0 * (1.0 - fill_ratio).powf(4.8);
    }

    // 7. Entropy Control: Dynamic variance dampening
    score += (post_residual as f64 - mean_residual).abs() * (2.8 + (progress * 2.8));

    // 8. Fitting Pressure: Prefer bins that maximize future connectivity
    score -= (fitting_bins_count as f64).min(140.0) * 125.0;

