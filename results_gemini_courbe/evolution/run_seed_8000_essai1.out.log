        score -= 520.0 / (post_residual as f64 + 0.05).powf(1.15);
    }

    // 3. Predictive Lookahead: Favor bins leaving specific residual for next_item_size
    if next_item_size > 0 && post_residual >= next_item_size {
        let leftover = (post_residual - next_item_size) as f64;
        score -= 750.0 - (leftover * 4.2) + (if leftover < 0.5 { 550.0 } else if leftover < 2.0 { 200.0 } else { 0.0 });
    }

    // 4. Dynamic Bin Opening: Adaptive thresholding to prevent premature creation
    if bin_residual == bin_capacity {
        if open_bins_count == 0 {
            score = -6200.0;
        } else {
            let density_factor = (mean_residual / bin_capacity as f64).clamp(0.02, 0.95);
            let late_game_penalty = if progress > 0.8 { 3200.0 + (progress * 2800.0) } else { 0.0 };
            score += 2100.0 + (mean_residual * 14.2) + (open_bins_count as f64 * 4.5 * (1.0 + progress.powf(4.0))) + (late_game_penalty / density_factor);
        }
    } else {
        if fitting_bins_count <= 8 {
            score -= 1100.0 / (fitting_bins_count as f64 + 0.15).powf(1.3);
        }
    }

    // 5. Temporal Horizon: Aggressive late-game compaction
    score += (progress.powf(7.0)) * 2200.0;

    // 6. Variance Control: Penalize deviations to keep residual distribution uniform
    let dev = (post_residual as f64 - mean_residual).abs();
    score += dev * 7.2;
    
    // Stricter check for residual bloat relative to local packing
    if post_residual as f64 > mean_residual * 1.05 {
        score += 850.0;
    }

    // 7. Adaptive Weighting: Differentiate strategy based on next item size
    let large_threshold = (bin_capacity as f64 * 0.65) as u32;
    if next_item_size > large_threshold {
        let fit_proximity = (post_residual as i32 - next_item_size as i32).abs() as f64;
        score += fit_proximity * 12.5;
