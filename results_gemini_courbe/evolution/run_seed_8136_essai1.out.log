 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items as f64;
    let is_new_bin = bin_residual == bin_capacity;
    
    // Base score: Favor filling to completion (minimize post_residual).
    // Shifted power to penalize mid-sized gaps more heavily.
    let mut score = (post_residual as f64).powf(1.22);

    // 1. Refined Fragmentation Mitigation:
    // Increased penalty for the "dead zone" (1-18 range) which prevents pairing of small items.
    if post_residual > 0 && post_residual < 19 {
        score += 215.0 * (1.0 - progress * 0.12);
    }

    // 2. Lookahead Synergy (Enhanced):
    // Prioritize bins that accommodate next_item_size with minimal slack.
    if next_item_size > 0 {
        if post_residual >= next_item_size {
            // Strong reward for a fit, scaling with how close the fit is to the target.
            score -= 285.0 + (1.0 / (post_residual - next_item_size + 1) as f64) * 150.0;
        } else if post_residual > 0 && post_residual < 22 {
            // Penalty for stranding an item that could have fit elsewhere.
            score += 190.0 * (next_item_size as f64 / 100.0);
        }
    }

    // 3. Adaptive Bin-Opening:
    // Exponentially weight the cost of a new bin based on global packing density.
    if is_new_bin {
        let density_weight = (open_bins_count as f64).powf(1.42) * 14.5;
        let penalty = 380.0 + density_weight;
        // If we have many fitting options, opening a new bin is very expensive.
        score += if fitting_bins_count > 0 { penalty * 6.5 } else { penalty * 0.08 };
    } else {
        // 4. Fitting Scarcity:
        // Prioritize existing bins when the supply of fit-able containers is low.
        if fitting_bins_count < 4 {
            score -= 240.0 / (fitting_bins_count as f64 + 0.3);
        }
    }

    // 5. Mean Residual Alignment:
    // Penalize high variance from the mean to promote uniform bin usage.
    score += (post_residual as f64 - mean_residual).abs() * 0.85;

    // 6. Tightness/Completion Reward:
    if post_residual == 0 {
        score -= 650.0;
    } else if post_residual < 4 {
        score -= 180.0;
    }

    // 7. Late-stage Compaction:
    // Aggressive consolidation as the stream ends.
    if progress > 0.85 {
        score -= (bin_capacity - post_residual) as f64 * 7.2;
    } else if progress > 0.6 {
        score -= (bin_capacity - post_residual) as f64 * 1.8;
    }

    score
}
