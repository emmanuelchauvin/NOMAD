    if bin_residual == bin_capacity {
        let mut new_bin_cost = 580.0 + (mean_residual * 8.0);
        if progress > 0.02 {
            new_bin_cost += 2400.0 * (progress - 0.02).powf(3.1);
        }
        score += new_bin_cost;
    } else {
        let dev = (bin_residual as f64 - mean_residual).abs();
        score += dev * 3.7;
        if post_residual < 20 {
            score -= 280.0 * (1.0 - progress * 0.28);
        }
    }

    // 5. Global Density Momentum: Increased weight on capacity utilization.
    score -= (bin_capacity - bin_residual) as f64 * 1.35;

    // 6. Mid-Range Sink: Targeted consolidation for higher-frequency item clusters.
    if post_residual >= 20 && post_residual <= 58 {
        score -= 260.0 * (1.0 + progress * 0.35);
    }

    // 7. Fitting Pressure: Elevated penalty for early-stage waste when open bin count is low.
