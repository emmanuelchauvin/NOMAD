 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items as f64;
    let post_res = post_residual as f64;
    let cap = bin_capacity as f64;

    // Core score: Penalize post-residual with non-linear growth to avoid micro-gaps.
    // Increased exponent to punish larger gaps more severely while maintaining sensitivity.
    let mut score = post_res + (post_res.powf(1.88) * 0.92);

    // Adaptive Fragmentation: Use a dynamic threshold based on mean residual to identify 'useless' gaps.
    let avg_item_est = (cap - mean_residual).max(1.0);
    if post_res > 0.0 && post_res < avg_item_est {
        score += (avg_item_est - post_res).powf(2.20) * 2.5;
    }

    // Lookahead Synergy: Fine-tune the reward for accommodating the next item in the stream.
    if next_item_size > 0 {
        let next_f = next_item_size as f64;
        if post_residual >= next_item_size {
            let remainder = post_res - next_f;
            // Reward perfect fit (remainder 0) or small remainders that don't strand the bin.
            score -= (next_f * 2.05) + (3.8 / (remainder + 0.015).powf(1.85));
        } else {
            // Penalize blocking the next item; scale penalty by progress to force efficiency early.
            score += next_f * (3.4 + (progress * 3.5));
        }
    }

    // Bin Creation Logic:
    if bin_residual == bin_capacity {
        // Higher base_cost and tighter clutter penalty to prevent unnecessary bin proliferation.
        let base_cost = 70.0;
        let progress_penalty = (1.0 - progress.powf(0.90)) * 140.0;
        let clutter_factor = (open_bins_count as f64).powf(1.48) * 8.8;
        score = base_cost + progress_penalty + clutter_factor;
    } else {
        // Utilization Reward: Strongly incentivize filling existing capacity.
        let utilization = 1.0 - (post_res / cap);
        score -= utilization * 92.0;

        // "Must-use" logic: Aggressively target the last available fitting bin to consolidate space.
        if fitting_bins_count == 1 {
            score -= 190.0;
        }
        
        // Anti-sparsity: Penalize bins that remain under-utilized.
        if utilization < 0.42 {
            score += (open_bins_count as f64).powf(1.30) * 5.2;
        }
    }

    // Late-stage compaction: Aggressive consolidation in the final 20% of the stream.
    // Adjusted weighting to prevent excessive fragmentation during final stages.
    let entropy_weight = if progress > 0.80 { 0.015 } else { 4.8 };
    score += (open_bins_count as f64).ln() * entropy_weight;

    score
}
