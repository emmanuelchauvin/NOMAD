 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items as f64;
    let mut score = post_residual as f64;

    // 1. Predictive Lookahead: Enhanced sensitivity to "dead zone" creation
    if next_item_size > 0 {
        if post_residual == 0 {
            score -= 68.0; // Stronger reward for perfect fit
        } else if post_residual < next_item_size {
            score += 155.0 + (next_item_size - post_residual) as f64 * 12.5;
        } else {
            let headroom = (post_residual - next_item_size) as f64;
            score -= 52.0 / (1.0 + (headroom * 0.42).sqrt());
            if headroom < 8.0 { score -= 42.0; }
        }
    }

    // 2. Adaptive New Bin Logic: Incorporate aggressive sprawl suppression
    if bin_residual == bin_capacity {
        let base_threshold = 38.0;
        let dynamic_pressure = (mean_residual * 0.85) + (open_bins_count as f64 * 1.25) + (progress * 115.0);
        score = base_threshold + dynamic_pressure;
    } else {
        // 3. Density-based Weighting: Tighten residuals relative to global mean
        score += (post_residual as f64 - mean_residual) * 1.65;
        
        // 4. Criticality: Prioritize closing existing bins when options are scarce
        if fitting_bins_count <= 2 {
            score -= 135.0 / (fitting_bins_count as f64 + 0.5);
        }
        
        // 5. Anti-Fragmentation: Non-linear fill ratio optimization
        let fill_ratio = (bin_capacity - bin_residual) as f64 / bin_capacity as f64;
        let open_bias = if open_bins_count > 6 { 115.0 } else { 55.0 };
        score -= (fill_ratio.powf(2.8) * open_bias);
        
        // Compaction pressure: Penalize residuals that exceed the current mean more aggressively
        if bin_residual as f64 > mean_residual {
            score += (bin_residual as f64 - mean_residual).powf(1.5) * 0.88;
        }
    }

    // 6. Terminal Compaction: Exponentially increase penalty for residual space in the final 12%
    if progress > 0.88 {
        score += (post_residual as f64).powf(2.1) * (8.0 + progress * 12.0);
    } else {
        score += progress * (post_residual as f64 * 0.55);
    }

    // 7. Splinter Prevention: Penalize residuals in the "unfillable" range [1, 9]
    if post_residual > 0 && post_residual <= 9 {
        score += 65.0 + (9.0 - post_residual as f64) * 18.0;
    }

    score
}
