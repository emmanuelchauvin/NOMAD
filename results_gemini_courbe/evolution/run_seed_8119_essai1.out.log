    // Bin Management: Dynamic cost to open, optimized for early vs late game
    if is_new_bin {
        // Increased cost for opening new bins when space is available
        let new_bin_base_cost = 720.0 + (open_bins_count as f64 * 42.0) + (progress * 550.0);
        score += if fitting_bins_count == 0 { 0.0 } else { new_bin_base_cost };
    } else {
        // Density Balancing: Use a tighter rolling mean window
        let target_res = mean_residual * 0.68;
        let deviation = (post_residual as f64 - target_res).abs();
        score += deviation * (4.8 - (progress * 1.3));

        // Tight-fit acceleration: Reward filling bins to near-capacity
        if post_residual < 10 {
            score -= (10.0 - post_residual as f64).powf(1.9) * 520.0;
        }
    }

    // Global Pressure: Non-linear penalty for opening too many concurrent bins
    if open_bins_count > 0 {
        score += (open_bins_count as f64).powf(2.65) * 18.0;
    }

    // Constraint Satisfaction: Prioritize unique fits
    if !is_new_bin {
        if fitting_bins_count == 1 {
            score -= 1100.0;
        } else if fitting_bins_count > 1 {
            score += (post_residual as f64).powf(1.6) * 15.0;
        }
    }

    // Adaptive End-of-Stream: Aggressive compaction in the final 15%
    if progress > 0.85 {
        if post_residual == 0 {
            score -= 800.0;
        } else if post_residual <= 6 {
