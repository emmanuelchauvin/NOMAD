            let exact_match_bonus = if post_residual == next_item_size { 620.0 } else { 310.0 };
            score -= exact_match_bonus + (progress * 150.0);
        } else {
            // Stronger penalty for blocking the next item
            score += (next_item_size - post_residual) as f64 * (110.0 + (1.0 - progress) * 125.0);
