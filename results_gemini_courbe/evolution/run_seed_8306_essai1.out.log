    if is_new_bin {
        let density_factor = (open_bins_count as f64 / (step_index as f64 / 15.0 + 1.0)).sqrt();
        // Shift weight toward conservation in the final 20% of the stream.
        let late_game_multiplier = if progress > 0.8 { 2.2 } else { 1.0 };
        score += (1100.0 + (mean_residual * 3.8) + (progress.powi(2) * 1600.0) + (density_factor * 400.0)) * late_game_multiplier;
    } else {
        // 5. Residual Balancing: Penalize divergence from mean_residual to prevent "Swiss cheese" bins.
        let residual_diff = (post_residual as f64 - mean_residual).abs();
        if residual_diff > (bin_capacity as f64 * 0.10) {
            score += 380.0 + (residual_diff * 1.5);
