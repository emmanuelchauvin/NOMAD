 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items as f64;
    let is_new_bin = bin_residual == bin_capacity;
    let post_residual_f = post_residual as f64;
    
    // Core objective: Minimize post_residual with a high-order penalty to prioritize Best-Fit.
    // We shift the exponent to 1.9 to aggressively discourage large empty gaps.
    let mut score = post_residual_f.powf(1.9);

    if !is_new_bin {
        // Fragmentation pressure: Penalize bins that leave awkward gaps.
        // The weight increases as we progress to force tighter packing when bins are plentiful.
        score += (post_residual_f / bin_capacity as f64) * 45.0 * (1.0 + progress);

        // Advanced Lookahead:
        // Use a non-linear penalty for "dead zones" (gaps smaller than the next item).
        if next_item_size > 0 {
            if post_residual > 0 && post_residual < next_item_size {
                score += ((next_item_size - post_residual) as f64).powf(2.5) * 20.0;
            } else if post_residual >= next_item_size {
                // Reward bins that maintain "utility" for the immediate future.
                score -= (next_item_size as f64) * (5.5 + progress * 5.0);
            }
        }
        
        // Entropy control: Keep residuals near the mean to prevent extreme bin variances.
        score += (post_residual_f - mean_residual).abs() * 1.5;
        
        // Local scarcity: If this is the only bin that fits, we must take it.
        if fitting_bins_count == 1 {
            score -= 85.0;
        }
    } else {
        // New bin decision matrix:
        if fitting_bins_count > 0 {
            // Calculate a "cost" to open a new bin based on existing fragmentation.
            // If mean_residual is low, existing bins are well-packed, so opening a new one is costly.
            let density_pressure = (open_bins_count as f64).powf(1.1) * 25.0;
            let fragmentation_relief = (1.0 - (mean_residual / bin_capacity as f64)) * 105.0;
            score += 180.0 + (mean_residual * 1.8) + density_pressure - fragmentation_relief;
        } else {
            // If no existing bin can fit, force new bin opening with a strong negative bias.
            score -= 500.0;
        }
    }

    // Late-stage compaction: Aggressively finalize near-full bins.
    if progress > 0.55 {
        let filled_amount = (bin_capacity - bin_residual) as f64;
        // Reward high-density completion to reduce active open_bins_count.
        score -= filled_amount.powf(1.7) * 4.8;
        
        // Dynamic barrier: Increasing cost to open new bins as we approach stream exhaustion.
        if is_new_bin {
            score += 130.0 * (progress - 0.55).powf(1.3);
        }
    }

    // Secondary outlier constraint: Penalize "too empty" bins relative to the current mean.
    if !is_new_bin && post_residual_f > mean_residual * 1.6 {
        score += (post_residual_f - mean_residual) * 2.5;
    }

    score
}
