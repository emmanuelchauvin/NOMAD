 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items as f64;
    let post_res = post_residual as f64;
    let cap = bin_capacity as f64;
    
    // Mutation: Refined base weight, focusing on aggressive minimization of post-fit residual space.
    // Adjusted coefficient to 1.78 to balance between tight fit and future-proofing.
    let mut score = post_res * 1.78;

    // 1. Refined Fragmentation Penalty:
    // Tightened penalty window to 3-44 to avoid over-penalizing useful mid-range remnants.
    if post_residual > 2 && post_residual < 45 {
        score += 62.0 + (post_res * 1.48);
    }
    
    // Quadratic penalty for residual bloat, tuned to favor higher local density.
    score += (post_res * post_res) / (cap * 0.082);

    // 2. Lookahead Coupling:
    // Enhanced lookahead to prioritize "next-fit" scenarios.
    if next_item_size > 0 {
        if post_residual >= next_item_size {
            let fit_bonus = (next_item_size as f64) * (4.7 - (progress * 1.15));
            score -= fit_bonus;
            if post_residual == next_item_size {
                score -= 105.0; // Higher incentive for exact-fit chains
            }
        } else if fitting_bins_count > 1 {
            score += (open_bins_count as f64).sqrt() * 12.5;
        }
    }

    // 3. Dynamic New Bin Threshold
    // Stricter new-bin penalty to force consolidation as the stream progresses.
    let new_bin_cost = 35.0 + (mean_residual * 1.8) + (progress * 175.0) + (open_bins_count as f64 * 0.40);
    
    if bin_residual == bin_capacity {
        score = new_bin_cost;
    } else if fitting_bins_count == 1 {
        // Scarcity Logic: Strong incentive to use the final fitting bin to avoid new bin creation.
        score -= 240.0;
    }

    // 4. Entropy Control:
    // Non-linear penalty for bin count, scaled by progress to permit early expansion.
    let fill_ratio = 1.0 - (mean_residual / cap);
    let density_factor = (open_bins_count as f64).powf(1.5) * (2.15 - fill_ratio);
    score += density_factor * 78.0;

    // 5. Harmonic Alignment:
    // Prioritize residuals that preserve common bin-size factors.
    if post_residual > 0 {
        if post_residual % 25 == 0 { score -= 65.0; }
        else if post_residual % 20 == 0 { score -= 48.0; }
        else if post_residual % 10 == 0 { score -= 32.0; }
    }

    // 6. Adaptive Item-Size Packing:
    if item_size < 30 {
        // Small items: focus on filling the most depleted bins to keep others empty.
        let fullness = 1.0 - (bin_residual as f64 / cap);
        score -= fullness * 65.0;
