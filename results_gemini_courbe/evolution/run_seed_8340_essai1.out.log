    }

    // 12. Strategic New Bin Avoidance: Bonus for fitting large items in existing bins
    if item_size > 55 && !is_new_bin {
        score -= 70.0;
    }

    // 13. Late-stage compaction correction
    if progress > 0.9 && !is_new_bin {
        score -= (post_residual as f64) * 0.5;
    }

    score
}
