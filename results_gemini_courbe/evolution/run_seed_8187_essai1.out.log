 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64 * 2.15;
    let progress = (step_index as f64 / total_items as f64).clamp(0.0, 1.0);
    let is_new_bin = bin_residual == bin_capacity;

    // 1. Enhanced Predictive Lookahead: Refined penalty for blocking immediate next item.
    if next_item_size > 0 && post_residual > 0 {
        if post_residual < next_item_size {
            score += (next_item_size - post_residual) as f64 * 880.0;
        } else if post_residual == next_item_size {
            score -= 1550.0;
        } else {
            score -= (380.0 - ((post_residual - next_item_size) as f64 * 4.5)).clamp(0.0, 380.0);
        }
    }

