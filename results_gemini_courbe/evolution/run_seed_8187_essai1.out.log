    if is_new_bin {
        let density_factor = (open_bins_count as f64 / (total_items as f64 / 96.0 + 5.0)).min(6.2);
        score += 2400.0 + (density_factor * 2800.0) * (1.1 - progress);
    } else {
        score -= (bin_capacity - bin_residual) as f64 * 6.4;
    }

    // 4. Anti-Fragmentation: Aggressive suppression of "sliver" residuals (1-22 range).
    if post_residual > 0 && post_residual <= 22 {
        score += 4800.0 - (post_residual as f64 * 215.0);
    } else if post_residual > 22 && post_residual <= 30 {
        score += 950.0;
    } else if post_residual > 30 {
        score -= 1050.0 * (post_residual as f64 / bin_capacity as f64);
    }

    // 5. Global Mean Coupling: Weighted variance penalty with increased sensitivity.
    score += (post_residual as f64 - mean_residual).abs() * (32.0 + progress * 28.0);

    // 6. Late-stage Compaction: Exponentially aggressive finalization.
    if progress > 0.92 {
        if is_new_bin {
            score += 95000.0 * progress.powi(48); 
        } else {
            score -= (bin_capacity - post_residual) as f64 * 1450.0;
            if post_residual < 9 { score -= 8800.0; }
        }
    }

    // 7. Fitting Bin Density Bonus: Encourages consolidation based on remaining potential.
    if fitting_bins_count > 0 {
        score -= (fitting_bins_count as f64).sqrt() * 520.0 * (1.0 - progress.powf(0.9));
