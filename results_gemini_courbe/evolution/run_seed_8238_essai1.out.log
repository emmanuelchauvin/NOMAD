 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items as f64;
    let mut score = post_residual as f64;

    // 1. Refined Sliver Penalty: Target very thin residuals that impede future packing
    if post_residual > 0 && post_residual < 44 {
        let sliver_penalty = 158.0 + (44.0 - post_residual as f64).powi(2) * 0.72;
        score += sliver_penalty * (1.0 + (open_bins_count as f64 * 0.08) + (1.0 - progress) * 1.4);
    }

    // 2. Lookahead: Heuristic coupling of current residual and incoming demand
    if next_item_size > 0 {
        if post_residual >= next_item_size {
            let slack = (post_residual - next_item_size) as f64;
            score -= 185.0 * (1.0 - (slack / bin_capacity as f64).powf(0.75));
        } else {
            score += 175.0;
        }
    }

    // 3. New Bin Constraint: Adjusted barrier to prevent premature opening
    if bin_residual == bin_capacity {
        let density_factor = (mean_residual / bin_capacity as f64) * 310.0;
        score += 295.0 + (open_bins_count as f64 * 22.0) + density_factor + (progress * 135.0);
        if item_size < 80 {
            score += 185.0;
        }
    }

    // 4. Scarcity Logic: Critical path protection
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 1150.0;
    }

    // 5. Variance Balancing: Force convergence toward the rolling mean
    let dev = (post_residual as f64 - mean_residual).abs();
    score += dev.powf(1.65) * 2.45;

    // 6. Filling Reward: High priority for full utilization
    if post_residual == 0 {
        score -= 580.0;
    }

    // 7. Adaptive Compaction: Shifted curve to tighten mid-game, accelerate end-game
    if progress > 0.55 {
        score -= (bin_capacity - post_residual) as f64 * 11.2 * progress.powi(7);
    } else if progress < 0.35 {
        score -= (bin_capacity - bin_residual) as f64 * 2.8;
    }

    // 8. Residual Density Normalization: Global state monitoring
    if open_bins_count > 2 {
        score += (bin_residual as f64 / bin_capacity as f64) * 125.0;
    }

    // 9. Capacity Pressure: Non-linear penalty for excessive bin count
    let capacity_threshold = (total_items / 85).max(4);
    if open_bins_count > capacity_threshold {
        score += 145.0 * ((open_bins_count - capacity_threshold) as f64).powf(1.55);
    }

    // 10. Entropy reduction: Prefer bins that leave space for large items
    if post_residual > 0 && post_residual < 40 {
        score += 95.0 * (1.3 - progress);
    }

    // 11. Dynamic Bin Aging: Penalty for keeping bins open too long without progress
    if open_bins_count > 5 && post_residual > (bin_capacity / 2) {
        score += (open_bins_count as f64) * 35.0 * progress;
