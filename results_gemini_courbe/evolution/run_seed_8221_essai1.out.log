 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items as f64;
    let post = post_residual as f64;
    let residual = bin_residual as f64;
    let capacity = bin_capacity as f64;
    
    let mut score = post;

    // Refined fragmentation penalty: 
    // Increased threshold and weight to aggressively discourage small, unusable slivers.
    if post > 0.0 && post < 48.0 {
        score += (48.0 - post) * 22.8;
    }

    // Lookahead refinement: 
    // Dynamically adjust lookahead sensitivity based on the volume of remaining items.
    if next_item_size > 0 {
        let next = next_item_size as f64;
        // Penalize bins that would leave a post_residual too small for the next item, 
