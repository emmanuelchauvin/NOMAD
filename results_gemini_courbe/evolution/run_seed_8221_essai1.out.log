        if post < next && post > 0.0 {
            let lookahead_penalty = (next - post) * 28.0 * (1.1 - progress).max(0.1);
            score += lookahead_penalty * (1.0 + (open_bins_count as f64 / 52.0));
        } else if post >= next && post < (next + 5.0) {
            score -= 15.0; // Bonus for "just enough" space
        }
    }

    if bin_residual == bin_capacity {
        // New Bin Decision:
        // Increased resistance to opening new bins, especially late in the stream.
        score += (mean_residual * 6.2) + (progress * 72.0);
        
        if fitting_bins_count > 0 {
            score += 325.0 * (1.0 - progress).powf(4.8) + (open_bins_count as f64 * 7.5);
        }
    } else {
        // Existing bin strategy:
        // Exponential reward for density, favoring bins that are already well-filled.
        let used = capacity - residual;
        score -= (used / capacity).powf(6.8) * 125.0;
        
        // Stricter penalty for "medium-empty" bins to force tighter packing.
        if residual > (capacity * 0.15) {
            score += (residual - (capacity * 0.10)) * 9.5;
        }
    }

    // Global density control:
    // Scaling on open_bins_count to favor consolidation early, shifting to efficiency late.
    score += (open_bins_count as f64).powf(2.4) * (1.05 - (progress * 0.4));

    // Perfect fit priority:
    // Stronger incentive to close bins entirely.
    if post == 0.0 && bin_residual != bin_capacity {
        score -= 185.0;
    }
    
    // Entropy dampener: 
    // Prevents small items from 'wasting' space in nearly-full bins while encouraging 
