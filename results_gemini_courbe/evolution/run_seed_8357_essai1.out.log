 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items as f64;
    let is_new_bin = bin_residual == bin_capacity;
    let mut score = post_residual as f64;

    // 1. Enhanced Fragmentation Suppression: Stronger penalty for "unfillable" slivers
    if post_residual > 0 {
        if post_residual < 8 {
            score += 115.0 / (post_residual as f64 + 0.1);
        } else if post_residual < 16 {
            score += 45.0;
        }
    }

    // 2. Lookahead Synergy: Dynamic fit alignment
    if next_item_size > 0 {
        if post_residual == 0 {
            score -= 88.0;
        } else if post_residual < next_item_size {
            score += (next_item_size - post_residual) as f64 * 38.0;
        } else {
            // Favor bins that leave exactly enough space for the next item
            let tight_fit = (post_residual as f64 - next_item_size as f64).abs();
            score -= (25.0 - tight_fit).max(0.0) * 1.5;
        }
    }

    // 3. Adaptive New Bin Threshold: Heuristic cost growth
    if is_new_bin {
        let open_cost = 135.0 + (mean_residual * 2.8) + (progress * 550.0);
        score += open_cost;
    } else {
        // 4. Load Balancing: Variance minimization relative to bin capacity
        let usage = (bin_capacity - bin_residual) as f64;
        let deviation = (usage - (bin_capacity as f64 - mean_residual)).abs();
        score += deviation.powf(1.6) * 0.9;
    }

    // 5. Scarcity Logic: Consolidation pressure
    if fitting_bins_count > 0 {
        score -= 210.0 / (fitting_bins_count as f64 + 0.5).sqrt();
    }

    // 6. Tail-End Compaction: Aggressive closure
    if progress > 0.82 {
        if is_new_bin {
            score += 3500.0 * (1.0 + progress);
        } else {
            score -= (bin_capacity - bin_residual) as f64 * 8.5;
        }
    }

    // 7. Residual Quantization: Favor "clean" remainder space
    if post_residual == 0 {
        score -= 45.0;
    } else if post_residual % 10 == 0 {
        score -= 25.0;
    }

    // 8. Density-Fit coupling: Bias towards filling deep bins
    let depth = (bin_capacity - bin_residual) as f64 / bin_capacity as f64;
    if !is_new_bin {
        score -= depth * 40.0;
    }

    // 9. Entropy reduction: Penalize bins that deviate from optimal packing density
    if !is_new_bin && post_residual as f64 > (mean_residual * 2.2) {
        score += 75.0;
    }

