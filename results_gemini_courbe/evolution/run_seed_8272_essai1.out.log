 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = (step_index as f64 / total_items as f64).clamp(0.0, 1.0);
    let post = post_residual as f64;
    let capacity = bin_capacity as f64;
    let is_new_bin = bin_residual == bin_capacity;
    
    let mut score = (post * post) * 0.082;
    score -= 245.0 / (1.0 + (post * 0.48));

    if next_item_size > 0 {
        let n = next_item_size as f64;
        if post > 0.0 && post < n {
            score += (n - post) * 62.0;
        } else if post >= n {
            score -= 88.0 * (1.0 - ((post - n) / capacity).powf(0.82)) * (1.15 - progress * 0.45);
        }
    }

    if is_new_bin {
        let density_pressure = (open_bins_count as f64 / (total_items as f64 / 92.0)).clamp(0.12, 8.5);
        score += 195.0 + (progress * 240.0) + (fitting_bins_count as f64 * 52.0 * density_pressure * (1.25 - progress));
        
        if progress > 0.94 {
            score += 650.0;
        }
    } else {
        let utilization = 1.0 - (post / capacity);
        let mean_utilization = 1.0 - (mean_residual / capacity);
        
        score += (utilization - mean_utilization).abs() * 192.0;
        
        let threshold = capacity * 0.16;
        if post < threshold {
            score -= 215.0 * (1.0 - (post / threshold).powf(0.75));
        }
        
        if utilization < 0.55 {
            score += 175.0 * (1.0 - progress.powf(0.62));
        }
        
        if post < (capacity * 0.06) {
            score -= 190.0;
        }
        
        if open_bins_count > (total_items / 85) {
            score += (post / capacity) * 115.0;
        }

        if post > mean_residual * 1.28 {
            score += 92.0 * (post / (mean_residual + 0.1));
        }
        
        if post > 0.0 && post < 12.0 {
            score -= 85.0;
        }
        
        if progress < 0.35 && post > capacity * 0.75 {
            score -= 140.0;
        }
        
        if post > mean_residual && post < (mean_residual * 1.5) {
            score += 62.0 * (post / (mean_residual + 0.5));
        }
        
        if post > 0.0 && post < (mean_residual * 0.30) {
            score -= 72.0;
        }
        
        if progress > 0.85 && post < (capacity * 0.28) {
            score -= 135.0 * (1.0 - (post / capacity));
        }
        
        // Refined lookahead: penalize nearly-full bins that block the next item
        if next_item_size > 0 {
