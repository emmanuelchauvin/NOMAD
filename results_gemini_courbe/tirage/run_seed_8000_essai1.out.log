 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Harmonic Penalty: Heavily penalize residuals that are small but non-zero (fragments)
    // if a small residual cannot accommodate common item sizes (10-40 range).
    if post_residual > 0 && post_residual < 20 {
        score += 45.0;
    }

    // 2. Lookahead Synergy: If the next item can fit in the post_residual, prioritize this bin.
    if next_item_size > 0 && post_residual >= next_item_size {
        score -= 30.0;
    }

    // 3. Last-Chance Mitigation: If this is the only bin that fits the current item, 
    // discourage opening a new bin by aggressively lowering the score.
    if fitting_bins_count == 1 && bin_residual >= item_size {
        score -= 20.0;
    }

    // 4. New Bin Thresholding: Penalize opening a new bin unless the current mean residual 
    // is very tight, suggesting we are struggling to pack.
    if bin_residual == bin_capacity {
        if open_bins_count > 0 && mean_residual > 15.0 {
            score += 50.0;
        } else {
            score += 80.0;
        }
    }

    // 5. Harmonic Class Alignment: Favor residuals that align with common item size multiples
    // to improve future packing efficiency.
    let remainder = post_residual % 25;
    if remainder == 0 {
        score -= 10.0;
    }

    // 6. Progression Normalization: As we reach the end of the stream, 
    // prioritize closing existing bins over opening new ones.
    let progress = step_index as f64 / total_items as f64;
    if progress > 0.8 && bin_residual == bin_capacity {
        score += 100.0;
    }

    score
}
