 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Best Fit Decreasing logic: Minimize post_residual (already in score)
    // 2. Penalty for creating "dead space": If post_residual is small but > 0, 
    // it's often better to leave a larger space for larger future items.
    if post_residual > 0 && post_residual < 20 {
        score += 25.0;
    }

    // 3. Harmonic Lookahead: If next_item_size is large, favor bins that can accommodate it.
    // Use modulo arithmetic to identify bins that align well with potential future sizes.
    if next_item_size > 0 {
        let fit_diff = (post_residual as i32 - next_item_size as i32).abs() as f64;
        score += fit_diff * 0.4;
    }

    // 4. Thresholding: If this is the last chance to fit the item (fitting_bins_count == 1),
    // heavily reward placing it here to avoid opening a new bin.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 50.0;
    }

    // 5. Progression awareness: As the stream nears the end, become more aggressive 
    // about filling existing bins rather than opening new ones.
    let progress = step_index as f64 / total_items as f64;
    if bin_residual == bin_capacity {
        // Penalty for opening a new bin increases as we progress through the stream.
        score += 30.0 + (progress * 40.0);
    }

    // 6. Mean Residual Balancing: Penalize bins that deviate significantly from the mean
    // to keep the packing density uniform across all active bins.
    let dev = (bin_residual as f64 - mean_residual).abs();
    score += dev * 0.2;

    score
}
