 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Penalty for creating "dead space": small residuals that are unlikely to fit future items.
    // We target residuals that are multiples of common item size clusters.
    if post_residual > 0 && post_residual < 20 {
        score += 45.0 + (post_residual as f64 * 0.5);
    }

    // Lookahead logic: if the next item fits into the current post_residual, reward this placement.
    if next_item_size > 0 && post_residual >= next_item_size {
        score -= 30.0;
    }

    // Harmonic refinement: favor filling bins to specific thresholds to leave room for larger items.
    // If we are at the end of the stream, prioritize aggressive packing.
    let progress = step_index as f64 / total_items as f64;
    if progress > 0.85 {
        score -= 20.0 * (1.0 - (post_residual as f64 / bin_capacity as f64));
    }

    // If this is a new bin, penalize it heavily unless it's the only option or the current 
    // open bins are poor candidates (high mean_residual suggests we are packing sparsely).
    if bin_residual == bin_capacity {
        if fitting_bins_count == 0 {
            score -= 10.0;
        } else {
            // Only open a new bin if the mean residual of existing bins is already very tight,
            // or if we are forced to by the heuristic logic.
            score += 40.0 + (mean_residual * 0.5);
        }
    }

    // Reward bins that become "perfect" or near-perfect fits.
    if post_residual == 0 {
        score -= 50.0;
    } else if post_residual < 10 {
        score -= 15.0;
    }

    score
}
