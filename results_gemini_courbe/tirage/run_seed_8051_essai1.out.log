 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Penalize creating "dead space" that is too small for any likely future item.
    // If post_residual is small but > 0, it's often a waste unless it fits the next item.
    if post_residual > 0 && post_residual < 20 {
        score += 45.0;
    }

    // 2. Lookahead optimization: If the next item fits perfectly in the post_residual, reward this bin.
    if next_item_size > 0 && post_residual >= next_item_size {
        let diff = (post_residual - next_item_size) as f64;
        // Reward small gaps after placing the next item (tight packing)
        score -= (30.0 / (1.0 + diff));
    }

    // 3. Global capacity management: If we are late in the stream, prioritize closing bins.
    let progress = step_index as f64 / total_items as f64;
    if progress > 0.8 && post_residual < 10 {
        score -= 20.0;
    }

    // 4. Heuristic for new bin creation:
    // Only open a new bin if the current fit is "poor" (leaves a large, unusable gap).
    if bin_residual == bin_capacity {
        if fitting_bins_count > 0 {
            // Strong penalty for opening a new bin if other options exist
            score += 60.0;
        } else {
            // No choice, must open new bin
            score -= 10.0;
        }
    }

    // 5. Balance against mean_residual:
    // If this bin's post_residual is significantly better than the global average, reward it.
    if (post_residual as f64) < mean_residual {
        score -= 10.0 * (1.0 - (post_residual as f64 / (mean_residual + 1.0)));
    }

    score
}
