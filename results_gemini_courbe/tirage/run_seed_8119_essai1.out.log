 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    // Objective: Minimize score.
    // Core logic: Best-Fit Decreasing heuristic modified by Best-Fit-Lookahead (BFL)
    // and a penalty for creating "fragmented" bins that cannot house common item sizes.

    let mut score = post_residual as f64;

    // 1. Penalize creating a new bin unless the current options are very poor.
    if bin_residual == bin_capacity {
        score += 25.0; // Base cost to open a new bin
        // If we have many open bins that could fit the item, opening a new one is highly inefficient.
        score += (fitting_bins_count as f64) * 15.0;
    }

    // 2. Harmonic Alignment: Reward post_residuals that are multiples of common item sizes (e.g., 20, 25).
    // This reduces the likelihood of creating "dead" space that fits nothing.
    let remainder_mod = (post_residual % 20) as f64;
    score += remainder_mod * 0.5;

    // 3. Lookahead Logic: If the next item exists, penalize bins that leave just enough space 
    // to "almost" fit the next item but not quite (the "dead zone" 1..next_item_size).
    if next_item_size > 0 {
        if post_residual < next_item_size && post_residual > 0 {
            // This is a high-penalty state (wasted potential for the next item).
            score += (next_item_size - post_residual) as f64 * 1.5;
        } else if post_residual >= next_item_size {
            // Reward bins that can accommodate the next item.
            score -= (next_item_size as f64) * 0.8;
        }
    }

    // 4. Global distribution awareness:
    // If the mean residual is high, we are currently packing loosely. 
    // Encourage filling the tightest bins first to keep open_bins_count low.
    if (bin_residual as f64) > mean_residual {
        score += 2.0;
    }

    // 5. Progression awareness:
    // As we approach the end of the stream, prioritize closing bins over opening new ones.
    let progress = step_index as f64 / total_items as f64;
    if bin_residual == bin_capacity {
        score += progress * 20.0;
    }

    score
}
