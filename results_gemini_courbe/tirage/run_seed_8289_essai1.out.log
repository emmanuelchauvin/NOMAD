 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Best-Fit logic: Penalize large post-residuals to keep bins tight.
    // 2. Harmonic Class Logic: If post_residual is small, favor it unless it creates "dead space" 
    //    that cannot accommodate common item sizes (below 20).
    if post_residual < 20 && post_residual > 0 {
        score += 45.0; // Penalty for creating "sliver" space that is hard to fill.
    }

    // 3. Lookahead integration: If the next item fits into the current post_residual, 
    //    heavily reward this bin to clear the queue faster.
    if next_item_size > 0 && next_item_size <= post_residual {
        score -= 60.0;
    }

    // 4. Distribution management: If we are late in the stream, prioritize closing bins 
    //    (minimizing open_bins_count) to avoid leaving many half-empty bins open.
    let progress = step_index as f64 / total_items as f64;
    score += (open_bins_count as f64) * progress * 5.0;

    // 5. New bin thresholding: If this is an empty bin (bin_residual == bin_capacity),
    //    apply a high cost to force the algorithm to prefer existing bins unless they are 
    //    all very poor fits (e.g., large post_residual > 50).
    if bin_residual == bin_capacity {
        score += 55.0;
        // If it's the only option (fitting_bins_count == 0), reduce the penalty.
        if fitting_bins_count == 0 {
            score -= 40.0;
        }
    }

    // 6. Mean residual balancing: If current post_residual is significantly better than 
    //    the global mean, reward it.
    if (post_residual as f64) < mean_residual {
        score -= 10.0;
    }

    score
}
