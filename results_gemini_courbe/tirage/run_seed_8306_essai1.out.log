 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Best-Fit Penalty: Minimize post_residual (Best Fit logic)
    // We favor bins where the remaining space is small, but penalize space that is
    // too small to fit common future items (e.g., < 10 or < next_item_size).
    if post_residual < next_item_size && post_residual > 0 {
        score += 50.0;
    }

    // 2. Harmonic Class Logic:
    // We want to avoid creating "orphaned" space by trying to keep the 
    // post_residual as a multiple of common item sizes (e.g., 20, 25, 33).
    let harmonic_penalty = (post_residual % 20) as f64;
    score += harmonic_penalty * 0.5;

    // 3. New Bin Threshold:
    // If this is a new bin (bin_residual == bin_capacity), set a threshold cost.
    // We only open a new bin if the current existing bins are "poor" fits.
    if bin_residual == bin_capacity {
        // Base cost to open a new bin is relatively high.
        // We reduce this cost if open_bins_count is high, discouraging fragmentation.
        score = 45.0 + (open_bins_count as f64 * 0.1);
    } else {
        // 4. Lookahead coupling:
        // If next_item_size fits in the post_residual, reward this placement.
        if next_item_size > 0 && post_residual >= next_item_size {
            score -= 20.0;
        }
        
        // 5. Mean residual pressure:
        // Avoid bins that deviate significantly from the mean residual of the set.
        let deviation = (bin_residual as f64 - mean_residual).abs();
        score += deviation * 0.05;
    }

    // 6. Final progression bias:
    // As the stream ends, be more aggressive about filling existing bins.
    let progress = step_index as f64 / total_items as f64;
    score -= progress * 5.0;

    score
}
