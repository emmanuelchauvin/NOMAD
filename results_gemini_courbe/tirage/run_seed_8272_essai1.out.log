 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Best Fit Decreasing logic: heavily penalize larger post-residuals to keep bins tight.
    // However, we reward post-residuals that are "perfect" or near-perfect fits (0-5).
    if post_residual == 0 {
        score -= 500.0;
    } else if post_residual < 5 {
        score -= 150.0;
    }

    // 2. Lookahead Synergy: If the next item fits into the current post_residual, 
    // significantly prioritize this bin to maximize packing density.
    if next_item_size > 0 && post_residual >= next_item_size {
        score -= 300.0;
        // Harmonic refinement: if the remaining space after both items is small, even better.
        let double_post = post_residual - next_item_size;
        if double_post < 10 {
            score -= 200.0;
        }
    }

    // 3. Harmonic Constraint: If this is the only bin that fits, we are forced to pick it.
    // If it's a new bin, penalize it unless the current open bins are very full.
    if bin_residual == bin_capacity {
        // Penalty for opening a new bin: higher if fitting_bins_count is low.
        score += 250.0;
        // But if the mean residual of existing bins is already small (< 20), 
        // the existing bins are "crowded", so opening a new one is less penalized.
        if mean_residual < 20.0 {
            score -= 100.0;
        }
    } else {
        // Penalty for leaving "dead space" that is too small for any likely future item (e.g., < 10).
        if post_residual < 10 && post_residual > 0 {
            score += 150.0;
        }
    }

    // 4. Stream Progression: Toward the end of the stream, prioritize closing bins 
    // rather than starting new ones.
    let progress = step_index as f64 / total_items as f64;
    if progress > 0.8 && bin_residual == bin_capacity {
        score += 400.0;
    }

    score
}
