 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items as f64;
    let post = post_residual as f64;
    
    // Penalize small "fragment" residuals that are unlikely to accommodate future items.
    // The penalty is non-linear, peaking at residuals around 10-20.
    let fragmentation_penalty = (100.0 - post) * (-(post - 15.0).powi(2) / 200.0).exp();
    
    // Lookahead logic: if next_item_size is large, favor bins that preserve larger residuals.
    let lookahead_pressure = if next_item_size > 0 {
        (next_item_size as f64 - post).max(0.0) * 0.5
    } else {
        0.0
    };
    
    // As the stream progresses, tighten the tolerance for opening new bins.
    // At the end of the stream, prioritize filling existing bins (higher penalty for new).
    let is_new_bin = bin_residual == bin_capacity;
    let new_bin_bias = if is_new_bin {
        (1.0 - progress) * 25.0 + 5.0
    } else {
        0.0
    };
    
    // Favor bins that are closer to the mean_residual to maintain uniform packing density
    let density_balance = (post - mean_residual).abs() * 0.2;
    
    // Base score is the post_residual (Best Fit style).
    // We add penalties for fragmentation, lookahead mismatch, and new bin creation.
    let mut score = post + fragmentation_penalty + lookahead_pressure + new_bin_bias + density_balance;
    
    // Heavily penalize opening a new bin if an existing bin could fit the item adequately.
    if is_new_bin && fitting_bins_count > 0 {
        score += 50.0 * (1.0 - progress);
    }
    
    score
}
