 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Best-Fit Penalty: Penalize remaining space that is too small for future items.
    // If post_residual is small but > 0, it creates "fragmentation".
    if post_residual > 0 && post_residual < 20 {
        score += 45.0;
    }

    // 2. Lookahead Coupling: If next_item_size is known, favor bins that fit it perfectly.
    // We want post_residual to be close to next_item_size.
    if next_item_size > 0 {
        let diff = (post_residual as i32 - next_item_size as i32).abs() as f64;
        score += diff * 0.8;
    }

    // 3. New Bin Threshold: Discourage opening a new bin unless the fit is excellent.
    if bin_residual == bin_capacity {
        // Only open a new bin if the item is large or if we have too many fragmented bins.
        score += 35.0;
        if item_size > 70 {
            score -= 20.0;
        }
    }

    // 4. Global State Awareness:
    // If we have very few fitting bins, don't waste a "good" bin.
    if fitting_bins_count == 1 && post_residual < 10 {
        score -= 15.0;
    }

    // 5. Mean Residual Alignment:
    // Avoid creating bins that are significantly "worse" than the current average.
    if post_residual as f64 > mean_residual {
        score += 10.0;
    } else {
        score -= 5.0;
    }

    // 6. Progression scaling: As we approach the end of the stream, prioritize packing tighter.
    let progress = step_index as f64 / total_items as f64;
    score += progress * 10.0;

    score
}
