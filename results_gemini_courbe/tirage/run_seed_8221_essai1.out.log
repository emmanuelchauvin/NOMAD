 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items as f64;
    let post = post_residual as f64;
    
    // Base score is the residual space remaining (Best Fit heuristic baseline).
    // We want to minimize this to keep bins tightly packed.
    let mut score = post;

    // Penalty for creating small, unusable gaps (1-9) that are difficult to fill,
    // weighted by the progression of the stream.
    if post > 0.0 && post < 10.0 {
        score += (10.0 - post) * 15.0 * (1.0 + progress);
    }

    // Lookahead logic: If the next item is large, penalize small residuals in the current bin
    // that might prevent the next item from fitting, forcing better utilization.
    if next_item_size > 0 {
        let next = next_item_size as f64;
        if post < next && post > 0.0 {
            score += (next - post) * 5.0;
        }
    }

    // Dynamic threshold: As the stream progresses, become more conservative about 
    // opening new bins. If fitting_bins_count is low, we prioritize keeping the 
    // current bin "open" by favoring lower post-residuals.
    if fitting_bins_count == 1 {
        score -= 20.0 * (1.0 - progress);
    }

    // Interaction with mean_residual: If the current bin is significantly worse than 
    // the average open bin, penalize it to encourage balancing.
    if post > mean_residual {
        score += (post - mean_residual) * 0.5;
    }

    // New-bin candidate handling:
    // If bin_residual == bin_capacity, it's a new bin. 
    // We assign it a cost that increases as we approach the end of the stream 
    // to discourage starting new bins when we could potentially squeeze into existing ones.
    if bin_residual == bin_capacity {
        score = 45.0 + (progress * 30.0);
    }

    score
}
