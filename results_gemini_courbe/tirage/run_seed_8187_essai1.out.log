 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Best-Fit Penalty: Penalize large post-residuals to favor tight packing.
    // We weight this by the total residual space to avoid creating many partially empty bins.
    score += (post_residual as f64) * 0.5;

    // 2. Lookahead matching: If the post_residual can fit the next item, heavily reward this bin.
    if next_item_size > 0 && post_residual >= next_item_size {
        // Reward is proportional to how snugly the next item would fit.
        score -= (100.0 - (post_residual - next_item_size) as f64) * 2.5;
    }

    // 3. Last-Chance Logic: If this is the only bin that can fit the current item, 
    // prioritize it heavily to avoid opening a new bin unnecessarily.
    if fitting_bins_count == 1 && bin_residual >= item_size {
        score -= 200.0;
    }

    // 4. Empty Bin Threshold: Make opening a new bin expensive unless the current 
    // alternatives are extremely poor (i.e., they result in very awkward residuals).
    if bin_residual == bin_capacity {
        score += 85.0; 
        // If we are near the end of the stream, discourage opening new bins.
        let progress = step_index as f64 / total_items as f64;
        score += progress * 50.0;
    }

    // 5. Mean residual equilibrium: Penalize bins that deviate significantly from the mean 
    // residual of currently open bins to promote uniform bin usage.
    let residual_deviation = (post_residual as f64 - mean_residual).abs();
    score += residual_deviation * 0.2;

    score
}
