 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items as f64;
    let is_new_bin = bin_residual == bin_capacity;
    
    // Base score is the post_residual (Best Fit principle)
    let mut score = post_residual as f64;

    // Penalty for opening a new bin: scales with progress to discourage early waste
    // and rewards opening new bins late in the stream if necessary.
    if is_new_bin {
        score += 15.0 + (progress * 25.0);
    }

    // Penalty for "bad" fits: If the remaining space is small but unusable,
    // we penalize it quadratically.
    if !is_new_bin && post_residual > 0 {
        let tightness = (bin_capacity - post_residual) as f64 / bin_capacity as f64;
        score += (tightness * 10.0).powf(2.0);
    }

    // Lookahead logic: If the next item exists, penalize bins that can't fit it
    // or favor bins that leave enough space for the next item.
    if next_item_size > 0 {
        if post_residual < next_item_size {
            score += 20.0 * (1.0 - progress);
        } else {
            // Reward bins that can accommodate the next item perfectly
            score -= 5.0 * (1.0 - (post_residual as f64 - next_item_size as f64) / bin_capacity as f64);
        }
    }

    // Pressure factor: if only one bin can fit the item, we are forced to use it.
    // If fitting_bins_count is low, we reduce the score to ensure we don't open a new bin.
    if !is_new_bin && fitting_bins_count == 1 {
        score -= 10.0;
    }

    // Interaction with mean_residual to keep bins balanced
    score += (post_residual as f64 - mean_residual).abs() * 0.1;

    score
}
