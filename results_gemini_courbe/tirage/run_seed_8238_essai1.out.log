 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items as f64;
    let post_res = post_residual as f64;
    
    // Base score: punish large post_residuals (Best Fit logic)
    let mut score = post_res;

    // Penalty for creating a "fragment" (a bin that is almost empty but not quite)
    // We penalize small post_residuals if they are likely to be unusable by future items.
    // If post_res is small (<10), it's a good fit, so subtract from score to reward.
    if post_res < 10.0 {
        score -= (10.0 - post_res) * 5.0;
    }

    // Dynamic adjustment based on stream progress:
    // Early in the stream, we are aggressive about packing (Best Fit).
    // Late in the stream, we become more conservative to avoid opening new bins.
    let exhaustion_factor = (1.0 - progress).powf(2.0);
    score += exhaustion_factor * (mean_residual - post_res).abs();

    // Lookahead coupling: If next_item_size is large, avoid leaving a small post_residual
    // that won't fit the next item.
    if next_item_size > 0 {
        let next_item = next_item_size as f64;
        if post_res < next_item && post_res > 0.0 {
            // Penalize small gaps that block the next item
            score += (next_item - post_res) * 2.5;
        }
    }

    // If this is a new bin (bin_residual == bin_capacity), calculate the cost of opening it.
    // We only open a new bin if the current fit is extremely poor (high post_residual).
    if bin_residual == bin_capacity {
        // High penalty for opening a new bin, scaled by how many bins are already open
        // and how much "dead space" we would create.
        score = 60.0 + (open_bins_count as f64 * 0.5) + (progress * 20.0);
    } else {
        // If it's an existing bin, reward bins that have residuals closer to the mean
        // to keep the distribution of residuals uniform.
        score += (post_res - mean_residual).powi(2) * 0.1;
    }

    score
}
