 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    // Current progress normalized [0, 1]
    let progress = step_index as f64 / total_items as f64;
    
    // Base score: prioritize smaller post-residual (Best Fit logic)
    let mut score = post_residual as f64;

    // Penalty for creating a bin that is "too empty" early on
    if bin_residual == bin_capacity {
        // We only want to open a new bin if we are forced to, or if all other bins have very poor fits.
        // We penalize the new bin based on how many other bins could have taken this item.
        score += 15.0 + (fitting_bins_count as f64 * 5.0);
        
        // As the stream progresses, make it slightly easier to open new bins to clean up fragmentation
        score -= (progress * 10.0);
    }

    // Lookahead logic: if the next item is large, avoid leaving a residual that is just slightly too small 
    // to accommodate it (e.g., residual 25 when next item is 30).
    if next_item_size > 0 {
        if post_residual < next_item_size {
            // This placement creates a "dead zone" for the next item.
            // Heavily penalize this unless the post_residual is near 0 (perfect fit).
            if post_residual > 5 {
                score += (next_item_size - post_residual) as f64 * 1.5;
            }
        } else {
            // This placement allows the next item to fit. Reward it.
            score -= (next_item_size as f64 * 0.5);
        }
    }

    // Global state awareness: 
    // If the mean residual is high, we are already fragmented. 
    // Try to pack tightly to reduce the total count.
    if mean_residual > 30.0 {
        score += post_residual as f64 * 0.2;
    }

    // Final adjustment: ensure that if a bin is a perfect fit (post_residual == 0), 
    // it always receives the highest priority (lowest score).
    if post_residual == 0 {
        score -= 50.0;
    }

    score
}
