 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    // ARCHETYPE: Harmonic classes logic
    // We prioritize Best-Fit while penalizing "fragmentation" (small residuals) 
    // unless the next item is likely to fit perfectly into the remaining space.

    let mut score = post_residual as f64;

    // 1. Penalize creating "dead space" that is too small for common items (e.g., < 20)
    // unless it's a perfect fit (post_residual == 0).
    if post_residual > 0 && post_residual < 20 {
        score += 45.0; 
    }

    // 2. Harmonic Lookahead: If the next item can fit perfectly into the post_residual,
    // we reward this placement heavily.
    if next_item_size > 0 && post_residual >= next_item_size {
        let diff = (post_residual - next_item_size) as f64;
        // Reward placements where the remaining space is exactly or closely filled by next_item
        score -= (30.0 / (1.0 + diff));
    }

    // 3. Penalty for opening a new bin prematurely: 
    // If this is a new bin (bin_residual == bin_capacity) and other bins could fit the item.
    if bin_residual == bin_capacity && fitting_bins_count > 0 {
        score += 60.0;
    }

    // 4. Harmonic Scaling: Balance against the mean residual of the system
    // to keep bins packed similarly (avoids isolated empty bins).
    let deviation = (post_residual as f64 - mean_residual).abs();
    score += deviation * 0.1;

    // 5. Progression adjustment: As the stream nears completion, become more aggressive
    // about packing into existing bins (reduce the penalty for tight fits).
    let progress = step_index as f64 / total_items as f64;
    score -= progress * 10.0;

    score
}
