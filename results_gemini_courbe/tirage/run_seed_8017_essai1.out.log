 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Harmonic Penalty: Heavily penalize residuals that are small but non-zero (fragments)
    // Especially if they cannot accommodate common item sizes.
    if post_residual > 0 && post_residual < 20 {
        score += 45.0;
    }

    // 2. Lookahead Synergy: If the next item fits into the post_residual, reward this bin.
    if next_item_size > 0 && post_residual >= next_item_size {
        score -= (next_item_size as f64) * 0.8;
    }

    // 3. New Bin Threshold: If this is an empty bin, penalize it based on how many 
    // bins are already open and the progress of the stream.
    if bin_residual == bin_capacity {
        let progress = step_index as f64 / total_items as f64;
        // Only open a new bin if the current fit quality (post_residual) of 
        // existing bins is significantly worse than the average.
        score = 25.0 + (open_bins_count as f64 * 0.5) + (progress * 10.0);
    } else {
        // 4. Fitting Pressure: If this is the only bin that can fit the item, 
        // prioritize it strongly to avoid unnecessary new bin creation.
        if fitting_bins_count == 1 {
            score -= 30.0;
        }
        
        // 5. Residual Alignment: Favor bins where the residual stays close to the 
        // global mean, preventing outlier bins with high/low waste.
        score += (post_residual as f64 - mean_residual).abs() * 0.2;
    }

    // 6. Harmonic Class Bias: Prefer residuals that are multiples of 25 (e.g., 25, 50, 75)
    // as they provide high flexibility for future items.
    if post_residual % 25 == 0 && post_residual > 0 {
        score -= 10.0;
    }

    score
}
