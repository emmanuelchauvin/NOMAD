 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Best-Fit Penalty: Minimize post_residual (Best Fit logic)
    // We prioritize bins that result in the smallest remaining space.
    
    // 2. Lookahead Coupling:
    // If the next item fits perfectly in the post_residual, drastically lower the score.
    if next_item_size > 0 && next_item_size <= post_residual {
        let fit_gap = (post_residual - next_item_size) as f64;
        score -= (100.0 - fit_gap).powf(1.5);
    }

    // 3. Global Density Balancing:
    // If we have many open bins, penalize creating a new bin unless the fit is very good.
    if bin_residual == bin_capacity {
        if open_bins_count > 0 {
            score += 45.0 + (open_bins_count as f64 * 2.5);
        }
        // Penalize opening a new bin if we are near the end of the stream
        let progress = step_index as f64 / total_items as f64;
        score += progress * 10.0;
    }

    // 4. Mean Residual Awareness:
    // Penalize bins that deviate significantly from the mean residual of currently open bins
    // to keep the packing density uniform.
    let residual_diff = (post_residual as f64 - mean_residual).abs();
    score += residual_diff * 0.5;

    // 5. Urgency Constraint:
    // If this is the only bin that can fit the item, prioritize it heavily.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 50.0;
    }

    score
}
