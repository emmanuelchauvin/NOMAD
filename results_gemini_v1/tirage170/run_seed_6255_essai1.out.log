 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Best-Fit Penalty: Penalize large residual space.
    // If post_residual is small, it's a tight fit (good).
    // If post_residual is large, it's a loose fit (bad).
    score += post_residual as f64 * 0.5;

    // 2. Harmonic Class Logic:
    // Favor placements that leave a residual which is a multiple of common item sizes (e.g., 20, 25).
    // This creates "bins of specific types" to increase packing density.
    let harmonic_penalty = (post_residual % 20) as f64 * 1.5;
    score += harmonic_penalty;

    // 3. Lookahead Integration:
    // If next_item_size is large, we want to preserve space in current bins.
    // If next_item_size is small, we can afford a tighter fit now.
    if next_item_size > 0 {
        if post_residual < next_item_size {
            // Penalize if the next item won't fit here, but only if we have many open bins.
            score += (next_item_size - post_residual) as f64 * 0.8;
        } else {
            // Reward if the next item fits perfectly.
            score -= (100 - (post_residual - next_item_size)) as f64 * 0.2;
        }
    }

    // 4. New Bin Threshold:
    // Discourage opening a new bin unless the current fit is extremely poor.
    if bin_residual == bin_capacity {
        // High penalty for opening a new bin unless we are constrained.
        score += 45.0 + (open_bins_count as f64 * 2.0);
    }

    // 5. Packing Density Optimization:
    // If this is the last chance for the current item (fitting_bins_count == 1),
    // prioritize filling it to avoid leaving the bin partially empty forever.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 20.0;
    }

    // 6. Global Trend adjustment:
    // As we approach the end of the stream, prioritize closing bins.
    let progress = step_index as f64 / total_items as f64;
    score += progress * mean_residual * 0.1;

    score
}
