 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Harmonic Penalty: Heavily penalize residuals that are small but non-zero (fragments)
    // if the remaining space is too small to fit common item sizes.
    if post_residual > 0 && post_residual < 20 {
        score += 45.0;
    }

    // 2. Lookahead Synergy: If the next item can fit in the post_residual, reward this bin.
    if next_item_size > 0 && post_residual >= next_item_size {
        score -= 25.0;
    }

    // 3. Fragmentation Control: If this is the last fitting bin, penalize opening a new bin
    // by making the current bin's score very attractive (unless the residual is disastrous).
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 30.0;
    }

    // 4. Harmonic Density: Favor bins that leave residuals closer to common multiples (e.g., 25, 50).
    // This helps keep bins "aligned" for future items.
    let remainder = post_residual % 25;
    score += (remainder as f64) * 0.8;

    // 5. New Bin Aversion: Penalize opening a new bin (bin_residual == bin_capacity)
    // unless the current state is highly fragmented.
    if bin_residual == bin_capacity {
        score += 20.0 + (open_bins_count as f64 * 0.5);
    }

    // 6. Global Pressure: As we approach the end of the stream, prioritize efficiency over future-proofing.
    let progress = step_index as f64 / total_items as f64;
    score += progress * 10.0;

    score
}
