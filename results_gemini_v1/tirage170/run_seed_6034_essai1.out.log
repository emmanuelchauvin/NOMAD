 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    // Objective: Minimize score.
    // Heuristic: Best-Fit Decreasing logic combined with lookahead-based space preservation.
    
    let mut score = post_residual as f64;

    // 1. Penalize opening a new bin heavily unless necessary
    if bin_residual == bin_capacity {
        if open_bins_count > 0 {
            score += 50.0; // Resistance to opening new bins
        }
    }

    // 2. Lookahead: If next_item_size fits in the remaining space, prioritize this bin
    if next_item_size > 0 && next_item_size <= post_residual {
        score -= 25.0; // Strong reward for preserving space for the next item
    }

    // 3. Penalty for "fragmentation": If post_residual is small but > 0, it's often unusable.
    // We prefer post_residual to be either 0 or large enough to fit future items.
    if post_residual > 0 && post_residual < 20 {
        score += 15.0; 
    }

    // 4. If this is the only bin that fits, we must take it (lower score)
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 40.0;
    }

    // 5. Dynamic balancing: If we are late in the stream, favor tighter packing (lower mean_residual)
    let progress = step_index as f64 / total_items as f64;
    if post_residual < (mean_residual as u32) {
        score -= 5.0 * progress;
    }

    score
}
