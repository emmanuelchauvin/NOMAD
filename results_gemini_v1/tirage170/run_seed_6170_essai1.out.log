 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items as f64;
    let is_new_bin = bin_residual == bin_capacity;
    
    // Base score: prioritize tighter fits (Best Fit principle).
    let mut score = post_residual as f64;

    // Penalty for opening a new bin: proportional to progress (late game, favor consolidation).
    if is_new_bin {
        score += 15.0 + (progress * 25.0);
        // If we have many open bins, penalize opening more heavily.
        score += open_bins_count as f64 * 2.0;
    } else {
        // Lookahead heuristic: If next item is large, avoid leaving tiny gaps.
        if next_item_size > 0 {
            if post_residual < next_item_size && post_residual > 0 {
                // Penalize "stranded" space that cannot fit the next item.
                score += (next_item_size - post_residual) as f64 * 0.8;
            }
        }
        
        // Reward creating "perfect" fits (residual 0) or "useful" fits (residual >= 20).
        if post_residual == 0 {
            score -= 10.0;
        } else if post_residual >= 20 {
            score -= 5.0;
        }
    }

    // Dynamic adjustment based on global state:
    // If we are late in the stream, be more aggressive about packing tightly.
    if progress > 0.8 {
        score += (post_residual as f64) * 0.5;
    }

    // If this is the only bin that fits, prioritize it heavily to avoid unnecessary new bins.
    if fitting_bins_count == 1 && !is_new_bin {
        score -= 20.0;
    }

    score
}
