 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    // Basic Best-Fit strategy: prioritize smaller post_residual
    let mut score = post_residual as f64;

    // Penalty for creating a "fragmented" bin: if post_residual is too small to fit typical future items
    // (assuming mean item size is ~40-50 based on range 10-80), penalize residuals < 20.
    if post_residual > 0 && post_residual < 20 {
        score += 35.0;
    }

    // Lookahead logic: if the next item fits into the current post_residual, prioritize this bin strongly.
    if next_item_size > 0 && post_residual >= next_item_size {
        score -= 25.0;
    }

    // Global state awareness: if we are late in the stream, be more aggressive about filling bins
    // even if it creates small residuals, to avoid leaving too many bins partially empty.
    let progress = step_index as f64 / total_items as f64;
    score -= progress * 10.0;

    // Penalty for opening a new bin: only open if the current fit is extremely poor 
    // or if the item is large and we have high fragmentation.
    if bin_residual == bin_capacity {
        if fitting_bins_count > 0 {
            // Penalize opening a new bin if other options exist, unless the bin is very large.
            score += 45.0 + (item_size as f64 * 0.5);
        }
    }

    // Balance the mean residual: discourage bins that deviate significantly from the current mean
    // to keep the bin distribution uniform.
    let deviation = (post_residual as f64 - mean_residual).abs();
    score += deviation * 0.1;

    // Final adjustment: prioritize bins that are "almost full" to clear them out
    if post_residual < 10 {
        score -= 15.0;
    }

    score
}
