 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Penalty for creating a "small" residual that is unlikely to fit future items.
    // If post_residual is small but > 0, it's often a "dead space" trap.
    if post_residual > 0 && post_residual < 20 {
        score += 45.0;
    }

    // Harmonic/Modulo logic: prioritize leaving space that is a multiple of 25 or 33
    // to accommodate common item size clusters.
    let harmonic_mod = (post_residual % 25) as f64;
    score += harmonic_mod * 0.8;

    // Lookahead logic: if next_item_size fits in the post_residual, reward this placement.
    if next_item_size > 0 && next_item_size <= post_residual {
        score -= 50.0;
    }

    // If this is a new bin (bin_residual == bin_capacity), penalize it based on 
    // the current density of open bins. We only want to open a new bin if 
    // the existing bins are already too fragmented.
    if bin_residual == bin_capacity {
        score += 35.0; 
        score += (open_bins_count as f64) * 2.0;
        score -= (mean_residual * 0.5);
    }

    // Favor bins that have a residual closest to the average to keep them uniform,
    // which helps in balancing the capacity for future incoming items.
    let deviation = (post_residual as f64 - mean_residual).abs();
    score += deviation * 0.2;

    // If this is the only fitting bin, we are forced to use it. Lower the score
    // to ensure we don't open a new bin unnecessarily.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 20.0;
    }

    // Progression awareness: towards the end of the stream, prioritize packing tighter.
    let progress = step_index as f64 / total_items as f64;
    score += progress * 10.0;

    score
}
