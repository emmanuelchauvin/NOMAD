 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    // Heuristic #146: Harmonic Residual Optimization
    // Penalize small residuals (splinters) that cannot fit common item sizes.
    // Reward bins that align with the next item size to maximize packing density.
    
    let mut score = post_residual as f64;

    // 1. Splinter Penalty: If post_residual is too small to fit a common item (e.g., < 20),
    // heavily penalize it unless it is exactly 0 (perfect fit).
    if post_residual > 0 && post_residual < 20 {
        score += 45.0; 
    }

    // 2. Harmonic Alignment: Reward residuals that are multiples of common item sizes (e.g., 25, 33, 50).
    // This creates "bins of harmony" that are more likely to accept future items.
    if post_residual % 25 == 0 {
        score -= 10.0;
    }

    // 3. Lookahead Synergy: If the next item fits perfectly into the remaining space, 
    // highly prioritize this bin.
    if next_item_size > 0 && post_residual >= next_item_size {
        let fit_diff = (post_residual - next_item_size) as f64;
        score -= (50.0 - fit_diff).max(0.0);
    }

    // 4. Density Balancing: If we have many open bins, penalize opening a new bin (residual == capacity).
    if bin_residual == bin_capacity && open_bins_count > 0 {
        score += 35.0 + (open_bins_count as f64 * 2.0);
    }

    // 5. Last Chance Logic: If this is the only bin that can fit the item, 
    // force selection (reduce score significantly).
    if fitting_bins_count == 1 && bin_residual >= item_size {
        score -= 60.0;
    }

    // 6. Progression Scaling: As the stream nears the end, prioritize closing bins
    // by penalizing empty space more aggressively.
    let progress = step_index as f64 / total_items as f64;
    score += (progress * 20.0);

    score
}
