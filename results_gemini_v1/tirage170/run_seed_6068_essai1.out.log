 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Harmonic Penalty: Heavily penalize residuals that are small but non-zero (Fragmenting)
    // We favor residuals that are either 0 (perfect fit) or large enough to accommodate the next item.
    if post_residual > 0 {
        if next_item_size > 0 && post_residual < next_item_size {
            score += 50.0; // Penalty for creating a bin that cannot fit the immediate future item
        }
        
        // Harmonic-like preference: favor residuals that are multiples of common item sizes (e.g., 20, 25, 33)
        // This encourages leaving "clean" remainder blocks for future items.
        let remainder_mod = post_residual % 25;
        score += remainder_mod as f64 * 0.5;
    }

    // 2. Capacity Normalization: If this is an empty bin (new bin candidate)
    if bin_residual == bin_capacity {
        // Only open a new bin if the mean residual of existing bins is already tight (low flexibility)
        // or if no fitting bins exist.
        if fitting_bins_count > 0 {
            score += (100.0 - mean_residual) * 0.8;
        } else {
            score -= 10.0; // Preference for opening a bin if it's the only option
        }
    }

    // 3. Lookahead/Density Balancing
    // As the stream progresses, prioritize tight packing (Best Fit) to avoid bin sprawl.
    let progress = step_index as f64 / total_items as f64;
    if next_item_size > 0 && post_residual >= next_item_size {
        score -= (1.0 - progress) * 20.0; // Reward bins that can accommodate the next item early on
    }

    // 4. Fitting Constraint
    // If this bin is the last chance for the item, prioritize it to avoid opening a new bin unnecessarily.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 40.0;
    }

    score
}
