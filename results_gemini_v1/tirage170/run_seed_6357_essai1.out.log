 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Penalty for creating "dead space": small residuals that are unlikely to fit future items.
    // We prioritize bins that leave a post_residual of 0 (perfect fit) or a large enough 
    // residual to accommodate at least one more item from the common distribution.
    if post_residual > 0 && post_residual < 20 {
        score += 45.0; 
    }

    // Lookahead logic: If a future item exists, prefer bins where the post_residual 
    // can accommodate the next_item_size.
    if next_item_size > 0 {
        if post_residual >= next_item_size {
            score -= 30.0;
        } else {
            // If we can't fit the next item, penalize if we had other options.
            score += 15.0;
        }
    }

    // Harmonic class logic: Bias towards filling bins to capacity to minimize the 
    // total number of bins. If this is the last chance for the current bin (fitting_bins_count == 1),
    // we are more lenient, but still prefer keeping the mean_residual low.
    if fitting_bins_count == 1 && post_residual > 0 {
        score += (post_residual as f64) * 0.5;
    }

    // Threshold logic: If we are near the end of the stream, prioritize closing bins 
    // over perfect packing to reduce the final open_bins_count.
    let progress = step_index as f64 / total_items as f64;
    if progress > 0.9 {
        score -= (bin_capacity - post_residual) as f64 * 0.2;
    }

    // New-bin candidate handling: Ensure opening a new bin is only done when 
    // existing bins are poor fits (post_residual is small but not zero).
    if bin_residual == bin_capacity {
        score += 35.0; 
    }

    score
}
