 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items.max(1) as f64;
    let post = post_residual as f64;
    
    // Penalize "stranded" space: if the remaining space is too small to fit typical future items
    // (approximated by the current item_size and next_item_size), punish it exponentially.
    let min_future = if next_item_size > 0 { item_size.min(next_item_size) } else { item_size };
    let waste_penalty = if post > 0.0 && post < min_future as f64 {
        (min_future as f64 - post).powi(2) * 2.5
    } else {
        0.0
    };

    // Reward tighter fits (Best Fit principle)
    let fit_score = post.powi(2) * 0.1;

    // Lookahead logic: if we have few bins fitting the item, prioritize preserving them
    // unless the current fit is excellent.
    let scarcity_penalty = if fitting_bins_count <= 1 { -5.0 } else { 0.0 };

    // Dynamic thresholding based on stream progress: 
    // Be more conservative (avoid opening new bins) as we approach the end of the stream.
    let is_new_bin = bin_residual == bin_capacity;
    let progress_bias = if is_new_bin {
        (1.0 - progress) * 20.0 + (open_bins_count as f64 * 0.5)
    } else {
        0.0
    };

    // Combine factors
    let score = fit_score + waste_penalty + scarcity_penalty + progress_bias;

    score
}
