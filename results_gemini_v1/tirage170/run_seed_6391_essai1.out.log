 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Reward perfect fits (Best Fit strategy)
    if post_residual == 0 {
        score -= 500.0;
    }

    // 2. Penalty for creating "dead space" (small fragments < 10 are hard to fill)
    if post_residual > 0 && post_residual < 10 {
        score += 150.0;
    }

    // 3. Aggressive 2-step lookahead: Favor placing if post_residual fits the next item
    if next_item_size > 0 && post_residual >= next_item_size {
        score -= 200.0;
        // Further reward if it creates a near-perfect fit for the next item
        if (post_residual - next_item_size) < 5 {
            score -= 150.0;
        }
    }

    // 4. Global balance: If this bin is the last chance for the current item, 
    // prioritize it to avoid opening unnecessary new bins.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 100.0;
    }

    // 5. Penalize opening a new bin if we have many empty/under-utilized bins
    if bin_residual == bin_capacity && open_bins_count > 0 {
        let progress = step_index as f64 / total_items as f64;
        // Late game: be more aggressive about opening bins if necessary, 
        // early game: be conservative.
        score += 100.0 * (1.0 - progress);
        score += mean_residual * 0.5;
    }

    // 6. Penalty for creating a bin that deviates significantly from the mean residual
    // (Keeps bin usage uniform)
    let residual_diff = (post_residual as f64 - mean_residual).abs();
    score += residual_diff * 0.2;

    score
}
