 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    // The goal is to minimize score.
    // Base score is the post_residual (Best Fit principle).
    let mut score = post_residual as f64;

    // Harmonic/Modulo logic: Penalize residuals that cannot easily accommodate standard item sizes.
    // We treat post_residual as a potential "dead zone". 
    // If post_residual is in (0, 20), it is very likely to become stranded/wasted space.
    if post_residual > 0 && post_residual < 20 {
        score += 45.0;
    }

    // Lookahead logic: If a next_item exists, prioritize bins where the post_residual 
    // can accommodate the next item.
    if next_item_size > 0 {
        if post_residual >= next_item_size {
            score -= 30.0;
        }
    }

    // Harmonic class logic: Favor bins that leave a residual which is a multiple of 25 (e.g., 0, 25, 50, 75).
    // These are "clean" residuals that fit many common item sizes.
    if post_residual % 25 == 0 {
        score -= 15.0;
    }

    // Multi-bin pressure: If we have many open bins, penalize opening a new one 
    // (where bin_residual == bin_capacity) to force consolidation.
    if bin_residual == bin_capacity {
        if open_bins_count > 0 {
            score += 50.0 + (open_bins_count as f64 * 2.0);
        }
    }

    // Scarcity adjustment: If only one bin can fit the item, we are forced to use it
    // unless we open a new one. We make existing bins very attractive here.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 20.0;
    }

    // Progression scaling: As we approach the end of the stream, be more aggressive
    // about filling bins to reduce total count.
    let progress = step_index as f64 / total_items as f64;
    score += progress * 10.0;

    score
}
