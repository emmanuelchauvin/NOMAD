 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items as f64;
    let is_new_bin = bin_residual == bin_capacity;
    
    // Base score: We prefer smaller post-residuals (Best Fit logic)
    let mut score = post_residual as f64;

    // Penalty for creating a new bin: Only open if we absolutely have to or if 
    // the current bin space is extremely fragmented.
    if is_new_bin {
        if fitting_bins_count > 0 {
            // Penalize opening a new bin if other bins can fit the item.
            // The penalty scales with progress to allow more flexibility early on.
            score += 40.0 * (1.0 - progress * 0.5);
        }
    } else {
        // Lookahead heuristic: If the next item is large, avoid leaving a residual
        // that is too small to fit the next item (Dead Space avoidance).
        if next_item_size > 0 && post_residual < next_item_size {
            score += 25.0 * (1.0 - (post_residual as f64 / 100.0));
        }

        // Global state awareness: If the current bin is significantly "emptier" than 
        // the average, we prefer filling it to keep the average residual low.
        let deviation = (bin_residual as f64 - mean_residual).abs();
        if bin_residual > mean_residual as u32 {
            score -= deviation * 0.2;
        }
    }

    // Tight fit incentive: If post_residual is near zero, reward it heavily
    // to promote "Perfect Fit" packing.
    if post_residual < 5 {
        score -= 15.0;
    }

    // Constraint: Ensure we don't return negative infinity; keep relative to capacity.
    score
}
