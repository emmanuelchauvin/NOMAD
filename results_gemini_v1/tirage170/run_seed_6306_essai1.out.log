 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Penalty for creating 'fragmented' space that is too small for common item sizes
    // If post_residual is small but not zero, it's often a dead-end.
    if post_residual > 0 && post_residual < 20 {
        score += 45.0;
    }

    // Harmonic-inspired incentive: favor residuals that are multiples of common item sizes
    // This encourages keeping space open for future items that might fit perfectly
    if post_residual % 25 == 0 {
        score -= 15.0;
    }

    // Lookahead logic: if next_item_size fits in this post_residual, reward this bin
    if next_item_size > 0 && post_residual >= next_item_size {
        score -= 25.0;
    }

    // If this is the only bin that can fit the item, we are forced to take it.
    // However, if fitting_bins_count is 0, we are evaluating a new bin.
    if bin_residual == bin_capacity {
        // Penalty for opening a new bin: base cost + adjustment for current open bin density
        score = 85.0 + (open_bins_count as f64 * 0.5);
    } else if fitting_bins_count == 1 {
        // High priority to use the last chance bin to avoid opening new ones
        score -= 30.0;
    }

    // Calibration based on progression: as we near the end of the stream, 
    // prioritize tighter packing (lower residuals) more aggressively.
    let progress = step_index as f64 / total_items as f64;
    score += progress * 10.0;

    // Penalty for deviating from the mean residual (encourages uniform filling)
    let residual_diff = (post_residual as f64 - mean_residual).abs();
    score += residual_diff * 0.2;

    score
}
