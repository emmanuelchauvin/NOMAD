 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Best-Fit Penalty: Penalize large post_residuals to favor tight packing.
    // We prioritize bins that leave the smallest residual space.
    score += (post_residual as f64).powf(1.1);

    // 2. Lookahead Synergy: If the next item fits into the current post_residual, 
    // strongly reward this bin. This is the core 2-step matching logic.
    if next_item_size > 0 && post_residual >= next_item_size {
        score -= (next_item_size as f64) * 2.5;
        
        // Reward bins that become "perfect" matches for the next item
        if post_residual == next_item_size {
            score -= 20.0;
        }
    }

    // 3. New Bin Thresholding: Prevent opening a new bin unless existing options 
    // are truly poor (e.g., they create large unusable gaps).
    if bin_residual == bin_capacity {
        // Only open a new bin if the mean residual is already quite high, 
        // suggesting existing bins are mostly 'fragmented'.
        if mean_residual < 20.0 {
            score += 50.0; // Heavy penalty for opening a new bin prematurely
        } else {
            score -= 10.0; // Reward opening a new bin if existing ones are poor fits
        }
    }

    // 4. Scarcity Penalty: If this is the only bin that can fit the current item, 
    // prioritize using it to keep the bin count low.
    if fitting_bins_count == 1 {
        score -= 15.0;
    }

    // 5. Global Efficiency Adjustment: As the stream nears completion, 
    // become more aggressive about filling existing gaps.
    let progress = step_index as f64 / total_items as f64;
    score += progress * (post_residual as f64) * 0.5;

    score
}
