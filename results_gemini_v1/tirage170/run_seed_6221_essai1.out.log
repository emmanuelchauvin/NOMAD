 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    // Objective: Minimize score to place item.
    // post_residual: 0..90. Lower is better (Best Fit).
    
    let mut score = post_residual as f64;
    let progress = step_index as f64 / total_items as f64;

    // Penalty for creating 'orphaned' space: if post_residual is small but > 0, 
    // it effectively kills the bin for large future items. 
    // We penalize values that cannot fit the mean item size (approx 40-50).
    if post_residual > 0 && post_residual < 20 {
        score += 35.0 * (1.0 - progress);
    }

    // Lookahead logic: If next item is large, favor bins that can still accommodate it.
    if next_item_size > 0 {
        if post_residual >= next_item_size {
            score -= 15.0; // Reward bin that can house next item
        } else if post_residual < next_item_size && post_residual > 0 {
            score += 10.0; // Penalize bin that 'blocks' the next item
        }
    }

    // New bin logic: Only open a new bin if the current fit is extremely poor (residual > 60)
    // or if we are nearing the end of the stream and fitting_bins_count is low.
    if bin_residual == bin_capacity {
        if fitting_bins_count > 0 {
            // High penalty for opening new bin if existing ones can fit
            score = 100.0 + (50.0 * (1.0 - progress));
        } else {
            // Neutral score for forced new bin
            score = 40.0;
        }
    } else {
        // Encourage balanced usage: penalize bins that deviate significantly from mean_residual
        let deviation = (post_residual as f64 - mean_residual).abs();
        score += 0.2 * deviation;
    }

    // Final scaling based on remaining capacity in the system
    score += (open_bins_count as f64 * 0.5);

    score
}
