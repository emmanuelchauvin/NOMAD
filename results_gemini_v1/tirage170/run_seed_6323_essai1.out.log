 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Best-Fit Penalty: Penalize large residual, but reward tight fits (Best-Fit principle)
    // We favor post_residual being as close to 0 as possible.
    score += post_residual as f64 * 1.5;

    // 2. Lookahead Logic: If the next item can fit in the current post_residual, prioritize this bin.
    if next_item_size > 0 && next_item_size <= post_residual {
        score -= (next_item_size as f64) * 2.2;
    }

    // 3. Harmonic Class Logic: Reward placements that leave residuals that are multiples of common item sizes (e.g., 20, 25, 33).
    // This reduces fragmentation by creating "standardized" remaining space.
    let remainder_mod = post_residual % 20;
    if remainder_mod == 0 {
        score -= 10.0;
    } else {
        score += remainder_mod as f64 * 0.5;
    }

    // 4. New Bin Thresholding: Prevent opening a new bin unless the fit is extremely poor.
    // If this is a new bin (bin_residual == bin_capacity), apply a heavy penalty.
    if bin_residual == bin_capacity {
        // Only open a new bin if we have many open bins already or if the fit is truly bad.
        score += 45.0; 
        
        // Dynamic threshold: If we are near the end of the stream, discourage new bins.
        let progress = step_index as f64 / total_items as f64;
        score += progress * 20.0;
    }

    // 5. Fitting Density: If this is the only bin that can fit the item, prioritize it.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 30.0;
    }

    // 6. Mean Residual Balancing: Avoid bins that deviate significantly from the mean residual.
    let residual_diff = (post_residual as f64 - mean_residual).abs();
    score += residual_diff * 0.2;

    score
}
