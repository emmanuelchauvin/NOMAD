 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    // Objective: Minimize score. Lower score = better bin choice.
    
    let is_new_bin = bin_residual == bin_capacity;
    let progress = step_index as f64 / total_items as f64;
    
    // 1. Base cost: The tighter the fit, the better (Best-Fit principle).
    let mut score = post_residual as f64;

    // 2. Penalty for opening new bins: Only do it if forced or if the fit is extremely poor elsewhere.
    if is_new_bin {
        // Only consider a new bin if we have many items left or if open bins are already highly fragmented.
        score += 45.0 * (1.0 - progress);
        if fitting_bins_count > 0 {
            score += 60.0; // Strong penalty for opening a new bin if an existing one works.
        }
    } else {
        // 3. Lookahead Logic: If the next item is large, favor bins that can accommodate it.
        if next_item_size > 0 {
            if post_residual >= next_item_size {
                score -= 15.0; // Reward: This bin can fit the next item too.
            } else if post_residual > 0 && post_residual < 20 {
                score += 25.0; // Penalty: Creating 'dead space' that is too small for common items.
            }
        }
    }

    // 4. Global State awareness: If we have many open bins, prioritize consolidating into existing ones.
    if open_bins_count > 5 {
        score -= (open_bins_count as f64) * 0.5;
    }

    // 5. Fragmentation management: Avoid bins that deviate significantly from the mean residual.
    let dev = (post_residual as f64 - mean_residual).abs();
    score += dev * 0.2;

    // 6. Last-chance logic: If this is the only bin that fits, prioritize it heavily.
    if fitting_bins_count == 1 && !is_new_bin {
        score -= 50.0;
    }

    score
}
