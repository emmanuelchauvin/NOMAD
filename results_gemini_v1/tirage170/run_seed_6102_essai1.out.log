 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    // Objective: Minimize score.
    // Strategy: Favor Best-Fit (small post_residual), but apply a penalty to "dead space"
    // that cannot accommodate the next_item_size.
    
    let is_new_bin = bin_residual == bin_capacity;
    let mut score = post_residual as f64;

    if is_new_bin {
        // Penalty for opening a new bin: base cost is high to force existing bin usage.
        // We scale the penalty by the current open_bins_count to encourage consolidation.
        score = 45.0 + (open_bins_count as f64 * 2.5);
    } else {
        // 1. Penalty for creating "dead space": if post_residual is smaller than next_item_size,
        // it is likely to remain unused for at least one more step.
        if next_item_size > 0 && post_residual < next_item_size {
            score += (next_item_size - post_residual) as f64 * 1.2;
        }

        // 2. Convergence pressure: As we approach the end of the stream, prioritize 
        // filling bins completely to avoid leaving stragglers.
        let progress = step_index as f64 / total_items as f64;
        score += progress * (post_residual as f64 * 0.5);

        // 3. Balance incentive: If this bin's residual is significantly lower than the 
        // global mean_residual, it is a "tight" bin. We prefer to keep it tight.
        if (post_residual as f64) < mean_residual {
            score -= (mean_residual - post_residual as f64) * 0.8;
        }
    }

    // 4. Critical threshold: If this is the only fitting bin, heavily discount the score
    // to prevent opening a new bin unnecessarily (Best-Fit policy).
    if fitting_bins_count == 1 && !is_new_bin {
        score -= 20.0;
    }

    score
}
