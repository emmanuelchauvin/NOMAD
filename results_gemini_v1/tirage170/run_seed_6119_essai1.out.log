 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Harmonic Penalty: Penalize residuals that are small but not zero (fragmentation)
    // We favor "perfect fits" (post_residual == 0) and "large remainders" (leaving room for large items)
    if post_residual > 0 && post_residual < 20 {
        score += 25.0; // Heavy penalty for creating small, unusable slivers
    }

    // 2. Lookahead Synergy: If the next item fits into the current post_residual, reward this bin
    if next_item_size > 0 && post_residual >= next_item_size {
        score -= 15.0; 
    }

    // 3. Density Management: If fitting_bins_count is 1, we are at a critical decision point.
    // If the post_residual is too small for the next item, we penalize keeping this bin to force 
    // a new bin creation if it allows better packing for the next_item_size.
    if fitting_bins_count == 1 && next_item_size > post_residual && next_item_size > 0 {
        score += 10.0;
    }

    // 4. Harmonic Scaling: Penalize bins that deviate significantly from the mean_residual
    // This encourages filling bins at a similar rate, keeping the "wavefront" of bin residuals flat.
    let residual_diff = (post_residual as f64 - mean_residual).abs();
    score += residual_diff * 0.1;

    // 5. New Bin Thresholding: If this is an empty bin (bin_residual == bin_capacity),
    // set a baseline "cost" to open a new bin. This is the threshold for "Best Fit" vs "New Bin".
    if bin_residual == bin_capacity {
        // We only open a new bin if the current best existing bin is truly terrible (score > 40)
        score = 40.0;
    }

    // 6. Progression Bias: As the stream nears the end, prioritize tight packing (lower residuals)
    let progress = step_index as f64 / total_items as f64;
    score += progress * 5.0;

    score
}
