 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items as f64;
    
    // Base score: Favor tight fit (Best Fit)
    let mut score = post_residual as f64;

    if bin_residual == bin_capacity {
        // Refined threshold for new bins:
        // Increase penalty to prevent premature bin creation, but allow it if mean_residual is low (packing is loose).
        score += 155.0 + (mean_residual * 1.8) + (progress * 25.0);
    } else {
        // Targeted sliver penalty: strictly avoid creating space smaller than common item lower-bounds.
        if post_residual > 0 && post_residual < 22 {
            score += 52.0 * (1.0 - (progress * 0.3));
        }

        // Lookahead: If next_item_size fits perfectly, prioritize that bin to reduce fragmentation.
        if next_item_size > 0 {
            if post_residual >= next_item_size {
                score -= 35.0;
            }
            let diff = (post_residual as i32 - next_item_size as i32).abs() as f64;
            score += diff * 0.75;
        }

        // Priority for constrained bins: If only one bin works, prioritize it to conserve capacity.
        if fitting_bins_count == 1 {
            score -= 135.0;
        }

        // Adaptive packing: 
        // Early: favor bins that leave larger space for future large items.
        // Late: pack as tightly as possible to close bins.
        if progress < 0.4 {
            score += (35.0 - post_residual as f64).max(0.0) * 1.5;
        } else {
            score -= (bin_capacity - post_residual) as f64 * 0.35;
        }

        // Entropy control: Consolidate if too many bins are open.
        if open_bins_count > 6 {
            score += (post_residual as f64) * 0.8;
        }
        
        // Variance dampening: Strongly reward near-perfect packing.
        if post_residual < 4 {
            score -= 28.0;
        }

        // Harmonic alignment: Penalize residuals that don't fit into common 25-unit blocks.
        score += ((post_residual % 25) as f64) * 0.4;
    }

    score
}
