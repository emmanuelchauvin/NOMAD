 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;
    let progress = step_index as f64 / total_items as f64;
    let remaining = (total_items - step_index) as f64;

    // 1. Refined New Bin Penalty:
    // Increased base cost to force tighter packing in existing bins.
    if bin_residual == bin_capacity {
        score += 58.0 + (progress * 42.0) + (open_bins_count as f64 * 3.2);
    }

    // 2. Dynamic Dead Zone Mitigation (Refined):
    // Stronger penalty for small residuals that prevent future placement of medium-sized items.
    if post_residual > 0 && post_residual < 24 {
        score += 32.0 - (post_residual as f64 * 1.1);
    }

    // 3. Lookahead Integration:
    // Prioritize bins that leave a residual capable of swallowing the next item perfectly.
    if next_item_size > 0 {
        if post_residual >= next_item_size {
            let gap = post_residual - next_item_size;
            // Best Fit Lookahead: Reward tight fit (gap == 0) exponentially more.
            score -= 18.0 + (10.0 / (1.0 + gap as f64));
        } else if post_residual > 0 {
            score += 12.0;
        }
    }

    // 4. Density Balancing:
    // Favor bins that are already "near full" to reduce the number of active bins.
    if (bin_residual as f64) < mean_residual {
        score -= 12.0;
    } else if post_residual > 0 {
        score += 5.0;
    }

    // 5. Scarcity Logic:
    // Stronger gravity toward bins that are the unique fit for the current item.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 72.0;
    }

    // 6. Global Fragmentation Control (Adjusted):
    // Scale penalty by the ratio of open bins to remaining items to prevent premature bin explosion.
    let consolidation_factor = (open_bins_count as f64) * (3.5 + (remaining / total_items as f64 * 4.0));
    score += consolidation_factor;

    // 7. Residual Variance Dampener:
    // Penalize extreme residual outliers to keep the distribution of bin usage uniform.
    let residual_diff = (bin_residual as f64 - mean_residual).abs();
    score += residual_diff * 0.15;

    score
}
