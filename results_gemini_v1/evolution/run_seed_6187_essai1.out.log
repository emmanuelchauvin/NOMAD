 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Penalize opening new bins unless necessary (fitting_bins_count == 0)
    if bin_residual == bin_capacity {
        if fitting_bins_count > 0 {
            score += 200.0; // High penalty for opening a new bin unnecessarily
        } else {
            score -= 50.0;  // Reward opening a new bin if nothing else fits
        }
    }

    // 2. Lookahead optimization: If next_item fits perfectly in the post_residual, prioritize this bin
    if next_item_size > 0 {
        if post_residual == next_item_size {
            score -= 40.0;
        } else if post_residual > next_item_size {
            // Penalize large gaps that could have been filled by the next item
            score += (post_residual - next_item_size) as f64 * 0.5;
        } else {
            // Penalize creating a bin that is too small for the next item
            score += 10.0;
        }
    }

    // 3. Balance: Encourage filling bins close to the global mean to avoid stragglers
    let deviation = (post_residual as f64 - mean_residual).abs();
    score += deviation * 0.2;

    // 4. Pressure: As we approach the end of the stream, prioritize tighter packing
    let progress = step_index as f64 / total_items as f64;
    score += (1.0 - progress) * (post_residual as f64 * 0.1);

    // 5. Prefer bins that are already partially filled (Best-Fit principle)
    // Avoid creating "islands" of empty space
    if bin_residual < bin_capacity {
        score -= (bin_capacity - bin_residual) as f64 * 0.1;
    }

    score
}
