 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items as f64;
    let post = post_residual as f64;
    let is_new_bin = bin_residual == bin_capacity;

    // Use a slightly lower exponent for post_residual to allow for more flexible packing 
    // early in the process, while maintaining a strong penalty for large remaining gaps.
    let mut score = post.powf(1.25);

    if is_new_bin {
        // Adjusted base cost to be more conservative with bin openings.
        // We incorporate a dynamic factor that considers the ratio of items left to open bins.
        let density_factor = (total_items - step_index) as f64 / (open_bins_count.max(1) as f64 * 10.0);
        score = 24.5 + (mean_residual * 0.65) + (open_bins_count as f64 * 0.15) - (density_factor * 0.5);
        
        if fitting_bins_count == 0 {
            score -= 135.0; // Stronger incentive to open new bins only when strictly necessary
        }
        
        score += progress * 60.0; // Aggressive terminal consolidation
    } else {
        // Fragment Penalty: Refined to identify "near-dead" space more effectively
        if post > 0.0 && post < (mean_residual * 0.45) {
            score += (mean_residual - post).powf(1.6) * 7.5;
        }

        // Adaptive Lookahead: Increased sensitivity to fit the next item precisely
        if next_item_size > 0 {
            if post >= next_item_size as f64 {
                // Reward configurations that keep the residual close to the next item's size
                let leftover = post - next_item_size as f64;
                score -= 52.0 - (leftover * 0.5);
            } else if post > 0.0 {
                // Heavier penalty for blocking the next item
                score += (next_item_size as f64 - post) * 5.5; 
            }
        }

        // Scarcity Logic: Higher priority for bins that are the only viable candidates
        if fitting_bins_count == 1 {
            score -= 125.0;
        }
        
        // Global Balance: Tighter control over variance, especially as total_items increases
        score += (post - mean_residual).abs() * 1.4;
        
        // Terminal phase: Stronger bias to finish existing bins
        score -= progress * 35.0;
    }

    score
}
