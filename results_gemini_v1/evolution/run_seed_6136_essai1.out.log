 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let post = post_residual as f64;
    let is_new_bin = bin_residual == bin_capacity;
    
    // Base score: punish large residual gaps with a sharper exponential curve
    // to force tighter packing into existing bins.
    let mut score = post.powf(1.82);

    // 1. Adaptive Dead Space Penalty
    // Refined: specifically target "islands" that block the next item.
    if post_residual > 0 && post_residual < next_item_size {
        score += 48.0 + (next_item_size as f64 - post_residual as f64).powf(1.1) * 3.2;
    }

    // 2. Dynamic New Bin Thresholding
    if is_new_bin {
        // Factor in the average residual to estimate if the current state is overcrowded.
        let density_factor = (bin_capacity as f64 - mean_residual) / bin_capacity as f64;
        score += 72.0 + (open_bins_count as f64).sqrt() * 14.5 + (density_factor * 20.0);
    } else {
        // 3. Fitting Priority
        // Heavily incentivize using the only available bin for this item.
        if fitting_bins_count == 1 {
            score -= 68.0;
        }

        // 4. Lookahead optimization
        // Reward bins that can accommodate the next item, scaling by relative bin fullness.
        if next_item_size > 0 && post_residual >= next_item_size {
            let fullness = 1.0 - (post_residual as f64 / bin_capacity as f64);
            score -= (next_item_size as f64) * 2.1 * (1.0 + fullness);
        }
    }

    // 5. Temporal Horizon Scaling
    // Increase pressure to consolidate as we exhaust the stream.
    let progress = step_index as f64 / total_items as f64;
    if is_new_bin {
        score += progress * 65.0;
    } else {
        // Encourage aggressive compaction for existing bins in late stages
        // by rewarding low post_residuals.
        score -= progress * (bin_capacity - post_residual) as f64 * 0.45;
    }

    // 6. Variance Dampener
    // Penalize extreme residual imbalance if we have many open bins.
    if !is_new_bin && (post_residual as f64) < (mean_residual * 0.5) {
        score -= 12.0;
    }

    score
}
