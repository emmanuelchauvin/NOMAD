 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    // Base score: prioritize tight fills, but use a sharper power law for post-residual
    let mut score = (post_residual as f64).powf(1.08) * 1.22;

    // 1. Refined Dead-Gap Penalty: Focused on the 1-28 range to minimize unusable slivers.
    if post_residual > 0 && post_residual < 29 {
