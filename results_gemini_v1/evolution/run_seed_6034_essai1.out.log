        let density_factor = (open_bins_count as f64).min(32.0) * 4.2;
        score += 82.0 + (mean_residual * 0.42) - density_factor;
    } else {
        // 4. Harmonic Alignment: Shift to 16-unit alignment for better fit with standard item sizes.
        let remainder = post_residual % 16;
        score += (remainder as f64) * 0.72;
        
        // 5. Aggressive Closure: If a bin is near completion, force it to finish.
        if post_residual < 10 {
