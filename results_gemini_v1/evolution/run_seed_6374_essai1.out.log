 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Encourage Best-Fit behavior: Penalize leaving large gaps that are hard to fill.
    // Higher post_residual is generally bad, but we want to avoid "fragile" gaps.
    if post_residual > 0 {
        score += (post_residual as f64).powf(1.2);
    }

    // 2. Lookahead Synergy: If the current post_residual can perfectly or nearly fit the next item, reward it.
    if next_item_size > 0 {
        if post_residual >= next_item_size {
            // Reward placement that makes the next item fit perfectly (Best-Fit-Lookahead)
            score -= (100.0 - (post_residual as f64 - next_item_size as f64).abs()).powf(1.5);
        } else {
            // Penalize if this placement makes it impossible to fit the next item in this bin
            score += 50.0;
        }
    }

    // 3. Density Management: Penalize creating new bins unless necessary.
    if bin_residual == bin_capacity {
        // Penalty for opening a new bin is inversely proportional to how many open bins are already struggling.
        // We only want to open a new bin if the current `open_bins_count` is low or the fit is terrible.
        score += 80.0 + (open_bins_count as f64 * 2.0);
    }

    // 4. Global State Awareness: If we are near the end of the stream, prioritize closing bins.
    let progress = step_index as f64 / total_items as f64;
    if progress > 0.8 {
        // Near the end, be more aggressive about filling existing bins rather than opening new ones.
        score += (1.0 - progress) * 200.0;
    }

    // 5. Fitting Constraint: If this is the last bin that can fit the item, give it a strong preference.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 150.0;
    }

    // 6. Mean Residual Balancing: Avoid bins that deviate significantly from the average residual.
    score += (post_residual as f64 - mean_residual).abs() * 0.5;

    score
}
