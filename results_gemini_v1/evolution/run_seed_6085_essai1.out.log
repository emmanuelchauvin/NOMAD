 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let is_new_bin = bin_residual == bin_capacity;
    let progress = step_index as f64 / (total_items as f64 + 1.0);
    
    // Base score: prioritize tightest fit (Best Fit)
    // We use a non-linear scaling of the post_residual to favor highly compact bins
    let mut score = (post_residual as f64).powf(1.05);

    // Dynamic penalty for new bins:
    // Increased weight on late-game consolidation to reduce trailing fragment bins
    if is_new_bin {
        score += 38.0 * (1.2 - progress).max(0.2);
        if fitting_bins_count > 0 {
            score += 52.0 + (open_bins_count as f64 * 1.1);
        }
    } else {
        // Reward fills that keep the bin_residual closer to the expected mean_residual
        // to prevent creating "dead" zones that are too small for future items.
        let deviation = (bin_residual as f64 - mean_residual).abs();
        score -= (deviation * 0.22).min(7.5);
    }

    // Lookahead refinement:
    // If next_item_size is large, we aggressively penalize bins that cannot accommodate it
    // post-insertion. We use the ratio of next_item_size to bin_capacity for scaling.
    if next_item_size > 0 {
        if post_residual < next_item_size {
            score += 22.0 + (progress * 15.0);
        } else {
            // Reward bins that maintain a high probability of fitting the next item
            score -= 8.0 * (next_item_size as f64 / bin_capacity as f64);
        }
    }

    // Fragmentation control:
    // Penalize the creation of bins that create small, unusable slivers.
    // If post_residual is < 12 but > 0, it is likely a fragmentation trap.
    if post_residual > 0 && post_residual < 12 {
        score += 6.0 * (1.0 - (post_residual as f64 / 12.0));
    }

    // Global bin count pressure:
    // As the count of open bins increases, we tighten the requirements for opening new ones.
    score += (open_bins_count as f64 * 0.85);
    
    // Encouraging packing into bins that are already "semi-full" rather than 
    // spreading items across many nearly empty bins.
    if !is_new_bin && (bin_residual as f64 > mean_residual) {
        score -= 4.2;
    }

    // Critical constraint: Force fit into existing bins if it is the only option,
    // avoiding the high penalty of opening a new bin at all costs.
    if fitting_bins_count == 1 && !is_new_bin {
        score -= 40.0;
    }

    score
}
