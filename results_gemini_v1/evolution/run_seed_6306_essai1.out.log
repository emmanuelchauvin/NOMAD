 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items as f64;
    let post = post_residual as f64;
    let capacity = bin_capacity as f64;

    // Use a non-linear objective: strongly minimize post_residual (Best Fit)
    // but include a small bias for bins that are already well-utilized to reduce fragmentation.
    let mut score = post * (1.0 + (capacity - bin_residual as f64) / capacity);

    // Lookahead refinement: specifically target bins that can accommodate the next item
    // while avoiding bins that would become "useless" (residual too small for common items).
    if next_item_size > 0 {
        if post_residual >= next_item_size {
            // Reward bins that preserve space for the next item
            score -= (next_item_size as f64) * 0.8;
        } else if post < 15.0 && post > 0.0 {
            // Penalize "micro-gaps" that are too small to be useful
            score += 15.0 - post;
        }
    }

    // Dynamic new-bin suppression: 
    // The cost of a new bin should scale with the number of open bins and stream progress.
    if bin_residual == bin_capacity {
        // Base cost + density-dependent penalty
        let open_penalty = (open_bins_count as f64).min(20.0) * 4.0;
        let progress_penalty = progress * capacity * 0.8;
        score += 30.0 + open_penalty + progress_penalty;
    } else {
        // Uniformity constraint: keep bin residuals close to the mean to avoid "orphan" bins
        let residual_diff = (post - mean_residual).abs();
        score += residual_diff * 0.4;
    }

    // Criticality override: If this is the only bin that fits the item, 
    // provide a strong incentive to use it to prevent an unnecessary new bin.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 50.0;
    }

    score
}
