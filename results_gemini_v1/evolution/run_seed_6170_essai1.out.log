 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items as f64;
    let is_new_bin = bin_residual == bin_capacity;
    
    // Base score: punish large gaps, prioritize tighter packing.
    let mut score = post_residual as f64;

    // 1. Enhanced Lookahead: Focus on "Dead Space" avoidance for the next item.
    if next_item_size > 0 {
        if post_residual >= next_item_size {
            // Reward for keeping room for the next item, but scale by item size to favor larger fits.
            score -= (next_item_size as f64) * 3.65;
        } else if post_residual > 0 {
            // Penalty for stranding the next item is now non-linear, emphasizing the risk of small remaining gaps.
            score += ((next_item_size - post_residual) as f64).powf(1.2) * 5.8;
        }
    }

    // 2. Adaptive New-Bin Threshold:
    // Increased penalty for opening new bins to force consolidation, especially as the stream nears completion.
    if is_new_bin {
        let completion_pressure = progress * 110.0;
        let consolidation_pressure = (open_bins_count as f64).powf(0.92) * 20.0;
        let efficiency_discount = (mean_residual - 20.0).max(0.0) * 2.5;
        score += (80.0 + completion_pressure + consolidation_pressure - efficiency_discount).max(18.0);
    } else {
        // 3. Fragmentation Control:
        // Prioritize exhausting bins that have become restrictive.
        if fitting_bins_count == 1 {
            score -= 125.0;
        } else if fitting_bins_count <= 2 {
            score -= 60.0 + (progress * 45.0);
        }
        
        // 4. Harmonic Alignment:
        // Target zero-residual and "near-full" states more aggressively.
        if post_residual == 0 {
            score -= 145.0; 
        } else if post_residual <= 4 {
            score -= 55.0;
        } else if post_residual % 20 == 0 {
            score -= 30.0;
        }
    }

    // 5. Variance Smoothing:
    // Penalize deviation from the mean to ensure uniform depletion of bins.
    let dev = (post_residual as f64 - mean_residual).abs();
    score += dev * 1.1;

    // 6. Micro-Tightness Bias:
    // Aggressively eliminate 'dead' space < 14 that prevents large item placement.
    if post_residual > 0 && post_residual < 14 {
        score -= (14 - post_residual) as f64 * 18.0;
    }

    // 7. Density-Aware Consolidation:
    // If we have many open bins, heavily penalize creating more space-intensive bins.
    // Use a dynamic threshold based on the remaining item count.
    let remaining_ratio = 1.0 - progress;
    if (open_bins_count as f64) > (total_items as f64 * 0.04).max(10.0) * remaining_ratio {
        score += post_residual as f64 * 1.15;
    }

    score
}
