 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;
    let is_new_bin = bin_residual == bin_capacity;
    let progress = step_index as f64 / total_items as f64;

    // 1. Dynamic New Bin Thresholding: Exponentially scale cost to minimize active bin set
    if is_new_bin {
        let open_bin_penalty = (open_bins_count as f64).powf(1.3) * 15.0;
        score += 135.0 + (progress * 60.0) + open_bin_penalty;
        if fitting_bins_count > 0 {
            score += 650.0; // High barrier for new bin when current bins suffice
        }
    }

    // 2. Lookahead & Fragmentation Control: Tighten dead-space penalties
    if next_item_size > 0 {
        if post_residual >= next_item_size {
            score -= 75.0; // High reward for retaining capacity for next item
            if post_residual == next_item_size { score -= 60.0; }
            else if post_residual < 12 { score -= 30.0; } 
        } else if post_residual > 0 && post_residual < 25 {
            // Penalize "dead zones" that are too small to hold significant items
            score += 90.0 + (25 - post_residual) as f64 * 2.0;
        }
    }

    // 3. Utilization & Finalization: Prioritize bins nearing full capacity (Best-Fit Variant)
    if !is_new_bin {
        let usage = (bin_capacity - bin_residual) as f64 / bin_capacity as f64;
        score -= usage * 85.0;
        if post_residual < 6 {
            score -= 55.0; // Strong incentive to close bins
        }
    }

    // 4. Distribution Alignment: Align with common item size clusters
    let rem25 = post_residual % 25;
    if rem25 == 0 { 
        score -= 30.0; 
    } else if rem25 > 20 { 
        score -= 15.0; 
    } else { 
        score += rem25 as f64 * 0.8; 
    }

    // 5. Critical Path Handling: Prevent fragmentation when choices are limited
    if fitting_bins_count == 1 && !is_new_bin {
        score -= 400.0;
    }

    // 6. Terminal Phase Aggression: Force compaction when stream nears end
    if progress > 0.80 {
        // Increase weight on density as the remaining items decrease
        score -= (bin_capacity - post_residual) as f64 * 3.5;
    }

    // 7. Mean Residual Feedback: Global state adjustment
    if mean_residual > 20.0 {
        score += post_residual as f64 * 0.5;
    }

    score
}
