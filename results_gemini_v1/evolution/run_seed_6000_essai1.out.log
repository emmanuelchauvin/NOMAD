 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items as f64;
    let is_new_bin = bin_residual == bin_capacity;
    let post = post_residual as f64;
    
    // Core logic: Minimize post_residual, but apply non-linear pressure on fragmentation.
    let mut score = post;

    if is_new_bin {
        // Dynamic threshold for opening new bins: 
        // Increased base cost and coupling with open_bins_count to defer new bin allocation.
        score = 32.5 + (progress.powf(1.65) * 36.0) + (open_bins_count as f64 * 0.35);
    } else {
        // Lookahead: penalize if the resulting gap is smaller than the next item
        // but large enough to be an "unfillable" fragment.
        if next_item_size > 0 {
            if post < next_item_size as f64 {
                score += 58.0; 
            } else if post < 28.0 {
                // Sharpened fragment penalty using a power function to force tighter packing.
                score += (28.0 - post).powf(1.2) * 4.5;
            }
        }

        // Reward fitting into the only available bin to prevent unnecessary new bin creation.
        if fitting_bins_count == 1 {
            score -= 35.0;
        }
        
        // Adaptive load balancing: prioritize bins closer to the mean_residual
        // to keep the bin distribution compact and uniform.
        let deviation = (post - mean_residual).abs();
        score += deviation * 0.60;

        // Late stage optimization: 
        // If we are in the late stage of the stream, prioritize filling bins.
        if progress > 0.65 {
            // Stronger incentive to exhaust near-full bins.
            score -= (bin_capacity as f64 - post) * 0.75;
            
            // Penalize creating "micro-fragments" that are effectively unusable.
            // Adjusted threshold and penalty to be more aggressive against dead space.
            if post > 0.0 && post < 14.0 {
                score += 28.0 - (post * 0.6);
            }
        }
        
        // Anti-clustering: early in the stream, favor keeping higher residuals 
        // to accommodate incoming large items.
        if progress < 0.35 {
            score += (bin_capacity - post_residual) as f64 * 0.22;
        }
    }

    score
}
