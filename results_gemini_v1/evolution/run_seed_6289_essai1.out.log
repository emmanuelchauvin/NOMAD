 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items as f64;
    let is_new_bin = bin_residual == bin_capacity;
    
    // We aim to reduce the bin count by making the "New Bin" option more expensive
    // while refining the packing of existing bins to be more "Best-Fit" oriented.
    let mut score = if is_new_bin {
        // Threshold: Only open a new bin if the average waste is already high, 
        // or if we are in the final 5% of the stream to clear remaining items.
        let base_penalty = 52.0 + (mean_residual * 0.4);
        if progress > 0.95 { base_penalty - 25.0 } else { base_penalty }
    } else {
        // Use a non-linear penalty for fragmentation.
        // post_residual: 0 is ideal, large values are bad.
        let mut s = (post_residual as f64).powi(2) / 12.0;

        // Lookahead optimization: If the bin can fit the next item, 
        // we reward that potential synergy to prevent future bin openings.
        if next_item_size > 0 && post_residual >= next_item_size {
            s -= 8.0 * (1.0 - (post_residual - next_item_size) as f64 / bin_capacity as f64);
        }
        s
    };

    // Apply pressure to reduce the total number of bins by favoring 
    // filling existing bins when open_bins_count is high.
    if !is_new_bin {
        score -= (open_bins_count as f64 * 0.12);
        
        // If this is the only bin that fits the current item, 
        // prioritize it heavily to avoid the new bin penalty.
        if fitting_bins_count == 1 {
            score -= 22.0;
        }
    }

    // Dynamic phase adjustment: 
    // Early stream: Prioritize packing density (mean_residual).
    // Late stream: Prioritize closing bins (lower score for existing).
    score += (1.0 - progress) * (mean_residual * 0.3);
    score -= progress * 5.0;

    score
}
