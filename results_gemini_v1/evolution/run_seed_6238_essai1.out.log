        // Sensitivity to mean_residual to prevent premature new bin creation when existing ones are underutilized.
        let fragmentation_penalty = if mean_residual > 22.0 { 1250.0 } else { 450.0 };
        score += 610.0 + (fragmentation_penalty * (1.0 - progress)) + (open_bins_count as f64 * 0.85);
