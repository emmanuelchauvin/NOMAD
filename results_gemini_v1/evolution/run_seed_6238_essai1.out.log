        } else {
            // Increased penalty for blocking the next item, modulated by progress.
            score += 2650.0 * (1.25 - progress).max(0.3);
        }
    }

    // New-Bin Logic: Dynamically modulate cost based on global state.
    if bin_residual == bin_capacity {
