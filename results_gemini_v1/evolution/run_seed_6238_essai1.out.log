        // Encourage using existing bins that are significantly tighter than the global average.
        // Penalty reduction scaled by progress to optimize long-tail packing.
        if post < mean_residual {
            score -= 550.0 * (progress + 0.25);
        }
        // Entropy dampener: Slightly favor bins that are already open to minimize the active set size.
        score -= (open_bins_count as f64) * 0.25;
    }

    // Pressure Valve: If this is the only bin that fits, prioritize it massively.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 9200.0;
    }

    // Global density normalization:
    // As we near the end of the stream, prioritize filling bins with higher capacity to minimize the number of trailing bins.
    let fill_level = (bin_capacity - bin_residual) as f64;
