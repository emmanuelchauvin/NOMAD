 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items as f64;
    let post = post_residual as f64;
    let capacity_used = (bin_capacity - bin_residual) as f64;
    
    // Core logic: Tightness (Best Fit) with quadratic penalty for larger remaining space.
    // Increased quadratic penalty to strongly discourage "medium" gaps that block future items.
    let mut score = post * 2.95 + (post * post) * 0.155;

    // Lookahead: Anticipation logic focused on chain-fitting.
    if next_item_size > 0 {
