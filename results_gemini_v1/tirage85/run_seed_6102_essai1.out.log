 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    // Harmonic classes logic:
    // We prioritize keeping post_residual as small as possible (Best Fit),
    // but penalize bins that leave "dead space" which cannot accommodate common item sizes.
    // We use modulo arithmetic to identify "clean" fits (multiples of 10, 20, 25).
    
    let mut score = post_residual as f64;

    // 1. Encourage filling bins near capacity to minimize total bins.
    // If post_residual is very small (near 0), we reward this strongly.
    if post_residual < 5 {
        score -= 50.0;
    }

    // 2. Harmonic Class Coupling:
    // If post_residual is a multiple of 10, it is more likely to fit future items.
    if post_residual > 0 && post_residual % 10 == 0 {
        score -= 10.0;
    }

    // 3. Lookahead Logic (Next Item):
    // If the next item fits into the post_residual, we heavily prioritize this bin.
    if next_item_size > 0 && next_item_size <= post_residual {
        score -= 40.0;
    }

    // 4. Fitting Bin Scarcity:
    // If this is the only fitting bin, prioritize it to avoid opening a new one,
    // unless the post_residual is so small it makes the bin unusable (dead space).
    if fitting_bins_count == 1 && post_residual > 5 {
        score -= 20.0;
    }

    // 5. New Bin Penalty:
    // If this is a new bin (bin_residual == bin_capacity), apply a heavy penalty
    // unless the mean_residual of existing bins is already very low (indicating congestion).
    if bin_residual == bin_capacity {
        score += 30.0 + (mean_residual * 0.5);
    }

    // 6. Progressive Scaling:
    // As we reach the end of the item stream, prioritize closing bins (Best Fit) 
    // to avoid leaving items stranded.
    let progress = step_index as f64 / total_items as f64;
    score += progress * 10.0;

    score
}
