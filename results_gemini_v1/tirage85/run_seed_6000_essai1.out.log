 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Harmonic Penalty: Heavily penalize residuals that are small but non-zero (the "fragmentation trap").
    // We favor residuals that are exactly 0 or large enough to accommodate a future item.
    if post_residual > 0 && post_residual < 20 {
        score += 40.0;
    } else if post_residual == 0 {
        score -= 10.0;
    }

    // 2. Lookahead Logic: If the next item fits into the current post_residual, reward this placement.
    // This implements a primitive Best-Fit-Lookahead strategy.
    if next_item_size > 0 && post_residual >= next_item_size {
        score -= 25.0;
    }

    // 3. New Bin Thresholding: Discourage opening a new bin unless the current fit is extremely poor.
    // If it's a new bin, penalize based on the ratio of open bins to total progress.
    if bin_residual == bin_capacity {
        let progress = step_index as f64 / total_items as f64;
        // As the stream progresses, opening new bins becomes increasingly expensive.
        score += 30.0 + (progress * 50.0);
    }

    // 4. Harmonic Alignment: Favor fitting items into bins that bring the mean residual closer to a "sweet spot".
    // 100 / 3 = 33.3, 100 / 4 = 25.0. Residuals near these values are often optimal for packing.
    let target_residual = 25.0;
    let dev = (post_residual as f64 - target_residual).abs();
    score += dev * 0.2;

    // 5. Urgency: If this is the only bin that can fit the item, prioritize it.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 15.0;
    }

    score
}
