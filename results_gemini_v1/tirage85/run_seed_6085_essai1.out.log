 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Harmonic Penalty: Penalize post_residuals that are small but non-zero (fragments)
    // We prefer post_residuals that are either 0 (perfect fit) or large enough to accommodate the next item.
    if post_residual > 0 {
        if next_item_size > 0 && post_residual < next_item_size {
            // High penalty for creating a bin that cannot fit the next item
            score += 40.0;
        } else {
            // Harmonic reward: prioritize bins that leave space for future items based on 1/k fractions
            score += (post_residual as f64 / bin_capacity as f64) * 10.0;
        }
    }

    // 2. Fitting Scarcity: If this is the only bin that can fit the item, prioritize it heavily
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 50.0;
    }

    // 3. New Bin Threshold: Discourage opening new bins unless the fit is excellent
    if bin_residual == bin_capacity {
        // Only open a new bin if the current mean_residual is very low (bins are full)
        // or if we are nearing the end of the stream
        let progress = step_index as f64 / total_items as f64;
        score += 35.0 + (mean_residual * 0.5) - (progress * 10.0);
    }

    // 4. Density Balancing: Prefer bins that keep the mean_residual stable
    // Penalize bins that are significantly emptier than the current average
    if (bin_residual as f64) > mean_residual * 1.5 {
        score += 15.0;
    }

    // 5. Perfect Fit Bonus
    if post_residual == 0 {
        score -= 20.0;
    }

    score
}
