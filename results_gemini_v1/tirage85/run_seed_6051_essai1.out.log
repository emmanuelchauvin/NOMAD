 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Best-Fit Penalty: Penalize large post_residuals to favor tight packing.
    // We favor bins that result in a post_residual close to 0.
    
    // 2. Lookahead Integration: If the current post_residual can accommodate the 
    // next item, reward this bin heavily to minimize the need for future bins.
    if next_item_size > 0 && post_residual >= next_item_size {
        score -= (next_item_size as f64) * 1.5;
    }

    // 3. Mean Residual Balancing: Penalize bins that deviate significantly from 
    // the global mean residual to keep bin states uniform.
    let dev = (post_residual as f64 - mean_residual).abs();
    score += dev * 0.2;

    // 4. New Bin Thresholding: If this is an empty bin (bin_residual == bin_capacity),
    // apply a heavy penalty unless the fitting_bins_count is 0. 
    // This forces the algorithm to prioritize existing bins.
    if bin_residual == bin_capacity {
        if fitting_bins_count > 0 {
            score += 85.0; // Strong resistance to opening a new bin unnecessarily
        } else {
            score -= 50.0; // Must open a new bin if nothing fits
        }
    }

    // 5. Progression Scaling: As we approach the end of the stream, prioritize 
    // closing existing bins (lower residuals) over starting new ones.
    let progress = step_index as f64 / total_items as f64;
    score += progress * 10.0 * (post_residual as f64 / bin_capacity as f64);

    // 6. Tightness reward: Reward bins that become "full" (residual < 10)
    if post_residual < 10 {
        score -= 20.0;
    }

    score
}
