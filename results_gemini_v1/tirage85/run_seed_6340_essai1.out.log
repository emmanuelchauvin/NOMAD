 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Best Fit Decreasing (BFD) logic: penalize large post_residual
    // 2. Harmonic/Modulo logic: reward post_residuals that are multiples of common item sizes (20, 25, 50)
    // to keep bins aligned for potential future items.
    let harmonic_penalty = ((post_residual % 20) as f64) * 0.5;
    score += harmonic_penalty;

    // 3. Lookahead coupling: If next item fits in the current post_residual, reward this bin
    if next_item_size > 0 && next_item_size <= post_residual {
        score -= 45.0;
    }

    // 4. Scarcity/Efficiency: Penalize opening new bins unless the current best fit is poor.
    // If bin_residual == bin_capacity, it's a new bin candidate.
    if bin_residual == bin_capacity {
        if fitting_bins_count > 0 {
            // Only open a new bin if the current mean residual suggests we are wasting space
            // or if the item is very large (e.g., > 70).
            if item_size > 70 || mean_residual < 15.0 {
                score += 10.0;
            } else {
                score += 100.0; // High penalty for opening new bin if better fits exist
            }
        }
    } else {
        // Reward filling bins to near-capacity (Best Fit logic)
        // If post_residual is small, it's a tight fit.
        if post_residual < 10 {
            score -= 20.0;
        }
    }

    // 5. Progression awareness: As we near the end of the stream, be more conservative with new bins
    let progress = step_index as f64 / total_items as f64;
    if progress > 0.9 {
        score += (post_residual as f64) * 0.2;
    }

    score
}
