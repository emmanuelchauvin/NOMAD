 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Harmonic Penalty: Heavily penalize residuals that are small but not zero (fragmentation).
    // Modulo logic creates "preferred" bucket sizes based on common item divisors (20, 25, 33).
    if post_residual > 0 {
        let harmonic_penalty = (post_residual as f64 % 20.0) * 1.5;
        score += harmonic_penalty;
    }

    // 2. Lookahead Synergy: If the next item fits into the current post_residual, prioritize this bin.
    if next_item_size > 0 && next_item_size <= post_residual {
        score -= (next_item_size as f64) * 2.5;
    }

    // 3. Density Balancing: If we are in the later half of the stream, prioritize filling existing bins.
    let progress = step_index as f64 / total_items as f64;
    if progress > 0.5 {
        score -= (bin_capacity - post_residual) as f64 * 0.5;
    }

    // 4. New Bin Thresholding: 
    // If bin_residual == bin_capacity, we are evaluating a NEW bin. 
    // We only want to open a new bin if the current fitting bins are "bad" fits (leaving fragmented space).
    if bin_residual == bin_capacity {
        // Base cost for opening a new bin is high to encourage packing.
        score += 45.0;
        // If we have many open bins, penalize opening more.
        score += (open_bins_count as f64) * 2.0;
    } else {
        // We are evaluating an EXISTING bin.
        // If it's the last chance (fitting_bins_count == 1), reward using it to avoid opening a new bin.
        if fitting_bins_count == 1 {
            score -= 10.0;
        }
        
        // Penalize bins that deviate significantly from the mean residual (standardize bin fullness).
        let dev = (post_residual as f64 - mean_residual).abs();
        score += dev * 0.8;
    }

    score
}
