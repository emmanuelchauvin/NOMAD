 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Best-Fit logic: Penalize large post_residuals (dead space)
    // 2. Harmonic/Modulo logic: Reward post_residuals that are multiples of common item sizes (e.g., 20, 25)
    // to keep bins "friendly" for future items.
    let harmonic_penalty = (post_residual % 20) as f64 * 0.5;
    score += harmonic_penalty;

    // 3. Lookahead integration: If the next item is large, avoid leaving very small residuals (e.g., < 10)
    // which are effectively dead space for most items.
    if next_item_size > 0 {
        if post_residual < next_item_size && post_residual > 0 {
            score += (next_item_size - post_residual) as f64 * 1.5;
        }
    }

    // 4. New bin management: If this is a new bin, penalize it heavily unless the fit is perfect 
    // or we have too many open bins (fragmentation).
    if bin_residual == bin_capacity {
        score += 15.0; // Base cost to open a new bin
        if fitting_bins_count > 0 {
            score += 20.0; // Strongly discourage opening new if existing bins can take it
        }
    }

    // 5. Fragmentation control: If current mean_residual is low, prioritize filling 
    // bins that are already "tight" to preserve high-capacity bins for future large items.
    if (bin_residual as f64) < mean_residual {
        score -= 5.0;
    }

    // 6. Progressive tightening: As we approach the end of the stream, 
    // become more aggressive about fitting into existing bins to minimize total count.
    let progress = step_index as f64 / total_items as f64;
    score -= progress * 5.0;

    score
}
