 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;
    let progress = step_index as f64 / (total_items as f64 + 1.0);

    // 1. Best-Fit Penalty: Minimize post_residual (Best Fit logic)
    // The current score is post_residual. We prioritize small post_residual.

    // 2. Lookahead Integration: If the next item fits into the current post_residual, 
    // prioritize this bin to prevent fragmentation.
    if next_item_size > 0 && next_item_size <= post_residual {
        score -= (next_item_size as f64) * 0.8;
    }

    // 3. New Bin Threshold: If we are forced to open a new bin, penalize it heavily 
    // early in the process, but allow it if current bins are "too full" to be useful.
    if bin_residual == bin_capacity {
        if fitting_bins_count > 0 {
            // Strong penalty for opening a new bin if an existing one works
            score += 45.0 + (progress * 20.0);
        } else {
            // If no existing bin works, this is the baseline
            score = 25.0;
        }
    }

    // 4. Global State balancing:
    // If we have many open bins, penalize creating more (force tighter fitting).
    // If mean_residual is low, we are packing efficiently; maintain this.
    if open_bins_count > 0 {
        score += (open_bins_count as f64 * 2.5) * (1.0 - progress);
        
        // If this bin's post_residual is significantly worse than the mean, penalize it
        if (post_residual as f64) > mean_residual {
            score += (post_residual as f64 - mean_residual) * 0.5;
        }
    }

    // 5. Criticality adjustment:
    // If this is the only bin that can fit the item, prioritize it strongly.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 15.0;
    }

    score
}
