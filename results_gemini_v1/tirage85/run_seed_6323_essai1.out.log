 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items as f64;
    
    // Base score is the post-placement residual (Best Fit principle).
    // Lower residual is generally better.
    let mut score = post_residual as f64;

    // Penalty for opening a new bin prematurely: 
    // If this is a new bin (bin_residual == bin_capacity) and there are existing bins that could fit the item,
    // we heavily penalize it unless the item is very large or we are near the end of the stream.
    if bin_residual == bin_capacity {
        if fitting_bins_count > 0 {
            score += 45.0 * (1.0 - progress);
            score += (item_size as f64) * 0.5;
        }
    } else {
        // Favor bins where the post_residual is small (tight fit).
        // If post_residual is 0, it's a perfect fit.
        if post_residual == 0 {
            score -= 10.0;
        }

        // Lookahead heuristic: 
        // If the next item can fit in the current post_residual, reward this bin.
        if next_item_size > 0 && post_residual >= next_item_size {
            score -= 25.0;
        }

        // Global state awareness:
        // If the current bin's residual is significantly larger than the mean_residual,
        // it is an "empty" bin compared to others; prioritize filling it.
        if (bin_residual as f64) > mean_residual {
            score -= 5.0;
        }
    }

    // Dynamic constraint: If fitting_bins_count is 1, this is the last chance for the item.
    // Discourage opening a new bin if this specific bin is the only one left.
    if fitting_bins_count == 1 && bin_residual == bin_capacity {
        score += 100.0;
    }

    score
}
