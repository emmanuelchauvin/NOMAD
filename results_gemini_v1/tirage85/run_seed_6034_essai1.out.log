 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Best Fit Decreasing logic: heavily penalize larger post_residuals
    // to keep bins packed as tightly as possible.
    score += post_residual as f64 * 1.5;

    // 2. Lookahead Synergy: If the post_residual can accommodate the next item,
    // reward this bin heavily to prevent future fragmentation.
    if next_item_size > 0 && post_residual >= next_item_size {
        score -= (next_item_size as f64) * 2.5;
        
        // Add a secondary bonus if the post_residual matches the next item almost perfectly
        let waste = (post_residual - next_item_size) as f64;
        score += waste * 0.5;
    }

    // 3. New Bin Thresholding: If this is a new bin (residual == capacity),
    // penalize it based on how many bins are already open to discourage 
    // fragmenting the bin count unless necessary.
    if bin_residual == bin_capacity {
        score += (open_bins_count as f64) * 10.0;
        // If we have many fitting bins, opening a new one is highly inefficient.
        score += (fitting_bins_count as f64) * 20.0;
    }

    // 4. Global Density Awareness: Penalize bins that deviate from the mean residual
    // to encourage uniform packing across the entire set of open bins.
    let deviation = (post_residual as f64 - mean_residual).abs();
    score += deviation * 0.2;

    // 5. Progression adjustment: As the stream nears the end, become more conservative
    // about opening new bins.
    let progress = step_index as f64 / total_items as f64;
    if bin_residual == bin_capacity {
        score += progress * 50.0;
    }

    score
}
