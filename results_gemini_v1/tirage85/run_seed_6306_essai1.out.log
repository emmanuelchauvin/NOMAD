 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items as f64;
    let post = post_residual as f64;
    
    // Penalize new bin creation (bin_residual == bin_capacity) increasingly as the stream progresses
    // to force tighter packing later in the sequence.
    let is_new_bin = bin_residual == bin_capacity;
    let mut score = if is_new_bin {
        (1.0 - progress) * 20.0 + (progress * 120.0)
    } else {
        // Best Fit Decreasing logic: favor small post_residual (tight fit)
        // Non-linear penalty for larger gaps.
        post * (1.0 + 0.5 * (post / bin_capacity as f64))
    };

    // Lookahead interaction: if next item is large, avoid creating small post_residual 
    // that creates "dead space" (e.g., 5-9 remaining) that can't fit next_item.
    if next_item_size > 0 && post < next_item_size as f64 && post > 0.0 {
        score += (next_item_size as f64 - post) * 2.0;
    }

    // Penalize creating many open bins early on; encourage consolidation
    if !is_new_bin {
        score += (open_bins_count as f64 / 10.0) * (1.0 - progress);
    }

    // If this is the only bin that fits, prioritize it heavily by reducing the score
    if fitting_bins_count == 1 && !is_new_bin {
        score -= 50.0;
    }

    score
}
