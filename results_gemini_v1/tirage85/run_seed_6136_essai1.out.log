 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Harmonic Penalty: Favor bins that leave small residuals or perfect fits (0).
    // Penalize residuals that are too small to fit common small items (e.g., < 10) 
    // unless it is a perfect fit.
    if post_residual > 0 && post_residual < 10 {
        score += 25.0;
    }

    // 2. Lookahead Synergy: If the next item can fit in the post_residual, reward this bin.
    if next_item_size > 0 && post_residual >= next_item_size {
        score -= (next_item_size as f64) * 0.8;
    }

    // 3. Harmonic Density: Discourage opening new bins unless necessary.
    // If this is a new bin (bin_residual == bin_capacity), apply a heavy penalty
    // scaled by the availability of existing fitting bins.
    if bin_residual == bin_capacity {
        score += 30.0 + (fitting_bins_count as f64 * 5.0);
    }

    // 4. Mean Residual Balancing: Avoid bins that deviate significantly from the global mean.
    // This helps keep the "tightness" of bins uniform.
    let dev = (post_residual as f64 - mean_residual).abs();
    score += dev * 0.2;

    // 5. Progression Weighting: As the stream nears the end, prioritize closing bins
    // by preferring smaller post_residuals (Best Fit logic).
    let progress = step_index as f64 / total_items as f64;
    score += progress * (post_residual as f64 * 0.5);

    // 6. Thresholding: Penalize "dead zones" (10-20 range) which are hard to fill.
    if post_residual >= 10 && post_residual <= 20 {
        score += 15.0;
    }

    score
}
