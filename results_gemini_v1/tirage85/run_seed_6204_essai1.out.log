 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Best-Fit Penalty: Minimize post_residual to keep bins tight.
    // We prioritize bins that result in smaller post_residuals.
    
    // 2. Lookahead Coupling: If the next item fits perfectly into this post_residual, 
    // significantly reward this placement.
    if next_item_size > 0 && next_item_size <= post_residual {
        let fit_diff = (post_residual - next_item_size) as f64;
        // Reward small gaps after the next item is placed
        score -= 50.0 * (1.0 / (1.0 + fit_diff));
    }

    // 3. Mean Residual Balancing: If the post_residual is significantly lower 
    // than the current mean, we are creating a "tight" bin.
    if (post_residual as f64) < mean_residual {
        score -= 10.0;
    }

    // 4. Scarcity Logic: If this is the only fitting bin, we are forced to use it.
    // We dampen the score to ensure it is picked over a new bin.
    if fitting_bins_count == 1 && bin_residual < bin_capacity {
        score -= 100.0;
    }

    // 5. New Bin Suppression: Make opening a new bin expensive unless 
    // the post_residual of existing bins is extremely poor (e.g., > 40).
    if bin_residual == bin_capacity {
        score += 45.0; 
        // Penalize opening a new bin based on how many bins are already open
        score += (open_bins_count as f64) * 0.5;
    }

    // 6. Progressive Tightening: As we approach the end of the stream, 
    // become more aggressive about filling gaps.
    let progress = step_index as f64 / total_items as f64;
    score += progress * (post_residual as f64) * 0.2;

    score
}
