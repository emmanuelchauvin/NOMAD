 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items as f64;
    let is_new_bin = bin_residual == bin_capacity;
    
    // Base score is the post-placement residual (Best Fit principle)
    let mut score = post_residual as f64;

    // Penalty for opening a new bin: proportional to progress and open bins
    // We want to avoid new bins as we approach the end of the stream
    if is_new_bin {
        score += 45.0 + (progress * 20.0) + (open_bins_count as f64 * 2.0);
    } else {
        // Reward bins that are "tight" after placement
        // If post_residual is very small, this is a "perfect" fit
        score -= (100.0 - post_residual as f64) * 0.1;

        // Lookahead heuristic: if next item is large, favor bins that can accommodate it
        if next_item_size > 0 {
            if post_residual >= next_item_size {
                score -= 15.0; // Reward bins that can hold the next item
            } else if post_residual > 0 && post_residual < 20 {
                score += 25.0; // Penalize "dead space" that is too small for common items
            }
        }
    }

    // Global state adjustment: if many bins are open, try to consolidate
    if open_bins_count > 5 {
        score += (post_residual as f64) * 0.5;
    }

    // Critical threshold: if this is the only fitting bin, reduce its penalty
    // unless it leaves a very awkward residual
    if fitting_bins_count == 1 && !is_new_bin {
        if post_residual > 10 {
            score -= 10.0;
        }
    }

    score
}
