 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Penalize opening new bins unless absolutely necessary (Best Fit strategy)
    if bin_residual == bin_capacity {
        if fitting_bins_count > 0 {
            score += 200.0; // Heavy penalty for opening new bin if existing ones work
        } else {
            score -= 50.0; // Reward opening new bin if no other options exist
        }
    }

    // 2. Lookahead optimization: If post_residual perfectly matches next_item_size, prioritize
    if next_item_size > 0 {
        if post_residual == next_item_size {
            score -= 40.0;
        } else if post_residual < next_item_size {
            // Penalize creating a hole too small for the predicted next item
            score += 30.0;
        }
    }

    // 3. Balance towards mean_residual to keep bin distribution uniform
    // Penalize bins that deviate too far from the current average residual
    let diff_from_mean = (post_residual as f64 - mean_residual).abs();
    score += diff_from_mean * 0.5;

    // 4. Tightness constraint: Reward filling bins to near-zero residuals
    // This is the "Best Fit" component
    if post_residual < 10 {
        score -= 25.0;
    }

    // 5. Progression scaling: Be more aggressive early on, more conservative at the end
    let progress = step_index as f64 / total_items as f64;
    score += progress * 10.0;

    score
}
