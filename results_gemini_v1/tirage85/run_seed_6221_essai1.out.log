 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Penalty for creating "dead space": small residuals that are unlikely to fit future items.
    // We target residuals that are either 0 or large enough to accommodate common item sizes.
    if post_residual > 0 && post_residual < 20 {
        score += 45.0; 
    }

    // Harmonic logic: Reward placements that leave a residual that is a multiple of common item sizes (e.g., 25, 33, 50).
    // This mimics the "Harmonic" bin packing approach by grouping items into capacity fractions.
    let remainder = post_residual % 25;
    if remainder == 0 {
        score -= 15.0;
    }

    // Lookahead logic: If the next item can fit into the new post_residual, strongly favor this placement.
    if next_item_size > 0 && post_residual >= next_item_size {
        score -= 30.0;
    }

    // If this is the only bin that can fit the item, we are forced to take it unless opening a new one is better.
    // If fitting_bins_count is 1, penalize the "New Bin" option heavily to prevent unnecessary bin creation.
    if bin_residual == bin_capacity && fitting_bins_count > 0 {
        score += 50.0;
    }

    // Progression: As we approach the end of the stream, prioritize tight packing (Best Fit) 
    // over keeping large residuals for potential lookahead.
    let progress = step_index as f64 / total_items as f64;
    score += progress * 20.0;

    // Penalize high open_bins_count to encourage consolidation.
    score += (open_bins_count as f64) * 2.0;

    score
}
