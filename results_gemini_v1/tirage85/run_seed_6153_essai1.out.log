 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    // Objective: Minimize score.
    // Strategy: Best-Fit Decreasing logic combined with lookahead-aware fragmentation penalty.
    
    let is_new_bin = bin_residual == bin_capacity;
    let mut score = post_residual as f64;

    // 1. Penalize new bin opening unless necessary
    if is_new_bin {
        if fitting_bins_count > 0 {
            // Strong penalty for opening a new bin if an existing one fits the item
            score += 150.0;
        } else {
            // Baseline for unavoidable new bin
            score = 50.0;
        }
    }

    // 2. Fragment sensitivity: penalize small remainders that are difficult to fill (1-19 range)
    if post_residual > 0 && post_residual < 20 {
        score += 40.0;
    }

    // 3. Lookahead integration: favor bins that leave space for the next item
    if next_item_size > 0 {
        if post_residual >= next_item_size {
            // Reward bins that can accommodate the next item immediately
            score -= 30.0;
        } else {
            // Penalize bins that block the next item if it's large
            if next_item_size > 50 {
                score += 20.0;
            }
        }
    }

    // 4. Global state adjustment: avoid creating bins that deviate significantly from mean occupancy
    let deviation = (post_residual as f64 - mean_residual).abs();
    score += deviation * 0.1;

    // 5. Progress-aware tightening: become more aggressive (Best-Fit) as we approach the end
    let progress = step_index as f64 / total_items as f64;
    if progress > 0.8 {
        // Near end of stream, prioritize tightest fit (Best-Fit)
        score += post_residual as f64 * 0.5;
    }

    score
}
