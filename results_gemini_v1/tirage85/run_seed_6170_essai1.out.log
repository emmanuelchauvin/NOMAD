 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Best Fit Decreasing logic: Favor bins that result in small residuals (tight packing).
    // We penalize large post_residuals exponentially to discourage leaving wasted space.
    score += (post_residual as f64).powf(1.5);

    // 2. Lookahead Integration: If the next item fits perfectly into the current post_residual,
    // we heavily reward this bin to create a "perfect pair" (Best-Fit-Lookahead).
    if next_item_size > 0 && post_residual >= next_item_size {
        let diff = (post_residual - next_item_size) as f64;
        // Reward small gaps after the next item is placed
        score -= 50.0 * (1.0 / (1.0 + diff));
    }

    // 3. New Bin Penalty: If this is a new bin, apply a significant penalty unless 
    // the current fitting options are extremely poor (i.e., we are forced to open one).
    if bin_residual == bin_capacity {
        // Only open a new bin if the average residual of existing bins is already very tight
        // or if we have no good choices.
        score += 45.0 + (mean_residual * 0.5);
    } else {
        // 4. Balancing: If this bin is a "last chance" (fitting_bins_count == 1), 
        // reduce the score to ensure we don't unnecessarily open a new bin.
        if fitting_bins_count == 1 {
            score -= 20.0;
        }
    }

    // 5. Global density adjustment: As we approach the end of the stream, 
    // become more aggressive about filling bins to reduce the final bin count.
    let progress = step_index as f64 / total_items as f64;
    score += progress * 10.0;

    score
}
