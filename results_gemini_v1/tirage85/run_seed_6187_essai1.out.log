 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Dead Space Penalty: If the post_residual is positive but too small 
    // to fit the smallest possible item (assumed ~10) or specifically 
    // the next item, penalize it heavily to avoid fragmentation.
    if post_residual > 0 {
        if next_item_size > 0 && post_residual < next_item_size {
            score += 50.0 + (next_item_size - post_residual) as f64;
        } else if post_residual < 15 {
            score += 30.0;
        }
    }

    // 2. Open Bin Pressure: Penalize opening a new bin if we have many bins already,
    // but reward filling a bin completely (Best Fit).
    if bin_residual == bin_capacity {
        // High penalty for opening a new bin if we have existing capacity
        score += 40.0 + (open_bins_count as f64 * 2.0);
    } else {
        // Reward bins that are nearly full (Best Fit behavior)
        score -= (bin_capacity - bin_residual) as f64 * 0.5;
    }

    // 3. Lookahead/Contextual Adjustment:
    // If this is the last chance for this bin (fitting_bins_count == 1),
    // and the post_residual is very small, we should favor this bin to 
    // "seal" it rather than leaving it as a medium-empty bin.
    if fitting_bins_count == 1 && post_residual < 10 {
        score -= 20.0;
    }

    // 4. Global Density Awareness:
    // As the stream progresses, favor higher density (lower mean_residual)
    if mean_residual > 0.0 {
        score += mean_residual * 0.2;
    }

    score
}
