 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // 1. Penalize creating "dead space" (small residuals that likely won't fit future items)
    // We prioritize keeping residuals large enough to fit the average or next item.
    if post_residual > 0 && post_residual < 20 {
        score += 45.0;
    }

    // 2. Lookahead optimization: If the post_residual can perfectly or near-perfectly 
    // accommodate the next item, heavily prioritize this bin.
    if next_item_size > 0 {
        let diff = (post_residual as i32 - next_item_size as i32).abs();
        if diff < 5 {
            score -= 30.0;
        }
    }

    // 3. New-bin threshold management: 
    // If this is a new bin (bin_residual == bin_capacity), penalize it unless no 
    // other bin can fit the current item effectively.
    if bin_residual == bin_capacity {
        if fitting_bins_count > 0 {
            // Discourage opening a new bin if existing bins can take the item
            score += 60.0;
        } else {
            // If no other choice, normalize to a neutral-high score
            score = 25.0;
        }
    }

    // 4. Mean residual alignment:
    // Avoid creating bins that deviate significantly from the current average 
    // state of the packing, to maintain homogeneity in bin remaining space.
    let deviation = (post_residual as f64 - mean_residual).abs();
    score += deviation * 0.1;

    // 5. Progression scaling: 
    // As we approach the end of the stream, be more conservative about opening new bins.
    let progress = step_index as f64 / total_items as f64;
    if bin_residual == bin_capacity {
        score += progress * 40.0;
    }

    score
}
