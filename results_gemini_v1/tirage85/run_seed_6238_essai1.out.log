 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items as f64;
    let is_new_bin = bin_residual == bin_capacity;
    
    // Base score: We prefer smaller post_residuals (Best Fit logic).
    let mut score = post_residual as f64;

    // Penalty for opening a new bin: Only do this if the fit is truly abysmal in existing bins.
    if is_new_bin {
        // If we have many options, opening a new bin is usually inefficient.
        // As we near the end of the stream, we become more conservative about opening new bins.
        score = 25.0 + (progress * 50.0) + (open_bins_count as f64 * 0.5);
    } else {
        // Reward bins that are already "fuller" (lower residual) to consolidate space.
        score -= (bin_capacity - bin_residual) as f64 * 0.1;

        // Lookahead: If the next item is large, prioritize bins that have enough space left to accommodate it.
        if next_item_size > 0 {
            if post_residual >= next_item_size {
                score -= 15.0; // Strong reward for "pairing" capability.
            } else if post_residual > 0 && post_residual < 20 {
                // Penalize "sliver" residuals that are too small to be useful.
                score += 10.0;
            }
        }
    }

    // Dynamic adjustment based on global congestion.
    // If the mean residual is high, we are wasting space; be more aggressive in filling bins.
    score += (mean_residual - post_residual as f64) * 0.2;

    // Criticality: If this is the only bin that fits, we must take it (lower the score).
    if fitting_bins_count == 1 && !is_new_bin {
        score -= 40.0;
    }

    score
}
