          "logic_code": "pub fn score_node(job_cpu: u32, job_ram: u32, node_residual_cpu: u32, node_residual_ram: u32, node_capacity_cpu: u32, node_capacity_ram: u32, step_index: usize, total_jobs: usize, active_nodes_count: usize, mean_cpu_residual: f64, mean_ram_residual: f64, next_job_cpu: u32, next_job_ram: u32) -> f64 {\n    let cpu_norm = node_residual_cpu as f64 / node_capacity_cpu as f64;\n    let ram_norm = node_residual_ram as f64 / node_capacity_ram as f64;\n    \n    let imbalance_penalty = (cpu_norm - ram_norm).abs();\n    \n    let residual_score = (node_residual_cpu + node_residual_ram) as f64;\n    let normalization_factor = 1.0 - imbalance_penalty.powi(3);\n    \n    let lookahead_score = if next_job_cpu == 0 && next_job_ram == 0 {\n        0.0\n    } else {\n        let next_cpu_norm = (node_residual_cpu + next_job_cpu) as f64 / node_capacity_cpu as f64;\n        let next_ram_norm = (node_residual_ram + next_job_ram) as f64 / node_capacity_ram as f64;\n        let next_imbalance_penalty = (next_cpu_norm - next_ram_norm).abs();\n        if next_imbalance_penalty < imbalance_penalty {\n            1.0 + (imbalance_penalty - next_imbalance_penalty) * 2.0\n        } else {\n            0.5\n        }\n    };\n    \n    let horizon_score = ((step_index as f64 / total_jobs as f64).powi(3)) * 2.0;\n    \n    let score = residual_score * normalization_factor * lookahead_score * horizon_score;\n    score\n}",
