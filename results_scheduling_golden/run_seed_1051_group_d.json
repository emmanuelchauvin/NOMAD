          "logic_code": "pub fn score_node(job_cpu: u32, job_ram: u32, node_residual_cpu: u32, node_residual_ram: u32, node_capacity_cpu: u32, node_capacity_ram: u32, step_index: usize, total_jobs: usize, active_nodes_count: usize, mean_cpu_residual: f64, mean_ram_residual: f64, next_job_cpu: u32, next_job_ram: u32) -> f64 {\n    let cpu_norm = node_residual_cpu as f64 / node_capacity_cpu as f64;\n    let ram_norm = node_residual_ram as f64 / node_capacity_ram as f64;\n    let imbalance_penalty = (cpu_norm - ram_norm).abs();\n    \n    let time_horizon_factor = ((total_jobs - step_index) as f64 / total_jobs as f64).powf(0.5);\n    let cluster_pressure_factor = if active_nodes_count < 2 {\n        1.0\n    } else {\n        (node_capacity_cpu * node_capacity_ram) as f64 / (active_nodes_count * (mean_cpu_residual * mean_ram_residual)).sqrt()\n    };\n    \n    let lookahead_weight = if step_index == total_jobs - 2 {\n        1.5\n    } else {\n        1.0\n    };\n    \n    let next_job_fit_cpu = node_residual_cpu >= next_job_cpu;\n    let next_job_fit_ram = node_residual_ram >= next_job_ram;\n    let complementary_pairing_bonus = if next_job_fit_cpu && next_job_fit_ram {\n        2.0\n    } else {\n        1.0\n    };\n    \n    // Introduce non-linear conditionals and lookahead packing bonuses\n    let lookahead_packing_bonus = if step_index < total_jobs / 4 {\n        (node_residual_cpu + node_residual_ram) as f64 / (next_job_cpu + next_job_ram) as f64 * 0.5\n    } else {\n        1.0\n    };\n    \n    // Introduce imbalance penalties and horizon-aware placement logic\n    let imbalance_penalty_factor = if imbalance_penalty > 0.2 {\n        1.25\n    } else {\n        1.0\n    };\n    let horizon_weight = (total_jobs - step_index) as f64 / total_jobs as f64;\n    let time_horizon_bonus = time_horizon_factor * horizon_weight;\n    \n    let score = cpu_norm + ram_norm - imbalance_penalty * imbalance_penalty_factor * cluster_pressure_factor + lookahead_weight * complementary_pairing_bonus * lookahead_packing_bonus * time_horizon_bonus;\n    score\n}",
