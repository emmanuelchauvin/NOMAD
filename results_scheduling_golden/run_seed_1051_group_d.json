e_horizon_factor * horizon_weight;\n    \n    // Dead space ratio penalty\n    let dead_space_ratio_cpu = node_capacity_cpu - node_residual_cpu;\n    let dead_space_ratio_ram = node_capacity_ram - node_residual_ram;\n    let dead_space_penalty = (dead_space_ratio_cpu + dead_space_ratio_ram) as f64 / (node_capacity_cpu + node_capacity_ram) as f64;\n    \n    let score = cpu_norm + ram_norm - imbalance_penalty * imbalance_penalty_factor * cluster_pressure_factor + lookahead_weight * complementary_pairing_bonus * time_horizon_bonus - dead_space_penalty;\n    score\n}",
