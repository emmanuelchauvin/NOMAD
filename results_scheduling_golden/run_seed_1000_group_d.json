          "logic_code": "pub fn score_node(job_cpu: u32, job_ram: u32, node_residual_cpu: u32, node_residual_ram: u32, node_capacity_cpu: u32, node_capacity_ram: u32, step_index: usize, total_jobs: usize, active_nodes_count: usize, mean_cpu_residual: f64, mean_ram_residual: f64, next_job_cpu: u32, next_job_ram: u32) -> f64 {\n    let cpu_norm = (node_residual_cpu as f64 - job_cpu as f64) / mean_cpu_residual;\n    let ram_norm = (node_residual_ram as f64 - job_ram as f64) / mean_ram_residual;\n    let imbalance = (cpu_norm - ram_norm).abs();\n    \n    // Non-linear penalty for imbalance\n    let imbalance_penalty = imbalance.powi(2);\n    \n    // Lookahead packing bonus\n    let lookahead_bonus = if next_job_cpu <= node_capacity_cpu && next_job_ram <= node_capacity_ram { 0.1 } else { 0.0 };\n    \n    // Horizon-aware placement logic\n    let horizon_factor = step_index as f64 / total_jobs as f64;\n    let horizon_bonus = if horizon_factor < 0.25 { 0.5 } else if horizon_factor < 0.75 { 0.3 } else { 0.1 };\n    \n    // Node capacity utilization\n    let cpu_utilization = node_residual_cpu as f64 / node_capacity_cpu as f64;\n    let ram_utilization = node_residual_ram as f64 / node_capacity_ram as f64;\n    let capacity_bonus = if cpu_utilization < 0.5 && ram_utilization < 0.5 { 0.2 } else { 0.1 };\n    \n    // Final score calculation\n    let score = imbalance_penalty - lookahead_bonus + horizon_bonus - capacity_bonus;\n    score\n}",
