    "semantic_interface": "AST Seed synthesized by qwen2.5-coder:7b",
    "logic_code": "pub fn score_node(job_cpu: u32, job_ram: u32, node_residual_cpu: u32, node_residual_ram: u32, node_capacity_cpu: u32, node_capacity_ram: u32, step_index: usize, total_jobs: usize, active_nodes_count: usize, mean_cpu_residual: f64, mean_ram_residual: f64, next_job_cpu: u32, next_job_ram: u32) -> f64 {\n    let cpu_norm = node_residual_cpu as f64 / node_capacity_cpu as f64;\n    let ram_norm = node_residual_ram as f64 / node_capacity_ram as f64;\n    let imbalance_penalty = (cpu_norm - ram_norm).abs();\n    \n    // Dynamic horizon awareness\n    let horizon_factor = step_index as f64 / total_jobs as f64;\n    \n    // Lookahead awareness for the next two jobs\n    let lookahead_cpu = next_job_cpu + next_job_cpu; // Assuming the next job is the same as the current one for simplicity\n    let lookahead_ram = next_job_ram + next_job_ram;\n    let can_fit_next_job = node_residual_cpu >= lookahead_cpu && node_residual_ram >= lookahead_ram;\n    \n    let mut score = cpu_norm + ram_norm - imbalance_penalty * horizon_factor;\n    if can_fit_next_job {\n        // Pairing complementary jobs is more beneficial\n        score -= 0.5; // Penalize pairing to avoid resource wastage\n    }\n    \n    score\n}",
