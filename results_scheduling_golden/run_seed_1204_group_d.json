          "name": "LLM-Seed-003-mut-g1-mut-g1-mut-g1-mut-g3-mut-g4",
          "semantic_interface": "Mutated from parent df9700832d6dcb76 at gen 4",
          "logic_code": "pub fn score_node(job_cpu: u32, job_ram: u32, node_residual_cpu: u32, node_residual_ram: u32, node_capacity_cpu: u32, node_capacity_ram: u32, step_index: usize, total_jobs: usize, active_nodes_count: usize, mean_cpu_residual: f64, mean_ram_residual: f64, next_job_cpu: u32, next_job_ram: u32) -> f64 {\n    let cpu_norm = node_residual_cpu as f64 / node_capacity_cpu.max(1) as f64;\n    let ram_norm = node_residual_ram as f64 / node_capacity_ram.max(1) as f64;\n    let imbalance = (cpu_norm - ram_norm).abs();\n\n    let capacity_utilization = 1.0 - ((node_residual_cpu + job_cpu) as f64 / node_capacity_cpu.min(node_residual_cpu + job_cpu) as f64);\n    let time_horizon_factor = step_index as f64 / total_jobs as f64;\n    let lookahead_bonus = (next_job_cpu as f64 + next_job_ram as f64) * (1.0 - imbalance);\n\n    // Combine residual fitting with lookahead anticipation\n    let residual_fit_penalty = ((node_residual_cpu - job_cpu).powi(2) + (node_residual_ram - job_ram).powi(2)) as f64 / (node_capacity_cpu.max(node_capacity_ram) as f64);\n    let lookahead_packing_bonus = if next_job_cpu < node_residual_cpu && next_job_ram < node_residual_ram { 1.0 } else { 0.5 };\n\n    let score = cpu_norm + ram_norm - imbalance - capacity_utilization * time_horizon_factor + lookahead_bonus - residual_fit_penalty * lookahead_packing_bonus;\n\n    score\n}",
