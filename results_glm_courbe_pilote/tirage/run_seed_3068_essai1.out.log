 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Perfect fit bonus
    if post_residual == 0 {
        score -= 500.0;
    }

    // 2-step lookahead: strongly reward when next item exactly fills post_residual
    if next_item_size > 0 {
        if post_residual == next_item_size {
            score -= 400.0;
        } else if post_residual >= next_item_size {
            // next item fits: mild reward proportional to leftover after next
            let after_next = post_residual - next_item_size;
            score -= 100.0 + after_next as f64 * 0.5;
        } else {
            // dead space for next item: penalize the unusable gap
            let gap = next_item_size - post_residual;
            score += gap as f64 * 2.0;
        }
    }

    // Penalize small unusable residuals relative to typical item sizes
    if post_residual > 0 && post_residual < 10 {
        score += 60.0;
    }

    // Compare residual against mean residual: prefer filling below-mean (wasted) bins
    score -= (mean_residual - post_residual as f64) * 0.3;

    // Last-chance bin: strongly favor using it to avoid opening a new bin
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 150.0;
    }

    // New-bin candidate: keep it neutral-ish, only attractive when current fit is bad
    if bin_residual == bin_capacity {
        score += 80.0;
    }

    // Late in stream: prefer closing bins tightly
    let progress = step_index as f64 / total_items.max(1) as f64;
    score -= progress * 20.0 * (bin_capacity - bin_residual) as f64 / bin_capacity as f64;

    score
}
