 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Perfect fit reward
    if post_residual == 0 {
        score -= 1000.0;
    }

    // 2-step lookahead: if next item fits exactly in post_residual, strong reward
    if next_item_size > 0 && post_residual >= next_item_size {
        let gap = post_residual - next_item_size;
        if gap == 0 {
            score -= 900.0;
        } else {
            score -= 200.0 / (gap as f64 + 1.0);
        }
    }

    // Penalize small unusable dead space (waste) when next item can't use it
    if next_item_size > 0 && post_residual < next_item_size && post_residual > 0 {
        let tightness = post_residual as f64 / next_item_size as f64;
        score += 60.0 * (1.0 - tightness);
    }

    // Reward bins tighter than mean residual (good fits)
    score -= (mean_residual - post_residual as f64) * 0.5;

    // Last-chance bin bonus: only bin that fits the item
    if fitting_bins_count == 1 && bin_residual >= item_size {
        score -= 400.0;
    }

    // New bin candidate: only prefer when current bin would leave big waste
    let is_new_bin = bin_residual == bin_capacity;
    if is_new_bin {
        // penalize opening new bin mildly, unless it enables a good 2-step chain
        score += 150.0;
        if next_item_size > 0 && post_residual >= next_item_size {
            score -= 250.0;
        }
        // late in stream, prefer reusing open bins
        let progress = step_index as f64 / total_items.max(1) as f64;
        score += 100.0 * progress;
    }

    // Slight penalty for very fragmented open-bin pools
    score += open_bins_count as f64 * 0.5;

    score
}
