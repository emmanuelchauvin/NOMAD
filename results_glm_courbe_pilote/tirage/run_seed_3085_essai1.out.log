 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Perfect fit reward
    if post_residual == 0 {
        score -= 500.0;
    }

    // 2-step lookahead: reward exact match of next item into post_residual
    if next_item_size > 0 && post_residual >= next_item_size {
        let next_fit = post_residual - next_item_size;
        if next_fit == 0 {
            score -= 400.0; // chain perfect fit
        } else {
            score -= 150.0 * (1.0 - (next_fit as f64) / (bin_capacity as f64));
        }
    } else if next_item_size > 0 {
        // next item won't fit here: penalize dead space creation
        score += 40.0;
    }

    // Last-chance bin bonus: avoid opening a new bin when this is the only fitting bin
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 120.0;
    }

    // Penalize bins far from mean residual (prefer balanced usage)
    let dev = (post_residual as f64 - mean_residual).abs();
    score += 0.3 * dev;

    // New-bin candidate: only attractive when open bins fit poorly
    let is_new_bin = bin_residual == bin_capacity;
    if is_new_bin {
        let waste = (bin_residual - item_size) as f64;
        // base penalty to prefer existing bins
        score += 60.0;
        // if few fitting bins and this fit is bad, encourage new bin
        if fitting_bins_count <= 1 {
            score -= 200.0;
        }
        // encourage new bin when post_residual would be tiny dead space in existing bins
        if next_item_size > 0 && post_residual > 0 && post_residual < next_item_size {
            score -= 100.0;
        }
        // reward large leftover in new bin (usable for future items)
        score -= 0.2 * waste;
    }

    // Tight fit preference: smaller post_residual relative to item size is good
    score += 0.1 * (post_residual as f64);

    // Late in stream: consolidate, prefer filling existing bins tightly
    let progress = step_index as f64 / total_items.max(1) as f64;
    if progress > 0.7 {
        score -= 30.0 * progress;
    }

    score
}
