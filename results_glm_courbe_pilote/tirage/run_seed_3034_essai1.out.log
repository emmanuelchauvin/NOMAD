 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Strict dead-space avoidance: residuals that are too small to ever
    // hold another item (min item size 1..100 unknown, but tiny gaps are
    // almost always waste) are heavily penalized.
    if post_residual > 0 && post_residual < 12 {
        score += (12.0 - post_residual as f64) * 6.0;
    }

    // Perfect fit is gold.
    if post_residual == 0 {
        score -= 40.0;
    } else {
        // Reward tight fits relative to bin capacity.
        let tightness = 1.0 - (post_residual as f64 / bin_capacity as f64);
        score -= tightness * 8.0;
    }

    // Dead space is worse if the next item cannot use it.
    if next_item_size > 0 && post_residual > 0 && post_residual < next_item_size {
        score += (next_item_size - post_residual) as f64 * 2.0;
    }
    // Reward when the residual can host the lookahead item.
    if next_item_size > 0 && post_residual >= next_item_size && post_residual < next_item_size * 2 {
        score -= 6.0;
    }

    // Last chance bin: strongly prefer using it before opening a new bin.
    if fitting_bins_count == 1 && bin_residual >= item_size {
        score -= 25.0;
    }

    // Open-bin pressure: with many bins open, avoid spreading residual
    // capacity; favor filling existing bins.
    let progress = if total_items > 0 { step_index as f64 / total_items as f64 } else { 0.0 };
    score += open_bins_count as f64 * 0.4 * (0.5 + progress);

    // Prefer bins below the mean residual (fill the emptier-tail bins less,
    // keep tight bins tight) — actually favor bins whose residual is BELOW
    // mean (they are already tight): penalize placing into very loose bins.
    if (bin_residual as f64) > mean_residual * 1.25 && bin_residual != bin_capacity {
        score += 5.0;
    }

    // New empty bin candidate: neutral baseline with a mild penalty so it is
    // only chosen when existing bins fit poorly (large dead space or none fit).
    if bin_residual == bin_capacity {
        score += 18.0;
        // Late in the stream, opening a new bin is less costly than wrecking
        // a usable residual — soften the penalty as progress increases.
        score -= progress * 10.0;
    }

    score
}
