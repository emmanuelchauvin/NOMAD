 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Strict dead-space avoidance: gaps too small to ever host a realistic item are poison.
    let min_item = 1u32;
    let dead_threshold = if next_item_size > min_item { next_item_size } else { min_item };
    if post_residual > 0 && post_residual < dead_threshold {
        score += 60.0 * (dead_threshold - post_residual) as f64;
    }

    // Perfect fit: strongly reward zero post residual.
    if post_residual == 0 {
        score -= 150.0;
    }

    // Tightness reward: the closer the fill, the better (non-linear coupling).
    let fill = item_size as f64 / bin_residual.max(1) as f64;
    score -= 40.0 * fill * fill;

    // Penalize leaving large-but-awkward gaps: post residual in (0, 10) is near-dead.
    if post_residual > 0 && post_residual < 10 {
        score += 25.0;
    }

    // Last-chance bin: if this is the only fitting bin, avoid opening a new one.
    if fitting_bins_count == 1 && bin_residual >= item_size {
        score -= 55.0;
    }

    // Open-bin pressure: when many bins are open, discourage opening new bins;
    // when few bins are open, mild encouragement of consolidation.
    let progress = step_index as f64 / total_items.max(1) as f64;
    let new_bin_bonus = 30.0 * (1.0 - progress) + 2.0 * open_bins_count as f64;
    if bin_residual == bin_capacity {
        // Brand-new bin candidate: base cost so it only wins when open bins are unattractive.
        score += 20.0 + new_bin_bonus;
        // But if the next item exactly fills the remainder after this placement, new bin is great.
        if next_item_size > 0 && post_residual == next_item_size {
            score -= 80.0;
        }
    }

    // Mean-residual coupling: prefer bins whose residual is below the mean (tighter bins),
    // penalize dumping into the loosest bin.
    let bin_res_f = bin_residual as f64;
    if bin_res_f < mean_residual {
        score -= 8.0;
    } else if bin_res_f > mean_residual * 1.5 {
        score += 6.0;
    }

    // Late in the stream, close out bins aggressively: reward near-full placements more.
    if progress > 0.8 && post_residual <= 15 {
        score -= 20.0;
    }

    score
}
