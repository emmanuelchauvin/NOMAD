 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Perfect fit: overwhelmingly reward closing the bin exactly.
    if post_residual == 0 {
        score -= 1000.0;
    }

    // 2-step lookahead: reward if the next item exactly matches the post residual.
    if next_item_size > 0 {
        if next_item_size == post_residual {
            score -= 500.0;
        } else if next_item_size < post_residual {
            // Next item fits here: reward proportionally to how tight the pair is.
            score -= 120.0 * (next_item_size as f64 / post_residual as f64);
        } else {
            // Next item cannot use this residual: penalize leaving dead space.
            score += 0.5 * (post_residual as f64) * (next_item_size as f64 / bin_capacity as f64);
        }
    }

    // Tightness reward: smaller post residual relative to capacity is better.
    score -= 30.0 * (1.0 - post_residual as f64 / bin_capacity as f64);

    // Last-chance bin: strongly favor using it to avoid opening a new bin.
    if fitting_bins_count == 1 && bin_residual < bin_capacity {
        score -= 200.0;
    }

    // Compare against mean residual: penalize bins far below mean (wasting a tight bin),
    // mildly favor bins with residual close to mean.
    let diff = post_residual as f64 - mean_residual;
    score += 0.15 * diff;

    // New-bin candidate: neutral-ish baseline, only attractive when the item is large
    // (poor fit anywhere) or when current bins are nearly full on average.
    if bin_residual == bin_capacity {
        let pressure = mean_residual / bin_capacity as f64; // high => bins nearly full
        let large_item = item_size as f64 / bin_capacity as f64;
        score = 60.0 - 40.0 * pressure - 30.0 * large_item;
        if next_item_size > 0 && next_item_size >= item_size {
            // A fresh bin can also host the next big item: slight bonus.
            score -= 10.0;
        }
        if post_residual == 0 {
            score -= 1000.0; // exact fill of a fresh bin
        }
    }

    score
}
