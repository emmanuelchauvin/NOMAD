        };
        score += (reusable_excess * reusable_excess / capacity.max(1.0) * 0.035).min(18.0);
    } else {
        let fill_ratio = 1.0 - residual / capacity;
        let relative_residual = residual / capacity;
        score -= 142.0 * fill_ratio;

        let dead_space_penalty = if residual > 0.0 && residual < 7.0 {
            (7.0 - residual) * 6.4
        } else if residual > 0.0 && residual < item {
            (item - residual) * 2.35
        } else {
            0.0
        };
        score += dead_space_penalty;

        if residual == 0.0 {
            score -= 43.0;
        } else if residual < item {
