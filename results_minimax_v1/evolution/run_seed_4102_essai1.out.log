        if progress > 0.94 {
            score -= 9.0;
        }

        let demand_mismatch = (item - mean_residual).abs();
        score += (demand_mismatch * demand_mismatch * 0.018).min(24.0);

        let reusable_excess = if next > 0.0 {
            (capacity - item - next).max(0.0)
