                } else if leftover <= 18.0 {
                    score -= 4.0;
                }
            }
        }

        if residual > 0.0 && residual < item {
            score += (residual / item.min(capacity)) * 18.0;
        }

        if residual_gap > 0.0 {
            score += residual_gap * residual_gap * 0.22;
        } else if residual_gap < 0.0 {
            score += residual_gap * 0.9;
        }

        if residual > 0.0 && residual < item {
