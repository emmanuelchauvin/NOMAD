            score += band * 0.75;
        }

        let useful_floor = if next > 0.0 { next } else { item.min(8.0) };
        if residual > 0.0 {
            if residual < useful_floor {
                let unusable = (useful_floor - residual).min(residual);
                score += unusable * 1.18;
