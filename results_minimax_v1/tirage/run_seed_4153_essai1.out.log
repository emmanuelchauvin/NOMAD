 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    let capacity = bin_capacity.max(1) as f64;
    let item = item_size as f64;
    let residual = bin_residual as f64;
    let next = next_item_size as f64;
    let progress = step_index as f64 / total_items.max(1) as f64;

    let is_new_bin = bin_residual >= bin_capacity;
    let dead_space = if post_residual > 0 && post_residual < item.min(next.max(1.0)) {
        (post_residual as f64).min(item.min(next.max(1.0)))
    } else {
        0.0
    };

    score += dead_space * 7.0;
    score += (post_residual as f64 / capacity).powi(2) * 18.0;

    if post_residual == 0 {
        score -= 28.0;
    }

    if is_new_bin {
        score += 12.0;
        score += (open_bins_count as f64).max(0.0).sqrt() * 1.5;
        score -= progress * 3.0;
    } else {
        let utilization = 1.0 - residual / capacity;
        score -= utilization * 9.0;

        if fitting_bins_count == 1 {
            score -= 22.0;
        }

        if next > 0.0 && post_residual >= next {
            score -= 6.0;
        } else if next > 0.0 && post_residual > 0.0 && post_residual < next {
            score += 8.0;
        }

        score += ((mean_residual - post_residual as f64) / capacity).abs() * 4.0;
        score += (mean_residual / capacity) * 2.0;
    }

    if open_bins_count == 0 && !is_new_bin {
        score += 20.0;
    }

    score
}
