 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    let progress = if total_items == 0 {
        0.0
    } else {
        step_index as f64 / total_items as f64
    };

    // Small residuals are likely to become unusable dead space.
    if post_residual > 0 && post_residual < 10 {
        score += 80.0;
    } else if post_residual > 0 && post_residual < 20 {
        score += 35.0;
    } else if post_residual > 0 && post_residual < 30 {
        score += 12.0;
    }

    // Strongly prefer exact fills and near-perfect consolidation.
    if post_residual == 0 {
        score -= 100.0;
    } else if post_residual <= 5 {
        score -= 35.0;
    }

    // A new empty bin has a large residual by definition, so make its score
    // reflect the opportunity cost rather than directly opening it.
    let is_new_bin = bin_residual == bin_capacity;
    if is_new_bin {
        score += 25.0;
        if open_bins_count == 0 {
            score -= 125.0;
        }
    }

    // If this is the only fitting bin, avoid creating an avoidable dead gap.
    if fitting_bins_count == 1 && post_residual > 0 && post_residual < 20 {
        score += 45.0;
    }

    // With many open bins, consolidate aggressively and resist opening more.
    let pressure = (open_bins_count as f64).sqrt();
    if open_bins_count > 1 {
        score -= 3.0 * pressure;
        if post_residual == 0 {
            score -= 8.0 * pressure;
        }
        if is_new_bin {
            score += 15.0 * pressure;
        }
    } else if open_bins_count == 0 {
        score -= 30.0;
    }

    // Use the mean residual to favor placements that move the population
    // toward tighter bins, especially in the latter part of a long stream.
    let mean_gap = mean_residual - post_residual as f64;
    score -= 0.12 * mean_gap;
    if progress > 0.5 && mean_residual < 30.0 {
        score -= 5.0;
    }

    // Lookahead: preserve space when the next item is substantially larger.
    if next_item_size > 0 {
        let size_gap = next_item_size as f64 - item_size as f64;
        if size_gap > 0.0 {
            score += 0.20 * size_gap;
        }
        if post_residual < next_item_size && post_residual > 0 {
            score += 10.0;
        }
    }

    score
}
