 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    let dead_space_penalty = if post_residual == 0 {
        0.0
    } else if post_residual < next_item_size && next_item_size > 0 {
        (next_item_size - post_residual) as f64 * 4.0
    } else if post_residual < 10 {
        12.0
    } else if post_residual < 20 {
        6.0
    } else {
        (post_residual as f64 - 20.0).max(0.0) * 0.35
    };

    score += dead_space_penalty;

    let fit_scarcity = if fitting_bins_count == 0 {
        1000.0
    } else if fitting_bins_count == 1 {
        18.0
    } else {
        0.0
    };
    score += fit_scarcity;

    let pressure = if open_bins_count == 0 {
        0.0
    } else {
        (open_bins_count as f64).ln() * 2.0
    };
    score += pressure;

    let mean_gap_penalty = if mean_residual < 20.0 {
        (20.0 - mean_residual) * 0.8
    } else {
        0.0
    };
    score += mean_gap_penalty;

    if step_index + 1 >= total_items && next_item_size == 0 {
        score += (post_residual as f64) * 0.15;
    }

    if bin_residual == bin_capacity {
        score -= 14.0;
    }

    score
}
