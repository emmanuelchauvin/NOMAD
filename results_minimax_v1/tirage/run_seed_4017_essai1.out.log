 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;
    let capacity = bin_capacity as f64;
    let item = item_size as f64;

    // Strictly penalize residual gaps that are unlikely to be useful.
    let next = next_item_size as f64;
    if next > 0.0 && post_residual > 0.0 && post_residual < next {
        score += (next - post_residual as f64) * 3.0;
    }
    if post_residual > 0.0 && post_residual < 20.0 {
        score += (20.0 - post_residual as f64) * 1.5;
    }
    if post_residual == 0 {
        score -= 8.0;
    }

    // Prefer placements that preserve bins with broadly useful capacity.
    score += (mean_residual - post_residual as f64) * 0.35;

    // Pressure to use existing bins rises as the stream becomes longer.
    let progress = if total_items == 0 {
        0.0
    } else {
        step_index as f64 / total_items as f64
    };
    score -= open_bins_count as f64 * (0.25 + 0.75 * progress);

    // A last fitting opportunity deserves a strong preference, unless the new
    // bin has materially better future capacity.
    if fitting_bins_count == 1 && bin_residual < bin_capacity {
        score -= 18.0 + 4.0 * progress;
    }

    // Do not create a new bin when an existing placement has little dead space.
    if bin_residual == bin_capacity && open_bins_count > 0 {
        score += 10.0;
    }

    // Very large residuals are wasteful, but less so when the lookahead is large.
    if post_residual > 40.0 {
        score += (post_residual as f64 - 40.0) * 0.25;
        if next > 0.0 && post_residual as f64 >= next {
            score -= 3.0;
        }
    }

    // Prefer using a reasonably tight bin over leaving a large open remainder.
    score += (capacity - bin_residual as f64 - item).max(0.0) * 0.02;

    score
}
