 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    let progress = if total_items == 0 {
        1.0
    } else {
        (step_index as f64 / total_items as f64).clamp(0.0, 1.0)
    };

    let pressure = (open_bins_count as f64).sqrt();
    score += pressure * 3.0;

    let unusable = if post_residual == 0 {
        0.0
    } else if post_residual < item_size.min(next_item_size.max(1)) {
        post_residual as f64
    } else {
        0.0
    };
    score += unusable * 8.0;

    if fitting_bins_count == 1 {
        score -= 18.0;
    }

    if bin_residual == bin_capacity {
        score += 12.0;
    }

    let deviation = (mean_residual - post_residual as f64).abs();
    score += deviation * 0.8;

    if next_item_size == 0 {
        score -= post_residual as f64 * 0.2;
    } else {
        let next_fit = if post_residual >= next_item_size {
            1.0
        } else {
            0.0
        };
        score -= next_fit * 4.0;

        if post_residual > 0 && post_residual < next_item_size {
            score += (next_item_size - post_residual) as f64 * 0.35;
        }
    }

    score += (1.0 - progress) * 0.5;
    score
}
