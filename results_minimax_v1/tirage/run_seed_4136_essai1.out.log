 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    if post_residual > 0 && post_residual < next_item_size && next_item_size > 0 {
        score += (post_residual as f64).powi(2) * 1.35;
    } else if post_residual > 0 && post_residual < 10 {
        score += (10.0 - post_residual as f64) * 1.8;
    }

    let pressure = open_bins_count as f64 / (total_items.max(1) as f64).sqrt();
    score += pressure * 4.0;

    if fitting_bins_count <= 1 {
        score += 18.0;
    }

    if bin_residual == bin_capacity {
        score += 12.0;
    }

    score += (post_residual as f64 - mean_residual).abs() * 0.18;
    score -= (step_index as f64 / total_items.max(1) as f64) * 0.5;

    score
}
