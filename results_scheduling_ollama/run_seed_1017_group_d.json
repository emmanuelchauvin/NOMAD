          "semantic_interface": "Mutated from parent c8bd95a4fe4077f3 at gen 4",
          "logic_code": "pub fn score_node(job_cpu: u32, job_ram: u32, node_residual_cpu: u32, node_residual_ram: u32, node_capacity_cpu: u32, node_capacity_ram: u32, step_index: usize, total_jobs: usize, active_nodes_count: usize, mean_cpu_residual: f64, mean_ram_residual: f64, next_job_cpu: u32, next_job_ram: u32) -> f64 {\n    let cpu_norm = node_residual_cpu as f64 / node_capacity_cpu as f64;\n    let ram_norm = node_residual_ram as f64 / node_capacity_ram as f64;\n    let imbalance_penalty = (cpu_norm - ram_norm).abs();\n    \n    // Non-linear conditionals and lookahead bonuses/penalties\n    let lookahead_bonus = if next_job_cpu <= node_residual_cpu && next_job_ram <= node_residual_ram { 0.3 } else { 0.0 };\n    let cpu_imbalance_penalty = if cpu_norm > 1.0 { (cpu_norm - 1.0) * 5.0 } else { 0.0 };\n    let ram_imbalance_penalty = if ram_norm > 1.0 { (ram_norm - 1.0) * 5.0 } else { 0.0 };\n    \n    // Fine-grained residual fitting with lookahead anticipation\n    let cpu_fit_score = -(node_residual_cpu as f64 / mean_cpu_residual).powi(2);\n    let ram_fit_score = -(node_residual_ram as f64 / mean_ram_residual).powi(2);\n    let lookahead_fit_bonus = if next_job_cpu <= node_residual_cpu && next_job_ram <= node_residual_ram {\n        -((next_job_cpu as f64 / (node_capacity_cpu - node_residual_cpu) as f64).powi(2) + \n          (next_job_ram as f64 / (node_capacity_ram - node_residual_ram) as f64).powi(2)) * 0.5\n    } else { 0.0 };\n    \n    // Horizon-aware placement logic\n    let time_horizon_factor = step_index as f64 / total_jobs as f64;\n    let node_utilization = 1.0 - (node_residual_cpu as f64 + node_residual_ram as f64) / (node_capacity_cpu as f64 + node_capacity_ram as f64);\n    \n    // Combined score\n    let score = -(cpu_norm + ram_norm) * 0.5 + imbalance_penalty * 0.5 +\n                lookahead_bonus -\n                cpu_imbalance_penalty -\n                ram_imbalance_penalty +\n                time_horizon_factor * 0.1 +\n                node_utilization * 0.3 +\n                cpu_fit_score * 0.2 +\n                ram_fit_score * 0.2 +\n                lookahead_fit_bonus;\n    \n    score\n}",
