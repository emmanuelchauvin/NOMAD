          "name": "LLM-Seed-002-mut-g4",
          "semantic_interface": "Mutated from parent 3fe3742c7d93f4d7 at gen 4",
          "logic_code": "pub fn score_node(job_cpu: u32, job_ram: u32, node_residual_cpu: u32, node_residual_ram: u32, node_capacity_cpu: u32, node_capacity_ram: u32, step_index: usize, total_jobs: usize, active_nodes_count: usize, mean_cpu_residual: f64, mean_ram_residual: f64, next_job_cpu: u32, next_job_ram: u32) -> f64 {\n    let cpu_norm = node_residual_cpu as f64 / node_capacity_cpu as f64;\n    let ram_norm = node_residual_ram as f64 / node_capacity_ram as f64;\n    \n    let resource_imbalance_penalty = (cpu_norm - ram_norm).abs();\n    \n    // Non-linear conditionals\n    let cpu_overload_penalty = if cpu_norm > 0.9 { (cpu_norm - 0.9) * 10.0 } else { 0.0 };\n    let ram_overload_penalty = if ram_norm > 0.9 { (ram_norm - 0.9) * 10.0 } else { 0.0 };\n    \n    // Lookahead packing bonuses\n    let next_job_total = next_job_cpu + next_job_ram;\n    let lookahead_bonus = if node_residual_cpu >= next_job_cpu && node_residual_ram >= next_job_ram {\n        next_job_total as f64 * (1.0 - cpu_norm) * (1.0 - ram_norm)\n    } else { 0.0 };\n    \n    // Imbalance penalties\n    let imbalance_penalty = resource_imbalance_penalty * total_jobs as f64;\n    \n    // Horizon-aware placement logic\n    let horizon_factor = step_index as f64 / total_jobs as f64;\n    let horizon_bonus = if active_nodes_count < total_jobs / 2 { 1.0 - horizon_factor } else { 0.0 };\n    \n    // Combine all components into the final score\n    let score = cpu_norm + ram_norm - resource_imbalance_penalty - cpu_overload_penalty - ram_overload_penalty + lookahead_bonus - imbalance_penalty + horizon_bonus;\n    \n    score\n}",
