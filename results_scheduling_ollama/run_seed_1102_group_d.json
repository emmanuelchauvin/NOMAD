          "logic_code": "pub fn score_node(job_cpu: u32, job_ram: u32, node_residual_cpu: u32, node_residual_ram: u32, node_capacity_cpu: u32, node_capacity_ram: u32, step_index: usize, total_jobs: usize, active_nodes_count: usize, mean_cpu_residual: f64, mean_ram_residual: f64, next_job_cpu: u32, next_job_ram: u32) -> f64 {\n    let cpu_norm = node_residual_cpu as f64 / (node_capacity_cpu.max(1) * 0.8) as f64;\n    let ram_norm = node_residual_ram as f64 / (node_capacity_ram.max(1) * 0.8) as f64;\n\n    // Fine-grained residual fitting\n    let cpu_resid_penalty = ((cpu_norm - mean_cpu_residual).abs() / mean_cpu_residual).min(1.0);\n    let ram_resid_penalty = ((ram_norm - mean_ram_residual).abs() / mean_ram_residual).min(1.0);\n\n    // Lookahead anticipation\n    let lookahead_bonus = if next_job_cpu <= node_capacity_cpu && next_job_ram <= node_capacity_ram { 0.5 } else { -0.2 };\n\n    // Imbalance penalty\n    let imbalance_penalty = ((cpu_norm - ram_norm).abs() * 10.0).min(1.0);\n\n    // Time horizon factor\n    let time_horizon_factor = (step_index as f64 / total_jobs as f64).powf(2.0);\n\n    let score = cpu_norm + ram_norm - cpu_resid_penalty - ram_resid_penalty - imbalance_penalty + lookahead_bonus + time_horizon_factor;\n    score\n}",
