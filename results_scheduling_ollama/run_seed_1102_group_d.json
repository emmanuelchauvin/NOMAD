    "name": "LLM-Seed-001-mut-g1-mut-g3-mut-g4",
    "semantic_interface": "Mutated from parent be97a9a6268cf4bb at gen 4",
    "logic_code": "pub fn score_node(job_cpu: u32, job_ram: u32, node_residual_cpu: u32, node_residual_ram: u32, node_capacity_cpu: u32, node_capacity_ram: u32, step_index: usize, total_jobs: usize, active_nodes_count: usize, mean_cpu_residual: f64, mean_ram_residual: f64, next_job_cpu: u32, next_job_ram: u32) -> f64 {\n    let cpu_norm = node_residual_cpu as f64 / node_capacity_cpu.max(1) as f64;\n    let ram_norm = node_residual_ram as f64 / node_capacity_ram.max(1) as f64;\n    let imbalance_penalty = (cpu_norm - ram_norm).abs() * 0.5;\n    let lookahead_bonus = if step_index < total_jobs { next_job_cpu as f64 + next_job_ram as f64 } else { 0.0 };\n    let node_utilization = (node_capacity_cpu - node_residual_cpu) as f64 / node_capacity_cpu as f64;\n    let residual_ratio = (node_residual_cpu as f64 / mean_cpu_residual).min(1.0);\n    let score = cpu_norm + ram_norm - imbalance_penalty + lookahead_bonus * node_utilization * residual_ratio;\n    score\n}",
