          "semantic_interface": "Mutated from parent a84343c40db4a315 at gen 2",
          "logic_code": "pub fn score_node(job_cpu: u32, job_ram: u32, node_residual_cpu: u32, node_residual_ram: u32, node_capacity_cpu: u32, node_capacity_ram: u32, step_index: usize, total_jobs: usize, active_nodes_count: usize, mean_cpu_residual: f64, mean_ram_residual: f64, next_job_cpu: u32, next_job_ram: u32) -> f64 {\n    let cpu_norm = node_residual_cpu as f64 / node_capacity_cpu as f64;\n    let ram_norm = node_residual_ram as f64 / node_capacity_ram as f64;\n    \n    // Penalize resource imbalance\n    let imbalance_penalty = (cpu_norm - ram_norm).abs() * 10.0; // Increase penalty weight\n    \n    // Normalize residuals\n    let cpu_score = node_residual_cpu as f64 / mean_cpu_residual;\n    let ram_score = node_residual_ram as f64 / mean_ram_residual;\n    \n    // Dynamic horizon awareness\n    let dynamic_horizon = step_index as f64 / total_jobs as f64 * 2.0; // Increase weight\n    \n    // Lookahead awareness (k=3)\n    let lookahead_penalty = if node_residual_cpu >= next_job_cpu && node_residual_ram >= next_job_ram {\n        0.0\n    } else {\n        1.5 // Increase penalty for lookahead violation\n    };\n    \n    // Non-linear conditionals\n    let cpu_overflow_penalty = if node_residual_cpu < job_cpu { (job_cpu - node_residual_cpu) as f64 * 2.0 } else { 0.0 }; // Penalize CPU overflow\n    let ram_overflow_penalty = if node_residual_ram < job_ram { (job_ram - node_residual_ram) as f64 * 2.0 } else { 0.0 }; // Penalize RAM overflow\n    \n    // Packing bonus for lookahead jobs\n    let packing_bonus = if node_residual_cpu >= next_job_cpu && node_residual_ram >= next_job_ram {\n        node_residual_cpu as f64 * node_residual_ram as f64 * 0.25 // Bonus for fitting both in the same node\n    } else {\n        0.0\n    };\n    \n    // Combine all scores\n    let score = cpu_score + ram_score - imbalance_penalty * dynamic_horizon + lookahead_penalty + cpu_overflow_penalty + ram_overflow_penalty + packing_bonus;\n    \n    score\n}",
