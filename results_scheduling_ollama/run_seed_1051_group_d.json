    "id": "f622cc34a07eef49",
    "name": "LLM-Seed-002-mut-g1-mut-g1-mut-g1",
    "semantic_interface": "Mutated from parent b6e1d2493b961fc9 at gen 1",
    "logic_code": "pub fn score_node(job_cpu: u32, job_ram: u32, node_residual_cpu: u32, node_residual_ram: u32, node_capacity_cpu: u32, node_capacity_ram: u32, step_index: usize, total_jobs: usize, active_nodes_count: usize, mean_cpu_residual: f64, mean_ram_residual: f64, next_job_cpu: u32, next_job_ram: u32) -> f64 {\n    let cpu_norm = node_residual_cpu as f64 / node_capacity_cpu as f64;\n    let ram_norm = node_residual_ram as f64 / node_capacity_ram as f64;\n    let imbalance_penalty = (cpu_norm - ram_norm).abs();\n    \n    // Dynamic horizon awareness\n    let step_fraction = step_index as f64 / total_jobs as f64;\n    let dynamic_factor = 1.0 + (step_fraction * 0.5); // Adjust factor based on step\n    \n    // Lookahead awareness for next job\n    let next_job_norm_cpu = next_job_cpu as f64 / node_capacity_cpu as f64;\n    let next_job_norm_ram = next_job_ram as f64 / node_capacity_ram as f64;\n    \n    // Non-linear conditionals based on lookahead\n    if next_job_cpu <= node_residual_cpu && next_job_ram <= node_residual_ram {\n        dynamic_factor *= 1.2; // Favor nodes that can fit the next job\n    } else if (next_job_norm_cpu + next_job_norm_ram) > (cpu_norm + ram_norm) {\n        dynamic_factor /= 0.8; // Penalize nodes where next job does not improve balance\n    }\n    \n    // Combine fine-grained residual fitting with lookahead anticipation\n    let residual_ratio = (node_residual_cpu * node_residual_ram) as f64 / (node_capacity_cpu * node_capacity_ram) as f64;\n    let lookahead_penalty = if residual_ratio < 0.2 {\n        dynamic_factor * 1.5 // Penalize nodes with low residual space\n    } else if residual_ratio > 0.8 {\n        dynamic_factor * 0.7 // Favor nodes with high residual space\n    } else {\n        dynamic_factor\n    };\n    \n    // Fine-tuned thresholds for bin residual space or dead space ratio\n    let residual_score = if residual_ratio < 0.3 {\n        dynamic_factor * 1.8 // Strongly penalize nodes with very low residual space\n    } else if residual_ratio > 0.7 {\n        dynamic_factor * 0.6 // Mildly favor nodes with high residual space\n    } else {\n        dynamic_factor\n    };\n    \n    let score = (cpu_norm + ram_norm) / 2.0 + imbalance_penalty * lookahead_penalty * residual_score;\n    score\n}",
