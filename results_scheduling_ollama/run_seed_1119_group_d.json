    "logic_code": "pub fn score_node(job_cpu: u32, job_ram: u32, node_residual_cpu: u32, node_residual_ram: u32, node_capacity_cpu: u32, node_capacity_ram: u32, step_index: usize, total_jobs: usize, active_nodes_count: usize, mean_cpu_residual: f64, mean_ram_residual: f64, next_job_cpu: u32, next_job_ram: u32) -> f64 {\n    let cpu_norm = node_residual_cpu as f64 / node_capacity_cpu as f64;\n    let ram_norm = node_residual_ram as f64 / node_capacity_ram as f64;\n    let imbalance_penalty = (cpu_norm - ram_norm).abs();\n    \n    let step_ratio = step_index as f64 / total_jobs as f64;\n    let dynamic_horizon_factor = 1.0 + 2.0 * step_ratio * (1.0 - step_ratio);\n    \n    let next_job_fit_cpu = node_residual_cpu >= next_job_cpu;\n    let next_job_fit_ram = node_residual_ram >= next_job_ram;\n    \n    // Lookahead penalties and bonuses\n    let lookahead_penalty = if next_job_fit_cpu && next_job_fit_ram {\n        0.0\n    } else if next_job_fit_cpu || next_job_fit_ram {\n        1.0\n    } else {\n        2.0\n    };\n    \n    let lookahead_bonus = if next_job_fit_cpu && next_job_fit_ram {\n        dynamic_horizon_factor * 1.5\n    } else if next_job_fit_cpu || next_job_fit_ram {\n        dynamic_horizon_factor * 1.0\n    } else {\n        dynamic_horizon_factor * 0.7\n    };\n    \n    // Non-linear conditionals and penalties for residual space utilization\n    let cpu_overload_penalty = if node_residual_cpu < next_job_cpu / 4 { -0.5 } else { 0.0 };\n    let ram_overload_penalty = if node_residual_ram < next_job_ram / 4 { -0.5 } else { 0.0 };\n    \n    // Additional terms to penalize dead space and reinforce bin utilization\n    let cpu_dead_space_ratio = (node_capacity_cpu - node_residual_cpu) as f64 / node_capacity_cpu as f64;\n    let ram_dead_space_ratio = (node_capacity_ram - node_residual_ram) as f64 / node_capacity_ram as f64;\n    let dead_space_penalty = -(cpu_dead_space_ratio * 0.3 + ram_dead_space_ratio * 0.3);\n    \n    // Adjust score to penalize low utilization and reward high utilization\n    let cpu_utilization_bonus = (node_residual_cpu as f64 / node_capacity_cpu as f64) * 0.5;\n    let ram_utilization_bonus = (node_residual_ram as f64 / node_capacity_ram as f64) * 0.5;\n    \n    // Combine fine-grained residual fitting with lookahead anticipation\n    let combined_fit_penalty = if next_job_fit_cpu && next_job_fit_ram {\n        0.0\n    } else if next_job_fit_cpu || next_job_fit_ram {\n        1.0\n    } else {\n        2.0 + (cpu_dead_space_ratio + ram_dead_space_ratio) * 0.5\n    };\n    \n    let score = cpu_norm + ram_norm - imbalance_penalty + lookahead_bonus - cpu_overload_penalty - ram_overload_penalty + dead_space_penalty + cpu_utilization_bonus + ram_utilization_bonus - combined_fit_penalty;\n    score\n}",
