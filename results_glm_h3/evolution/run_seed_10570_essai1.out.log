        if next_item_size > 0 && bin_capacity >= item_size + next_item_size {
            let leftover = bin_capacity - item_size - next_item_size;
            if leftover == 0 {
                score -= 10.0;
            } else if leftover <= 4 {
                score -= 5.0;
            }
        }
    } else {
        let fill = item_size as f64 / bin_residual as f64;
        if fill > 0.85 {
            score -= 12.0 * (fill - 0.85) / 0.15;
        } else if fill < 0.3 && post_residual > 0 && post_residual < 10 {
            score += 10.0;
        }
        if post_residual > 0 && post_residual < 0.05 * bin_capacity as f64 && fitting_bins_count > 1 {
            score -= 10.0;
        }
        if next_item_size > 0 && post_residual >= next_item_size && post_residual <= next_item_size * 2 {
            score -= 8.0;
        }
        if next_item_size > 0 && post_residual == next_item_size * 2 && fill > 0.5 {
            score -= 5.0;
        }
        if next_item_size > 1 && post_residual == next_item_size * 3 && fill > 0.6 {
            score -= 7.0;
        }
        if fill > 0.6 && next_item_size > 0 && post_residual >= next_item_size {
            score -= 3.0 * (fill - 0.6) / 0.4;
        }
        if fill < 0.5 && next_item_size > 0 {
            let gap = post_residual as f64 - next_item_size as f64;
            if gap > 0.0 && gap < 4.0 {
                score += gap * 1.0;
            }
        }
        if fill > 0.92 {
            score -= 10.0 * (fill - 0.92) / 0.08;
        }
        if fitting_bins_count <= 2 && fill > 0.7 {
            score -= 6.0 * (fill - 0.7) / 0.3;
        }
        // prefer leaving residual divisible by next item for chains
        if next_item_size > 1 && post_residual > 0 && post_residual % next_item_size == 0 && post_residual <= next_item_size * 5 {
            score -= 4.0;
        }
        // guard against opening bins when a decent fit exists
        if post_residual > 0 && (post_residual as f64) < 0.5 * bin_capacity as f64 {
            score -= 3.0 * rem_frac;
        }
        // extra anti-fragmentation when many bins compete
        if fitting_bins_count > 3 && post_residual >= next_item_size && next_item_size > 0 {
            let slack = (post_residual - next_item_size) as f64;
            if slack < 3.0 {
                score -= 7.0 * (1.0 - progress);
            }
        }
        // reward near-perfect fills more aggressively mid-stream
        if fill > 0.95 && post_residual == 0 {
            score -= 5.0;
        }
        // tighten the near-perfect band — treat fill>0.9 as near-perfect late
        if fill > 0.9 && post_residual > 0 && (post_residual as f64) < 0.08 * bin_capacity as f64 && progress > 0.5 {
            score -= 4.0 * rem_frac;
        }
        // mutation: scarcity-aware tightness — when only one open bin fits, prefer
