        }
        if remaining < 60.0 && fitting_bins_count >= 2 {
            score += 15.0;
        }
        // opening a new bin is only attractive for big items that pair with next
        if next_item_size > 0 && item_size + next_item_size == bin_capacity {
            score -= 14.0;
        }
        // allow new bins for large items even without pairing, but only early/mid-stream
        let item_frac = item_size as f64 / bin_capacity as f64;
        if item_frac > 0.75 && progress < 0.7 && fitting_bins_count >= 2 {
            score -= 8.0;
        }
        // mutation: new-bin bonus scaled by pairing quality — if the leftover after this
