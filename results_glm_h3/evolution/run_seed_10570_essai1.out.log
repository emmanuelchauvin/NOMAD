 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;
    let progress = step_index as f64 / (total_items.max(1) as f64);
    let rem_frac = ((total_items - step_index).max(1) as f64 / (total_items.max(1) as f64)).min(1.0);

    if post_residual == 0 {
        score -= 1000.0;
    }

    if next_item_size > 0 {
        if post_residual == next_item_size {
            score -= 900.0;
        } else if post_residual >= next_item_size {
            let slack = (post_residual - next_item_size) as f64;
            score -= 60.0 - (slack * 0.5).min(55.0);
            if slack > 0.0 && slack < 7.0 {
                score -= 18.0;
            }
            if slack < 14.0 {
                score -= (14.0 - slack) * 1.1;
            }
            if slack >= 20.0 && slack < 40.0 {
                score -= 8.0;
            }
            // pair lookahead: residual reusable by next two items
            let pair = next_item_size * 2;
            if post_residual >= pair {
                let pair_slack = post_residual - pair;
                if pair_slack == 0 {
                    score -= 45.0;
                } else if (pair_slack as f64) < 0.06 * bin_capacity as f64 {
                    score -= 22.0;
                }
            }
            // harmonic anticipation: residual divisible by next item size
            if next_item_size > 1 && post_residual % next_item_size == 0 {
                let k = post_residual / next_item_size;
                if k >= 2 && k <= 4 {
                    score -= 6.0 + k as f64;
                }
                if k >= 3 && k <= 6 {
                    score -= 10.0;
                }
            }
            // triple lookahead for tight residual chains
            if next_item_size > 1 && post_residual >= next_item_size * 3 {
                let trip = post_residual - next_item_size * 3;
                if trip == 0 {
                    score -= 30.0;
                } else if (trip as f64) < 0.04 * bin_capacity as f64 {
                    score -= 14.0;
                }
            }
            // quad lookahead — residual chains of four small items
            if next_item_size > 1 && post_residual >= next_item_size * 4 {
                let quad = post_residual - next_item_size * 4;
                if quad == 0 {
                    score -= 26.0;
                } else if (quad as f64) < 0.03 * bin_capacity as f64 {
                    score -= 11.0;
                }
            }
            // quint lookahead for tiny items — long chains of small pieces
            if next_item_size > 1 && next_item_size <= 20 && post_residual >= next_item_size * 5 {
                let quint = post_residual - next_item_size * 5;
                if quint == 0 {
                    score -= 20.0;
                } else if (quint as f64) < 0.02 * bin_capacity as f64 {
                    score -= 8.0;
                }
            }
        } else {
            let waste = (next_item_size - post_residual) as f64;
            let scarcity = 1.0 / (fitting_bins_count.max(1) as f64);
            score += 30.0 + waste * 0.9 + waste * 0.4 * scarcity;
            let remaining = (total_items - step_index).max(1) as f64;
            if remaining > 200.0 {
                score += waste * 0.25;
            }
            if waste <= 4.0 && fitting_bins_count > 2 {
                score -= 8.0;
            }
            if waste <= 2.0 && fitting_bins_count == 1 {
                score -= 12.0;
            }
        }
    }

    // dead-space penalty: small leftovers unlikely to be reused
    if post_residual > 0 && post_residual < 12 {
        score += (12 - post_residual) as f64 * 1.2;
    }
    // residual exactly reusable-sized band
    if next_item_size > 0 && post_residual >= next_item_size && post_residual <= next_item_size + 3 {
        score -= 10.0;
    }

    if post_residual > 0 {
        let dead = post_residual as f64 / bin_capacity as f64;
        if dead < 0.12 {
            score += dead * 40.0 * rem_frac;
        } else if dead < 0.28 && next_item_size > 0 && (post_residual as f64) < next_item_size as f64 * 0.6 {
            score += 6.0 * rem_frac;
        }
        if progress > 0.9 {
            score += post_residual as f64 * post_residual as f64 * 0.004;
        }
        if dead < 0.10 && next_item_size > 0 && (post_residual as u32) < next_item_size {
            score += 9.0 * rem_frac;
        }
        if next_item_size > 0 && (post_residual as u32) < next_item_size && (post_residual as u32) < item_size {
            score += 4.0 * rem_frac;
        }
        // anti-dead-space mid-stream: residuals no item (<=100) can fully use
        if progress > 0.15 && post_residual > 100 {
            let unusable = post_residual - 100;
            score += unusable as f64 * 0.35 * rem_frac;
        }
        if progress > 0.8 && next_item_size > 0 && post_residual >= next_item_size {
            let slack = (post_residual - next_item_size) as f64;
            if slack > 0.0 && slack < 5.0 {
                score -= 6.0 * rem_frac;
            }
        }
        // endgame tightness — late stream, avoid leaving any residual at all
        if progress > 0.95 && post_residual > 0 {
            score += post_residual as f64 * 0.5 * rem_frac;
        }
        // mid-stream dead-space ramp — penalize unusable residuals earlier and harder
        if progress > 0.35 && next_item_size > 0 && (post_residual as u32) < next_item_size {
            score += (next_item_size - post_residual) as f64 * 0.6 * rem_frac;
        }
        // mutation: unusable-gap ramp — residuals between next_item and next_item+small gap
        // are nearly dead; the sliver above next_item will rarely be reused
        if progress > 0.45 && next_item_size > 0 && post_residual > next_item_size {
            let sliver = post_residual - next_item_size;
            if sliver <= 6 {
                score += sliver as f64 * 0.9 * rem_frac;
            }
        }
    }

    if fitting_bins_count > 1 && next_item_size > 0 && post_residual >= next_item_size {
        score -= (fitting_bins_count as f64 - 1.0).min(3.0) * 4.0;
    }

    if bin_residual == bin_capacity {
        let frag = mean_residual / bin_capacity as f64;
        let remaining = (total_items - step_index).max(1) as f64;
        if frag < 0.18 && fitting_bins_count > 0 {
            score += 60.0;
        }
        if item_size as f64 >= bin_residual as f64 * 0.5 && frag > 0.25 {
            score += 25.0;
        }
        if remaining < 20.0 && fitting_bins_count > 0 {
            score += 30.0;
        }
        if next_item_size > 0 && next_item_size as f64 / bin_capacity as f64 > 0.6 && frag < 0.3 {
            score += 20.0;
        }
        if frag > 0.35 && next_item_size > 0 && next_item_size as f64 > mean_residual * 0.8 {
            score += 12.0;
        }
        if fitting_bins_count > 0 && frag < 0.35 {
            let item_frac = item_size as f64 / bin_capacity as f64;
            if item_frac > 0.7 {
                score -= 18.0;
            }
        }
        if fitting_bins_count > 0 {
            let item_frac = item_size as f64 / bin_capacity as f64;
            let next_frac = next_item_size as f64 / bin_capacity as f64;
            if item_frac > 0.45 && frag < 0.22 && next_frac > 0.35 {
                score += 14.0;
            }
        }
        if fitting_bins_count > 0 && next_item_size > 0 && mean_residual >= next_item_size as f64 + 8.0 {
            score += 6.0;
