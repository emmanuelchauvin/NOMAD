 Logic Code       : pub fn score_bin (item_size : u32 , bin_residual : u32 , bin_capacity : u32 , step_index : usize , total_items : usize , open_bins_count : usize , mean_residual : f64 , next_item_size : u32 , post_residual : u32 , fitting_bins_count : usize) -> f64 {
    let mut score = post_residual as f64 ;
    let progress = step_index as f64 / total_items . max (1) as f64 ;
    if post_residual == 0 {
        score -= 1000.0 ;
    } else {
        if next_item_size > 0 {
            if next_item_size == post_residual {
                score -= 900.0 - 30.0 * progress ;
            } else if next_item_size <= post_residual {
                let two_step_waste = (post_residual - next_item_size) as f64 ;
                if two_step_waste == 0.0 {
                    score -= 700.0 ;
                } else if two_step_waste >= 10.0 {
                    score -= 300.0 - 2.0 * two_step_waste ;
                } else {
                    score -= 80.0 + 1.5 * (10.0 - two_step_waste) ;
                }
                let after_next = post_residual - next_item_size ;
                if after_next >= 3 {
                    score -= (2.0 + 2.0 * progress) * (after_next as f64) . min (15.0) ;
                }
                if after_next <= 12 && mean_residual >= after_next as f64 {
                    score -= 22.0 - 0.8 * after_next as f64 ;
                }
                if next_item_size > 1 && after_next >= next_item_size {
                    score -= 6.0 + 0.2 * (after_next / next_item_size) as f64 ;
                    if after_next % next_item_size == 0 {
                        score -= 8.0 * (1.0 - progress) ;
                    }
                }
                if after_next < next_item_size && after_next <= 3 {
                    score -= 14.0 * (1.0 - progress) ;
                }
                if after_next < next_item_size && after_next >= 1 && (next_item_size - after_next) <= 5 {
                    score -= 6.0 * (1.0 - progress) ;
                }
                if (after_next as f64 - mean_residual) . abs () <= 4.0 {
                    score -= 6.0 * (1.0 - progress) ;
                }
            } else {
                let miss = next_item_size - post_residual ;
                score += 2.0 * miss as f64 ;
                if post_residual < 25 {
                    score += 15.0 ;
                }
                if post_residual < 3 {
                    score -= 400.0 ;
                }
                if miss <= 6 && fitting_bins_count <= 2 {
                    score -= 5.0 ;
                }
                if miss <= 10 && fitting_bins_count <= 2 && progress > 0.7 {
                    score -= 10.0 * (1.0 - progress) ;
                }
                if miss <= 2 {
                    score -= 18.0 * (1.0 - progress) ;
                }
                if post_residual >= 8 && post_residual <= 16 {
                    score += 10.0 * (1.0 - progress) ;
                }
                if miss > 3 && miss as f64 <= mean_residual * 0.5 {
                    score += 4.0 * (1.0 - progress) ;
                }
