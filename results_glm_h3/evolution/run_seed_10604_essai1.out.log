            score += 10.0 ;
        }
        if next_item_size > 1 && fresh_left == 2 * next_item_size {
            score -= 12.0 ;
        }
        if fresh_left <= 2 {
            score -= 25.0 * (1.0 - progress) ;
        }
        if next_item_size > 0 && (fresh_left as f64 - mean_residual) . abs () <= 2.0 {
            score -= 8.0 ;
        }
        if next_item_size > 1 && fresh_left >= 2 * next_item_size && fresh_left % next_item_size == 0 {
            score -= 6.0 * (1.0 - progress) ;
        }
        if next_item_size > 0 && fresh_left > next_item_size && ((fresh_left - next_item_size) as f64 - mean_residual) . abs () <= 3.0 {
            score -= 9.0 * (1.0 - progress) ;
        }
        if post_residual > 0 && post_residual < 4 && open_bins_count > 2 {
            score += 15.0 ;
        }
        // mutation: discourage fresh bins late when any open bin can host next item comfortably
        if next_item_size > 0 && fitting_bins_count >= 1 && mean_residual >= next_item_size as f64 && progress > 0.6 {
            score += 10.0 * progress ;
        }
        // mutation: fresh bin attractive early with big items (large usable leftover)
        if item_frac > 0.5 && progress < 0.4 {
            score -= 6.0 * (0.4 - progress) / 0.4 ;
        }
    }
    score
}
