        }
        if next_item_size > 0 && post_residual > next_item_size {
            let headroom = post_residual - next_item_size ;
            if (headroom as f64 - mean_residual) . abs () <= 3.0 {
                score -= 7.0 ;
            }
            if (headroom as f64 - mean_residual) . abs () <= 1.0 && fitting_bins_count <= 3 {
