            let unusable_ratio = post_residual as f64 / (next_item_size as f64) . max (1.0) ;
            score += 0.4 * post_residual as f64 + 30.0 * dead_frac + 12.0 * (1.0 - unusable_ratio) ;
            if next_item_size - post_residual <= 4 {
