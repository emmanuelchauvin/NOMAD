 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Perfect fit bonus: strongly reward leaving zero residual.
    if post_residual == 0 {
        score -= 1000.0;
    }

    // 2-step lookahead: reward when next item exactly fills post_residual.
    if next_item_size > 0 {
        if next_item_size == post_residual {
            score -= 900.0;
        } else if next_item_size <= post_residual {
            // Next item fits: reward proportional to how much of the remaining
            // space it consumes (tight chain packing).
            let fill = next_item_size as f64 / post_residual as f64;
            score -= 250.0 * fill;
        } else {
            // Next item does NOT fit here: penalize, but less if post_residual
            // is small (dead space unlikely to be usable anyway).
            let waste = next_item_size as f64 - post_residual as f64;
            let dead = post_residual as f64 / bin_capacity as f64;
            score += 120.0 * waste / (next_item_size as f64) * (1.0 - dead);
        }
    }

    // Compare against mean residual: bins with residual far below mean are
    // already tight; prefer placing into them (waste little extra capacity).
    let diff = post_residual as f64 - mean_residual;
    score += 0.15 * diff;

    // Last-chance bin: if this is the only bin that fits, strongly prefer it
    // to avoid opening a new bin.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 300.0;
    }

    // New-bin candidate: penalize opening a new bin unless the item is large
    // relative to capacity and current bins are fragmented (high mean residual).
    if bin_residual == bin_capacity {
        let fragmentation = (mean_residual / bin_capacity as f64).clamp(0.0, 1.0);
        let large_item = item_size as f64 / bin_capacity as f64;
        score += 200.0 - 180.0 * fragmentation - 100.0 * large_item;
        // Early in the stream, opening bins is cheap (future items can fill them).
        let progress = step_index as f64 / total_items.max(1) as f64;
        score -= 80.0 * (1.0 - progress);
    }

    // Mild penalty for very small leftover slivers that few items can use.
    if post_residual > 0 && post_residual < 10 {
        score += 40.0;
    }

    score
}
