 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Perfect fit bonus
    if post_residual == 0 {
        score -= 1000.0;
    }

    // Aggressive 2-step lookahead: reward bins whose post_residual matches next_item_size
    if next_item_size > 0 {
        let diff = (post_residual as i64 - next_item_size as i64).abs() as f64;
        if post_residual >= next_item_size {
            // next item fits exactly-ish: strong reward
            score -= 200.0 * (1.0 - diff / bin_capacity as f64);
        } else {
            // next item would not fit here: penalize wasted space relative to next item
            score += 50.0 + diff * 0.5;
        }
    } else {
        // last item: prefer tightest fit
        score += 0.0;
    }

    // Compare residual to mean residual: prefer bins tighter than average
    score -= (mean_residual - post_residual as f64) * 0.3;

    // Penalize large dead space (unusable gaps)
    if post_residual > 0 && post_residual < 10 {
        score -= 30.0; // small but likely unusable gap -> fine, nearly perfect fit
    }
    if post_residual > 40 {
        score += (post_residual as f64 - 40.0) * 0.8; // large gap wasted
    }

    // Last-chance bin: if this is the only fitting bin, favor using it to avoid opening a bin
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 120.0;
    }

    // New-bin candidate: only prefer it when item is large relative to capacity
    if bin_residual == bin_capacity {
        let tightness = item_size as f64 / bin_capacity as f64;
        // opening a new bin is attractive for big items or when no open bin fits well
        score += 60.0 - 80.0 * tightness;
        if next_item_size > 0 && next_item_size <= bin_capacity {
            score += 20.0;
        }
    }

    // Slight preference for consolidating into fewer bins as stream progresses
    let progress = step_index as f64 / total_items.max(1) as f64;
    score -= progress * 5.0;

    score
}
