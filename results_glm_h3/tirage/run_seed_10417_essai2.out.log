 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Reward (lower score) when the next item exactly fills the post residual.
    if next_item_size > 0 && post_residual == next_item_size {
        score -= 40.0;
    }
    // Reward if next item can still fit in the leftover space.
    if next_item_size > 0 && post_residual >= next_item_size {
        score -= 10.0 + (post_residual - next_item_size) as f64 * 0.3;
    }
    // Penalize dead space too small for the next item (or anything meaningful).
    if post_residual > 0 && post_residual < 10 {
        score += 15.0;
    }
    if next_item_size > 0 && post_residual > 0 && post_residual < next_item_size {
        score += (next_item_size - post_residual) as f64 * 0.5;
    }

    // Prefer bins tighter than the mean residual (best-fit flavor).
    score += (bin_residual as f64 - mean_residual) * 0.25;

    // Last-chance bin: strongly favor using it before opening a new bin.
    if fitting_bins_count == 1 && bin_residual < bin_capacity {
        score -= 25.0;
    }

    // Early in the stream, allow opening new bins more readily (keep flexibility).
    let progress = step_index as f64 / (total_items.max(1) as f64);
    if bin_residual == bin_capacity {
        // New-bin candidate: base cost plus a discount early on.
        score = bin_capacity as f64 * 0.5 - 30.0 * (1.0 - progress);
        if next_item_size > 0 && next_item_size <= bin_capacity {
            score -= 5.0;
        }
    }

    score
}
