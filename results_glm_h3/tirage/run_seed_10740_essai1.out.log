 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Reward exact or near-exact fits strongly.
    if post_residual == 0 {
        score -= 1000.0;
    } else {
        // Penalize dead space that is too small to ever be useful (min item size 1, but
        // small residuals below a threshold are hard to fill).
        let dead = post_residual as f64;
        if dead < 10.0 {
            score += (10.0 - dead) * 8.0;
        }
    }

    // 2-step lookahead: reward bins whose post_residual can host the next item exactly,
    // penalize those that leave post_residual incompatible with next_item_size.
    if next_item_size > 0 {
        let nxt = next_item_size as f64;
        if (post_residual as u32) == next_item_size {
            score -= 400.0; // perfect chain: residual consumed fully next step
        } else if post_residual >= next_item_size {
            score -= 120.0; // next item still fits here
        } else {
            score += 60.0 + (next_item_size - post_residual) as f64; // chain broken
        }
        // Bonus if post_residual - next_item_size is itself a nice round residual (e.g. 0 or >= 10)
        if post_residual >= next_item_size {
            let two_step = post_residual - next_item_size as u32;
            if two_step == 0 {
                score -= 250.0;
            } else if two_step >= 10 {
                score -= 30.0;
            } else {
                score += (10 - two_step) as f64 * 5.0;
            }
        }
    } else {
        // Last item: strongly prefer closing bins completely.
        score -= 500.0;
    }

    // Relative-to-mean coupling: prefer bins tighter than average.
    let res_f = bin_residual as f64;
    if mean_residual > 0.0 {
        score += (res_f - mean_residual) * 0.8;
    }

    // Last-chance bonus: if this is the only fitting bin, avoid opening a new bin
    // unless the fit is terrible.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 150.0;
    }

    // New-bin candidate: make it attractive only when fits are poor or stream is early.
    if bin_residual == bin_capacity {
        let progress = step_index as f64 / total_items.max(1) as f64;
        let poor_fit = post_residual as f64 > 40.0;
        if poor_fit && progress < 0.9 {
            score -= 80.0;
        } else {
            score += 200.0; // discourage spreading across bins when a decent fit exists
        }
    }

    // Mild preference to fill older/more-open-bin situations efficiently.
    score += open_bins_count as f64 * 0.5;

    score
}
