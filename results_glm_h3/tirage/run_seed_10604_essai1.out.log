 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Strict dead-space avoidance: penalize small unusable gaps hard.
    if post_residual > 0 {
        let min_item = 1u32;
        if post_residual < min_item {
            score += 1000.0;
        }
        // Dead space that cannot fit the next item is wasted.
        if next_item_size > 0 && post_residual < next_item_size {
            score += 2.5 * (next_item_size - post_residual) as f64;
        }
        // Non-linear penalty on tiny gaps (worst kind of dead space).
        let gap = post_residual as f64;
        score += 20.0 * (-gap / 10.0).exp();
    } else {
        // Perfect fit: strong reward.
        score -= 15.0;
    }

    // Reward tight fits relative to residual.
    let fill_ratio = item_size as f64 / bin_residual.max(1) as f64;
    score -= 10.0 * fill_ratio * fill_ratio;

    // Open-bin pressure: prefer filling existing bins when many are open.
    let progress = step_index as f64 / total_items.max(1) as f64;
    score += 0.15 * open_bins_count as f64 * (0.5 + 0.5 * progress);

    // Last-chance bin: strongly favor using it to avoid opening a new bin.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 8.0;
    }

    // New-bin candidate: only attractive when residuals are fragmented.
    if bin_residual == bin_capacity {
        if mean_residual > item_size as f64 * 1.5 && open_bins_count > 2 {
            score += 5.0; // discourage new bin when existing space suffices
        } else {
            score -= 3.0;
        }
    }

    // Lookahead coupling: if next item fits exactly in post_residual, reward.
    if next_item_size > 0 && post_residual == next_item_size {
        score -= 6.0;
    }

    score
}
