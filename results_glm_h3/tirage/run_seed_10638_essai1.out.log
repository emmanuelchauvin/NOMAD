 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Perfect fit: strongly reward closing the bin exactly.
    if post_residual == 0 {
        score -= 1000.0;
    }

    // 2-step lookahead: reward when the next item fits the residual left behind.
    if next_item_size > 0 {
        let nxt = next_item_size as f64;
        let pr = post_residual as f64;
        if nxt <= pr {
            // Next item fits exactly or nearly: reward tight coupling.
            let slack = pr - nxt;
            if slack == 0.0 {
                score -= 300.0;
            } else {
                score -= 150.0 * (1.0 - slack / bin_capacity as f64);
            }
        } else {
            // Next item won't fit here: penalize leaving residual that is
            // too small to be useful (dead space trap).
            score += 40.0 * (1.0 - pr / nxt);
        }
    }

    // Penalize small unusable residuals relative to mean residual.
    let pr = post_residual as f64;
    if pr > 0.0 && pr < mean_residual * 0.5 {
        score += 30.0;
    }

    // Last-chance bin: reward using it to avoid opening a new bin.
    if fitting_bins_count == 1 && bin_residual >= item_size {
        score -= 120.0;
    }

    // New-bin candidate (empty bin): make it unattractive unless residuals
    // of open bins are all poor (large post_residual penalty above handles it).
    if bin_residual == bin_capacity {
        score += 50.0 + 0.1 * open_bins_count as f64;
    }

    // Late in the stream: prefer consolidating into existing bins.
    let progress = step_index as f64 / total_items.max(1) as f64;
    score += progress * 10.0 * pr / bin_capacity as f64;

    score
}
