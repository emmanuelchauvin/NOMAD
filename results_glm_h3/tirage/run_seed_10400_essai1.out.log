 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Perfect fit reward: zero waste is ideal.
    if post_residual == 0 {
        score -= 1000.0;
    }

    // 2-step lookahead: if the next item exactly fills the post-residual,
    // this is a chain fit — strongly favor it.
    if next_item_size > 0 && post_residual > 0 {
        if next_item_size == post_residual {
            score -= 500.0;
        } else if next_item_size <= post_residual {
            // Next item fits: mild reward proportional to how snugly.
            let snug = (post_residual - next_item_size) as f64;
            score -= 50.0 * (1.0 - snug / bin_capacity as f64);
        } else {
            // Next item will NOT fit in the leftover: penalize dead space
            // scaled by how small the unusable gap is relative to the next item.
            let dead = (next_item_size - post_residual) as f64;
            score += 30.0 * (1.0 - dead / bin_capacity as f64).max(0.0);
        }
    }

    // Compare post_residual against the mean residual of open bins:
    // leaving a residual well below the mean creates an outlier bin that
    // is hard to fill later.
    let cap = bin_capacity as f64;
    let pr = post_residual as f64;
    if pr < mean_residual {
        score += 0.6 * (mean_residual - pr);
    } else {
        score -= 0.3 * (pr - mean_residual);
    }

    // Last-chance bin: if this is the only bin that fits, avoid opening
    // a new bin unless the fit is terrible.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 120.0 + 0.5 * item_size as f64;
    }

    // Penalize using a nearly-full bin for a tiny item (waste of a scarce slot).
    if item_size < 20 && bin_residual < 40 && bin_residual != bin_capacity {
        score += 40.0;
    }

    // Early in the stream, be slightly more willing to open new bins
    // to build a diverse residual pool.
    let progress = step_index as f64 / total_items.max(1) as f64;
    if bin_residual == bin_capacity {
        // New-bin candidate: its base score is the capacity; adjust.
        score -= 200.0 * (1.0 - progress);
        // If no open bin fits well, new bin is attractive.
        if post_residual == bin_capacity {
            score -= 0.0;
        }
    }

    // Slight preference for filling bins when many are open.
    score += 0.05 * open_bins_count as f64;

    score
}
