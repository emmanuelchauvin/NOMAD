 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Perfect-fit reward: exact match leaves zero dead space.
    if post_residual == 0 {
        score -= 1000.0;
    }

    // 2-step lookahead: reward bins whose residual can host the next item exactly or well.
    if next_item_size > 0 && post_residual >= next_item_size {
        let gap = (post_residual - next_item_size) as f64;
        score -= 50.0 + 20.0 * (1.0 - gap / bin_capacity as f64);
        if post_residual == next_item_size {
            score -= 200.0; // chain of perfect fits
        }
    } else if next_item_size > 0 && post_residual > 0 {
        // Residual too small for next item: penalize proportionally to wasted capacity.
        let waste = post_residual as f64 / bin_capacity as f64;
        score += 30.0 * waste;
    }

    // Relative-to-mean residual shaping: prefer leaving residuals near the mean
    // (balanced bins), penalize outliers.
    let dev = (post_residual as f64 - mean_residual).abs();
    score += 0.5 * dev;

    // Last-chance bin: strongly favor using it to avoid opening a new bin.
    if fitting_bins_count == 1 && bin_residual >= item_size {
        score -= 80.0;
    }

    // Prefer denser bins early; as stream progresses, be more tolerant of new bins.
    let progress = step_index as f64 / (total_items.max(1) as f64);
    if bin_residual == bin_capacity {
        // New-bin candidate: attractive only if current item leaves a large residual
        // that likely fits future items, and few bins are open.
        score = 100.0 - 0.3 * post_residual as f64 - 2.0 * open_bins_count as f64 * (1.0 - progress);
        if next_item_size > 0 && post_residual >= next_item_size {
            score -= 40.0;
        }
    }

    score
}
