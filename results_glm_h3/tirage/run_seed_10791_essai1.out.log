 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Strong reward for exact / near-exact fits.
    if post_residual == 0 {
        score -= 1000.0;
    } else {
        score -= 300.0 / post_residual as f64;
    }

    // Aggressive 2-step lookahead: reward bins whose post_residual
    // can accommodate the next item (chain packing).
    if next_item_size > 0 {
        if post_residual >= next_item_size {
            // slack after placing both current and next item
            let slack2 = post_residual - next_item_size;
            score -= 150.0 + 100.0 / (1.0 + slack2 as f64);
        } else {
            // penalize blocking the next item
            let gap = next_item_size - post_residual;
            score += 40.0 + 0.5 * gap as f64;
        }
    }

    // Relative-to-mean coupling: bins tighter than the mean are
    // preferred targets for filling up.
    let res = post_residual as f64;
    if mean_residual > 0.0 {
        score += 0.4 * (res - mean_residual);
    }

    // Last-chance bin: strong preference to use it before opening new.
    if fitting_bins_count == 1 {
        score -= 120.0;
    } else if fitting_bins_count > 1 {
        // mild penalty so ties among many fitting bins are broken by fit quality
        score += 5.0 * (fitting_bins_count as f64).ln();
    }

    // New-bin candidate: only attractive when no open bin fits well.
    if bin_residual == bin_capacity {
        // baseline cost of opening a fresh bin
        score += 80.0;
        // more attractive late in the stream when many bins are open
        // and mean residual is small (open bins are nearly full anyway)
        let progress = step_index as f64 / total_items.max(1) as f64;
        score -= 60.0 * progress * (mean_residual / bin_capacity as f64);
        if next_item_size > 0 && next_item_size >= bin_capacity {
            score -= 200.0; // next item needs a fresh bin anyway
        }
    }

    score
}
