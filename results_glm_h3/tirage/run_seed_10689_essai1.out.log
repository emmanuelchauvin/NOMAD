 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Time horizon: early in the stream, prefer compacting into open bins;
    // late in the stream, tight fits matter more.
    let progress = step_index as f64 / total_items.max(1) as f64;

    // Penalize small post-residuals that create unusable dead space,
    // but only if the next item cannot use them.
    if post_residual > 0 && (next_item_size as u32) > post_residual {
        let dead = post_residual as f64;
        score += dead * (0.6 + 1.4 * progress);
    }

    // Reward perfect-ish fits (post_residual small but next item might use it).
    if next_item_size > 0 && (next_item_size as u32) <= post_residual {
        let fit_quality = (next_item_size as f64) / (post_residual as f64).max(1.0);
        score -= 18.0 * fit_quality * (1.0 - progress * 0.5);
    }

    // Last-chance bonus: if this is the only fitting bin, strongly prefer it
    // over opening a new bin (unless the fit is terrible).
    if fitting_bins_count == 1 && bin_residual < bin_capacity {
        let waste_ratio = post_residual as f64 / bin_capacity as f64;
        score -= 25.0 * (1.0 - waste_ratio);
    }

    // New-bin candidate: penalize opening a new bin when decent alternatives
    // exist; allow it when the stream is early and future items are large,
    // or when this bin would otherwise be a poor fit.
    if bin_residual == bin_capacity {
        let base_penalty = 30.0 + 20.0 * progress;
        let lookahead_bonus = if next_item_size > item_size { 10.0 } else { 0.0 };
        score += base_penalty - lookahead_bonus;
        // If no open bin fits well, opening a new bin is less bad.
        if post_residual > (bin_capacity as u32 / 2) {
            score -= 15.0;
        }
    }

    // Global state coupling: many open bins with high mean residual ->
    // favor bins below mean residual (consolidation pressure).
    let dev = mean_residual - bin_residual as f64;
    score += 0.35 * dev * (1.0 + (open_bins_count as f64).ln().max(0.0)) * (1.0 - progress);

    // Mild reward for exact capacity utilization.
    let util = item_size as f64 / bin_capacity as f64;
    score -= 8.0 * util * util;

    score
}
