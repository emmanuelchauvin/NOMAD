 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Strict dead-space avoidance: residuals too small for any future item
    // (minimum item size is 1, but small gaps < ~15 are statistically hard to reuse)
    if post_residual < 15 {
        score += 60.0; // heavy penalty: near-unusable dead space
    } else if post_residual < 30 {
        score += 20.0;
    }

    // Reward exact-ish fits strongly
    if post_residual == 0 {
        score -= 100.0;
    } else if post_residual <= 5 {
        score -= 40.0;
    }

    // Lookahead: if the next item fits in this bin's post-residual, reward;
    // if next item is large and post_residual can't host it, penalize mildly.
    if next_item_size > 0 {
        if post_residual >= next_item_size as u32 {
            score -= 15.0;
        } else if post_residual > 0 && post_residual < next_item_size as u32 {
            score += 8.0;
        }
    }

    // Last-chance bin: strongly favor using the only fitting bin to avoid a new bin
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 50.0;
    }

    // Open-bin pressure: with many open bins, discourage spreading; prefer packing tight
    let pressure = open_bins_count as f64 / (1.0 + mean_residual / bin_capacity as f64);
    score += pressure * 2.0;

    // New-bin candidate: prefer opening a new bin only when it's early in the stream
    // or the current fit is poor (large post_residual relative to capacity)
    if bin_residual == bin_capacity {
        let progress = step_index as f64 / total_items.max(1) as f64;
        score -= 30.0 * (1.0 - progress);
        if post_residual as f64 > 0.6 * bin_capacity as f64 && open_bins_count > 0 {
            score -= 20.0; // poor fit elsewhere -> new bin is fine
        }
    }

    // Mild preference for bins with tighter residual (best-fit coupling)
    score += (bin_residual as f64 - mean_residual) * 0.1;

    score
}
