 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Harmonic class of the leftover space: residues mod 10 partition dead space.
    let residue = post_residual % 10;
    let harmonic = (post_residual / 10) as f64; // number of full 10-slots left

    // Penalize leftovers that are too small to be useful (dead space).
    // A leftover < 10 is nearly unusable given min item size 1..100 unknown;
    // weight by harmonic class: prefer leftovers that are multiples of 10.
    if residue == 0 {
        score -= 6.0 * harmonic.min(8.0);
    } else {
        // non-aligned leftovers: penalty grows as residue deviates from 0/5
        let dev = residue.min(10 - residue) as f64;
        score += 1.5 * dev;
    }

    // Perfect fit: enormous reward.
    if post_residual == 0 {
        score -= 1000.0;
    }

    // Lookahead coupling: if the next item fits exactly into post_residual,
    // strongly reward this placement (chain packing).
    if next_item_size > 0 {
        if next_item_size == post_residual {
            score -= 120.0;
        } else if next_item_size < post_residual {
            // reward proportional to how tightly next item nests
            let slack = (post_residual - next_item_size) as f64;
            score -= 8.0 * (1.0 - slack / bin_capacity as f64);
            if (post_residual - next_item_size) % 10 == 0 {
                score -= 4.0; // nested leftover stays harmonic-aligned
            }
        } else {
            // next item won't fit here: mild penalty for stranding space
            score += 5.0;
        }
    }

    // Last-chance bin: if this is the only bin that fits, strongly prefer it
    // over opening a new bin, unless the fit is terrible.
    if fitting_bins_count == 1 && bin_residual < bin_capacity {
        score -= 40.0;
        if post_residual <= 5 {
            score -= 30.0; // near-perfect last-chance fit
        }
    }

    // New-bin candidate handling: an empty bin has residual == capacity.
    // Only prefer a fresh bin when existing fits are very poor (large post_residual
    // relative to capacity) or when many bins are open and mean residual is high.
    if bin_residual == bin_capacity {
        // baseline for fresh bin: keep it moderately high so it loses to good fits
        score = bin_capacity as f64 * 0.55;
        let progress = step_index as f64 / total_items.max(1) as f64;
        let crowded = (open_bins_count as f64).ln().max(0.0);
        // open a new bin if mean residual across open bins is small (they're all tight)
        let tight = (mean_residual / bin_capacity as f64) < 0.15;
        if tight || fitting_bins_count == 0 {
            score -= 25.0 + 10.0 * crowded * (1.0 - progress);
        }
        // late in the stream, avoid spawning bins for tiny gains
        if progress > 0.9 {
            score += 10.0;
        }
    } else {
        // penalty for leaving very large holes in partially filled bins
        let frac = post_residual as f64 / bin_capacity as f64;
        if frac > 0.6 {
            score += 12.0 * frac;
        }
        // slight preference for filling fuller bins (best-fit bias already via base)
        score -= 0.05 * (1.0 - frac) * (bin_residual as f64);
    }

    // Mean-residual steering: prefer bins below the mean residual (tighter bins)
    if (bin_residual as f64) < mean_residual && bin_residual < bin_capacity {
        score -= 3.0;
    }

    score
}
