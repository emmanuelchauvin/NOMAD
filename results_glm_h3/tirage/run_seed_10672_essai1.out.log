 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Dead-space penalty: small gaps that no future item (>=10) can use.
    if post_residual > 0 && post_residual < 10 {
        score += 200.0;
    } else if post_residual > 0 && post_residual < next_item_size as f64 * 1.0 && next_item_size > 0 {
        // Gap unusable by the lookahead item: penalize proportionally.
        score += 50.0 + (next_item_size as f64 - post_residual as f64) * 2.0;
    }

    // Reward exact or near-exact fits.
    if post_residual == 0 {
        score -= 300.0;
    } else if post_residual <= 5 {
        score -= 100.0;
    }

    // Last-chance bonus: only one bin fits the item; avoid opening a new bin.
    if fitting_bins_count == 1 && bin_residual >= item_size {
        score -= 80.0;
    }

    // Lookahead synergy: if next item fits exactly in the post-residual.
    if next_item_size > 0 && post_residual == next_item_size {
        score -= 60.0;
    }

    // Open-bin pressure: mildly discourage spreading across many bins,
    // but ease off near the end of the stream.
    let progress = step_index as f64 / total_items.max(1) as f64;
    score += (open_bins_count as f64 - mean_residual / 10.0) * (1.0 - 0.5 * progress);

    // New-bin candidate: neutral-ish baseline so it only wins when fits are bad.
    if bin_residual == bin_capacity {
        score += 40.0 - mean_residual * 0.3;
    }

    score
}
