 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Perfect fit reward
    if post_residual == 0 {
        score -= 500.0;
    }

    // 2-step lookahead: reward if next item exactly fills post_residual
    if next_item_size > 0 {
        if post_residual == next_item_size {
            score -= 300.0;
        } else if post_residual >= next_item_size {
            // next item fits here too: good chaining, penalize leftover after that
            score -= 100.0 - 0.5 * (post_residual - next_item_size) as f64;
        } else {
            // next item won't fit: penalize leftover dead space
            score += 0.3 * (next_item_size - post_residual) as f64;
        }
    }

    // Relative to mean residual: prefer bins tighter than average
    score += 0.5 * (mean_residual - post_residual as f64);

    // Last-chance bin: strongly favor using it
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 200.0;
    }

    // Penalize opening a new bin when reasonable fits exist
    if bin_residual == bin_capacity {
        score += 50.0 + 0.5 * open_bins_count as f64;
        if next_item_size > 0 && post_residual >= next_item_size {
            score -= 120.0;
        }
    }

    // Late-stream bias: consolidate more aggressively toward the end
    let progress = step_index as f64 / total_items as f64;
    score -= 20.0 * progress * (post_residual as f64 / bin_capacity as f64);

    score
}
