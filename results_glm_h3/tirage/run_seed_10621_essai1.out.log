 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Exact fit is perfect.
    if post_residual == 0 {
        score -= 1000.0;
    }

    // Aggressive 2-step lookahead: reward when next item fits the post residual.
    if next_item_size > 0 {
        if next_item_size == post_residual {
            score -= 500.0;
        } else if next_item_size <= post_residual {
            // Reward proportional to how well the next item fills the leftover.
            let fill = next_item_size as f64 / post_residual as f64;
            score -= 200.0 * fill;
        } else {
            // Penalize post residual that cannot host the next item, scaled by
            // how dead the space is relative to mean residual.
            let dead = post_residual as f64 / mean_residual.max(1.0);
            score += 50.0 * dead.min(3.0);
        }
    }

    // Compare post residual against mean residual: leaving less than average
    // leftover is good (tight packing).
    score -= 0.5 * (mean_residual - post_residual as f64);

    // Last-chance bin: strongly favor using it to avoid opening a new bin.
    if fitting_bins_count == 1 && bin_residual < bin_capacity {
        score -= 150.0;
    }

    // Penalize tiny unusable slivers (dead space), except exact fits.
    if post_residual > 0 && post_residual < 10 {
        score += 80.0;
    }

    // Late in the stream, prefer tightening existing bins over opening new ones.
    let progress = step_index as f64 / total_items.max(1) as f64;
    if bin_residual == bin_capacity {
        // New-bin candidate: penalize more as stream progresses; allow early
        // opening when current bin fits are poor.
        score += 40.0 + 120.0 * progress;
        if next_item_size > 0 && next_item_size > bin_residual {
            score -= 30.0;
        }
    }

    score
}
