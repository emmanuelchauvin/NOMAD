 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Exact-fit reward: minimize dead space
    if post_residual == 0 {
        score -= 1000.0;
    } else if post_residual <= 2 {
        score -= 500.0;
    }

    // Aggressive 2-step lookahead: reward bins whose post_residual matches next item
    if next_item_size > 0 {
        let nr = next_item_size as f64;
        if post_residual as f64 == nr {
            score -= 900.0;
        } else if post_residual >= next_item_size {
            let slack = post_residual as f64 - nr;
            // small slack after next item is good; penalize proportionally
            score -= 300.0 * (1.0 - slack / bin_capacity as f64);
        } else {
            // next item won't fit here; penalize relative to gap
            score += 0.5 * (nr - post_residual as f64);
        }
    }

    // Relative-to-mean coupling: prefer bins tighter than average
    score += (post_residual as f64 - mean_residual) * 0.7;

    // Last-chance bin: strongly favor using it to avoid opening a new bin
    if fitting_bins_count == 1 && bin_residual >= item_size {
        score -= 250.0;
    }

    // New-bin candidate: keep it neutral-high so only genuinely bad fits trigger opening
    if bin_residual == bin_capacity {
        score += 60.0;
        // open a new bin if item is large relative to typical residuals
        if item_size as f64 > mean_residual {
            score -= 120.0;
        }
    }

    // Dead-space penalty for large unusable residuals
    if post_residual > 0 && post_residual < 10 {
        score += 150.0;
    }

    // Late-stream tightness: as stream progresses, waste less
    let progress = step_index as f64 / total_items.max(1) as f64;
    score *= 1.0 + 0.3 * progress;

    score
}
