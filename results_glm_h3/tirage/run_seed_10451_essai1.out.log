 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Perfect fit reward
    if post_residual == 0 {
        score -= 1000.0;
    } else if post_residual <= 5 {
        score -= 200.0;
    }

    // 2-step lookahead: reward bins whose post_residual matches next item
    if next_item_size > 0 {
        let gap = (post_residual as i64 - next_item_size as i64).abs() as f64;
        if post_residual as i64 >= next_item_size as i64 {
            // next item fits after this placement: reward tightness of that fit
            score -= 150.0 * (1.0 - gap / bin_capacity as f64);
        } else {
            // next item won't fit: penalize proportionally to the shortfall
            score += 0.5 * gap;
        }
    }

    // Prefer bins tighter than the mean residual (better packing)
    score += 0.3 * (mean_residual - post_residual as f64);

    // Last-chance bin: strongly favor using it to avoid opening a new bin
    if fitting_bins_count == 1 && bin_residual >= item_size {
        score -= 120.0;
    }

    // Encourage consolidation when many bins are open
    score += 0.05 * open_bins_count as f64 * (post_residual as f64 / bin_capacity as f64);

    // New-bin candidate: only attractive when item is large or no tight fit exists
    if bin_residual == bin_capacity {
        score += 40.0 + 0.5 * item_size as f64;
    }

    score
}
