 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Perfect fit reward
    if post_residual == 0 {
        score -= 1000.0;
    }

    // 2-step lookahead: reward if next item fits exactly into post_residual
    if next_item_size > 0 {
        if post_residual == next_item_size {
            score -= 800.0;
        } else if post_residual >= next_item_size {
            // next item fits, but penalize leftover after that hypothetical placement
            score -= 200.0 - (post_residual - next_item_size) as f64;
        } else {
            // next item won't fit: penalize leaving dead space
            score += 50.0;
        }
    }

    // Compare residual against mean residual across open bins
    score -= 2.0 * (bin_residual as f64 - mean_residual);

    // Last-chance bin bonus: only bin that fits, avoid opening a new bin
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 300.0;
    }

    // Penalize opening new bins when open bins fit well
    if bin_residual == bin_capacity {
        score += 100.0 + 0.5 * open_bins_count as f64;
    }

    // Slight preference to fill tighter bins early in the stream
    let progress = step_index as f64 / total_items.max(1) as f64;
    score += 0.1 * post_residual as f64 * (1.0 - progress);

    score
}
