 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Reward perfect or near-perfect fills (dead space minimization).
    if post_residual == 0 {
        score -= 1000.0;
    } else if post_residual <= 5 {
        score -= 300.0;
    } else if post_residual <= 10 {
        score -= 100.0;
    }

    // Aggressive 2-step lookahead: reward when next item exactly matches post_residual.
    if next_item_size > 0 {
        let diff = if post_residual >= next_item_size {
            post_residual - next_item_size
        } else {
            next_item_size - post_residual
        } as f64;

        // Exact match: next item fills this bin completely.
        if post_residual == next_item_size {
            score -= 800.0;
        } else if post_residual > next_item_size {
            // Next item fits: reward proportionally to tightness of the pair.
            score -= 400.0 * (1.0 - diff / bin_capacity as f64);
        } else {
            // Next item won't fit here: penalize leaving a gap next item nearly fits.
            score += 50.0 * (1.0 - diff / bin_capacity as f64);
        }

        // Penalize post_residual in the awkward zone just below typical item sizes.
        if post_residual > 0 && post_residual < 10 {
            score += 120.0;
        }
    } else {
        // Last item: strongly prefer tightest fit.
        score -= 500.0;
    }

    // Relative-to-mean coupling: prefer bins whose residual deviates favorably.
    score += 0.5 * (post_residual as f64 - mean_residual);

    // Last-chance bin: if this is the only fitting bin, avoid opening a new bin
    // unless the fit is terrible.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 150.0;
    }

    // Penalize opening new bins early in the stream when open bins could fit well.
    if bin_residual == bin_capacity {
        score += 80.0 * (1.0 - step_index as f64 / total_items.max(1) as f64);
        // But allow new bin if fit would be very poor in all open bins.
        if post_residual > 60 {
            score -= 100.0;
        }
    }

    // Mild pressure to consolidate when many bins are open.
    score += open_bins_count as f64 * 0.05;

    score
}
