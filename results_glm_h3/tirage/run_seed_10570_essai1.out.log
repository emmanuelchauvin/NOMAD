 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Perfect fit reward
    if post_residual == 0 {
        score -= 1000.0;
    }

    // 2-step lookahead: reward bins whose post_residual matches next item exactly
    if next_item_size > 0 && post_residual > 0 {
        let nxt = next_item_size as f64;
        let pr = post_residual as f64;
        if (pr - nxt).abs() < 0.5 {
            score -= 400.0; // next item fills this bin perfectly
        } else if pr > nxt {
            score -= 150.0 * (1.0 - (pr - nxt) / bin_capacity as f64);
        } else {
            // next item cannot fit; penalize dead space relative to mean residual
            score += 0.6 * (nxt - pr).min(80.0);
        }
    }

    // Prefer tight fits relative to mean residual
    score -= 0.5 * (mean_residual - post_residual as f64).max(0.0);

    // Last-chance bin bonus: avoid wasting scarce fitting capacity
    if fitting_bins_count == 1 && bin_residual >= item_size {
        score -= 120.0;
    }

    // Penalize opening a new bin early unless existing residuals are very tight
    let is_new_bin = bin_residual == bin_capacity;
    if is_new_bin {
        let progress = step_index as f64 / total_items.max(1) as f64;
        score += 60.0 - 40.0 * progress;
        if mean_residual > item_size as f64 * 1.5 {
            score += 80.0; // existing bins still roomy; don't open new one
        }
        if next_item_size > 0 && post_residual as f64 >= next_item_size as f64 {
            score -= 50.0; // new bin can also host next item
        }
    }

    // Mild preference for keeping many open bins consolidated
    score += 0.05 * open_bins_count as f64;

    score
}
