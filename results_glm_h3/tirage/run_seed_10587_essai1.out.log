 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Perfect fit reward
    if post_residual == 0 {
        score -= 1000.0;
    }

    // 2-step lookahead: reward if next item exactly fills post_residual
    if next_item_size > 0 && next_item_size <= post_residual {
        let gap = (post_residual as i64 - next_item_size as i64) as f64;
        score -= 200.0 - gap * 0.5; // exact match strongly favored
    } else if next_item_size > 0 {
        // next item can't use this bin's leftover: penalize dead space
        score += next_item_size as f64 * 0.1;
    }

    // Compare leftover to mean residual: prefer bins tighter than average
    score += (post_residual as f64 - mean_residual) * 0.3;

    // Last-chance bin bonus: only one bin fits, avoid opening new bin
    if fitting_bins_count == 1 && bin_residual >= item_size {
        score -= 150.0;
    }

    // Penalize opening a new bin when open bins exist with reasonable residual
    if bin_residual == bin_capacity && open_bins_count > 0 {
        score += 80.0 + mean_residual * 0.2;
    }

    // Late in stream: be more conservative with new bins
    let progress = step_index as f64 / (total_items.max(1) as f64);
    if bin_residual == bin_capacity {
        score += progress * 40.0;
    }

    score
}
