 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Exact fit is ideal
    if post_residual == 0 {
        score -= 1000.0;
    }

    // Aggressive 2-step lookahead: reward when next item fits the post residual exactly or well
    if next_item_size > 0 && post_residual >= next_item_size {
        let next_fit = post_residual - next_item_size;
        score -= 60.0 * (1.0 - next_fit as f64 / bin_capacity as f64);
        if next_fit == 0 {
            score -= 300.0; // perfect 2-chain
        }
    } else if next_item_size > 0 {
        // next item cannot fit here; penalize small dead residuals proportionally
        let dead = post_residual as f64;
        if dead < 10.0 {
            score += 40.0; // tiny unusable sliver
        } else {
            score += 10.0 * (1.0 - dead / bin_capacity as f64);
        }
    }

    // Compare against mean residual: prefer bins whose post residual is near the mean
    // (keeps residuals balanced), but avoid leaving residuals that are hard to fill.
    let dev = (post_residual as f64 - mean_residual).abs();
    score += 0.5 * dev;

    // Last chance: strongly favor using the only bin that fits
    if fitting_bins_count == 1 && bin_residual >= item_size {
        score -= 250.0;
    }

    // Prefer fuller bins (small residual before placement)
    score += 0.3 * (bin_residual as f64 / bin_capacity as f64);

    // Early in stream: be more willing to open new bins (penalize open bins less later)
    let progress = if total_items > 0 { step_index as f64 / total_items as f64 } else { 0.0 };
    if bin_residual == bin_capacity {
        // New bin candidate: attractive early or when item is large relative to residuals
        score -= 80.0 * (1.0 - progress);
        if item_size as f64 > mean_residual {
            score -= 30.0;
        }
    } else {
        // Using existing bins gets more attractive as stream progresses
        score -= 20.0 * progress;
    }

    // Penalty proportional to number of open bins to discourage sprawl
    score += 2.0 * open_bins_count as f64;

    score
}
