 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    let capacity = bin_capacity.max(1) as f64;
    let item = item_size as f64;
    let residual = bin_residual as f64;
    let next = next_item_size as f64;
    let progress = if total_items == 0 {
        0.0
    } else {
        (step_index as f64 / total_items as f64).min(1.0)
    };

    let mut dead_space = post_residual as f64;
    if next > 0.0 && post_residual >= next {
        dead_space = 0.0;
    }
    if post_residual > 0 && post_residual < item.min(next.max(1.0)) {
        dead_space += (item - post_residual as f64).max(0.0);
    }
    if post_residual == 0 {
        dead_space = 0.0;
    }

    score += 1.75 * dead_space;
    score += 0.85 * (post_residual as f64).powi(2) / capacity;
    score += 4.0 * (open_bins_count as f64).max(0.0).sqrt();
    score += 0.018 * (open_bins_count as f64) * (100.0 - (100.0 - mean_residual).min(100.0));

    if fitting_bins_count <= 1 {
        score -= 18.0;
    }
    if bin_residual == bin_capacity {
        score += 28.0 + 7.0 * progress;
        if next > 0.0 {
            score += 0.12 * (next - item).abs();
        }
    } else {
        if post_residual == 0 {
            score -= 10.0;
        }
        if next > 0.0 && post_residual >= next {
            score -= 7.0;
        }
        if residual < item {
            score += 15.0;
        }
    }

    score -= 3.0 * progress * (post_residual as f64 / capacity);

    score
}
