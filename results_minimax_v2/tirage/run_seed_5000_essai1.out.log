 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    let capacity = bin_capacity.max(1) as f64;
    let item = item_size as f64;
    let residual = bin_residual as f64;
    let mean = mean_residual.max(0.0);
    let next = next_item_size as f64;

    let is_new_bin = bin_residual >= bin_capacity;
    let progress = if total_items == 0 {
        0.0
    } else {
        (step_index as f64 / total_items as f64).min(1.0)
    };

    let dead_space = if post_residual > 0 && (post_residual as u32) < item_size.min(next.max(1.0) as u32) {
        post_residual as f64
    } else {
        0.0
    };
    let small_gap_penalty = if post_residual > 0 && post_residual < 10 {
        (10.0 - post_residual as f64) * 0.35
    } else {
        0.0
    };

    score += dead_space * 2.5;
    score += small_gap_penalty;
    score += post_residual as f64 * 0.08;

    let fill_efficiency = if capacity > 0.0 {
        (item / capacity).min(1.0)
    } else {
        0.0
    };
    score -= fill_efficiency * 6.0;

    let residual_ratio = (residual / capacity).min(1.0);
    score -= (1.0 - residual_ratio) * 3.0;

    if is_new_bin {
        score += 35.0;
        score += open_bins_count as f64 * 0.25;
    } else {
        score += open_bins_count as f64 * 0.08;

        if fitting_bins_count <= 1 {
            score -= 18.0;
        }

        if next > 0.0 && post_residual as f64 + 1e-9 >= next {
            score -= 8.0;
        }

        if mean > 0.0 && residual < mean {
            score -= (mean - residual) * 0.12;
        } else if mean > 0.0 && residual > mean {
            score += (residual - mean) * 0.05;
        }

        if progress > 0.75 && post_residual <= 10 {
            score += (0.9 - progress) * 2.0;
        }
    }

    score
}
