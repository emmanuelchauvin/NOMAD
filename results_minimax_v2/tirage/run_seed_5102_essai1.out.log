 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    if bin_residual == bin_capacity {
        score -= 120.0;
        score += 0.35 * (open_bins_count as f64).max(0.0);
        score += 0.08 * (mean_residual - bin_capacity as f64 * 0.5);
    } else {
        score += 0.22 * (post_residual as f64).powi(2) / bin_capacity as f64;

        let waste_penalty = if post_residual == 0 {
            0.0
        } else if post_residual < item_size.min(next_item_size.max(1)) {
            18.0
        } else if post_residual < 10 {
            8.0
        } else {
            0.0
        };
        score += waste_penalty;

        if next_item_size > 0 && post_residual >= next_item_size {
            score -= 14.0 + 0.10 * (next_item_size as f64);
        } else if next_item_size > 0 {
            score += 0.08 * (next_item_size as f64 - post_residual.min(next_item_size) as f64);
        }

        score -= 0.15 * (item_size as f64);
        score += 0.05 * (mean_residual - post_residual as f64);

        let scarcity = if fitting_bins_count <= 1 {
            28.0
        } else if fitting_bins_count == 2 {
            11.0
        } else {
            0.0
        };
        score += scarcity;

        let progress = if total_items > 0 {
            step_index as f64 / total_items as f64
        } else {
            0.0
        };
        score += 7.0 * progress * (post_residual as f64) / bin_capacity as f64;
    }

    if open_bins_count == 0 {
        score -= 25.0;
    }

    score += 0.015 * (step_index as f64) / (total_items.max(1) as f64).sqrt();

    score
}
