 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    if bin_residual == bin_capacity {
        score -= 28.0;
    }

    if next_item_size > 0 {
        if post_residual >= next_item_size {
            score -= 18.0 + (next_item_size as f64 / bin_capacity as f64) * 8.0;
        } else {
            let overflow = (next_item_size - post_residual) as f64;
            score += overflow * 0.65;
        }

        let post_deviation = post_residual as f64 - mean_residual;
        score += post_deviation * 0.18;

        if post_residual < next_item_size && post_residual < item_size {
            score += 10.0;
        }
    } else {
        score += post_residual as f64 * 0.08;
    }

    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score += 7.0;
    }

    let progress = if total_items > 0 {
        step_index as f64 / total_items as f64
    } else {
        0.0
    };

    if bin_residual != bin_capacity {
        score -= progress * 4.0;

        if open_bins_count > 1 {
            let utilization = 1.0 - (bin_residual as f64 / bin_capacity as f64);
            score -= utilization * utilization * 6.0;
        }
    }

    if post_residual == 0 {
        score -= 20.0;
    }

    score
}
