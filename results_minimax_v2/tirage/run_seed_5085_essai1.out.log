 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    let progress = if total_items == 0 {
        0.0
    } else {
        step_index as f64 / total_items as f64
    };

    let dead_space = (post_residual > 0 && post_residual < item_size) as u32 as f64;
    let near_dead_space = (post_residual >= item_size && post_residual < 2 * item_size) as u32 as f64;
    let pressure = open_bins_count as f64 / (1.0 + total_items as f64);

    score += dead_space * (35.0 + 30.0 * pressure);
    score += near_dead_space * (8.0 + 12.0 * pressure);

    if post_residual == 0 {
        score -= 12.0;
    } else {
        score += (post_residual as f64 / bin_capacity.max(1) as f64) * 4.0;
    }

    if bin_residual == bin_capacity {
        score += 120.0 + 80.0 * pressure;
        if fitting_bins_count == 0 {
            score -= 180.0;
        }
    } else if fitting_bins_count == 1 {
        score -= 45.0;
        score += dead_space * 25.0;
    }

    if next_item_size > 0 {
        if post_residual >= next_item_size {
            score -= 10.0;
        } else {
            score += (next_item_size - post_residual) as f64 * 0.35;
        }
    }

    let mean_gap = (mean_residual - item_size as f64).abs();
    score += mean_gap * 0.08;

    if progress > 0.85 {
        score += dead_space * 18.0;
    }

    score
}
