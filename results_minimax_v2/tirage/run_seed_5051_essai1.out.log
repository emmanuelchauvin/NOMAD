 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    let mut unusable_dead_space = 0.0;
    if post_residual > 0 && post_residual < item_size.min(next_item_size.max(1)) {
        unusable_dead_space = (post_residual as f64).powi(2);
        score += unusable_dead_space * 8.0;
    }

    let pressure = if total_items > 0 {
        step_index as f64 / total_items as f64
    } else {
        0.0
    };

    let pressure_factor = 1.0 + (open_bins_count as f64).sqrt() * 0.35 + pressure * 0.5;
    score += unusable_dead_space * pressure_factor;

    if fitting_bins_count <= 1 {
        score += (item_size as f64) * 0.08;
    }

    if post_residual == 0 {
        score -= item_size as f64 * 0.12;
    }

    if bin_residual == bin_capacity {
        score += open_bins_count as f64 * 1.25;
        score += mean_residual.max(0.0) * 0.015;
    } else {
        score -= (mean_residual - post_residual as f64).abs() * 0.01;
    }

    score
}
