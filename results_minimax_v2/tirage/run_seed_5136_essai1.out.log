 Logic Code       : pub fn score_bin(
    item_size: u32,
    bin_residual: u32,
    bin_capacity: u32,
    step_index: usize,
    total_items: usize,
    open_bins_count: usize,
    mean_residual: f64,
    next_item_size: u32,
    post_residual: u32,
    fitting_bins_count: usize,
) -> f64 {
    let mut score = post_residual as f64;

    // Prefer tighter placements, but do not create negligible fragments.
    let item = item_size as f64;
    let capacity = bin_capacity.max(1) as f64;
    let residual = bin_residual as f64;
    let progress = step_index as f64 / total_items.max(1) as f64;

    let tightness = 1.0 - (residual / capacity);
    score += (1.0 - tightness) * 9.0;

    // Dead space is increasingly costly near the end of the stream.
    let dead_penalty = if post_residual > 0 && (post_residual as u32) < item_size.min(20) {
        4.0 + 10.0 * progress
    } else {
        0.0
    };
    score += dead_penalty;

    // Reward consuming space close to the average residual.
    let mean_gap = (mean_residual - residual).abs();
    score -= mean_gap * 0.08;

    // A lookahead item can use the residual space created by this placement.
    if next_item_size > 0 && post_residual >= next_item_size {
        score -= 5.0 + 4.0 * (next_item_size as f64 / capacity);
    } else if next_item_size > 0 {
        score += 0.6 * (next_item_size as f64 / capacity);
    }

    // If this is the only fitting bin, urgency rises late in the stream.
    if fitting_bins_count <= 1 {
        score -= (2.0 + 8.0 * progress) * (item / capacity);
    }

    // Opening an empty bin is acceptable only when the existing bins are poor;
    // the empty candidate receives this same structural signal through residual.
    if bin_residual == bin_capacity {
        score += open_bins_count as f64 * 0.025;
        score += mean_residual * 0.015;
    }

    // Slightly favor placements in bins whose remaining space is less globally typical.
    score += (mean_residual - residual) * 0.012;

    score
}
