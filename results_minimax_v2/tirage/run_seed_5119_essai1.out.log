 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    let progress = if total_items > 0 {
        step_index as f64 / total_items as f64
    } else {
        1.0
    };

    // Small residual gaps are substantially less useful than larger ones.
    if post_residual > 0 && post_residual < next_item_size {
        score += (next_item_size - post_residual) as f64 * 3.0;
    } else if post_residual > 0 && (post_residual as f64) < mean_residual {
        score += (mean_residual - post_residual as f64) * 0.35;
    }

    // Tight placements are favored, with extra emphasis on avoiding tiny dead gaps.
    let tightness = item_size as f64 / bin_residual.max(1) as f64;
    score -= tightness * 0.25;

    if post_residual == 0 {
        score -= 8.0;
    }

    // A unique fitting bin should normally be used before opening another bin.
    if fitting_bins_count == 1 && bin_residual < bin_capacity {
        score -= 10.0;
    }

    // Opening pressure rises late in the stream and when many bins remain open.
    let pressure = open_bins_count as f64 * (0.015 + 0.04 * progress);
    score -= pressure * (1.0 - tightness).clamp(0.0, 1.0);

    // Prefer consuming a bin whose residual is below the average.
    if post_residual < mean_residual {
        score -= (mean_residual - post_residual as f64) * 0.08;
    }

    score
}
