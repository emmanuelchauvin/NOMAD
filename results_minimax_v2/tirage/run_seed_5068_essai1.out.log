 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;
    let progress = if total_items == 0 {
        0.0
    } else {
        step_index as f64 / total_items as f64
    };

    // Small remnants are usually unusable for future items, so charge them
    // heavily.  Larger remnants are retained as useful packing capacity.
    let dead_gap = (post_residual as f64).min(9.0);
    score += dead_gap * dead_gap * 2.0;

    // Very tight residuals deserve an additional penalty: filling them can
    // strand a sizable portion of the bin, while loose residuals are safer.
    if post_residual > 0 && post_residual < item_size {
        score += (item_size - post_residual) as f64 * 0.75;
    }

    // Prefer tighter fits, but only after accounting for dead-space risk.
    score -= (bin_residual as f64 - post_residual as f64).powf(0.15) * 0.10;

    // A nearly empty new bin is a last resort when there are alternatives.
    // As the stream matures, permit opening one more bin to avoid stranding
    // capacity, but keep the new-bin score unattractive when other bins fit.
    if bin_residual == bin_capacity {
        score += 35.0;
        score += open_bins_count as f64 * 0.55;
        score += progress * 20.0;
        if fitting_bins_count == 0 {
            score -= 45.0;
        }
    } else {
        // Pressure from many open bins favors using existing capacity.
        score += open_bins_count as f64 * 0.18;

        // If this is the only fitting bin, strongly prefer it over opening.
        if fitting_bins_count == 1 {
            score -= 28.0;
        }

        // Align residual space with the mean residual of active bins; this
        // mildly favors placements that preserve a balanced global state.
        score += (post_residual as f64 - mean_residual).abs() * 0.035;
    }

    // Lookahead: avoid creating a gap that cannot accommodate the next item.
    if next_item_size > 0 && post_residual > 0 && post_residual < next_item_size {
        score += (next_item_size - post_residual) as f64 * 1.35;
    }

    score
}
