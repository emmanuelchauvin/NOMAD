 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    let item = item_size as f64;
    let cap = bin_capacity as f64;
    let post = post_residual as f64;
    let next = next_item_size as f64;
    let mean = mean_residual as f64;

    let progress = if total_items > 0 {
        step_index as f64 / total_items as f64
    } else {
        1.0
    };

    let is_new_bin = bin_residual >= bin_capacity;
    let is_last_item = next_item_size == 0;

    // Dead-space penalty: small leftovers are much less useful than large ones.
    if post > 0.0 && post < item {
        let normalized_gap = post / cap;
        score += 35.0 * (1.0 - normalized_gap).powi(2);
    } else if post == 0.0 {
        score -= 6.0;
    } else {
        score -= 2.0 * (post / cap);
    }

    // Prefer tight fits that leave reusable residual capacity.
    let utilization = 1.0 - post / cap;
    score -= 4.0 * utilization;

    // Lookahead: reward leaving room for the next item.
    if !is_last_item && next > post {
        let shortage = (next - post) / cap;
        score += 12.0 * shortage;
    } else if !is_last_item && next > 0.0 {
        score -= 1.5 * (post / cap);
    }

    // Open-bin pressure: consolidate when many bins remain active.
    let pressure = (open_bins_count as f64).max(1.0).ln() / 5.0;
    score += 3.0 * pressure;

    // A single fitting bin is a critical decision point.
    if fitting_bins_count == 1 && !is_new_bin {
        score -= 8.0;
    }

    // New bins are normally unattractive, but become competitive in tight streams.
    if is_new_bin {
        score += 30.0;
        if progress > 0.65 {
            score -= 10.0 * progress;
        }
        if mean < item {
            score -= 8.0 * (item - mean) / cap;
        }
    }

    // Prefer placements near the mean residual profile of active bins.
    let deviation = (post - mean).abs() / cap;
    score += 5.0 * deviation;

    score
}
