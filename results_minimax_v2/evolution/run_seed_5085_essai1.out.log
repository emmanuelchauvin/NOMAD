    let norm_next = (next / capacity).clamp(0.0, 1.0);
    let fitting_ratio = (fitting_bins_count as f64 / open_bins_count.max(1) as f64).clamp(0.0, 1.0);
    let horizon = 0.62 + 0.38 * progress;

