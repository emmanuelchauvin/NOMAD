 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;
    let progress = if total_items == 0 {
        0.0
    } else {
        step_index as f64 / total_items as f64
    };

    if bin_residual == bin_capacity {
        score += 260.0;
        score -= 70.0 * progress;
        score -= if next_item_size == 0 { 0.0 } else { 18.0 };
    } else {
        let next = next_item_size as f64;
        let post = post_residual as f64;

        if next > 0.0 {
            if post >= next {
                score -= 115.0 + 25.0 * (post - next) / bin_capacity as f64;
            } else {
                score += 135.0 + 45.0 * (next - post) / bin_capacity as f64;
            }

            let exact = if post == next { 1.0 } else { 0.0 };
            score -= 85.0 * exact;
        } else {
            score -= 45.0;
        }

        let mean = if mean_residual.is_finite() {
            mean_residual.max(0.0)
        } else {
            0.0
        };
        score += 32.0 * (post - mean) / bin_capacity as f64;
        score += 0.22 * (post - mean).abs();

        if post < item_size {
            score += 90.0;
        }
        if post <= 9 {
            score += 55.0;
        } else if post <= 19 {
            score += 18.0;
        }

        if fitting_bins_count == 1 {
            score -= 72.0;
        }

        score -= 18.0 * progress;
        score += 8.0 * open_bins_count as f64 / 100.0;
    }

    score
}
