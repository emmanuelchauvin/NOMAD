 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    let progress = if total_items == 0 {
        0.0
    } else {
        step_index as f64 / total_items as f64
    };

    let residual = bin_residual as f64;
    let capacity = bin_capacity.max(1) as f64;
    let mean = mean_residual.max(0.0);
    let open_bins = open_bins_count as f64;
    let fitting = fitting_bins_count as f64;
    let next_size = next_item_size as f64;

    let unusable_gap = if post_residual == 0 {
        0.0
    } else if post_residual < next_size && next_size > 0.0 {
        (next_size - post_residual as f64).max(0.0)
    } else {
        0.0
    };
    score += 3.5 * unusable_gap;

    let dead_fraction = post_residual as f64 / capacity;
    score += 18.0 * dead_fraction * dead_fraction;

    let occupancy = item_size as f64 / capacity;
    score -= 8.0 * occupancy;

    let mean_gap = (mean - post_residual as f64).max(0.0);
    score += 0.45 * mean_gap;

    let pressure = (open_bins / (open_bins + 4.0)).min(1.0);
    score += 4.0 * pressure * (post_residual as f64 / capacity);

    if fitting <= 1.0 && fitting > 0.0 {
        score -= 10.0 * occupancy;
        score -= 2.0 * pressure;
    }

    if open_bins > 1.0 && mean > residual * 0.5 {
        score += 1.5 * (mean - residual * 0.5).max(0.0) / capacity;
    }

    if next_size > 0.0 {
        let next_fit = if post_residual >= next_item_size {
            -2.0 * (next_item_size as f64 / capacity)
        } else {
            1.5 * (next_item_size as f64 / capacity)
        };
        score += next_fit;
    }

    score += 2.0 * progress * (post_residual as f64 / capacity);

    score
}
