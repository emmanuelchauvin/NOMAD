        }
    }

    // GEN-36 mutation: dead-space shaping near item boundary
    if !fresh && pr > 0.0 && pr < cap {
        if pr < it && progress < 0.9 {
            score += (1.0 - progress) * 30.0 * (pr / cap);
        }
        if nx > 0.0 && (pr - nx).abs() < 3.0 && pr != nx {
