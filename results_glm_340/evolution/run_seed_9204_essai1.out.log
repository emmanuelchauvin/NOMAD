    }

    // GEN-36 mutation: fresh-bin discount when residual would strand a large block late
    if fresh && fitting_bins_count > 0 && progress > 0.5 {
        let stranded = bin_residual.saturating_sub(item_size) as f64;
        if stranded > 0.55 * cap {
