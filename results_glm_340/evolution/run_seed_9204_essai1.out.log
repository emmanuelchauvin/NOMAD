 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;
    let cap = bin_capacity as f64;
    let pr = post_residual as f64;
    let it = item_size as f64;
    let nx = next_item_size as f64;
    let progress = step_index as f64 / total_items.max(1) as f64;
    let fresh = bin_residual == bin_capacity;
    let half = 0.5 * cap;

    // Perfect fit: strong reward, amplified early
    if post_residual == 0 {
        score -= 1100.0 + 150.0 * (1.0 - progress);
    }

    // Cubic dead-space penalty, softened late
    score += pr.powi(3) / (cap * cap * cap) * 90.0 * (1.0 - 0.5 * progress);

    // Last-chance bin
    if fitting_bins_count == 1 && !fresh {
        score -= 350.0;
    }

    // Lookahead chain logic
    if next_item_size > 0 {
        if post_residual == next_item_size {
            score -= 580.0;
        } else if post_residual > next_item_size {
            let chain_left = post_residual - next_item_size;
            let chain_bonus = if chain_left <= item_size { 110.0 } else if chain_left <= next_item_size { 60.0 } else { 0.0 };
            score -= 60.0 * (pr / nx.max(1.0)).ln().max(0.0) + chain_bonus;
            let slack = pr - nx;
            if slack < 8.0 {
                score -= (8.0 - slack) * 12.0;
            }
            if chain_left > item_size && chain_left >= next_item_size {
                score -= 25.0;
            }
        } else {
            score += (next_item_size - post_residual) as f64 * (0.7 + 0.5 * (1.0 - progress));
            if pr < 8.0 {
                score -= 20.0;
            }
        }
        if post_residual == item_size.saturating_add(next_item_size) {
            score -= 300.0;
        } else if post_residual < item_size.saturating_add(next_item_size) && pr < 0.25 * cap {
            score += 60.0 + 0.5 * (0.25 * cap - pr);
        }
    }

    // Tightness vs mean, amplified by open bin count
    score += (pr - mean_residual) * (0.5 + 0.005 * open_bins_count.min(60) as f64);

    // Consolidation pressure
    score += (open_bins_count as f64).powi(2) * 0.004 + open_bins_count as f64 * 0.2;

    // Waste-ratio term
    let fill_fraction = it / cap;
    let hole_fraction = pr / cap;
    if hole_fraction > fill_fraction {
        score += (hole_fraction - fill_fraction) * 140.0;
    }

    // New-bin candidate logic
    if fresh {
        score += 55.0;
        if fitting_bins_count == 0 {
            score -= 280.0;
        } else if fitting_bins_count == 1 {
            let waste_if_stuffed = bin_residual.saturating_sub(item_size) as f64;
            score -= 130.0 + 0.7 * waste_if_stuffed;
        } else {
            let best_possible_waste = bin_residual.saturating_sub(item_size) as f64;
            if best_possible_waste > 0.4 * cap {
                score -= 90.0;
            }
        }
        if next_item_size > 0 && next_item_size >= item_size {
            score -= 80.0;
        }
        if progress > 0.8 && pr > 0.45 * cap {
            score += 100.0 * progress;
        }
        if fitting_bins_count > 1 && pr <= 4.0 {
            score += 120.0;
        }
        if fitting_bins_count > 0 {
            let min_waste = bin_residual.saturating_sub(item_size) as f64;
            if min_waste > 0.6 * cap && progress < 0.7 {
                score -= 60.0 * (1.0 - progress);
            }
        }
    } else {
        score -= 15.0;
    }

    // Early stream: discourage fragmenting
    score += progress * 20.0 * (pr / cap);

    // Small items prefer near-perfect fits
    if item_size <= 10 && post_residual > 0 {
        score += pr * 0.45;
    }

    // Very large items: prefer any existing bin that fits
    if it > 0.7 * cap && !fresh {
        score -= 60.0;
    }

    // Exact-size match to current residual
    if post_residual == item_size {
        score -= 90.0;
        if nx > it {
            score -= 70.0;
        }
    }

    // Borrowed: mid-band dead-space shaping
    let dist_from_half = (pr - half).abs();
    if pr > 0.0 && pr < cap && !fresh {
        score += (1.0 - dist_from_half / half) * 18.0;
    }

    // Late-stream consolidation
    if progress > 0.75 {
        score += (pr / cap) * 35.0 * progress;
    }

    // Mid-stream near-exact chain fit
    if progress > 0.35 && progress < 0.85 && nx > 0.0 && pr >= nx && pr - nx < 12.0 {
        score -= 45.0;
    }

    // Dead-space trap detection
    if post_residual > 0 && post_residual < 15 {
        score += 35.0 * (1.0 - progress);
    }

    // Clean remainder after next item
    if next_item_size > 0 && post_residual >= next_item_size {
        let rem2 = post_residual - next_item_size;
        if rem2 == 0 {
            score -= 40.0;
        } else if rem2 <= 5 {
            score -= 18.0;
        }
    }

    // Residual variance-aware tightening
    if mean_residual > 0.0 {
        let tight_gain = (pr / mean_residual).powi(2).min(4.0);
        score -= 10.0 * tight_gain * (1.0 - progress) * 0.5;
    }

    // Adaptive sliver threshold scaled by observed item sizes
    let sliver_limit = if nx > 0.0 { (nx * 0.5).clamp(8.0, 25.0) } else { 15.0 };
    if post_residual > 0 && (post_residual as f64) < sliver_limit && post_residual != next_item_size {
        score += 40.0 * (1.0 - progress) * (1.0 - post_residual as f64 / sliver_limit);
    }

    // Pair-sum lookahead
    if next_item_size > 0 {
        let pair_sum = item_size.saturating_add(next_item_size);
        if bin_residual >= pair_sum {
            let pair_slack = bin_residual - pair_sum;
            if pair_slack <= 10 {
                score -= 70.0 - 4.0 * pair_slack as f64;
            }
        }
    }

    // Prefer tightest fit when many bins fit
    if fitting_bins_count > 2 {
        score += pr * 0.12;
    }

    // Late-stream new-bin restraint
    if progress > 0.85 && fresh && fitting_bins_count > 0 {
        score += 140.0 * progress;
    }

    // Fragmentation guard
    if fitting_bins_count <= 2 && !fresh && pr > 0.5 * cap {
        score += 25.0 + 0.3 * (pr - 0.5 * cap);
    }

    // GEN-9: residual-dead-space coupling
    if !fresh && next_item_size > 0 && post_residual > 0 && post_residual < next_item_size {
        let miss = (next_item_size - post_residual) as f64;
        if miss <= 20.0 {
            score += miss * (2.5 + 3.0 * progress);
        }
    }

    // GEN-9: reward bins whose post-residual can host plausible future fill
    if !fresh && post_residual > 0 {
        let est_item = (cap - mean_residual).max(1.0);
        let fits_est = (post_residual as f64 / est_item).floor();
