        }
    }

    // GEN-36 mutation: tiling-error coupling — reward post-residuals that are
    // near-multiples of the mean observed item size for exact future tiling.
    if !fresh && post_residual > 0 && mean_residual > 1.0 {
        let est = mean_residual.max(1.0);
        let k = (pr / est).round().max(1.0);
        let tiling_err = ((pr - k * est).abs()) / est;
        score += tiling_err * 16.0 * (0.5 + 0.5 * progress);
        if tiling_err < 0.1 {
            score -= 20.0 * k.min(3.0) * (1.0 - 0.5 * progress);
        }
    }

    // GEN-36 mutation: keep room for follow-up item after next placement
    if !fresh && next_item_size > 0 && post_residual >= next_item_size {
        let rem2 = post_residual - next_item_size;
        if rem2 > 0 && (rem2 as f64) < nx * 0.25 && rem2 < 20 {
            score += (20.0 - rem2 as f64) * 3.0 * (0.5 + progress);
        } else if rem2 >= next_item_size {
            score -= 28.0 * (1.0 - 0.4 * progress);
        }
    }

    // GEN-36 mutation: fresh-bin opening gate vs estimated next-item demand
    if fresh && fitting_bins_count > 0 && next_item_size > 0 {
        let best_waste = bin_residual.saturating_sub(item_size) as f64;
        if best_waste < nx as f64 * 0.6 {
            score += 55.0 * (1.0 - 0.3 * progress);
        }
    }

    score
