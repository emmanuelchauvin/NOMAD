            let leftover = post_residual as f64 - fits_est * est_item;
            score -= 14.0 * fits_est.min(3.0) * (1.0 - leftover / est_item) * (1.0 - 0.4 * progress);
        }
    }

    // GEN-9: fresh-bin decision refined
    if fresh && fitting_bins_count > 0 {
        let waste_existing = bin_residual.saturating_sub(item_size) as f64;
        let item_frac = it / cap;
        if waste_existing > cap * (0.5 - 0.4 * item_frac) {
            score -= 45.0 + 0.35 * (waste_existing - cap * (0.5 - 0.4 * item_frac));
        }
        if progress < 0.25 && open_bins_count < 8 {
            score -= 30.0 * (1.0 - progress);
        }
    }

    // GEN-11: awkward-band gap penalty strengthened with progress coupling
    if !fresh && next_item_size > 0 && post_residual > next_item_size {
        let gap = post_residual - next_item_size;
        if gap > 0 && gap < 8 {
            score -= (8 - gap) as f64 * 7.0 * (0.5 + progress);
        }
    }

    // GEN-11: mid-band residual trap
    if !fresh && nx > 0.0 && pr >= nx && pr < 0.3 * cap && fitting_bins_count > 1 {
        let waste = pr - nx;
        score += waste * 1.5 * progress;
    }

    // GEN-11: fresh-bin bias against small items late
    if fresh && item_size <= 30 && fitting_bins_count > 0 && progress > 0.3 {
        score += 90.0 * progress;
    }

    // GEN-13: dead-space budget accounting
    if !fresh && post_residual > 0 {
        let remaining = ((total_items - step_index) as f64).max(1.0);
        let est_item = (cap - mean_residual).max(1.0);
        let recoverable = if pr >= est_item * 0.5 { 1.0 } else { pr / (est_item * 0.5) };
        let permanence = (1.0 - recoverable).clamp(0.0, 1.0);
        let hole_price = pr * (0.15 + 0.55 * permanence) * (1.0 - 0.6 / (1.0 + remaining * 0.02));
        score += hole_price;
        if next_item_size > 0 && pr >= next_item_size as f64 {
            let refund = (pr - next_item_size as f64).min(pr);
            score -= refund * 0.35 * (1.0 - progress);
        }
    }

    // GEN-13: two-step chain refinement
    if !fresh && next_item_size > 0 && post_residual >= next_item_size {
        let rem2 = post_residual - next_item_size;
        if rem2 as f64 >= 0.2 * cap {
            score -= 22.0 * (1.0 - 0.5 * progress);
        } else if rem2 > 0 && (rem2 as f64) < 0.08 * cap {
            score += 14.0 * (1.0 - rem2 as f64 / (0.08 * cap));
        }
    }

    // GEN-13: fresh-bin gate tightened
    if fresh && fitting_bins_count >= 2 {
        let best_waste = bin_residual.saturating_sub(item_size) as f64;
        if best_waste < 0.25 * cap {
            score += 70.0 * (1.0 - 0.5 * progress);
        }
    }

    // GEN-13: triple-chain lookahead
    if !fresh && next_item_size > 0 {
        let pair_sum = item_size.saturating_add(next_item_size);
        if post_residual == pair_sum {
            score -= 110.0 * (1.0 - 0.5 * progress);
        }
        let rem3 = bin_residual.saturating_sub(pair_sum);
        if rem3 > 0 && rem3 <= 100 && rem3 >= next_item_size / 2 {
            score -= 35.0 * (1.0 - progress);
        }
    }

    // GEN-36 mutation: near-full bin squeeze bonus
    if !fresh && pr <= 6.0 {
        score -= (6.0 - pr) * 9.0 * (0.5 + progress);
    }

    // GEN-36 mutation: among several fitting bins, reward tightness relative to mean
    if fitting_bins_count >= 2 && !fresh {
        let rel = (pr / mean_residual.max(1.0)).min(2.0);
        score += rel * 6.0;
        if pr < 0.15 * cap {
