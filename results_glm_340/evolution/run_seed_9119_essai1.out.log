        if fill > 0.7 && fitting_bins_count >= 2 {
            fresh_cost -= 4.0 * (fill - 0.7) * 10.0 * (0.5 + 0.5 * progress);
        }
        if fitting_bins_count >= 1 && next_item_size > 0
            && post_residual >= item_size + next_item_size {
            fresh_cost += 4.0 + 3.0 * progress;
        }
        if remaining < 30.0 && fitting_bins_count >= 1 && fill < 0.85 {
            fresh_cost += 4.0 * (1.0 - remaining / 30.0) * (1.0 - fill);
        }
        if fitting_bins_count >= 1 && progress > 0.3 && mean_residual > 4.0 {
            fresh_cost += 0.35 * (mean_residual - 4.0) * (progress - 0.3) * 2.0;
        }
        if fitting_bins_count >= 1 && next_item_size as f64 > 0.75 * cap {
            fresh_cost -= 5.0;
        }
        if fitting_bins_count >= 1 && post_residual > 0 {
            if post_residual <= 2 {
                fresh_cost += 12.0;
            } else if next_item_size > 0 && post_residual % next_item_size == 0 {
                fresh_cost += 8.0 * (0.5 + 0.5 * progress);
            }
        }
        if fitting_bins_count >= 1 && post_residual > 0
            && next_item_size > post_residual
            && pr > mean_residual * 1.4 {
            let e = pr - mean_residual * 1.4;
            fresh_cost -= 2.0 * e * (0.4 + 0.6 * progress);
        }
        if fitting_bins_count >= 1 && post_residual <= 4 && fill > 0.5 {
            fresh_cost += 10.0 * (1.0 - pr / 5.0) * (0.4 + 0.6 * progress);
        }
        if fitting_bins_count >= 1 && next_item_size > post_residual
            && next_item_size - post_residual <= 4
            && pr > mean_residual {
            fresh_cost -= 3.0 * (1.0 - (next_item_size - post_residual) as f64 / 5.0)
                * (0.5 + 0.5 * progress);
        }
        if fitting_bins_count >= 1 && next_item_size > 0 && post_residual >= next_item_size {
            let k = post_residual / next_item_size;
            if k >= 2 {
                fresh_cost += 3.0 * (k.min(4) as f64) * (0.3 + 0.7 * progress);
            }
        }
        if fitting_bins_count >= 1 && post_residual >= 10 && post_residual <= 20
            && next_item_size > post_residual
            && pr > mean_residual * 1.1 {
            fresh_cost -= 2.5 + 0.15 * (post_residual - 10) as f64 * (0.5 + progress);
        }
        if fitting_bins_count >= 2 && post_residual <= 6 {
            fresh_cost += 6.0 * (1.0 - pr / 7.0) * (0.5 + 0.5 * progress);
        }
        // Fresh-bin surcharge tied to remaining scarcity.
        if fitting_bins_count >= 1 && remaining < 60.0 {
            let scarcity = 1.0 - remaining / 60.0;
            let rescue = fill > 0.85 || (next_item_size as f64 > 0.7 * cap && fill > 0.5);
            if !rescue {
                fresh_cost += 14.0 * scarcity * scarcity * (0.4 + 0.6 * progress);
            } else {
                fresh_cost -= 4.0 * scarcity;
            }
        }
        // Fresh-bin surcharge when an open bin would be left nearly full.
        if fitting_bins_count >= 1 && post_residual > 0 && post_residual <= 2 {
            fresh_cost += 6.0 * (1.0 - progress);
        }
        // Mean-residual-aware fresh-bin gate.
        if fitting_bins_count >= 1 {
            let mrn = mean_residual / cap;
            if mrn < 0.05 {
                fresh_cost += 10.0 * (0.05 - mrn) * 20.0 * (0.5 + 0.5 * progress);
            } else if mrn > 0.20 && fill < 0.5 {
                fresh_cost -= 6.0 * (mrn - 0.20) * 20.0;
            }
        }
        // Item-size vs. mean-residual fresh gate.
        if fitting_bins_count >= 1 {
            let ratio = item_size as f64 / mean_residual.max(1.0);
            if ratio > 1.8 && fill > 0.45 {
                fresh_cost -= 2.5 * ((ratio - 1.8).min(3.0)) * (0.4 + 0.6 * progress);
            } else if ratio < 0.6 {
                fresh_cost += 3.0 * (0.6 - ratio) * 5.0 * (0.5 + 0.5 * progress);
            }
        }
        // Stranded-capacity fresh-bin gate.
        if fitting_bins_count >= 1 {
            let best_pr = pr;
            if best_pr > mean_residual.max(1.0) * 1.6 && fill > 0.55 {
                fresh_cost -= 3.0 * (best_pr - mean_residual.max(1.0) * 1.6).min(10.0)
                    * (0.4 + 0.6 * progress);
            } else if best_pr <= 2.0 {
                fresh_cost += 4.0 * (1.0 - best_pr / 3.0) * (0.5 + 0.5 * progress);
            }
        }
        // Fresh-bin harvestability gate.
        if fitting_bins_count >= 1 {
            let mr = mean_residual.max(1.0);
            let ratio = pr / mr;
            let near_mult = (ratio - ratio.round()).abs();
            if ratio >= 1.0 && near_mult <= 0.12 {
                fresh_cost += 3.5 * (1.0 - near_mult / 0.12) * (0.4 + 0.6 * progress);
            } else if ratio > 0.6 && ratio < 0.95 {
                fresh_cost -= 2.5 * (1.0 - (ratio - 0.6).abs() / 0.35) * (0.4 + 0.6 * progress);
            }
        }
        // Fresh-bin gate on aggregate open-bin slack.
        if fitting_bins_count >= 1 {
            let agg = mean_residual * open_bins_count.max(1) as f64;
            let agg_frac = (agg / (cap * 8.0)).min(1.0);
            if agg_frac > 0.5 && fill > 0.5 {
                fresh_cost -= 5.0 * (agg_frac - 0.5) * 2.0 * (0.4 + 0.6 * progress);
            } else if agg_frac < 0.25 {
                fresh_cost += 4.0 * (0.25 - agg_frac) * 4.0 * (0.5 + 0.5 * progress);
            }
        }
        // Discourage fresh bins when the current item could finish an open bin.
        if fitting_bins_count >= 1 && post_residual == 0 {
            fresh_cost += 10.0 + 6.0 * progress;
        }
        // Fresh-bin residual-drift gate.
        if fitting_bins_count >= 1 {
            let mrn = mean_residual / cap;
            if mrn > 0.12 && fill > 0.4 {
                fresh_cost -= 4.0 * (mrn - 0.12) * 12.0 * (0.4 + 0.6 * progress);
            } else if mrn < 0.06 && fill < 0.7 {
                fresh_cost += 3.0 * (0.06 - mrn) * 25.0 * (0.5 + 0.5 * progress);
            }
        }
        // Fresh-bin chain-completion gate.
        if fitting_bins_count >= 1 && next_item_size > 0 {
            if post_residual == next_item_size {
                fresh_cost += 9.0 + 5.0 * progress;
            } else if post_residual > 0 && post_residual < next_item_size
                && next_item_size - post_residual > 10 {
                fresh_cost -= 2.0 * (0.4 + 0.6 * progress);
            }
        }
        // Fresh-bin dead-space escape valve.
        if fitting_bins_count >= 1 && post_residual > 0 {
            let mr = mean_residual.max(1.0);
            if pr > mr * 2.2 && fill > 0.35 {
                fresh_cost -= 2.5 * ((pr - mr * 2.2) / mr).min(3.0) * (0.4 + 0.6 * progress);
            }
            if pr <= mr * 0.5 {
                fresh_cost += 3.0 * (1.0 - pr / (mr * 0.5).max(1.0)) * (0.5 + 0.5 * progress);
            }
        }
        // Gen 38: fresh-bin exact-fit lockout.
        if fitting_bins_count >= 1 && post_residual <= 2 {
            fresh_cost += 9.0 * (1.0 - pr / 3.0) * (0.5 + 0.5 * progress);
        }
        // Gen 38: cheapening when item + next item would exactly fill a fresh bin.
        if next_item_size > 0 && (item_size + next_item_size) as f64 >= cap * 0.98
            && fitting_bins_count >= 1
            && post_residual as f64 > cap - (item_size + next_item_size) as f64 {
            fresh_cost -= 7.0;
        }
        // NEW (gen 39): dead-space liquidity gate on fresh bins — when the best
        // open-bin post-residual is a large multiple of the mean residual, the
        // open fleet is already fragmented; a fresh bin can be cheaper than
        // compounding that waste, but only for small/mid items.
        if fitting_bins_count >= 1 && post_residual > 0 {
            let mr = mean_residual.max(1.0);
            let frag = pr / mr;
            if frag > 2.5 && fill < 0.55 {
                fresh_cost -= 2.0 * ((frag - 2.5) / 3.0).min(1.0) * (0.4 + 0.6 * progress);
            } else if frag < 1.2 {
                fresh_cost += 3.0 * (1.0 - frag / 1.2) * (0.5 + 0.5 * progress);
            }
        }
        // NEW (gen 39): fresh-bin two-item exact-fill anticipation — if the next
        // item would exactly fill a fresh bin after this one, opening is cheap.
        if next_item_size > 0 && next_item_size as f64 == cap - item_size as f64
            && fitting_bins_count >= 1 {
            fresh_cost -= 8.0 * (1.0 - progress);
        }
        // NEW (gen 39): late-stream fresh-bin lockout — near the end, opening a
        // new bin is almost always a net loss unless the item is huge.
        if remaining < 40.0 && fitting_bins_count >= 1 && fill < 0.9 {
            let urgency = 1.0 - remaining / 40.0;
            fresh_cost += 6.0 * urgency * urgency * (1.0 - fill) * (0.5 + 0.5 * progress);
        }
        score += fresh_cost;
    }

    // NEW (gen 39): cross-bin compaction — when many open bins exist and the
    // chosen bin would leave a very small post-residual, reward it extra so the
    // fleet converges toward full bins instead of many half-full ones.
    if bin_residual != bin_capacity && open_bins_count > 3 && post_residual <= 3 {
        score -= 2.5 * (open_bins_count.min(20) as f64).ln() * (1.0 - pr / 4.0)
            * (0.4 + 0.6 * progress);
    }

    // NEW (gen 39): dead-space variance damping — prefer post-residuals close to
    // the fleet mean so future items (which cluster near mean sizes) remain
    // harvestable, reducing average dead space per bin.
    if bin_residual != bin_capacity && post_residual > 0 {
        let dev = (pr - mean_residual.max(1.0)).abs();
        score -= 1.0 * (1.0 - (dev / (mean_residual.max(1.0) * 1.5)).min(1.0))
            * (0.3 + 0.7 * progress);
    }

    // NEW (gen 39): residual-bucket alignment — reward post-residuals matching
    // common item-size buckets (5/10/25/50) that future items likely hit.
    if bin_residual != bin_capacity && post_residual > 0 && post_residual <= 60 {
        if post_residual % 50 == 0 {
            score -= 3.0 * (0.5 + 0.5 * progress);
        } else if post_residual % 25 == 0 {
            score -= 2.0 * (0.5 + 0.5 * progress);
        }
    }

    score
}
