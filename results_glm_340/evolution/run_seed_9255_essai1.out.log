 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;
    let progress = step_index as f64 / total_items.max(1) as f64;
    let pressure = open_bins_count as f64 * (0.55 + 0.45 * progress);

    // Dead-space avoidance bands, fine-grained near-zero residuals.
    if post_residual < 10 {
        score += 70.0;
    } else if post_residual < 20 {
        score += 33.0;
    } else if post_residual < 30 {
        score += 11.0;
    } else if post_residual < 45 {
        score += 1.5;
    }

    // Perfect / near-perfect fits.
    if post_residual == 0 {
        score -= 92.0;
    } else if post_residual <= 5 {
        score -= 35.0;
    } else if post_residual <= 8 {
        score -= 13.5;
    }

    // Tightness reward, amplified for large items; quadratic flavor.
    let tightness = item_size as f64 / bin_residual.max(1) as f64;
    let tight_w = if item_size >= 50 { 35.0 } else { 21.5 };
    score -= tight_w * tightness + 6.5 * tightness * tightness;

    score += pressure * 0.35;

    // Last-chance bin: only bin that fits — using it avoids a new bin.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 20.0 + 0.55 * open_bins_count as f64;
    }

    // Lookahead chain fits (combined with fine-grained residual fitting).
    if next_item_size > 0 && post_residual >= next_item_size {
        let next_tight = (post_residual - next_item_size) as f64;
        let chain_bonus = if next_tight == 0.0 {
            38.0
        } else if next_tight <= 10.0 {
            26.0 * (1.0 - next_tight / 110.0)
        } else {
            15.0 * (1.0 - next_tight / 100.0)
        };
        score -= chain_bonus;
        if next_tight > 0.0 && next_tight <= 25.0 && next_item_size >= 30 {
            score -= 3.5;
        }
        if next_item_size >= 60 && next_tight <= 15.0 {
            score -= 7.0;
        }
        if post_residual >= next_item_size * 2 {
            let two_step = post_residual - next_item_size * 2;
            if two_step <= 12 {
                score -= 4.0 * (1.0 - two_step as f64 / 14.0);
            }
        }
        if next_item_size <= 25 && post_residual >= next_item_size * 3 {
            let three_step = post_residual - next_item_size * 3;
            if three_step <= 6 {
                score -= 3.0 * (1.0 - three_step / 8.0_f64);
            }
        }
        let depth = post_residual / next_item_size;
        if depth >= 2 {
            let cap = if next_item_size <= 15 { 5.0 } else { 4.0 };
            score -= (depth.min(cap as u32) as f64 - 1.0) * 2.2;
        }
        if post_residual % next_item_size == 0 {
            let copies = post_residual / next_item_size;
            if copies >= 2 {
                score -= 3.0 + 1.2 * copies.min(5) as f64;
            }
        }
        let target = (mean_residual - next_item_size as f64).abs();
        let closeness = (post_residual as f64 - target).abs();
        if closeness <= 6.0 {
            score -= 2.0 * (1.0 - closeness / 7.0);
        }
    } else if next_item_size > 0 && post_residual > 0 && post_residual < next_item_size {
        let gap = (next_item_size - post_residual) as f64;
        score += 10.0 + 0.11 * gap;
        if gap <= 4.0 {
            score -= 3.0;
        }
        if post_residual <= 3 {
            score += 2.0;
        } else if gap > 12.0 {
            score += 0.08 * gap;
        }
        let typical = mean_residual.max(1.0);
        if post_residual as f64 >= typical * 0.9 {
            score -= 2.5;
        }
    }

    // Mean-residual coupling.
    let below_mean = (bin_residual as f64) < mean_residual;
    if next_item_size >= 50 {
        if below_mean { score -= 4.5; } else { score -= 2.0; }
    } else {
        if below_mean { score -= 10.0; } else { score += 4.5; }
    }

    // Dead-space ratio coupling — progressive quadratic ramp.
    if bin_residual > 0 && bin_residual != bin_capacity {
        let strand_ratio = post_residual as f64 / bin_residual as f64;
        if strand_ratio > 0.55 {
            let excess = strand_ratio - 0.55;
            score += 5.5 * excess * (1.0 + 1.6 * excess)
                * (post_residual as f64 / 30.0).min(1.5);
        }
        if post_residual >= 12 && post_residual <= 35 && bin_residual >= 50 {
            let dev = (post_residual as f64 - 25.0).abs();
            score += 0.45 * (1.0 - dev / 13.0).max(0.0);
        }
        if next_item_size > 0 && post_residual < next_item_size {
            score += 0.06 * post_residual as f64 * (1.0 - progress);
        }
        // Late-stream waste tax.
        let remaining_items = (total_items - step_index) as f64;
        if remaining_items < 15.0 && post_residual > 0 {
            let urgency = (15.0 - remaining_items) / 15.0;
            score += 0.12 * post_residual as f64 * urgency;
        }
        // Variance-aware dead-space penalty.
        let spread = (bin_residual as f64 - mean_residual).abs();
        let tight_pool = (1.0 - (spread / 40.0).min(1.0)).max(0.0);
        if post_residual > 20 {
            score += 0.09 * (post_residual - 20) as f64 * tight_pool
                * (1.0 - progress * 0.5);
        }
    }

    // New-bin candidate logic.
    if bin_residual == bin_capacity {
        let item_ratio = item_size as f64 / bin_capacity.max(1) as f64;
        let mut new_bin_score = 6.0 + pressure * 0.18;
        if item_size >= 60 {
            new_bin_score -= 19.5 + 11.0 * item_ratio;
        } else if item_size >= 40 {
            new_bin_score -= 6.0;
        } else {
            new_bin_score += 13.5;
        }
        if fitting_bins_count == 0 {
            new_bin_score -= 27.0;
        } else {
            let poor_pool = mean_residual < (item_size as f64) * 1.15;
            if poor_pool {
                new_bin_score -= 6.0 * item_ratio;
            } else {
                new_bin_score += 2.0 * item_ratio;
            }
            if fitting_bins_count == 1 && post_residual < 14 {
                new_bin_score -= 13.5 - 0.35 * post_residual as f64;
            }
            if post_residual as f64 > 0.45 * bin_residual as f64 {
                new_bin_score -= 4.5 * item_ratio;
            }
            if next_item_size >= 55 && mean_residual < next_item_size as f64 * 0.8 {
                new_bin_score -= 3.5;
            }
            if next_item_size > 0 && post_residual < next_item_size {
                new_bin_score -= 2.5 + 0.05 * next_item_size as f64;
                let gap = (next_item_size - post_residual) as f64;
                if gap > mean_residual.max(1.0) {
                    new_bin_score -= 2.5 * (gap / 30.0).min(1.5);
                }
            }
            if open_bins_count > 8 && mean_residual < 20.0 {
                new_bin_score -= 1.5 + 0.1 * (open_bins_count as f64 - 8.0).min(10.0);
            }
            let remaining = (total_items - step_index) as f64;
            if remaining < 8.0 {
                new_bin_score += 2.0 * (8.0 - remaining);
            }
            if next_item_size > 0 && post_residual < next_item_size && remaining > 20.0 {
                new_bin_score += 1.5;
            }
            if item_size >= 55 && mean_residual < item_size as f64 * 1.3 && remaining > 15.0 {
                new_bin_score -= 4.0 * (1.0 - item_size as f64 / 100.0);
            }
        }
        if progress < 0.3 {
            new_bin_score -= 6.5 * (0.3 - progress) / 0.3;
        }
        if progress > 0.8 {
            new_bin_score += 5.0 * (progress - 0.8) / 0.2;
        }
        if progress >= 0.3 && progress <= 0.8 && item_size < 40 {
            new_bin_score += 2.0;
        }
        score += new_bin_score;
    }

    score
}
