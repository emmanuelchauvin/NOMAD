    }

    // Residual-divisibility lookahead — perfect chain fill enabled.
    if next_item_size > 1 && post_residual > 0 && post_residual >= next_item_size {
        let q = post_residual / next_item_size;
        let rem = post_residual % next_item_size;
        if rem == 0 {
            score -= (q as f64).min(4.0) * 4.0 * (1.0 - 0.5 * progress);
            if q >= 2 {
                score -= (q as f64).min(5.0) * 3.5 * (0.6 + 0.6 * progress);
            }
        } else if rem <= 2 {
            score -= 3.0 * (1.0 - progress);
        }
    }

    // Late-stream compaction squeeze.
    if progress > 0.75 && post_residual > 0 {
        score += pr * (progress - 0.75) * 4.0;
    }

    // Discourage spreading small items off near-perfect packs.
    if bin_residual > item_size && bin_residual - item_size <= 2 && item_size <= 10 {
        score -= 8.0;
    }

    // Waste-fraction penalty on open bins, with chain-aware dead-space squeeze.
    if bin_residual < bin_capacity && post_residual > 0 {
        let waste_frac = pr / br.max(1.0);
        score += waste_frac * 6.0 * (1.0 - progress);
        let chains = next_item_size > 0 && next_item_size <= post_residual;
        if waste_frac > 0.45 && !chains {
            score += (waste_frac - 0.45) * 22.0 * (0.5 + 0.5 * progress);
        }
        if waste_frac < 0.2 {
            score -= (0.2 - waste_frac) * 15.0 * (0.6 + 0.6 * progress);
        }
    }

    // Density-ratio compaction with fill-efficiency gradient.
    if bin_residual < bin_capacity {
        let consumed_frac = item_f / br.max(1.0);
        if consumed_frac > 0.7 {
            score -= (consumed_frac - 0.7) * 30.0 * (1.2 - progress);
        }
        if next_item_size > 0 && post_residual >= next_item_size {
            let reusable = (post_residual - next_item_size) as f64;
            if consumed_frac > 0.5 && reusable <= 10.0 {
                score -= consumed_frac * (10.0 - reusable) * (0.6 + 0.8 * progress);
            }
        }
        if consumed_frac > 0.55 && consumed_frac < 0.7 {
            score -= (consumed_frac - 0.55) * 12.0 * (1.0 - progress);
        }
        let mean_fill = 1.0 - mean_residual / cap_f;
        if consumed_frac > mean_fill {
            score -= (consumed_frac - mean_fill) * 18.0 * (0.5 + open_bins_count.min(12) as f64 * 0.05);
        }
    }

    // Near-exact residual targeting.
    if post_residual > 0 && post_residual <= 12 {
        score -= 5.0 * (1.0 - progress) + 3.0 * progress;
    }

    // Dead-gap oracle.
    if post_residual > 0 && post_residual < 30 {
        let next_blocks = next_item_size > 0 && (next_item_size as f64) > pr;
        if next_blocks && pr < mean_residual * 0.8 {
            score += (mean_residual * 0.8 - pr) * (0.5 + progress);
        }
    }

    // Residual ladder smoothing.
    if post_residual > 0 {
        let dev = (pr - mean_residual).abs();
        if dev < 4.0 {
            score -= (4.0 - dev) * 2.5;
        }
        if dev <= 6.0 && post_residual >= 5 {
            score -= 3.0 + 2.0 * (1.0 - progress);
        }
    }

    // Stranded-gap accounting.
    if post_residual > 0 && post_residual < 20 {
        let can_take_next = next_item_size > 0 && next_item_size <= post_residual;
        let can_take_mean = (pr - mean_residual).abs() < 2.0;
        if !can_take_next && !can_take_mean {
            let deficit = (20.0 - pr).max(0.0);
            score += deficit * deficit * 0.08 * (0.4 + progress);
        }
    }

    // Dead-space variance squeeze.
    if post_residual > 0 && post_residual < 15 {
        let gap = (15.0 - pr).max(0.0);
        score += gap * gap * 0.05 * progress * progress;
    }

    // Endgame exactness.
    if progress > 0.85 && post_residual > 6 {
        score += (post_residual - 6) as f64 * 2.0;
    }

    // Fragmentation-weighted consolidation.
    let frag = open_bins_count as f64 / (1.0 + mean_residual / 8.0);
    if post_residual > 4 && post_residual < 20 && frag > 2.0 {
        let reusable = next_item_size > 0 && next_item_size <= post_residual;
        if !reusable {
            score += (20.0 - pr) * 0.12 * frag.min(6.0) * (0.5 + 0.5 * progress);
        }
    }

    // Two-item lookahead compaction with fine-grained chain fitting.
    if next_item_size > 0 && post_residual >= next_item_size {
        let two_gap = post_residual - next_item_size;
        if two_gap as f64 <= mean_residual * 1.2 && two_gap > 0 {
            score -= (mean_residual * 1.2 - two_gap as f64) * 0.5 * (0.4 + 0.6 * progress);
        }
        if two_gap <= 2 {
            score -= 9.0 * (1.0 - 0.3 * progress);
        } else if two_gap <= 6 {
            score -= (6 - two_gap) as f64 * 1.8 * (0.5 + 0.5 * progress);
        }
    }

    // Residual-entropy squeeze.
    if post_residual > 0 && post_residual < mean_residual * 0.45 && mean_residual < 25.0 {
        score += (mean_residual * 0.45 - pr) * 1.1 * (0.7 + 0.5 * progress);
    }
    if next_item_size > 0 && post_residual > next_item_size && post_residual <= next_item_size + 1 && item_f / br.max(1.0) > 0.4 {
        score -= 7.0 * (1.0 - 0.4 * progress);
    }

    // Exact-closure arbitration — sealing a bin perfectly is a
    // fleet-size-scaled near-free win over other open bins and fresh bins.
    if post_residual == 0 && bin_residual < bin_capacity {
        score -= 30.0 + (open_bins_count.min(14) as f64) * 1.5;
    }

    // Sliver-seal avoidance late in the stream.
    if post_residual > 0 && progress > 0.5 {
        let sliver = mean_residual / 3.0;
        if pr < sliver {
            score += (sliver - pr) * (1.0 + 2.0 * (progress - 0.5));
        }
    }

    // Exact-sum decomposition probe — guaranteed two-step closure reward.
    if next_item_size > 0 && post_residual > next_item_size {
        let two_step = post_residual - next_item_size;
        if two_step == item_size {
            score -= 22.0 * (0.7 + 0.6 * progress);
        } else if item_size > 0 && two_step % item_size == 0 {
            let k = two_step / item_size;
            if k >= 2 && k <= 3 {
                score -= 9.0 * (1.0 - 0.4 * progress);
            }
        }
    }

    // Dead-zone band refinement — residuals in (16, 25) that cannot host
    // the next item nor a mean-sized filler are true dead weight.
    if post_residual >= 16 && post_residual < 25 {
        let next_blocks = next_item_size == 0 || (next_item_size as f64) > pr;
        if next_blocks {
            score += 6.0 + (25.0 - pr) * 0.55 * (0.4 + 0.6 * progress);
        }
    }

    // Fleet-residual budget guard — when total open slack is tight relative
    // to remaining items, avoid burning slack on loose fits.
    if open_bins_count > 1 && bin_residual < bin_capacity {
        let fleet_slack = open_bins_count as f64 * mean_residual;
        let remaining = (total_items.saturating_sub(step_index)) as f64;
        if remaining > 0.0 {
            let slack_per_item = fleet_slack / remaining;
            let consumed_frac = item_f / br.max(1.0);
            if slack_per_item < 0.9 && consumed_frac < 0.6 {
                score += (0.9 - slack_per_item) * 14.0 * (1.0 - consumed_frac);
            }
        }
    }

    // Gen-42 mutation: chain-continuation depth probe — prefer placements
    // whose post-residual can absorb the next item AND still leave a
    // residual that matches the fleet mean (keeps future options alive).
    if next_item_size > 0 && post_residual >= next_item_size && post_residual > 0 {
        let after_next = post_residual - next_item_size;
        let dev = (after_next as f64 - mean_residual).abs();
        if dev < 5.0 {
            score -= (5.0 - dev) * 1.6 * (0.6 + 0.4 * progress);
        }
        // Penalize single-item-only chains that strand a mid-band gap.
        if after_next >= 16 && after_next < 25 {
            score += 5.0 * (0.5 + 0.5 * progress);
        }
    }

    score
