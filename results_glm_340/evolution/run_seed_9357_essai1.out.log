 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;
    let progress = if total_items > 0 { step_index as f64 / total_items as f64 } else { 0.0 };
    let cap_f = bin_capacity.max(1) as f64;
    let item_f = item_size as f64;
    let pr = post_residual as f64;
    let br = bin_residual as f64;

    // Sharper dead-space tiers, tuned by stream progress.
    if post_residual > 0 && post_residual < 8 {
        score += 80.0 + 10.0 * progress;
    } else if post_residual < 16 {
        score += 25.0;
    } else if post_residual < 25 {
        score += 8.0;
    }

    // Tight-fit rewards, deepened for large items.
    if post_residual == 0 {
        score -= 120.0 + item_f * 0.15;
        if open_bins_count > 6 {
            score -= 6.0 + open_bins_count.min(20) as f64 * 0.5;
        }
    } else if post_residual <= 4 {
        score -= 55.0;
    }

    // Two-step lookahead on the next item.
    if next_item_size > 0 {
        if next_item_size == post_residual {
            score -= 100.0;
        } else if next_item_size < post_residual {
            let future_gap = post_residual - next_item_size;
            if future_gap < 8 {
                score += 20.0;
            } else {
                score -= 10.0;
            }
        } else {
            score += pr * 0.25;
        }
    }

    // Last-chance bin: strongly prefer the only fitting open bin.
    if fitting_bins_count == 1 && bin_residual < bin_capacity {
        score -= 70.0;
    }

    // Progress-driven consolidation pressure.
    score += open_bins_count as f64 * (1.0 + progress);

    // New-bin candidate handling.
    if bin_residual == bin_capacity {
        score += 20.0 + 40.0 * progress;
        if item_f > mean_residual {
            score -= 25.0;
        }
        if item_size > 60 {
            score -= 20.0;
        }
        if fitting_bins_count == 0 {
            score -= 150.0;
        } else if fitting_bins_count == 1 && post_residual >= 8 {
            score += 35.0;
        }
        if next_item_size > 0 && (next_item_size as f64) <= mean_residual {
            score += 15.0;
        }
        if fitting_bins_count > 0 {
            let waste_ratio = (br - item_f) / cap_f;
            if item_f > 0.6 * cap_f && item_f > mean_residual + 8.0 {
                score -= 12.0 * progress;
            }
            if waste_ratio > 0.30 && item_f / cap_f > 0.5 {
                score -= 18.0;
            }
            if waste_ratio > 0.45 && next_item_size > 0 && (bin_residual - item_size) < next_item_size {
                score -= 10.0 * (1.0 - progress);
            }
            if waste_ratio > 0.38 && (br - item_f) > mean_residual * 1.6 {
                score -= 16.0 * (1.0 - 0.5 * progress);
            }
            if (item_f - mean_residual).abs() < 3.0 && waste_ratio > 0.25 {
                score -= 9.0 * (1.0 - progress);
            }
            let fleet_fragmentation = open_bins_count as f64 * mean_residual / cap_f;
            if fleet_fragmentation > 1.5 && item_f / cap_f > 0.55 {
                score -= (fleet_fragmentation - 1.5) * 4.5 * (1.0 - 0.6 * progress);
            }
            let crowded = open_bins_count as f64 / (1.0 + mean_residual / 10.0);
            if crowded > 3.0 && item_f / cap_f > 0.45 {
                score -= 8.0 + 6.0 * progress;
            }
            if mean_residual < 12.0 && item_f / cap_f > 0.7 {
                score -= 10.0 + 8.0 * progress;
            }
            if next_item_size > 0 && next_item_size as f64 > mean_residual && item_f > next_item_size as f64 {
                score -= 6.0 * (1.0 - progress);
            }
            if progress > 0.7 {
                let best_possible_gap = bin_residual.saturating_sub(item_size);
                if best_possible_gap <= 10 {
                    score += 90.0 * (progress - 0.7);
                }
            }
            // Spawn only when the fresh bin's post-residual can chain
            // with the next item; otherwise keep the open fleet absorbing.
            if next_item_size > 0 {
                let fresh_gap = bin_residual.saturating_sub(item_size);
                if (fresh_gap as f64) < next_item_size as f64 * 0.5 {
                    score += 14.0 * (1.0 - progress);
                } else if fresh_gap == next_item_size {
                    score -= 10.0 * (1.0 - progress);
                }
            }
            // Big-item spawn arbitration.
            if item_f / cap_f > 0.8 {
                score -= 14.0 * (1.0 - 0.5 * progress);
            }
            // Two-item chain feasibility for fresh bins.
            if next_item_size > 0 && fitting_bins_count >= 2 {
                let fresh_gap = bin_residual.saturating_sub(item_size);
                let leftover_after_next = fresh_gap as i64 - next_item_size as i64;
                if leftover_after_next > 0 && (leftover_after_next as f64) < mean_residual * 0.4 {
                    score += 12.0 * (0.5 + 0.5 * progress);
                }
            }
        }
    } else {
        // Prefer bins with residual close to the fleet mean.
        score += (br - mean_residual).abs() * 0.35;
        score -= progress * 8.0;
    }

    // Reward placements moving residual toward the fleet mean.
    let dr_before = (br - mean_residual).abs();
    let dr_after = (pr - mean_residual).abs();
    if dr_after < dr_before {
        score -= (dr_before - dr_after) * 0.4;
    }

    // Penalize gaps that neither fit the next item nor typical residuals.
    if next_item_size > 0 && post_residual > 0 && post_residual < next_item_size {
        score += (next_item_size - post_residual) as f64 * (0.5 + 1.5 * progress);
        let unreachable = (next_item_size as f64 - pr).min(pr);
        score += unreachable * 0.35 * (0.3 + 0.7 * (1.0 - progress));
        let fleet_slack = mean_residual / cap_f;
        score += (next_item_size - post_residual) as f64 * fleet_slack * 1.2 * progress;
    }

    // Prefer the bin whose post-residual best matches the next item size.
    if next_item_size > 0 && post_residual >= next_item_size && fitting_bins_count > 1 {
        let slack = (post_residual - next_item_size) as f64;
        score -= (1.0 - slack / cap_f) * 6.0;
    }

    // Perfect handoff chain reward, deepened late in the stream.
    if next_item_size > 0 && next_item_size == post_residual {
        score -= 15.0 * (0.5 + progress);
        if open_bins_count > 4 {
            score -= 8.0;
