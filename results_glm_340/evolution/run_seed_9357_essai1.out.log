        if chain_gap <= 3 {
            score -= 12.0 + 10.0 * progress;
        }
        if chain_gap <= 5 && open_bins_count >= 2 {
            score -= (6.0 - chain_gap as f64) * (1.5 + 0.25 * open_bins_count.min(12) as f64);
