    // MUTATION (gen 43): dead-space ceiling coupling.
    if post_residual > 0 && next_item_size > 0 && fitting_bins_count >= 1 {
        let fleet_dead = mean_residual * (open_bins_count as f64).max(1.0);
        let fleet_frac = (fleet_dead / (cap * open_bins_count.max(1) as f64)).clamp(0.0, 1.0);
        let pr = post_residual as f64;
        if fleet_frac > 0.30 {
            if pr >= next_item_size as f64 && pr % next_item_size.max(1) as u32 == 0 {
                score -= 6.0 * (pr / cap) * (0.5 + 0.5 * progress);
            }
        } else {
            let tight = 1.0 - (pr / cap);
            score -= 4.0 * tight * tight * (0.4 + 0.6 * progress);
        }
    }

    // MUTATION (gen 43): sliver-merge preference.
    if post_residual >= 1 && post_residual <= 4 && next_item_size > 0 {
        let band = ((next_item_size as f64 * 0.1).max(1.0)).min(4.0);
        if dead <= band {
            score -= 5.0 * (1.0 - dead / band) * (0.3 + 0.7 * progress);
        }
    }

    // MUTATION (gen 43): next-item consumption forecast.
    if next_item_size > 0 && post_residual == next_item_size {
        let scarcity = 1.0 - (fitting_bins_count as f64).min(5.0) / 5.0;
        score -= 6.0 + 10.0 * scarcity;
    } else if next_item_size > 0 && post_residual > next_item_size && progress > 0.65 {
        let over = post_residual - next_item_size;
        if over % next_item_size != 0 && over < next_item_size {
            score += 3.0 * (over as f64 / next_item_size as f64) * (progress - 0.65) / 0.35;
        }
    }

    // MUTATION (gen 44): fleet-variance compaction.
    if post_residual > 0 && next_item_size > 0 && fitting_bins_count >= 2 {
        let dev_norm = (dead - mean_residual) / cap;
        let is_tile = post_residual % next_item_size == 0;
        if !is_tile {
            score += 10.0 * dev_norm * dev_norm.abs() * (0.3 + 0.7 * progress);
        } else {
            score += 2.5 * dev_norm * dev_norm.abs() * (0.3 + 0.7 * progress);
        }
    }

    // MUTATION (gen 44): dead-space budget gate.
    if post_residual > 0 && next_item_size > 0 {
        let fleet_cap = open_bins_count as f64 * cap;
        let fleet_res = mean_residual * open_bins_count.max(1) as f64;
        let used_frac = ((fleet_cap - fleet_res) / fleet_cap.max(1.0)).clamp(0.0, 1.0);
        let margin = 1.0 - used_frac;
        if dead > next_item_size as f64 {
            let over = dead - next_item_size as f64;
            score += 4.0 * (over / cap) * (1.0 - margin) * (0.4 + 0.6 * progress);
        } else if dead == 0.0 {
            score -= 3.0 * (1.0 - margin) * (0.5 + 0.5 * progress);
        }
    }

    // MUTATION (gen 44): near-miss rescue refinement.
    if post_residual > 0 && next_item_size > 0 && post_residual < next_item_size {
        let miss = (next_item_size - post_residual) as f64;
        if miss <= 2.0 {
            score += 6.0 * (2.0 - miss) * (0.5 + 0.5 * progress);
        }
    }

    // MUTATION (gen 45): dead-space ratio sharpening.
    if post_residual > 0 && next_item_size > 0 && post_residual < next_item_size {
        let half_next = next_item_size as f64 * 0.5;
        if dead > half_next {
            let excess = (dead - half_next) / (next_item_size as f64 - half_next).max(1.0);
            score += 7.0 * excess * excess * excess * (0.4 + 0.6 * progress);
        }
    }

    // MUTATION (gen 45): variance-collapse drain.
    if post_residual > 0 && fitting_bins_count >= 2 && open_bins_count >= 3 {
        let pool = mean_residual.max(1.0);
        let below = (pool - dead) / pool;
        if below > 0.0 && below <= 0.5 {
            let weight = ((open_bins_count as f64).ln() / 4.0).clamp(0.25, 1.0);
            score -= 4.0 * (1.0 - below * 2.0) * weight * (0.3 + 0.7 * progress);
        }
    }

    // MUTATION (gen 45): residual-absorption pairing.
    if post_residual > 0 && next_item_size > 0 && post_residual < next_item_size {
        let absorb = 1.0 - (dead / mean_residual.max(1.0)).clamp(0.0, 1.0);
        if dead <= mean_residual {
            score -= 3.0 * absorb * (0.5 + 0.5 * (1.0 - progress));
        }
    }

    // MUTATION (gen 46): dead-space floor sharpening.
    if post_residual > 0 && next_item_size > 0 && post_residual < next_item_size {
        let pr = dead;
        let half_next = next_item_size as f64 * 0.5;
        if pr > half_next * 0.9 && pr <= next_item_size as f64 * 0.75 {
            let band_pos = (pr - half_next * 0.9) / (next_item_size as f64 * 0.75 - half_next * 0.9).max(1.0);
            score += 9.0 * band_pos * (1.0 - band_pos) * 4.0 * (0.4 + 0.6 * progress);
        }
        let pool = mean_residual.max(1.0);
        if pr < pool * 0.9 && pr > 0.0 {
            let absorbability = 1.0 - (pool - pr) / pool;
            score -= 2.5 * absorbability * (1.0 - (fitting_bins_count as f64).min(5.0) / 5.0) * (0.3 + 0.7 * progress);
        }
    }

    // MUTATION (gen 46): residual-decay governor.
    if post_residual > 0 && next_item_size > 0 && open_bins_count >= 4 {
        let fleet_avg_dead = mean_residual;
        if fleet_avg_dead > next_item_size as f64 * 0.6 {
            let excess_fleet = (fleet_avg_dead - next_item_size as f64 * 0.6) / cap;
            let tight_gain = 1.0 - (dead / cap);
            score -= 5.0 * excess_fleet.clamp(0.0, 0.3) * tight_gain * (0.5 + 0.5 * progress);
        }
    }

    // MUTATION (gen 46): fresh-bin dead-space floor gate.
    if bin_residual == bin_capacity && next_item_size > 0 {
        let fresh_res = (bin_capacity - item_size) as f64;
        let liability = fresh_res / cap;
        let pool_frac = mean_residual / cap;
        if liability > 0.35 && pool_frac < 0.20 && fitting_bins_count >= 1 {
            score += 10.0 * (liability - 0.35) / 0.65 * (0.5 + 0.5 * progress);
        }
        if fresh_res as u32 == next_item_size {
            score -= 4.0 * (0.5 + 0.5 * progress);
        }
    }

    // MUTATION (gen 47): fleet-residual sweep — when the fleet mean residual
    // cannot host the next item but this bin's post-residual can, reward
    // this bin as the designated receiver; this drains the fleet toward
    // fewer, tighter bins instead of leaving mean-sized orphans everywhere.
    if next_item_size > 0 && post_residual >= next_item_size && fitting_bins_count >= 2 {
        let pool = mean_residual.max(1.0);
        if pool < next_item_size as f64 {
            let deficit_frac = (next_item_size as f64 - pool) / next_item_size as f64;
            score -= 6.0 * deficit_frac * (1.0 - (dead - next_item_size as f64) / cap).clamp(0.0, 1.0)
                * (0.5 + 0.5 * progress);
        }
    }

    // MUTATION (gen 47): dead-space ratio governor refinement — grade the
    // sub-half-dead band continuously so that among bins with similar
    // dead space, the one whose leftover is closest to a small-item
    // multiple is preferred, sharpening residual compaction.
    if post_residual > 0 && next_item_size > 0 && dead > 0.0 && dead < next_item_size as f64 * 0.5 {
        let small_unit = next_item_size.max(2) as f64 * 0.25;
        let near_tile = (dead / small_unit).round() * small_unit;
        let tile_gap = (dead - near_tile).abs() / small_unit.max(1.0);
        score -= 3.0 * (1.0 - tile_gap) * (0.3 + 0.7 * progress);
    }

    // MUTATION (gen 47): endgame fresh-bin suppression — in the final
    // stretch, opening a bin is almost never worth it unless the item is
    // huge and no open bin can host it; tighten the gate.
    if bin_residual == bin_capacity && progress > 0.8 && fitting_bins_count >= 1 {
        let big_frac = item_size as f64 / cap;
        if big_frac < 0.55 {
            score += 14.0 * (0.55 - big_frac) / 0.55 * (progress - 0.8) / 0.2;
        }
    }

    score
}
