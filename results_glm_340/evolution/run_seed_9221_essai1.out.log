                score += 20.0 * dead_frac * (0.4 + progress);
            }
        }
        // Fresh-bin quadratic chain quality — avoid awkward middle zone.
        if next_item_size > 0 && item_size + next_item_size <= bin_capacity {
            let chain_left = (bin_capacity - item_size - next_item_size) as f64;
            let mid_lo = 0.05 * cap;
            let mid_hi = (mean_residual * 0.9).max(mid_lo + 1.0);
            if chain_left > mid_lo && chain_left < mid_hi {
                let depth = 1.0 - (chain_left - mid_lo) / (mid_hi - mid_lo);
                score += 16.0 * depth * (0.5 + progress);
            }
        }
        // Item-size-aware fresh-bin trigger.
        if fitting_bins_count > 0 && item_size as f64 > 0.55 * cap {
            let tight_open = bin_residual >= item_size
