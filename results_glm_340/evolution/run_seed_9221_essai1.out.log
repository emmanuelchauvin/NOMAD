    if !is_new_bin && post_residual > 0 && post_residual <= 3 {
        score -= 35.0 * (1.0 - pr / 4.0);
        score -= 20.0 * progress * (1.0 - pr / 4.0);
    }

    // Two-step lookahead in open bins.
    if !is_new_bin && next_item_size > 0 && post_residual >= next_item_size {
        let after = post_residual - next_item_size;
