            if leftover <= 2.0 {
                score -= 30.0 * (1.0 - progress);
            }
            if leftover <= 4.0 {
                score -= 35.0 * (1.0 - 0.5 * progress);
            } else if leftover <= 0.15 * cap {
                score -= 18.0 * (1.0 - leftover / (0.15 * cap)) * (1.0 - 0.5 * progress);
            }
            if leftover >= nf {
                score -= 15.0 * (1.0 - progress);
            }
        }
        if progress > 0.6 {
            score += 45.0 * (progress - 0.6) / 0.4;
        }
        if fitting_bins_count > 0 && progress > 0.35 && progress <= 0.6 && fitting_bins_count == 1 {
            score -= 18.0 * (1.0 - progress);
        }
        if fitting_bins_count > 0 && next_item_size > 0 {
            let worst_dead = bin_residual.saturating_sub(next_item_size) as f64;
            if worst_dead > item_size as f64 {
                score -= 12.0 + 20.0 * (1.0 - progress);
            }
        }
        if item_size as f64 > 0.7 * cap && fitting_bins_count > 0 {
            let best_possible = bin_residual.saturating_sub(item_size);
            if best_possible > 0 && (best_possible as f64) < 0.15 * cap {
                score -= 20.0;
            }
        }
        if next_item_size > 0 {
            let rem = bin_capacity % next_item_size;
            if rem == 0 {
                score -= 22.0 * (1.0 - 0.4 * progress);
            } else if rem <= 3 {
                score -= 10.0 * (1.0 - 0.4 * progress);
            }
        }
        if next_item_size > 0 {
            if nf > 0.5 * cap {
                score -= 10.0 * (1.0 - progress);
            } else if nf < 0.15 * cap {
                score += 6.0 * (1.0 - progress);
            }
        }
        if next_item_size > 0 && item_size < bin_residual {
            let fresh_left = bin_residual - item_size;
            if fresh_left >= next_item_size && (fresh_left - next_item_size) <= 3 {
                score -= 40.0 * (1.0 - progress);
            }
        }
        if next_item_size > 0 && item_size + next_item_size <= bin_capacity {
            let chain_left = (bin_capacity - item_size - next_item_size) as f64;
            if chain_left >= 1.0 && chain_left <= 0.35 * cap {
                score -= 22.0 * (1.0 - chain_left / (0.35 * cap)) * (1.0 - 0.6 * progress);
            }
            if chain_left >= mean_residual * 0.85 {
                score -= 12.0 * (1.0 - progress);
            }
        }
        if progress > 0.7 && open_bins_count > 6 {
            score += 10.0 * (open_bins_count as f64).ln() * (progress - 0.7) / 0.3;
        }
        if fitting_bins_count > 0 && progress > 0.3 && item_size as f64 >= 0.25 * cap {
            score += 14.0 * (progress - 0.3) / 0.7;
        }
        if fitting_bins_count > 0 && progress > 0.15 && mean_norm < 0.2 {
            score += 12.0 * (0.2 - mean_norm) * (0.5 + progress);
        }
        // Residual-variance-aware fresh-bin guard.
        if fitting_bins_count > 0 && progress > 0.25 {
