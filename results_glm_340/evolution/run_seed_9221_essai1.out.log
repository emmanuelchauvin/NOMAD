        }
        // Fresh-bin chain-harvest refinement.
        if next_item_size > 1 && item_size + next_item_size <= bin_capacity && progress > 0.2 && progress < 0.8 {
            let chain_left = bin_capacity - item_size - next_item_size;
            if chain_left > 0 {
                let rem2 = chain_left % (next_item_size.min(10));
                if rem2 == 0 {
                    score -= 12.0 * (1.0 - (progress - 0.2).abs().max(0.0) / 0.6);
