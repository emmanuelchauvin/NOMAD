            }
        }
        // Dead-space recovery pressure with many open bins.
        if fitting_bins_count > 0 && next_item_size > 0 && open_bins_count > 4 {
            let chain_left = bin_capacity.saturating_sub(item_size + next_item_size) as f64;
            if chain_left > 0.3 * cap {
                score += 20.0 * (chain_left / cap - 0.3) * ((open_bins_count - 4) as f64).min(8.0) * 0.25;
            }
        }
        if fitting_bins_count == 0 {
