 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let progress = step_index as f64 / total_items.max(1) as f64;
    let pr = post_residual as f64;
    let cap = bin_capacity as f64;
    let norm_pr = pr / cap;
    let is_new_bin = bin_residual == bin_capacity;
    let mean_norm = mean_residual / cap;
    let nf = next_item_size as f64;

    // Base: wasted space with super-linear punishment of large residuals.
    let mut score = pr + 14.0 * norm_pr * norm_pr * cap;

    // Progress-coupled residual pressure.
    let progress_pressure = 0.5 + progress * progress * 1.5;
    score += 30.0 * progress_pressure * norm_pr * (1.0 - norm_pr);

    // Smooth reward for near-perfect fits.
    let tightness = (-norm_pr / 0.08).exp();
    score -= 25.0 * tightness * (0.5 + progress);

    // Lookahead chaining with next item.
    if next_item_size > 0 {
        if post_residual == next_item_size {
            score -= 900.0;
        } else if next_item_size <= post_residual {
            let fill = nf / pr.max(1.0);
            score -= 20.0 * fill * (1.0 - norm_pr);
            let leftover_after = post_residual - next_item_size;
            if leftover_after <= 2 {
                score -= 25.0;
            } else if leftover_after <= 6 {
                score -= 8.0 * (1.0 - (leftover_after - 2) as f64 / 4.0);
            }
            if leftover_after > 0 && (leftover_after as f64) < 0.5 * nf {
                score += 4.0 * (1.0 - leftover_after as f64 / nf);
            }
        } else {
            let gap = (next_item_size - post_residual) as f64;
            let dead_frac = gap / nf.max(1.0);
            score += 8.0 * norm_pr * (0.3 + progress)
                + 5.0 + gap * 0.35
                + 20.0 * dead_frac * dead_frac * (0.5 + progress);
        }
    }

    // Mean-residual coupling: below-mean bins are compact.
    score += 15.0 * (norm_pr - mean_norm) * (1.0 + progress);

    // Dead-space ratio penalty.
    if !is_new_bin && next_item_size > 0 && post_residual < next_item_size {
        if norm_pr > 0.22 {
            score += 32.0 * (norm_pr - 0.22) * (0.5 + progress) * (1.0 + mean_norm);
        }
    }

    // Multi-fit competition.
    if !is_new_bin && fitting_bins_count > 1 && next_item_size > 0 {
        let mismatch = (pr - nf).abs() / cap;
        let comp = ((fitting_bins_count - 1) as f64).ln().max(0.0);
        score += 6.0 * mismatch * comp;
        if pr == nf {
            score -= 5.0 * comp;
        }
    }

    // Last-chance bin bonus.
    if fitting_bins_count == 1 && !is_new_bin {
        score -= 40.0;
    }

    if is_new_bin {
        let open_pressure = (open_bins_count as f64).ln().max(0.0);
        score = 55.0 + open_pressure * (15.0 + 40.0 * progress) - 25.0 * (1.0 - progress);
        if next_item_size > 0 && item_size + next_item_size <= bin_capacity {
            let leftover = (bin_capacity - item_size - next_item_size) as f64;
            score -= 60.0 * (1.0 - progress)
