            score -= 6.0 * (1.0 - norm_pr) * (0.5 + progress);
        } else if next_item_size - rem <= 2 {
            score += 5.0 * progress;
        }
    }

    // Variance-targeting squeeze.
    if !is_new_bin {
        let dev = (norm_pr - mean_norm).abs();
        if dev > 0.18 {
            score += 18.0 * (dev - 0.18) * progress;
        }
    }

    // Dead-space ratio guard.
    if !is_new_bin && next_item_size > 0 && post_residual > 0 && post_residual < next_item_size {
        let dead_frac = 1.0 - pr / nf;
        score += 10.0 * dead_frac * dead_frac * (0.4 + progress);
    }

    // Dead-space productivity check.
    if !is_new_bin && post_residual > 0 && progress > 0.5 {
        let mean_item_est = mean_residual.max(1.0);
        if pr < mean_item_est * 0.6 {
            score += 16.0 * (1.0 - pr / (mean_item_est * 0.6)) * (progress - 0.5);
        }
    }

    // Exact-fill chain reward.
    if !is_new_bin && next_item_size > 0 && post_residual > next_item_size {
        let after = post_residual - next_item_size;
        if (after as f64) <= mean_residual * 0.35 && after > 0 {
            score -= 12.0 * (1.0 - after as f64 / (mean_residual * 0.35).max(1.0)) * (0.5 + progress);
        }
    }

    // Awkward-dead-space squeeze in open bins.
    if !is_new_bin && next_item_size > 0 && post_residual > 0 && post_residual < next_item_size {
        let frac = pr / nf;
        if frac > 0.15 && frac < 0.85 {
            let depth = 1.0 - (frac - 0.15).abs() / 0.35;
            score += 9.0 * depth.max(0.0) * (0.6 + progress);
        }
    }

    // Open-bin reusability shaping.
    if !is_new_bin && next_item_size > 0 && post_residual >= next_item_size {
        let band = ((pr - nf) / nf.max(1.0)).min(1.0);
        if band < 0.25 {
            score -= 7.0 * (0.25 - band) * (0.5 + progress);
        }
    }

    // High-dead-space open-bin squeeze.
    if !is_new_bin && next_item_size > 0 && post_residual > 0 && post_residual < next_item_size {
        let frac = pr / nf;
        if frac > 0.5 {
            score += 14.0 * (frac - 0.5) * (0.3 + progress);
        }
    }

    // Perfect-dead-space elimination.
    if !is_new_bin && post_residual > 0 && norm_pr < 0.03 && open_bins_count > 3 {
        score -= 9.0 * (1.0 - norm_pr / 0.03) * (0.6 + progress);
    }

    // Residual-chain divisibility refinement.
    if !is_new_bin && next_item_size > 1 && post_residual >= next_item_size {
        let after = post_residual - next_item_size;
        if after > 0 && after % next_item_size == 0 {
            score -= 7.0 * (1.0 - progress);
        }
    }

    // Open-bin crowding penalty.
    if !is_new_bin && open_bins_count > 8 {
        score += 2.5 * (open_bins_count as f64 - 8.0).min(12.0) * (0.3 + progress);
    }

    // Preference for reusable residuals scaled by competition.
    if !is_new_bin && next_item_size > 0 && post_residual >= next_item_size {
        let reusability = 1.0 - (pr - nf) / cap;
        score -= 6.0 * reusability * (1.0 / fitting_bins_count.max(1) as f64);
    }

    // Stranded dead-space refinement.
    if !is_new_bin && next_item_size > 0 && post_residual > 0 && post_residual < next_item_size {
        let stranded = (next_item_size - post_residual) as f64;
        if stranded > nf * 0.4 && stranded < mean_residual * 0.8 {
            score += 8.0 * (1.0 - stranded / (mean_residual * 0.8)) * (0.4 + 0.6 * progress);
        }
    }

    // Compaction pull — reward near-zero post-residual after hosting next item.
    if !is_new_bin && next_item_size > 0 && post_residual >= next_item_size {
        let after = (post_residual - next_item_size) as f64;
        if after < 0.04 * cap {
            score -= 11.0 * (1.0 - after / (0.04 * cap)) * (0.3 + progress);
        }
    }

    // MUTATION (new): harmonic-class fit quality — items near capacity fractions
    // (e.g. cap/2, cap/3) fit best into bins whose residual matches them exactly;
    // penalize dumping large-class items into nearly-full bins late in stream.
    let quarter = (bin_capacity / 4).max(1);
    let item_class = item_size / quarter;
    if !is_new_bin && item_class >= 3 && norm_pr > 0.4 {
        score += 10.0 * (norm_pr - 0.4) * (0.5 + progress);
    }

    // MUTATION (new): early-stream large-item reserve — when a big item is coming,
