            if !tight_open && progress < 0.75 {
                score -= 14.0 * (1.0 - progress) * ((item_size as f64 / cap) - 0.55) / 0.45;
            }
        }
        // Pair-compatibility alignment with mean residual.
        if next_item_size > 0 && item_size + next_item_size <= bin_capacity {
            let chain_left = (bin_capacity - item_size - next_item_size) as f64;
            let align = 1.0 - ((chain_left - mean_residual) / cap).abs() * 4.0;
            if align > 0.0 {
                score -= 10.0 * align * (0.4 + 0.6 * progress);
            }
        }
        // Fresh-bin chain divisibility — perfect multi-item chains.
        if next_item_size > 1 && item_size + next_item_size <= bin_capacity {
            let chain_left = bin_capacity - item_size - next_item_size;
            let rem = chain_left % next_item_size;
            if rem == 0 && chain_left > 0 {
                score -= 20.0 * (1.0 - 0.5 * progress);
            } else if rem <= 2 {
                score -= 8.0 * (1.0 - 0.5 * progress);
            }
        }
        // Prefer fresh bins when all open fits leave bad dead space.
        if fitting_bins_count > 0 && next_item_size > 0 {
            let fresh_dead = (bin_capacity - item_size) as f64;
            if fresh_dead < nf && (fresh_dead / cap) < 0.12 {
                score -= 25.0 * (1.0 - progress);
