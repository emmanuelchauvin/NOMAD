            score += 10.0 * (1.0 - progress);
        }
    }

    let mean_weight = if progress > 0.75 { 0.35 } else { 0.55 };
    score += mean_weight * (mean_residual - post_residual as f64);

    // Open-bin pressure: discourage proliferation of bins.
    let pressure = (open_bins_count as f64).ln().max(0.0);
    score += pressure * (2.0 + 8.0 * progress);

    if fitting_bins_count == 1 && bin_residual < bin_capacity {
        score -= 40.0 + 20.0 * (1.0 - progress);
