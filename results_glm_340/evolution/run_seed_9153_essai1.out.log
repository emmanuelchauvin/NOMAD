            if lookahead_waste == 0.0 {
                score -= 22.0;
            } else if lookahead_waste <= 3.0 {
                score -= 15.0 * (1.0 + 0.5 * (1.0 - progress));
            }
            // Chain lookahead: leftover after next item can host a third item?
            if (lookahead_waste as u32) >= next_item_size {
                score -= 8.0 * (1.0 - progress);
                let after = lookahead_waste - next_item_size as f64;
                if after < next_item_size as f64 {
                    score -= 10.0 * (1.0 - after / next_item_size.max(1) as f64);
                }
                if after >= 2.0 * next_item_size as f64 {
                    score -= 5.0 * (1.0 - progress);
                }
                let rem = (post_residual as u32) % next_item_size.max(1);
                if rem == 0 {
                    score -= 7.0 * (1.0 - progress);
                } else if rem <= 2 {
                    score -= 3.0 * (1.0 - rem as f64 / 3.0) * (1.0 - progress);
                }
            }
            // Alignment with fleet mean residual is a good sign.
            let res_gap = ((post_residual as f64) - mean_residual).abs();
            if res_gap < 4.0 {
                score -= 4.0 * (1.0 - res_gap / 4.0) * (1.0 - progress);
            }
            if (post_residual as f64) >= 0.9 * mean_residual
                && (post_residual as f64) <= 1.3 * mean_residual {
                score -= 5.0 * (1.0 - progress)
                    * (1.0 - res_gap / (0.4 * mean_residual).max(1.0)).max(0.0);
            }
        } else if next_item_size > 0 {
            let gap = (next_item_size - post_residual) as f64;
            score += 0.4 * gap.min(50.0);
            if post_frac < 0.25 {
                let awkward = 1.0 - (post_frac.max(0.05)) / 0.25;
                score += 4.0 * awkward;
            }
            if gap <= 5.0 {
                score += 3.0 * (1.0 - gap / 5.0);
            }
            if gap > 10.0 && gap <= 25.0 && (next_item_size as f64) < 1.5 * mean_residual {
                score += 1.5 * (1.0 - (gap - 10.0) / 15.0) * (1.0 - progress);
            }
            if gap > 25.0 && (post_residual as f64) > 0.6 * mean_residual {
