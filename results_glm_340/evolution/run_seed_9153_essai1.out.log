        }
        // Round-number residuals are easier to fill later.
        if post_residual > 0 {
            let pr = post_residual;
            if pr % 10 == 0 {
                score -= 5.0 * (1.0 - progress);
            } else if pr % 5 == 0 {
                score -= 2.5 * (1.0 - progress);
            }
        }
        if post_residual > 0 && post_residual <= 2 && next_item_size > post_residual {
            score += 6.0 * (1.0 - progress);
        }
        if open_bins_count > 4 && post_residual > 0 {
