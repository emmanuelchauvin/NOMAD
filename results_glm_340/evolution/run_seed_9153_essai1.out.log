            }
        }

        if (post_residual as f64) < 0.5 * mean_residual && post_residual > 0 {
            score -= 3.0 * (1.0 - post_residual as f64 / mean_residual.max(1.0)).min(1.0);
        }

        // Self-tiling: post residual divisible by next item size.
        if next_item_size > 0 && post_residual > next_item_size {
            let q = post_residual / next_item_size;
            if post_residual % next_item_size == 0 && q >= 2 {
                score -= 5.0 * (1.0 - progress) * (q as f64).min(4.0) / 4.0;
