            score += 10.0 - 6.0 * progress;
        }

        if next_item_size > post_residual && post_residual < item_size {
            score += 12.0 * (1.0 - progress);
            if post_residual < 5 {
                score += 8.0 * (1.0 - progress);
            }
        }

        // Dead-space guard with stream-length and mean-gap scaling.
        if next_item_size > 0 && post_residual < next_item_size {
            let mean_gap = (mean_residual - post_residual as f64).max(0.0);
            score += 0.15 * mean_gap.min(30.0);
            if (post_residual as f64) < 0.5 * next_item_size as f64 {
                score += 8.0 * (1.0 - progress);
            }
            score += 10.0 * (1.0 - progress) * (1.0 - post_frac);
            let unusable = (next_item_size - post_residual) as f64;
            let dead_frac = unusable / bin_capacity as f64;
            if dead_frac > 0.02 {
                score += 25.0 * dead_frac * (0.4 + 0.6 * (1.0 - progress));
            }
            // Escalate when the stranded pattern is duplicated fleet-wide.
            if fitting_bins_count == 0 && dead_frac > 0.01 {
                score += 14.0 * dead_frac * bin_capacity as f64 / 10.0 * (0.5 + 0.5 * progress);
            }
        }

        // Near-full compaction rewards.
        if post_frac < 0.05 && post_residual > 0 {
            score -= 22.0 * (1.0 - post_frac / 0.05);
        } else if post_frac < 0.10 {
            score -= 6.0 * (1.0 - (post_frac - 0.05) / 0.05);
        }

        // Mid-band awkwardness: residuals unlikely to host anything.
        if post_frac >= 0.10 && post_frac < 0.25 {
            let awkward = 1.0 - (post_frac - 0.10) / 0.15;
            let unhostable = next_item_size > 0 && next_item_size > post_residual;
            score += 4.0 * awkward * if unhostable { 1.0 } else { 0.3 };
        }

        // Perfect second-fit rewards with scarcity scaling.
        if next_item_size > 0 && post_residual >= next_item_size {
            let slack = (post_residual - next_item_size) as f64;
            if slack <= 2.0 {
                let scarcity = if fitting_bins_count <= 2 { 1.6 } else { 1.0 };
                score -= 14.0 * scarcity * (1.0 - slack / 2.0) * (1.0 + 0.4 * (1.0 - progress));
            }
            if slack == 0.0 && fitting_bins_count <= 4 {
                score -= 9.0 * (1.0 + 0.3 * (1.0 - progress));
            }
            if slack > 2.0 && slack <= 12.0 && (slack as f64) <= mean_residual {
                score -= 3.0 * (1.0 - slack / 12.0) * (1.0 - progress);
            }
            if fitting_bins_count <= 3 && slack <= 6.0 {
                score -= 4.0 * (1.0 - slack / 6.0) * (1.0 - progress)
