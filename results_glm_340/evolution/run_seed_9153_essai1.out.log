            }
        }
        if post_residual == item_size {
            new_score += 25.0 * (1.0 + 0.3 * (1.0 - progress));
        }
        if next_item_size > 0 && post_residual >= 2 * next_item_size {
            new_score += 8.0 * (1.0 - progress);
        }
        if next_fits_new && item_size as f64 > 0.5 * bin_capacity as f64
            && post_residual > 0 && post_residual < next_item_size
            && (next_item_size - post_residual) as f64 > 0.15 * bin_capacity as f64 {
            new_score -= 10.0 * (1.0 - progress);
        }
        // Refuse fresh bins when existing fit leaves self-tiling residual.
        if post_residual > 0 && item_size > 0 && post_residual % item_size == 0 {
            new_score += 6.0 * (1.0 - progress);
        }
        // Late-stream consolidation: prefer existing fits over expansion.
        if progress > 0.7 && fitting_bins_count >= 1 && open_bins_count <= 4 {
            new_score += 5.0 * (progress - 0.7) / 0.3;
        }
        score += new_score;
