            if pair_waste as f64 > mean_residual * 1.2 {
                new_score += 5.0 * ((pair_waste - mean_residual) / 10.0).min(2.0);
            }
            if item_size + next_item_size < bin_capacity / 2 {
                new_score += 8.0 * (1.0 - progress);
            }
            if pair_waste >= next_item_size as f64 {
                new_score -= 10.0 * (1.0 - progress);
            }
            if pair_waste > 0.0 && (pair_waste as u32) % next_item_size == 0 {
                new_score -= 6.0 * (1.0 - progress);
            }
            if pair_waste > 0.0 && (pair_waste as f64) - mean_residual > 20.0 {
                new_score += 3.0 * (((pair_waste as f64) - mean_residual - 20.0) / 15.0).min(2.0);
            }
            if pair_waste > 0.0 && (pair_waste as f64) < 0.85 * mean_residual {
