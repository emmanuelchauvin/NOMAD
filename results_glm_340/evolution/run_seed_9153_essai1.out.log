            score -= 3.0 * (1.0 - progress);
        }
        // Dual-chain compaction: after-next remainder can host a mean item.
        if next_item_size > 0 && post_residual >= next_item_size {
            let after_next = post_residual - next_item_size;
            if (after_next as f64) >= 0.5 * mean_residual {
                score -= 5.0 * (1.0 - progress)
                    * (((after_next as f64) / mean_residual.max(1.0)).min(2.0) / 2.0);
            }
        }
        // Penalize consuming a scarce fit leaving a tiny stranded residual.
        if post_residual > 0 && post_residual <= 3 && fitting_bins_count <= 2
