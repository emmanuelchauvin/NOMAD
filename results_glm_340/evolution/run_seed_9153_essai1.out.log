        }
        if fill_ratio >= 0.75 && next_item_size > 0 && next_item_size <= post_residual {
            score -= 6.0 * (fill_ratio - 0.75) / 0.25 * (1.0 - post_frac / (1.0 - fill_ratio + 0.01)).min(1.0);
        }
        if post_residual == item_size {
            score -= 18.0 * (1.0 + 0.5 * (1.0 - progress));
        }
        if post_residual > 0 && (post_residual as f64) >= 0.8 * mean_residual
