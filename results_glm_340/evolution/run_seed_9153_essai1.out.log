            } else if pair_waste > 0.0 && pair_waste as u32 % 5 == 0 {
                new_score -= 2.0 * (1.0 - progress);
            }
            if pair_waste > post_residual as f64 {
                new_score += 5.0 * ((pair_waste - post_residual as f64) / 8.0).min(2.0);
            }
        } else if progress > 0.8 {
            new_score += 15.0;
        }
        if item_size as f64 > 0.6 * bin_capacity as f64 && fitting_bins_count <= 2 {
            new_score -= 12.0;
        }
        if progress > 0.85 {
            new_score += 10.0;
        }
        // Existing bins already nearly full: fresh bin preserves them.
        if post_frac <= 0.10 {
            new_score += 20.0 * (1.0 - post_frac / 0.10);
        }
        if next_item_size > 0 && post_residual >= next_item_size {
            new_score += 14.0;
        }
        if (post_residual as f64) < mean_residual {
            new_score += 3.0 * (mean_residual - post_residual as f64).min(20.0) / 4.0;
        }
        if item_size as f64 > 0.4 * bin_capacity as f64 && mean_residual > 1.5 * item_size as f64 {
            new_score -= 6.0;
        }
        if progress > 0.9 && mean_residual < 0.15 * bin_capacity as f64 {
            new_score += 6.0 * (progress - 0.9) / 0.1;
        }
        if post_residual > 0 && (post_residual as f64) < 0.6 * mean_residual && progress < 0.9 {
            new_score += 4.0 * (1.0 - post_residual as f64 / mean_residual.max(1.0));
        }
        if open_bins_count > 6 && next_fits_new {
            new_score += 0.8 * ((open_bins_count - 6) as f64).min(8.0);
        }
        if progress < 0.3 && fitting_bins_count <= 2 && open_bins_count > 3 {
            new_score -= 6.0;
        }
        if progress > 0.8 && next_fits_new {
            let pair_fill = (item_size + next_item_size) as f64 / bin_capacity as f64;
            if pair_fill < 0.85 {
