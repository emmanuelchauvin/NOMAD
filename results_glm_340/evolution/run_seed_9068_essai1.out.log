 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;
    let cap = bin_capacity as f64;

    let fit_ratio = item_size as f64 / bin_residual.max(1) as f64;
    let waste_ratio = post_residual as f64 / cap;
    let remaining_frac = (total_items.saturating_sub(step_index)) as f64 / total_items.max(1) as f64;

    // Reward near-perfect fits strongly, sharpened at the top end.
    if fit_ratio > 0.85 {
        score -= 58.0 * fit_ratio;
    }
    if fitting_bins_count >= 2 && fit_ratio > 0.6 {
        score -= 8.0 * (fit_ratio - 0.6);
    }
    if fit_ratio > 0.97 {
        score -= 18.0;
    }
    if post_residual == 0 {
        score -= 70.0;
        if fitting_bins_count >= 2 {
            score -= 25.0;
        }
    }

    // Perfect 2-step match.
    if next_item_size > 0 && post_residual == next_item_size {
        score -= 1000.0;
    }

    // Next item still fits after placement: reward proportionally.
    if next_item_size > 0 && post_residual >= next_item_size {
        let after_next = post_residual - next_item_size;
        score -= 50.0 + (after_next) as f64 * 0.35;
        if after_next <= 3 {
            score -= 12.0;
        }
        if after_next > 0 && after_next < next_item_size / 2 {
            score += 7.0;
        }
        if after_next >= 2 * next_item_size {
            score -= 10.0;
        }
        if after_next >= next_item_size && after_next - next_item_size <= 4 {
            score -= 6.0;
        }
        if after_next >= 1 && after_next <= 12 {
            score -= 7.0;
        }
        if after_next >= 30 {
            score -= 6.0;
        }
        if fitting_bins_count >= 3 {
            score += after_next as f64 * 0.12;
        }
        if post_residual >= 2 * next_item_size && post_residual < 3 * next_item_size {
            let slack2 = post_residual - 2 * next_item_size;
            if slack2 <= 4 {
                score -= 11.0 * (1.0 - slack2 as f64 / 5.0) * (0.5 + remaining_frac);
            }
        }
        if post_residual == 2 * next_item_size {
            score -= 22.0;
        }
        if next_item_size <= 20 && post_residual <= 3 * next_item_size {
            let tightness = 1.0 - after_next as f64 / (2.0 * next_item_size as f64).max(1.0);
            score -= 10.0 * tightness * (0.5 + remaining_frac);
        }
        if after_next > 0 && mean_residual > 1.0 && (after_next as f64) <= mean_residual * 1.5 {
            score -= 5.0 * (1.0 - after_next as f64 / (mean_residual * 1.5)) * remaining_frac;
        }
        if after_next > 0 && after_next % next_item_size == 0 {
            let k = after_next / next_item_size;
            score -= 4.0 * (k.min(4) as f64 - 1.0) * (0.4 + remaining_frac);
        }
        // REFINED: after placing the next item, if the leftover could be
        // closed by the fleet mean, reward it — this tightens the two-step
        // lookahead toward actual bin closure rather than just fitting.
        if after_next > 0 && open_bins_count >= 2 && mean_residual >= 1.0 {
            let closable = (after_next as f64 + mean_residual - cap).abs();
            if closable <= 4.0 {
                score -= 9.0 * (1.0 - closable / 5.0) * (0.5 + remaining_frac);
            }
        }
    } else if next_item_size > 0 {
        let orphan = (next_item_size - post_residual) as f64;
        score += orphan * 2.2 * (0.6 + 0.8 * remaining_frac)
            + if orphan > 0.25 * cap { 12.0 } else { 0.0 };
        if fitting_bins_count >= 2 {
            score += 14.0;
        }
        let gap_frac = orphan / next_item_size as f64;
        if gap_frac < 0.2 {
            score += 10.0 * (1.0 - gap_frac);
        }
        score += 14.0 * gap_frac * gap_frac * (0.4 + remaining_frac);
    }

    // Consolidation toward mean residual.
    if open_bins_count > 0 {
        score += (post_residual as f64 - mean_residual) * 0.45;
        score += 0.3 * (mean_residual - bin_residual as f64).max(0.0);
        let spread = (post_residual as f64 - mean_residual).abs();
        let crowding = (open_bins_count.min(12) as f64) / 12.0;
        score += spread * 0.09 * crowding * (0.4 + remaining_frac);
    }

    if open_bins_count > 0 {
        score += 12.0 * (open_bins_count as f64).ln().max(1.0);
    } else {
        score -= 10.0;
    }

    if fitting_bins_count == 1 && bin_residual < bin_capacity {
        score -= 280.0;
    }

    if waste_ratio < 0.08 {
        score -= 25.0;
    } else if waste_ratio > 0.45 {
        score += 18.0 * waste_ratio;
    }

    if post_residual >= 1 && post_residual <= 10 && bin_residual != bin_capacity {
        score -= 9.0;
    }

    if bin_residual != bin_capacity && post_residual >= 1 && post_residual <= 15 {
        let closeness = 1.0 - (post_residual as f64 - 1.0) / 14.0;
        score -= 5.0 * closeness * closeness;
    }

    // Dead-space accounting: penalize unusable gaps, but exempt gaps that the
    // fleet mean residual can absorb (they remain recoverable elsewhere).
    if bin_residual != bin_capacity && post_residual > 0 {
        let dead_hi = 25.0f64.max(0.25 * cap);
        if (post_residual as f64) > 1.0 && (post_residual as f64) < dead_hi {
            let depth = (post_residual as f64 - 1.0) / (dead_hi - 1.0);
            let small_sink = (item_size as f64 / post_residual.max(1) as f64).min(1.0);
            let fleet_absorb = mean_residual >= post_residual as f64 && open_bins_count >= 2;
            let w = if fleet_absorb { 0.55 } else { 1.0 };
            score += 10.0 * w * depth * (0.5 + remaining_frac) * (0.6 + 0.6 * small_sink);
        }
    }

    if post_residual == item_size && item_size <= bin_capacity / 2 {
        score -= 30.0;
    }

    if bin_residual != bin_capacity && bin_residual == 2 * item_size && 2 * item_size <= bin_capacity {
        score -= 14.0 * (0.5 + remaining_frac);
    }

    if post_residual > 0 && next_item_size > 0 && post_residual < next_item_size {
        let gap_frac = (next_item_size - post_residual) as f64 / next_item_size as f64;
        if gap_frac < 0.2 {
            score += 10.0 * (1.0 - gap_frac);
        }
    }

    // Dead-space recoverability via fleet composition.
    if bin_residual != bin_capacity && post_residual > 0 {
        let pr = post_residual as f64;
        let next = next_item_size as f64;
        let pairable_target = if next > 0.0 { next } else { pr };
        let pair_ok = mean_residual >= 1.0 && (pr + mean_residual) >= pairable_target;
        if pr < pairable_target && !pair_ok && remaining_frac > 0.2 {
            let deficit = (pairable_target - pr).max(1.0);
            score += (3.0 + 9.0 * (deficit / cap).min(1.0)) * (0.4 + remaining_frac);
        }
        if pr < pairable_target && mean_residual >= 1.0 && pr + mean_residual >= pairable_target - 6.0 {
            let near_miss = 1.0 - ((pairable_target - pr - mean_residual).max(0.0) / 6.0);
            score += 4.0 * near_miss * remaining_frac;
        }
    }

    // New-bin candidate handling.
    if bin_residual == bin_capacity {
        let progress = step_index as f64 / total_items.max(1) as f64;
        let big_item = item_size as f64 >= 0.6 * cap;
        let next_big = next_item_size as f64 >= 0.7 * cap;
        let next_unusable = next_item_size > 0 && post_residual > 0 && post_residual < next_item_size;
        let stranded = open_bins_count > 0 && bin_residual as f64 > 0.9 * cap && fitting_bins_count > 2;
        if open_bins_count == 0 || big_item || fit_ratio < 0.5 || (next_big && next_unusable) || stranded {
            score -= 25.0 + 15.0 * (1.0 - fit_ratio);
        } else {
            let crowded = open_bins_count as f64 > 4.0 + 6.0 * progress;
            score += 300.0 + 300.0 * (1.0 - progress) - if crowded { 40.0 } else { 0.0 };
            if open_bins_count > 2 && mean_residual < 0.12 * cap {
                score -= 60.0;
            }
            if fit_ratio < 0.75 && mean_residual < item_size as f64 {
                score -= 45.0;
            }
            if next_item_size > 0 && post_residual < next_item_size && mean_residual < next_item_size as f64 {
                score += 55.0;
            }
            if next_item_size > 0 && item_size as f64 > 0.5 * cap && mean_residual < next_item_size as f64 + 4.0 {
                score -= 35.0;
            }
            if next_item_size > 0 && post_residual > 0 && post_residual < next_item_size.max(1) {
                let stranded_depth = next_item_size.saturating_sub(post_residual) as f64;
                if stranded_depth > 0.35 * cap {
                    score -= 40.0;
                }
            }
            if fit_ratio < 0.85 && mean_residual < 0.18 * cap && remaining_frac > 0.5 {
                score -= 30.0 * (1.0 - fit_ratio) * remaining_frac;
            }
            if next_item_size > 0 && mean_residual < next_item_size as f64 && fit_ratio < 0.9 && remaining_frac > 0.35 {
                score -= 18.0 * (1.0 - mean_residual / next_item_size.max(1) as f64);
            }
            if open_bins_count > 5 && fit_ratio < 0.7 && mean_residual > item_size as f64 && remaining_frac > 0.25 {
                score -= 22.0 * (1.0 - fit_ratio) * remaining_frac;
            }
            if open_bins_count > 3 && mean_residual >= item_size as f64 * 1.1 && fit_ratio < 0.95 {
                score += 35.0 * (mean_residual / item_size.max(1) as f64).min(3.0);
            }
            if open_bins_count > 2 && mean_residual >= item_size as f64 + next_item_size as f64 * 0.5 && fit_ratio < 0.85 {
                score += 20.0 * remaining_frac;
            }
            if open_bins_count > 3
                && next_item_size > 0
                && mean_residual >= (item_size + next_item_size) as f64
                && fit_ratio < 0.9
            {
                score += 90.0;
            }
            if open_bins_count > 4
                && next_item_size > 0
                && mean_residual >= item_size as f64 * 1.3
                && mean_residual >= next_item_size as f64 * 1.1
                && remaining_frac > 0.3
            {
                score += 55.0 * (1.0 - remaining_frac) * 0.5 + 25.0;
            }
            if open_bins_count > 6 && progress < 0.4 && fit_ratio < 0.8 {
                score += 35.0 * (0.8 - fit_ratio) * 4.0;
            }
            if open_bins_count > 2
                && next_item_size > 0
                && mean_residual < 0.15 * cap
                && post_residual > 0
                && (post_residual as f64 + mean_residual) < next_item_size as f64
            {
                score += 30.0;
            }
            if remaining_frac < 0.25 && fit_ratio < 0.9 {
                score += 60.0 * (0.25 - remaining_frac) * 4.0 * (1.0 - fit_ratio);
            }
            // Refuse a fresh bin when the new bin's own post residual would
            // itself be dead space (too small for the next item and below the
            // fleet mean's pairing reach) — the fresh bin would immediately
            // become a dead-end.
            if open_bins_count > 2
                && next_item_size > 0
                && post_residual > 0
                && (post_residual as f64) < next_item_size as f64
                && (post_residual as f64 + mean_residual) < next_item_size as f64
                && remaining_frac > 0.2
            {
                score += 45.0 * remaining_frac;
            }
            // Prefer a fresh bin whose post residual pairs with the fleet
            // mean into a near-full bin — it promises future closure.
            if open_bins_count >= 2
                && mean_residual >= 1.0
                && post_residual > 0
                && ((post_residual as f64 + mean_residual) - cap).abs() <= 6.0
            {
                score -= 20.0 * (1.0 - ((post_residual as f64 + mean_residual) - cap).abs() / 7.0);
            }
            // A fresh bin is more acceptable when the item placed leaves
            // a post residual that is an exact multiple of the next item —
            // the new bin can be closed in consecutive steps.
            if next_item_size > 0
                && post_residual > 0
                && post_residual % next_item_size == 0
                && post_residual <= 3 * next_item_size
                && open_bins_count > 1
            {
                score -= 30.0 * (0.5 + remaining_frac);
            }
            // NEW: fresh-bin promise check — a new bin is only worth opening
            // mid-stream if its post residual is large enough to remain a
            // viable host for typical (mean-scale) future items. A fresh bin
            // whose leftover is below the fleet mean's reach is a wasted
            // capacity unit; penalize proportionally to how unreachable it is.
            if open_bins_count > 2
                && mean_residual >= 1.0
                && post_residual > 0
                && (post_residual as f64) < mean_residual
                && remaining_frac > 0.25
            {
                let depth = 1.0 - post_residual as f64 / mean_residual;
                score += 26.0 * depth * depth * remaining_frac;
            }
            // NEW: reward opening a fresh bin that closes the current item
            // exactly (post_residual == 0) when other open bins would strand
            // dead space — perfect closure justifies the extra bin.
            if post_residual == 0 && open_bins_count > 0 && fit_ratio < 0.95 {
                score -= 34.0 * (1.0 - fit_ratio) * (0.5 + remaining_frac);
            }
        }
    }

    if remaining_frac < 0.15 && bin_residual != bin_capacity {
        score -= (0.15 - remaining_frac) * 120.0 * (1.0 - waste_ratio);
    }

    if fitting_bins_count >= 4 && next_item_size > 0 && mean_residual < 0.2 * cap {
        if post_residual >= next_item_size {
            score -= 6.0;
        } else {
            score += 6.0;
        }
    }

    if next_item_size > 0
        && next_item_size as f64 > mean_residual.max(1.0) * 1.6
        && post_residual < next_item_size
        && fitting_bins_count >= 2
    {
        score += 8.0;
    }

    if open_bins_count >= 5 && remaining_frac > 0.4 && next_item_size > 0 {
        let pr = post_residual as f64;
        if pr >= next_item_size as f64 && pr < 0.5 * cap {
            score -= 4.0 * (pr / (0.5 * cap));
        }
    }

    if open_bins_count >= 3 && bin_residual != bin_capacity && next_item_size > 0 {
        let pr = post_residual as f64;
        if pr > next_item_size as f64 && pr < 0.6 * cap {
            let pairable = (pr + mean_residual - cap).abs();
            if pairable < 0.1 * cap {
                score -= 7.0 * (1.0 - pairable / (0.1 * cap));
            }
        }
    }

    if bin_residual != bin_capacity && next_item_size > 0 && post_residual > next_item_size {
        let slack = (post_residual - next_item_size) as f64;
        if slack < mean_residual && mean_residual > 1.0 {
            score += 4.0 * (1.0 - slack / mean_residual) * remaining_frac;
        }
    }

    if bin_residual != bin_capacity && post_residual > 0 && next_item_size > 0
        && post_residual < next_item_size && mean_residual < next_item_size as f64 {
        score += 8.0 * remaining_frac;
    }

    if bin_residual != bin_capacity && next_item_size > 0 && post_residual > next_item_size {
        let band = post_residual - next_item_size;
        if band >= 1 && band <= 8 && next_item_size >= 8 {
            score += 5.0 * (band as f64 / 8.0) * remaining_frac;
        }
    }

    if next_item_size > 0 && post_residual > next_item_size && post_residual < 2 * next_item_size {
        let frac = (post_residual - next_item_size) as f64 / next_item_size as f64;
        if frac > 0.6 {
            score += 9.0 * frac;
        }
    }

    if bin_residual != bin_capacity && next_item_size > 0 && next_item_size <= 15 && post_residual > next_item_size {
        if post_residual % next_item_size == 0 {
            score -= 5.0 * (0.3 + remaining_frac);
        }
    }

    // Two-step lookahead on dead space.
    if bin_residual != bin_capacity && next_item_size > 0 && post_residual > 0 {
        let pr = post_residual as f64;
        if pr < next_item_size as f64 && pr + mean_residual < next_item_size as f64 {
            let deficit = next_item_size as f64 - pr - mean_residual;
            score += 6.0 * (deficit / cap).min(1.0) * (0.5 + remaining_frac);
        }
    }

    // Reward residuals that exactly complement the fleet mean into a full bin.
    if bin_residual != bin_capacity && post_residual > 0 && open_bins_count >= 2 && mean_residual >= 1.0 {
        let sum = post_residual as f64 + mean_residual;
        if (sum - cap).abs() <= 3.0 {
            score -= 8.0 * (1.0 - (sum - cap).abs() / 4.0);
        }
    }

    // Aggressive dead-space elimination — for open bins, a post residual
    // that is smaller than the fleet mean's smallest useful payload is nearly
    // unrecoverable. Scale the penalty with how far below the mean it sits,
    // but only mid-stream where recovery still matters.
    if bin_residual != bin_capacity && post_residual > 0 && open_bins_count >= 3 && mean_residual >= 1.0 {
        let pr = post_residual as f64;
        if pr < mean_residual {
            let depth = 1.0 - pr / mean_residual;
            score += 14.0 * depth * depth * (0.3 + remaining_frac);
        }
        // Reward leaving a residual that is itself a "perfect host" — large
        // enough to fit the next item with minimal slack.
        if next_item_size > 0 && pr >= next_item_size as f64 {
            let slack = pr - next_item_size as f64;
            if slack <= 4.0 {
                score -= 9.0 * (1.0 - slack / 5.0) * (0.5 + remaining_frac);
            }
        }
    }

    // NEW: penalize open-bin placements that strand a residual just below a
    // common small-item size band (1..=10) when no small items are expected —
    // inferred from the next item being large.
    if bin_residual != bin_capacity
        && post_residual >= 1
        && post_residual <= 10
        && next_item_size > 12
        && remaining_frac > 0.15
    {
        score += 6.0 * remaining_frac;
    }

    // NEW: chain-closure bonus — prefer placements whose post residual can
    // absorb the next item AND whose remaining slack matches the fleet mean
    // residual closely, so the next-next placement can also close a bin.
    if bin_residual != bin_capacity
        && next_item_size > 0
        && post_residual >= next_item_size
        && open_bins_count >= 2
        && mean_residual >= 1.0
    {
        let after_next = (post_residual - next_item_size) as f64;
        let closeness = (after_next - mean_residual).abs();
        if closeness <= 5.0 && after_next >= 1.0 {
            score -= 7.0 * (1.0 - closeness / 6.0) * (0.4 + remaining_frac);
        }
    }

    // NEW: early-stream consolidation — when few bins are open and the stream
    // is young, mildly prefer bins whose post residual stays above the fleet
    // mean so future medium items still have hosts; below-mean leftovers
    // early on are the primary source of dead space.
    if bin_residual != bin_capacity
        && post_residual > 0
        && open_bins_count >= 2
        && open_bins_count <= 6
        && remaining_frac > 0.6
        && mean_residual >= 1.0
    {
        let pr = post_residual as f64;
        if pr < mean_residual * 0.6 {
            score += 5.0 * (1.0 - pr / (mean_residual * 0.6).max(1.0)) * remaining_frac;
        }
    }

    // NEW: exact-complement sweep — when the post residual is within a small
    // tolerance of what ANY plausible future payload needs to close the bin,
    // treat it as nearly closed and reward it proportionally to the tolerance
    // and to how many bins are competing (scarce hosts matter more).
    if bin_residual != bin_capacity
        && post_residual > 0
        && next_item_size > 0
        && open_bins_count >= 2
    {
        let pr = post_residual as f64;
        let next = next_item_size as f64;
        // Post residual equals a multiple of the next item minus a tiny
        // remainder: the bin can be closed by a short run of next-size items.
        if pr > next {
            let k = (pr / next).floor();
            let rem = pr - k * next;
            if rem <= 2.0 {
                score -= 10.0 * (1.0 - rem / 3.0) * (0.4 + remaining_frac) * (k.min(3.0) / 3.0);
            }
        }
    }

    score
}
