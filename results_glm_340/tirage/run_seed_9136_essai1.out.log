 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Perfect fit: huge reward.
    if post_residual == 0 {
        score -= 1000.0;
    }

    // 2-step lookahead: strongly reward bins where the next item also fits.
    if next_item_size > 0 {
        if post_residual >= next_item_size {
            // Tight two-item packing: post_residual close to next_item_size is best.
            score -= 200.0 - ((post_residual - next_item_size) as f64) * 0.5;
        } else {
            // Dead space that the next item cannot use: penalize proportionally.
            let waste = post_residual as f64 / next_item_size as f64;
            score += 40.0 * (1.0 - waste.min(1.0));
        }
    }

    // Penalize tiny unusable residuals (dead space below minimum item size).
    if post_residual > 0 && post_residual < 10 {
        score += 60.0;
    }

    // Prefer bins tighter than the mean residual (best-fit flavor).
    score -= (mean_residual - post_residual as f64) * 0.3;

    // Last-chance bin: strongly avoid opening a new bin when only one bin fits.
    if fitting_bins_count == 1 && bin_residual < bin_capacity {
        score -= 150.0;
    }

    // New-bin candidate: penalize opening a new bin, less so when it's early
    // in the stream or the current fit is very loose.
    if bin_residual == bin_capacity {
        let progress = step_index as f64 / (total_items.max(1) as f64);
        let mut new_bin_penalty = 120.0;
        if next_item_size > 0 && item_size >= next_item_size {
            new_bin_penalty -= 30.0; // big item now, smaller next: fine to open
        }
        if fitting_bins_count == 0 {
            new_bin_penalty = 0.0; // no alternative
        }
        score += new_bin_penalty * (0.5 + 0.5 * (1.0 - progress));
    }

    // Mild preference for consolidating into fewer bins.
    score += open_bins_count as f64 * 0.5;

    score
}
