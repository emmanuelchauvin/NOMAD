 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Perfect fit reward
    if post_residual == 0 {
        score -= 1000.0;
    }

    // 2-step lookahead: reward if next item fits exactly or well into post_residual
    if next_item_size > 0 {
        if next_item_size == post_residual {
            score -= 900.0; // chained perfect fit
        } else if next_item_size <= post_residual {
            let slack = (post_residual - next_item_size) as f64;
            score -= 200.0 * (1.0 - slack / bin_capacity as f64);
        } else {
            // next item won't fit: penalize proportionally to wasted potential
            let overflow = (next_item_size - post_residual) as f64;
            score += 0.5 * overflow;
        }
    }

    // Relative-to-mean coupling: prefer bins with residual near/below mean (tighter bins first)
    score += 0.3 * (bin_residual as f64 - mean_residual);

    // Last-chance bonus: if this is the only bin that fits, strongly prefer using it
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 150.0;
    }

    // Penalize creating tiny unusable dead space (1..small) that no item (min size 1..) reliably uses
    if post_residual > 0 && post_residual < 10 {
        score += 30.0;
    }

    // Early in stream: slightly discourage opening too many bins
    let progress = step_index as f64 / (total_items.max(1) as f64);
    if bin_residual == bin_capacity {
        score += 40.0 * (1.0 - progress);
    }

    // Prefer filling larger-residual bins when many bins are open (consolidation)
    score += 0.1 * open_bins_count as f64 * (post_residual as f64 / bin_capacity as f64);

    score
}
