 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Strong reward for perfect closure
    if post_residual == 0 {
        score -= 1000.0;
    }

    // 2-step lookahead: reward bins whose post_residual exactly fits the next item
    if next_item_size > 0 && post_residual >= next_item_size {
        let slack = (post_residual - next_item_size) as f64;
        score -= 200.0;
        score += slack * 0.8;
        if post_residual == next_item_size {
            score -= 500.0;
        }
    } else if next_item_size > 0 {
        // next item cannot follow here: penalize proportionally to the gap
        let gap = (next_item_size - post_residual) as f64;
        score += gap * 0.5;
    }

    // Penalize leaving large unusable dead space relative to mean residual
    let t = step_index as f64 / total_items.max(1) as f64;
    if post_residual as f64 > mean_residual {
        score += (post_residual as f64 - mean_residual) * 0.6 * (0.5 + t);
    } else {
        score -= (mean_residual - post_residual as f64) * 0.2;
    }

    // Last-chance bonus: if this is the only fitting bin, strongly prefer using it
    if fitting_bins_count == 1 && bin_residual < bin_capacity {
        score -= 150.0;
    }

    // Slight preference for keeping many open bins consolidated
    score += open_bins_count as f64 * 0.05;

    // Small bias toward larger items closing big residual bins
    score -= item_size as f64 * 0.1;

    score
}
