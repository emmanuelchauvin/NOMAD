 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Reward exact or near-exact fits (dead-space elimination).
    if post_residual == 0 {
        score -= 1000.0;
    } else if post_residual <= 5 {
        score -= 200.0;
    }

    // 2-step lookahead: reward if the NEXT item fits the post-residual perfectly.
    if next_item_size > 0 {
        let nxt = next_item_size as f64;
        if post_residual as f64 >= nxt {
            let gap = post_residual as f64 - nxt;
            if gap == 0.0 {
                score -= 500.0;
            } else {
                score -= 150.0 * (1.0 - gap / bin_capacity as f64);
            }
        } else {
            // Next item won't fit: penalize proportionally to wasted lookahead potential.
            score += 30.0 * (nxt - post_residual as f64) / nxt.max(1.0);
        }
    }

    // Penalize leaving residuals below the minimum item size (unusable dead space),
    // unless post_residual is 0 (perfect fit).
    if post_residual > 0 && post_residual < 10 {
        score += 80.0;
    }

    // Relative-to-mean coupling: bins with residual far below mean are tighter;
    // prefer filling tighter bins to consolidate waste.
    let cap = bin_capacity as f64;
    let rel = (bin_residual as f64 - mean_residual) / cap;
    score -= 25.0 * rel;

    // Last-chance bonus: if this is the only bin that fits, strongly prefer it
    // over opening a new bin (unless fit is terrible).
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 60.0;
    }

    // New-bin candidate: make empty bins mildly attractive only when item is large
    // and current bin fit is poor; otherwise discourage spreading across bins.
    if bin_residual == bin_capacity {
        let fit_ratio = item_size as f64 / cap;
        if fit_ratio > 0.7 {
            score -= 20.0 * (fit_ratio - 0.7) * 10.0;
        } else {
            score += 40.0;
        }
    }

    // Late-stream consolidation: as stream progresses, favor closing bins tightly.
    let progress = step_index as f64 / total_items.max(1) as f64;
    score += 10.0 * progress * (post_residual as f64 / cap);

    score
}
