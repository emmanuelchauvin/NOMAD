 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Perfect-fit reward: exact fill is always ideal.
    if post_residual == 0 {
        score -= 1000.0;
    }

    // Aggressive 2-step lookahead: strongly favor bins whose post_residual
    // exactly matches the next item size (chain placement).
    if next_item_size > 0 {
        let look = next_item_size as f64;
        let diff = (post_residual as f64 - look).abs();
        if diff == 0.0 {
            score -= 400.0;
        } else if post_residual as f64 >= look {
            // Next item fits: reward tightness of the chain.
            score -= 200.0 * (1.0 - diff / bin_capacity as f64);
        } else {
            // Dead space the next item cannot use: penalize proportionally.
            score += 50.0 * (1.0 - post_residual as f64 / look);
        }
    }

    // Favor bins with residual below the mean (tight bins get closed out).
    if (bin_residual as f64) < mean_residual {
        score -= 30.0;
    } else {
        score += 10.0;
    }

    // Last-chance bonus: if this is the only bin that fits, avoid opening a new bin.
    if fitting_bins_count == 1 && bin_residual >= item_size {
        score -= 150.0;
    }

    // Penalize creating large unusable dead space relative to capacity.
    let frac = post_residual as f64 / bin_capacity as f64;
    if frac > 0.0 && frac < 0.1 {
        score += 80.0; // tiny sliver is wasted capacity
    }

    // Early in the stream, prefer consolidating into fewer bins.
    let progress = step_index as f64 / total_items.max(1) as f64;
    score += progress * 5.0 * open_bins_count as f64;

    score
}
