 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Perfect fit: residual fully consumed -> strongly reward.
    if post_residual == 0 {
        score -= 1000.0;
    }

    // 2-step lookahead: if the next item exactly fills the post-residual,
    // this is a perfect chain -> big reward.
    if next_item_size > 0 {
        if post_residual == next_item_size {
            score -= 500.0;
        } else if post_residual >= next_item_size {
            // Next item fits here too: good chaining.
            let slack_after_next = post_residual - next_item_size;
            score -= 100.0 * (1.0 - slack_after_next as f64 / bin_capacity as f64);
        } else {
            // Dead space: next item cannot use the leftover.
            let waste = next_item_size - post_residual;
            score += 30.0 + waste as f64;
        }
    } else {
        // Last item: prefer minimal leftover.
        score += 0.0;
    }

    // Compare post_residual against mean residual across open bins:
    // leaving less than average behind is efficient packing.
    score -= 2.0 * (mean_residual - post_residual as f64);

    // Last-chance bin: if this is the only bin that fits, avoid opening a new bin.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 80.0;
    }

    // New empty bin candidate: only attractive when the item is large
    // relative to residual space available elsewhere, or many bins already open.
    if bin_residual == bin_capacity {
        let large_item = item_size as f64 > 0.6 * bin_capacity as f64;
        let crowded = open_bins_count as f64 > 8.0;
        if large_item || crowded {
            score -= 60.0;
        } else {
            score += 120.0; // prefer filling existing bins
        }
    }

    // Slight progression bias: later in the stream, consolidation matters more.
    let progress = step_index as f64 / total_items.max(1) as f64;
    score += 10.0 * progress * (post_residual as f64 / bin_capacity as f64);

    score
}
