 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Strong reward for near-perfect fits (minimizes dead space).
    if post_residual == 0 {
        score -= 1000.0;
    } else if post_residual <= 5 {
        score -= 200.0 + (5 - post_residual) as f64 * 20.0;
    } else if post_residual <= 10 {
        score -= 60.0;
    }

    // 2-step lookahead: reward if the next item exactly fills the post-residual,
    // penalize if the leftover is just slightly too small for the next item.
    if next_item_size > 0 {
        if next_item_size == post_residual {
            score -= 500.0;
        } else if next_item_size < post_residual {
            let gap = (post_residual - next_item_size) as f64;
            score -= (60.0 * (1.0 - gap / bin_capacity as f64)).max(0.0);
        } else {
            let overshoot = (next_item_size - post_residual) as f64;
            // Leftover unusable by next item: penalize proportionally to how close it was.
            score += 10.0 + 30.0 * (1.0 - overshoot / bin_capacity as f64);
        }
    }

    // Relative-to-mean coupling: prefer bins with residual below the mean
    // (consolidate fullness), penalize dipping into roomy bins.
    let resid = post_residual as f64;
    if resid < mean_residual {
        score -= 0.5 * (mean_residual - resid).min(50.0);
    } else {
        score += 0.3 * (resid - mean_residual).min(50.0);
    }

    // Last-chance bin: strongly favor it to avoid opening a new bin.
    if fitting_bins_count == 1 && bin_residual >= item_size && bin_residual != bin_capacity {
        score -= 150.0;
    }

    // New-bin candidate handling: only attractive when existing bins fit poorly.
    if bin_residual == bin_capacity {
        let progress = if total_items > 1 { step_index as f64 / total_items as f64 } else { 0.0 };
        let poor_fit = post_residual as f64 > 40.0;
        if fitting_bins_count == 0 || (poor_fit && progress < 0.5) {
            score -= 120.0;
        } else {
            // Discard new-bin option when decent placements exist.
            score += 250.0;
        }
    }

    // Mild pressure to close out bins as the stream matures.
    score += 0.05 * (bin_residual as f64) * (1.0 - step_index as f64 / (total_items.max(1) as f64));

    score
}
