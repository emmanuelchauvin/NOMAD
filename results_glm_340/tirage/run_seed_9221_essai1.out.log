 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Is this the brand-new empty bin candidate?
    let is_new_bin = bin_residual == bin_capacity;

    // Dead-space penalty: post_residual that cannot fit the next item is wasted space.
    if !is_new_bin && next_item_size > 0 && post_residual < next_item_size {
        let dead = next_item_size - post_residual;
        score += (dead as f64) * 2.5;
    }

    // Perfect fit reward
    if post_residual == 0 {
        score -= 60.0;
    }

    // Near-perfect fit reward
    if !is_new_bin && post_residual > 0 && post_residual <= 10 {
        score -= 25.0;
    }

    // Tight fit reward: item fills most of the residual
    let fill_ratio = item_size as f64 / bin_residual as f64;
    if !is_new_bin {
        if fill_ratio > 0.8 {
            score -= 20.0 * (fill_ratio - 0.8) * 5.0;
        } else if fill_ratio < 0.3 {
            // poor utilization of a large residual: penalize
            score += 15.0 * (0.3 - fill_ratio);
        }
    }

    // Last-chance bin: strongly prefer using the only bin that fits
    if !is_new_bin && fitting_bins_count == 1 {
        score -= 30.0;
    }

    // Open bins pressure: with many open bins, avoid opening new ones
    if is_new_bin {
        let pressure = open_bins_count as f64 * 8.0;
        score += pressure;
        // Early in stream, opening bins is cheaper; late, expensive
        let progress = if total_items > 0 { step_index as f64 / total_items as f64 } else { 0.0 };
        score += 20.0 * progress;
    } else {
        // Using an existing bin reduces pressure slightly when many bins are open
        score -= (open_bins_count as f64).min(20.0) * 0.5;
    }

    // Prefer bins below mean residual (consolidate waste into few bins)
    if !is_new_bin {
        let diff = bin_residual as f64 - mean_residual;
        score += diff * 0.3;
    }

    // Next-item synergy: if post_residual exactly fits next item, big reward
    if !is_new_bin && next_item_size > 0 && post_residual == next_item_size {
        score -= 40.0;
    }

    score
}
