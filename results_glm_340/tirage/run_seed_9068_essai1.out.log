 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // --- Harmonic class of the post-fit residual (capacity fractions) ---
    // Residuals are bucketed into harmonic classes relative to capacity:
    // tiny (0..=5), small (6..=15), medium (16..=34), large (35..=100)
    let tiny = if post_residual <= 5 { 1.0 } else { 0.0 };
    let small = if post_residual > 5 && post_residual <= 15 { 1.0 } else { 0.0 };
    let large = if post_residual >= 35 { 1.0 } else { 0.0 };

    // Tiny residuals are near-perfect fills: strongly reward.
    score -= 30.0 * tiny;

    // Small residuals are dead space (items >=10 can never use them): penalize.
    score += 25.0 * small;

    // Large residuals leave usable space: mild reward so we don't over-punish.
    score -= 6.0 * large;

    // --- Modulo arithmetic on post_residual: residuals divisible by common
    // item-size classes (10, 20, 25, 50) are re-usable by future items. ---
    if post_residual > 0 {
        if post_residual % 10 == 0 { score -= 8.0; }
        if post_residual % 20 == 0 { score -= 4.0; }
        if post_residual % 25 == 0 { score -= 3.0; }
        if post_residual % 50 == 0 { score -= 3.0; }
    }

    // --- Lookahead: does the next item fit exactly into post_residual? ---
    if next_item_size > 0 {
        if next_item_size == post_residual {
            score -= 40.0; // perfect chaining
        } else if next_item_size <= post_residual {
            score -= 12.0; // next item can still use this bin
        } else {
            score += 5.0;  // next item won't fit here
        }
    }

    // --- Integer division threshold: how many "average" items still fit? ---
    let avg_item = 30u32;
    let fits_avg = post_residual / avg_item;
    score -= fits_avg as f64 * 4.0;

    // --- Last-chance bin: if this is the only bin that fits, prefer using it
    // over opening a new bin (unless the fit is terrible). ---
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 20.0;
    }

    // --- New-bin candidate handling: brand-new empty bin. ---
    if bin_residual == bin_capacity {
        // Opening a new bin is only attractive when existing bins are crowded
        // and the item is large relative to capacity.
        let progress = step_index as f64 / (total_items.max(1) as f64);
        let crowding = mean_residual / bin_capacity as f64;
        score += 15.0; // base cost of opening a new bin
        score -= 20.0 * crowding * (item_size as f64 / bin_capacity as f64);
        score -= 10.0 * progress * (post_residual as f64 / bin_capacity as f64);
    }

    // --- Many open bins with slack: discourage spreading items thin. ---
    if open_bins_count > 3 && (post_residual as f64) > mean_residual {
        score += 3.0;
    }

    score
}
