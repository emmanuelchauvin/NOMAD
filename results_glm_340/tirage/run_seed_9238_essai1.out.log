 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Dead-space penalty: small gaps are wasted unless next item fits.
    if post_residual > 0 {
        let usable = next_item_size > 0 && post_residual >= next_item_size;
        if !usable {
            // unusable gap: penalize proportionally to how "dead" it is
            let deadness = 1.0 - (post_residual as f64) / (bin_capacity as f64);
            score += 60.0 * deadness * (post_residual as f64);
        } else {
            // gap that next item fits: reward
            score -= 25.0;
        }
    } else {
        // perfect fit: strong reward
        score -= 80.0;
    }

    // Tight-fit reward: fraction of bin consumed
    let fill = (item_size as f64) / (bin_capacity as f64);
    score -= 40.0 * fill;

    // Last-chance bin: strongly favor using it to avoid opening a new bin
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 30.0;
    }

    // New-bin candidate: keep neutral-ish baseline, penalize when open bins fit well
    if bin_residual == bin_capacity {
        score += 55.0;
        if open_bins_count == 0 {
            score -= 200.0;
        }
        // discourage opening new bins late in stream when mean residual is small
        if mean_residual > 0.0 && mean_residual < item_size as f64 + 15.0 {
            score += 20.0;
        }
    }

    // Open-bin pressure: many open bins -> prefer consolidating into existing bins
    if bin_residual != bin_capacity {
        score -= 5.0 * (open_bins_count as f64).ln().max(0.0);
    }

    // Lookahead: if next item exactly matches post_residual, big reward
    if next_item_size > 0 && post_residual == next_item_size {
        score -= 45.0;
    }

    score
}
