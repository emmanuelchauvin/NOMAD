 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Perfect fit bonus: strongly reward leaving near-zero dead space.
    if post_residual == 0 {
        score -= 1000.0;
    } else if post_residual <= 2 {
        score -= 200.0;
    }

    // Aggressive 2-step lookahead: reward bins whose post_residual can host the next item.
    if next_item_size > 0 {
        if post_residual >= next_item_size {
            let slack = (post_residual - next_item_size) as f64;
            score -= 60.0 - slack * 0.8; // tighter chain fit -> bigger bonus
            if post_residual == next_item_size {
                score -= 150.0; // exact 2-step chain (both fit perfectly)
            }
        } else {
            // Next item cannot follow here: penalize proportionally to wasted potential.
            score += (next_item_size - post_residual) as f64 * 0.5;
        }
    }

    // Compare post_residual against mean residual: avoid creating outliers of dead space.
    let pr = post_residual as f64;
    if pr > mean_residual {
        score += (pr - mean_residual) * 0.6;
    } else {
        score -= (mean_residual - pr) * 0.3;
    }

    // Last-chance bonus: if this is the only bin that fits, prefer using it over opening a new bin.
    if fitting_bins_count == 1 {
        score -= 120.0;
        // Extra push when the fit is decent.
        if (post_residual as f64) <= mean_residual {
            score -= 50.0;
        }
    }

    // Penalize new-bin candidate slightly, unless current bins are too crowded to be useful.
    if bin_residual == bin_capacity {
        let crowded = mean_residual < item_size as f64 * 0.5;
        if crowded {
            score -= 80.0;
        } else {
            score += 90.0;
        }
    }

    // Late-stream urgency: consolidate more aggressively as the stream ends.
    let progress = step_index as f64 / (total_items.max(1) as f64);
    score -= progress * 20.0 * (1.0 - pr / bin_capacity as f64);

    // Mild penalty for many open bins to encourage consolidation.
    score += open_bins_count as f64 * 0.5;

    score
}
