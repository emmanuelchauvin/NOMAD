 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Strict dead-space avoidance: small unusable gaps are heavily penalized.
    // A residual below the minimum item size (1) is impossible, but gaps of
    // 1..=9 are "dead" if the distribution's minimum is 10; be distribution
    // agnostic: penalize gaps smaller than next_item_size when nonzero.
    if post_residual > 0 {
        if next_item_size > 0 && post_residual < next_item_size {
            score += 25.0 + (next_item_size - post_residual) as f64 * 1.5;
        }
        // Tight fits are excellent: reward near-perfect packing.
        if post_residual <= 3 {
            score -= 12.0;
        }
    } else {
        // Perfect closure of a bin.
        score -= 30.0;
    }

    // Open-bins pressure: discourage spreading across many open bins early;
    // encourage consolidating into open bins rather than opening new ones.
    score += (open_bins_count as f64).sqrt() * 1.0;

    // Last-chance bin: strongly prefer using it over opening a new bin.
    if fitting_bins_count == 1 && bin_residual < bin_capacity {
        score -= 20.0;
    }

    // Lookahead: if the next item fits exactly into the post residual,
    // this placement sets up a perfect follow-up.
    if next_item_size > 0 && post_residual == next_item_size {
        score -= 15.0;
    }

    // Mean-residual coupling: prefer bins whose residual is below average
    // (i.e., they are already "full-ish") to keep large residuals available.
    if bin_residual as f64 > mean_residual {
        score += 3.0;
    } else {
        score -= 3.0;
    }

    // Slight preference for opening a new bin late in the stream is removed:
    // consolidation is always preferred; add mild new-bin penalty.
    if bin_residual == bin_capacity {
        score += 8.0;
    }

    score
}
