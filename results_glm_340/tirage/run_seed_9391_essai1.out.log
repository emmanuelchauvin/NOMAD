 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Strict dead-space avoidance: penalize unusable small gaps.
    let min_useful = 10u32; // smallest useful gap
    if post_residual > 0 && post_residual < min_useful {
        score += 1000.0;
    }
    // Penalize gaps too small for the next item (lookahead dead space).
    if next_item_size > 0 && post_residual > 0 && post_residual < next_item_size {
        score += 300.0 * (next_item_size - post_residual) as f64;
    }

    // Reward tight fits (small post_residual) more aggressively.
    score -= 2.0 * (item_size as f64 / bin_capacity as f64) * 50.0;

    // Open-bins pressure: with many open bins, favor filling existing bins
    // over opening new ones.
    let progress = step_index as f64 / total_items.max(1) as f64;
    let pressure = open_bins_count as f64 * (0.5 + 0.5 * progress);
    score += pressure * (bin_residual == bin_capacity) as i32 as f64 * 20.0;
    // General mild pressure proportional to open bins when fit is loose.
    score += pressure * 0.3 * (post_residual as f64 / bin_capacity as f64);

    // Last-chance bin: strongly favor using the only fitting bin.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 500.0;
    }

    // New-bin candidate: make it less attractive unless existing fits are bad.
    if bin_residual == bin_capacity {
        score += 150.0;
        // But if next item is huge and this item is small, opening a fresh bin
        // may preserve large residuals elsewhere; slight discount.
        if next_item_size >= 70 && item_size <= 30 {
            score -= 120.0;
        }
    }

    // Mean residual coupling: prefer bins deviating below mean (tighter bins).
    score += 0.5 * (mean_residual - bin_residual as f64).max(0.0);

    score
}
