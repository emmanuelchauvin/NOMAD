 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Reward exact/near-exact fills strongly.
    if post_residual == 0 {
        score -= 1000.0;
    } else if post_residual <= 5 {
        score -= 200.0;
    }

    // Aggressive 2-step lookahead: if the next item fits the post-residual,
    // this placement is excellent (chains a second fill).
    if next_item_size > 0 && post_residual >= next_item_size {
        score -= 150.0 + 0.5 * (post_residual - next_item_size) as f64;
        // Perfect chain: post residual exactly equals next item size.
        if post_residual == next_item_size {
            score -= 250.0;
        }
    } else if next_item_size > 0 && next_item_size > post_residual {
        // Dead space that the next item cannot use: penalize proportionally
        // to how big the leftover gap is relative to the next item.
        let gap = (next_item_size - post_residual) as f64;
        score += 0.8 * gap;
    }

    // Relative to mean residual: bins tighter than average are good targets.
    score -= 0.6 * (mean_residual - post_residual as f64);

    // Last-chance bin: strongly prefer using it to avoid opening a new bin.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 120.0;
    }

    // Penalize new-bin candidate unless it enables a clean lookahead chain.
    if bin_residual == bin_capacity {
        score += 90.0;
        if next_item_size > 0 && (bin_capacity - item_size) >= next_item_size {
            score -= 100.0;
        }
        // Early in stream, opening bins is cheaper; late in stream, consolidate.
        let progress = step_index as f64 / total_items.max(1) as f64;
        score += 60.0 * (1.0 - progress);
    }

    // Slight preference for bins with fewer competitors (spread load when many fit).
    if fitting_bins_count > 1 {
        score += 2.0 * (fitting_bins_count as f64 - 1.0);
    }

    score
}
