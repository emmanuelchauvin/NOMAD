 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Perfect fit reward
    if post_residual == 0 {
        score -= 1000.0;
    }

    // Aggressive 2-step lookahead: reward bins whose post_residual
    // exactly matches the next item's size.
    if next_item_size > 0 {
        let gap = (post_residual as i64 - next_item_size as i64).abs() as f64;
        // Exact match for next item -> strong reward
        if gap == 0.0 {
            score -= 300.0;
        } else if (post_residual as i64) >= (next_item_size as i64) {
            // Next item still fits: mild reward proportional to tightness
            score -= (50.0 * (1.0 - gap / bin_capacity as f64)).max(0.0);
        } else {
            // Next item would NOT fit: penalize wasted potential
            score += 40.0 + gap * 0.5;
        }
    }

    // Relative to mean residual: prefer bins tighter (smaller residual) than average
    score += 0.5 * (post_residual as f64 - mean_residual);

    // Last-chance bonus: if this is the only bin that fits, strongly prefer it
    if fitting_bins_count == 1 && bin_residual < bin_capacity {
        score -= 200.0;
    }

    // Penalize opening a new bin when decent open bins exist
    if bin_residual == bin_capacity {
        // New bin candidate: baseline penalty unless item is large relative to capacity
        // or open bins are already very full (mean residual low)
        let mean_fullness = 1.0 - mean_residual / bin_capacity as f64;
        let item_ratio = item_size as f64 / bin_capacity as f64;
        score += 120.0 - 80.0 * item_ratio - 60.0 * mean_fullness;
        // If next item is large, a fresh bin may be valuable
        if next_item_size > 0 {
            let next_ratio = next_item_size as f64 / bin_capacity as f64;
            score -= 50.0 * next_ratio;
        }
    }

    // Early in the stream, allow slightly more freedom to open bins (diversification)
    if total_items > 0 {
        let progress = step_index as f64 / total_items as f64;
        if bin_residual == bin_capacity {
            score -= 30.0 * (1.0 - progress);
        }
    }

    score
}
