 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Strong reward for perfect fit (zero dead space).
    if post_residual == 0 {
        score -= 1000.0;
    }

    // 2-step lookahead: reward when the leftover exactly matches the next item.
    if next_item_size > 0 {
        if post_residual == next_item_size {
            score -= 500.0;
        } else if post_residual >= next_item_size {
            // Leftover can host the next item: mild reward, scaled by tightness.
            let slack = (post_residual - next_item_size) as f64;
            score -= 150.0 * (1.0 - slack / bin_capacity as f64);
        } else {
            // Leftover too small for the next item: penalize dead space,
            // worse when the dead space is large relative to the next item.
            let dead = (next_item_size - post_residual) as f64;
            score += 0.5 * dead;
        }
    }

    // Penalize residual far below the mean residual (wasting a roomy bin on a small item).
    score += 0.3 * (mean_residual - post_residual as f64).max(0.0);

    // Last-chance bonus: if this is the only bin that can fit the item, strongly prefer it
    // over opening a new bin.
    if fitting_bins_count == 1 && bin_residual != bin_capacity {
        score -= 400.0;
    }

    // Mild penalty for opening a new bin when other bins could fit the item.
    if bin_residual == bin_capacity {
        score += 50.0;
        // New bin is acceptable if no open bin has room for the next item either
        // and this bin would end with a useful residual for the future.
        if next_item_size > 0 && post_residual >= next_item_size {
            score -= 60.0;
        }
    }

    // Late in the stream, tighten up: prefer minimizing residual even more.
    let progress = step_index as f64 / total_items.max(1) as f64;
    score *= 1.0 + 0.5 * progress;

    score
}
