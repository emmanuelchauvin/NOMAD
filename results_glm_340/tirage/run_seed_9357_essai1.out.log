 Logic Code       : pub fn score_bin(item_size: u32, bin_residual: u32, bin_capacity: u32, step_index: usize, total_items: usize, open_bins_count: usize, mean_residual: f64, next_item_size: u32, post_residual: u32, fitting_bins_count: usize) -> f64 {
    let mut score = post_residual as f64;

    // Perfect fit: strong reward.
    if post_residual == 0 {
        score -= 500.0;
    }

    // 2-step lookahead: does the next item fit into the post residual?
    if next_item_size > 0 {
        if post_residual >= next_item_size {
            // Next item fits: reward, scaled by how snug the chain is.
            let snug = 1.0 - (post_residual - next_item_size) as f64 / bin_capacity as f64;
            score -= 150.0 + 100.0 * snug;
        } else if post_residual > 0 {
            // Dead space the next item can't use: penalize proportionally.
            let waste = post_residual as f64 / bin_capacity as f64;
            score += 120.0 * waste;
        }
    }

    // Compare residual against mean residual of open bins.
    let dev = post_residual as f64 - mean_residual;
    score += 0.5 * dev;

    // Last-chance bin: strongly favor using it to avoid opening a new bin.
    if fitting_bins_count == 1 && bin_residual < bin_capacity {
        score -= 200.0;
    }

    // Mild preference to fill existing bins over opening new ones.
    if bin_residual < bin_capacity {
        score -= 30.0;
    } else {
        // Brand-new bin candidate: penalize slightly unless item is huge.
        score += 60.0 + 0.3 * (item_size as f64);
    }

    score
}
