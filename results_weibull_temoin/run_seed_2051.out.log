 Logic Code       : pub fn score_bin(
    item_size: u32,
    bin_residual: u32,
    bin_capacity: u32,
    step_index: usize,
    total_items: usize,
    open_bins_count: usize,
    mean_residual: f64,
    next_item_size: u32,
    post_residual: u32,
    fitting_bins_count: usize,
) -> f64 {
    let mut score = post_residual as f64;

    // Penalize creating a dead space that cannot fit the next item
    if post_residual > 0 && next_item_size > 0 && post_residual < next_item_size {
        score += 1000.0;
    }

    // Penalize large residual to avoid wasteful gaps
    score += (post_residual as f64).powi(2) * 0.01;

    // Reward the last fitting bin if only one can accommodate the item
    if fitting_bins_count == 1 {
        score -= 10.0;
    }

    // Penalize opening a brand‑new bin when many bins are already open
    if bin_residual == bin_capacity {
        score += (open_bins_count as f64) * 5.0;
    } else {
        // Slightly reward using existing bins when many are open
        if open_bins_count > 0 {
            score -= (open_bins_count as f64) * 0.1;
        }
    }

    // Ensure score is non‑negative
    if score < 0.0 {
        score = 0.0;
    }

    score
}
