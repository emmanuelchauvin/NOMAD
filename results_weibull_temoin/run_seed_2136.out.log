 Logic Code       : pub fn score_bin(
    item_size: u32,
    bin_residual: u32,
    bin_capacity: u32,
    step_index: usize,
    total_items: usize,
    open_bins_count: usize,
    mean_residual: f64,
    next_item_size: u32,
    post_residual: u32,
    fitting_bins_count: usize,
) -> f64 {
    // Base score: remaining space after placement
    let mut score = post_residual as f64;

    // Harmonic class: larger residual yields lower class number
    // (class = ceil(bin_capacity / (post_residual + 1)))
    let class = (bin_capacity as f64 / ((post_residual + 1) as f64)).ceil() as u32;
    score -= (class as f64) * 0.5;

    // Modulo bonus: prefer residuals divisible by 10
    if post_residual % 10 == 0 {
        score -= 5.0;
    }

    // Look‑ahead penalty or reward
    if next_item_size > 0 {
        if next_item_size > post_residual {
            // Not enough room for next item: penalise
            score += (next_item_size - post_residual) as f64 * 1.5;
        } else {
            // Enough room: slight reward
            score -= 2.0;
        }
    }

    // Penalise bins with residual far above the mean
    if open_bins_count > 0 && post_residual as f64 > mean_residual * 1.2 {
        score += (post_residual as f64 - mean_residual) * 0.3;
    }

    // Tighten packing towards the end of the stream
    let progress = step_index as f64 / total_items as f64;
    if progress > 0.9 {
        score -= (100 - post_residual) as f64 * 0.02;
    }

    // New‑bin handling
    if bin_residual == bin_capacity {
        if fitting_bins_count == 0 {
            // No bin can fit: strongly prefer opening a new bin
            score -= 20.0;
        } else {
            // Otherwise, mild penalty to discourage needless new bins
            score += 10.0;
        }
    }

    // Reward using the sole fitting bin to avoid opening a new one
    if fitting_bins_count == 1 {
        score -= 15.0;
    }

    // Tiny bonus for almost full bins
    if post_residual < 5 {
        score -= 1.0;
    }

    score
}
