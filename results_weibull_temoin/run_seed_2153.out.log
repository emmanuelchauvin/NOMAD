 Logic Code       : pub fn score_bin(
    item_size: u32,
    bin_residual: u32,
    bin_capacity: u32,
    step_index: usize,
    total_items: usize,
    open_bins_count: usize,
    mean_residual: f64,
    next_item_size: u32,
    post_residual: u32,
    fitting_bins_count: usize,
) -> f64 {
    // Base score is the remaining space after placement
    let mut score = post_residual as f64;

    // ---------- Dead‑space avoidance ----------
    // If the post‑residual is smaller than the next item, this bin will become a dead space
    if next_item_size > 0 && post_residual < next_item_size {
        score += 10.0 * (post_residual as f64); // heavy penalty for dead gaps
    }
    // Penalise tiny gaps that are unlikely to be useful
    if post_residual < 20 {
        score += 20.0;
    }
    // Reward bins that can still fit the next item
    if next_item_size > 0 && post_residual >= next_item_size {
        score -= 5.0;
    }

    // ---------- Last‑chance bonus ----------
    if fitting_bins_count == 1 {
        score -= 5.0; // this bin is the only candidate before opening a new one
    }

    // ---------- Open‑bins pressure ----------
    if open_bins_count > 5 {
        score += (open_bins_count as f64) * 1.0; // more open bins → higher penalty
    }

    // ---------- Mean‑residual comparison ----------
    if post_residual as f64 > mean_residual {
        score += (post_residual as f64 - mean_residual) * 0.5; // too large gap
    } else {
        score -= (mean_residual - post_residual as f64) * 0.3; // tighter than average
    }

    // ---------- Stream‑progress factor ----------
    let progress = if total_items > 0 {
        step_index as f64 / total_items as f64
    } else {
        0.0
    };
    if progress > 0.9 {
        // Near the end: enforce tighter packing
        score += post_residual as f64 * 2.0;
    }

    // ---------- New‑bin penalty ----------
    if bin_residual == bin_capacity {
        // Empty bin candidate – discourage opening unless necessary
        score += 30.0;
    }

    score
}
