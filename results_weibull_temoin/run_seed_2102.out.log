 Logic Code       : pub fn score_bin(
    item_size: u32,
    bin_residual: u32,
    bin_capacity: u32,
    step_index: usize,
    total_items: usize,
    open_bins_count: usize,
    mean_residual: f64,
    next_item_size: u32,
    post_residual: u32,
    fitting_bins_count: usize,
) -> f64 {
    // Base score: prefer bins that leave more space
    let mut score = (bin_capacity - post_residual) as f64;

    // Dead‑space penalty: if the remaining space cannot fit the next item
    if next_item_size > 0 && post_residual > 0 && post_residual < next_item_size {
        let dead_space = next_item_size - post_residual;
        score += dead_space as f64 * 1.5; // primary penalty

        // Extra penalty near the end of the stream
        let progress = step_index as f64 / total_items as f64;
        if progress > 0.8 {
            score += 2.0;
        }
    }

    // Reward if this is the sole bin that can take the item
    if fitting_bins_count == 1 {
        score -= 20.0;
    }

    // Open‑bin pressure: encourage using existing bins when many are open
    let open_factor = open_bins_count as f64;
    score -= 0.5 * open_factor;

    // Compare this bin’s residual to the mean residual of all open bins
    if (post_residual as f64) < mean_residual {
        score += (mean_residual - post_residual as f64) * 0.2; // penalty for being below average
    } else {
        score -= (post_residual as f64 - mean_residual) * 0.1; // reward for being above average
    }

    // Clamp to non‑negative values
    if score < 0.0 {
        score = 0.0;
    }

    score
}
