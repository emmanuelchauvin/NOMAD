 Logic Code       : pub fn score_bin(
    item_size: u32,
    bin_residual: u32,
    bin_capacity: u32,
    step_index: usize,
    total_items: usize,
    open_bins_count: usize,
    mean_residual: f64,
    next_item_size: u32,
    post_residual: u32,
    fitting_bins_count: usize,
) -> f64 {
    // Base score is the residual left after placing the item
    let mut score = post_residual as f64;

    // Reward the only fitting bin (last chance to use an open bin)
    if fitting_bins_count == 1 {
        // The larger the remaining space after placement, the more we reward
        score -= (bin_capacity - post_residual) as f64 * 0.5;
    }

    // Penalize if the residual cannot accommodate the next item
    if next_item_size > 0 && post_residual < next_item_size {
        score += (next_item_size - post_residual) as f64;
    }

    // Harmonic modulo reward: bins whose residual is a multiple of 10 are preferred
    if bin_residual % 10 == 0 {
        score -= 1.0;
    }

    // Heavy reward for almost full bins (dead‑space close to zero)
    if post_residual <= 5 {
        score -= 5.0;
    }

    // New‑bin candidate: penalize opening a new bin when many bins are already open
    if bin_residual == bin_capacity {
        let progress = step_index as f64 / total_items as f64;
        if open_bins_count > 3 || progress > 0.8 {
            score += 10.0; // discourage opening a new bin
        }
    }

    // Encourage balance: bins whose post‑residual is close to the mean residual
    let diff_from_mean = (mean_residual - post_residual as f64).abs();
    score -= diff_from_mean * 0.1;

    // Early in the stream we want tighter packing; later we allow more waste
    let progress = step_index as f64 / total_items as f64;
    if progress < 0.5 {
        score -= post_residual as f64 * 0.01;
    } else {
        score -= post_residual as f64 * 0.005;
    }

    score
}
