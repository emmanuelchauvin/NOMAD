 Logic Code       : pub fn score_bin(
    item_size: u32,
    bin_residual: u32,
    bin_capacity: u32,
    step_index: usize,
    total_items: usize,
    open_bins_count: usize,
    mean_residual: f64,
    next_item_size: u32,
    post_residual: u32,
    fitting_bins_count: usize,
) -> f64 {
    // Normalized stream progress
    let progress = step_index as f64 / total_items as f64;

    // Base score is the residual after placing the item
    let mut score = post_residual as f64;

    // Early stream: encourage tighter packing
    let early_term = (1.0 - progress).powi(3)
        * (post_residual as f64).powi(2)
        * 0.02;
    score -= early_term;

    // Late stream: allow a little slack for upcoming items
    let late_term = progress.powi(3)
        * (post_residual as f64).powi(2)
        * 0.015;
    score += late_term;

    // Fewer bins that can fit the item → higher priority
    let fit_bonus = (1.0 / (fitting_bins_count as f64 + 1.0))
        .powi(2)
        * 10.0;
    score -= fit_bonus;

    // Penalize many open bins to avoid excessive fragmentation
    let open_penalty = (open_bins_count as f64).powi(2) * 0.1;
    score += open_penalty;

    // Prefer bins whose residual is close to the mean residual
    let mean_bonus = (1.0 - mean_residual / bin_capacity as f64)
        .powi(3)
        * 5.0;
    score -= mean_bonus;

    // If the next item is large, reward leaving more space
    let next_bonus = ((next_item_size as f64) / bin_capacity as f64)
        .powi(2)
        * 8.0;
    score -= next_bonus;

    // Ensure non‑negative score
    if score < 0.0 {
        score = 0.0;
    }

    score
}
