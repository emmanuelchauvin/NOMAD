 Logic Code       : pub fn score_bin(
    item_size: u32,
    bin_residual: u32,
    bin_capacity: u32,
    step_index: usize,
    total_items: usize,
    open_bins_count: usize,
    mean_residual: f64,
    next_item_size: u32,
    post_residual: u32,
    fitting_bins_count: usize,
) -> f64 {
    // Base score: remaining space after placement
    let mut score = post_residual as f64;

    // --- 1. Unique-fit reward ------------------------------------
    // If this bin is the only one that can take the item, it becomes
    // highly desirable.
    if fitting_bins_count == 1 {
        score -= 100.0;
    }

    // --- 2. Aggressive 2‑step lookahead --------------------------
    if next_item_size > 0 {
        if post_residual >= next_item_size {
            // Will also fit the next item – great!
            score -= 50.0;
        } else if post_residual == 0 {
            // Bin becomes exactly full – no waste.
            score -= 20.0;
        } else {
            // Space left is too small for the next item – undesirable.
            score += 30.0;
        }
    }

    // --- 3. Mean‑residual bias -----------------------------------
    if mean_residual > 0.0 {
        let post = post_residual as f64;
        if post < mean_residual {
            // Bin has less free space than average – we want to fill it early.
            let diff = mean_residual - post;
            score -= 0.5 * diff;
        } else {
            // Bin has more free space than average – postpone filling it.
            let diff = post - mean_residual;
            score += 0.3 * diff;
        }
    }

    // --- 4. New‑bin penalty ---------------------------------------
    // When a call comes from an empty bin, we still penalize opening
    // a new bin if other suitable bins exist.
    if bin_residual == bin_capacity && fitting_bins_count > 0 {
        // Extra waste created by opening a new bin.
        let waste_if_new = bin_capacity - item_size;
        score += waste_if_new as f64 * 0.1;
    }

    // --- 5. Optional context: end‑of‑stream urgency ----------
    // If we are in the last quarter of the stream and have many open bins,
    // we slightly favor new bins for large items to avoid dead space.
    if step_index * 4 > total_items * 3 && open_bins_count > 10 && item_size > 70 {
        score -= 15.0;
    }

    score
}
