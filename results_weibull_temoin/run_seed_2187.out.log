 Logic Code       : pub fn score_bin(
    item_size: u32,
    bin_residual: u32,
    bin_capacity: u32,
    step_index: usize,
    total_items: usize,
    open_bins_count: usize,
    mean_residual: f64,
    next_item_size: u32,
    post_residual: u32,
    fitting_bins_count: usize,
) -> f64 {
    // Base score proportional to remaining space after placement
    let mut score = post_residual as f64;

    // Progress through the stream: 0.0 at start, 1.0 at end
    let progress = step_index as f64 / total_items as f64;

    // Dead‑space avoidance: penalise bins that will leave a gap too small for the next item
    if next_item_size > 0 && post_residual < next_item_size {
        let dead_space = (next_item_size - post_residual) as f64;
        // Stronger penalty when we are late in the stream
        score += dead_space * (1.0 - progress) * 3.0;
    }

    // Penalise bins with large residual when many open bins exist
    // Encourages using bins that are close to full when the open‑bin pressure is high
    score += (bin_residual as f64) * (open_bins_count as f64) * 0.02;

    // Strong reward if this is the only bin that can accept the item
    if fitting_bins_count == 1 {
        score -= 100.0;
    }

    score
}
