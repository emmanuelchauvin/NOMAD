 Logic Code       : pub fn score_bin(
    item_size: u32,
    bin_residual: u32,
    bin_capacity: u32,
    step_index: usize,
    total_items: usize,
    open_bins_count: usize,
    mean_residual: f64,
    next_item_size: u32,
    post_residual: u32,
    fitting_bins_count: usize,
) -> f64 {
    // Start with the residual space in the bin after placement
    let mut score = post_residual as f64;

    // Dead‑space penalty: if the remaining space cannot fit the next item,
    // or is an uncomfortably small gap, penalize heavily.
    if post_residual > 0 {
        if post_residual < next_item_size {
            score += 80.0; // next item would be forced to another bin
        } else if post_residual < 10 {
            score += 30.0; // small unusable gap
        }
    }

    // Pressure from many open bins: encourage opening a new bin
    score += (open_bins_count as f64) * 0.5;

    // Penalize bins that leave more space than the current average
    if post_residual as f64 > mean_residual {
        score += (post_residual as f64 - mean_residual) * 0.05;
    }

    // Tighten packing as we progress through the stream
    let remaining_ratio = (total_items - step_index) as f64 / total_items as f64;
    score += remaining_ratio * (post_residual as f64) * 0.1;

    // If this is the only bin that can accept the item, strongly favor it
    if fitting_bins_count == 1 {
        score -= 200.0;
    }

    // Slight penalty for opening a brand‑new bin unless forced
    if bin_residual == bin_capacity {
        score += 5.0;
    }

    score
}
