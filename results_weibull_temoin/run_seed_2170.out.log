 Logic Code       : pub fn score_bin(
    item_size: u32,
    bin_residual: u32,
    bin_capacity: u32,
    step_index: usize,
    total_items: usize,
    open_bins_count: usize,
    mean_residual: f64,
    next_item_size: u32,
    post_residual: u32,
    fitting_bins_count: usize,
) -> f64 {
    // Base score is the residual after placing the item
    let mut score = post_residual as f64;

    // Normalized stream progress (0.0 at start, 1.0 at end)
    let progress = step_index as f64 / total_items as f64;

    // Polynomial coupling terms
    let early_factor = (1.0 - progress).powi(2); // grows when progress is early
    let late_factor = progress.powi(2);          // grows when progress is late

    // Penalize large residuals early in the stream
    score -= 2.0 * (post_residual as f64) * early_factor;

    // Slightly reward bins whose residual is close to the mean, more so later
    score -= (mean_residual - post_residual as f64).abs() * 0.1 * late_factor;

    // Prefer using existing bins early in the stream
    score -= (open_bins_count as f64) * 0.05 * early_factor;

    // Discourage opening a brand‑new bin unless necessary
    if bin_residual == bin_capacity {
        score += 8.0;
    }

    // If this bin is the sole candidate, give a bonus
    if fitting_bins_count == 1 {
        score -= 3.0;
    }

    // Lookahead: penalize placing the item if the next item won't fit in the remaining space
    if next_item_size > post_residual {
        score += ((next_item_size - post_residual) as f64) * 0.02 * late_factor;
    }

    score
}
