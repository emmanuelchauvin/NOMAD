 Logic Code       : pub fn score_bin(
    item_size: u32,
    bin_residual: u32,
    bin_capacity: u32,
    step_index: usize,
    total_items: usize,
    _open_bins_count: usize,
    mean_residual: f64,
    next_item_size: u32,
    post_residual: u32,
    fitting_bins_count: usize,
) -> f64 {
    // Base score is the residual left after placing the item.
    let mut score = post_residual as f64;

    // Aggressive 2‑step lookahead:
    //   * If the bin can still hold the next item, strongly reward it.
    if next_item_size > 0 && post_residual >= next_item_size {
        score -= 2.0 * (next_item_size as f64);
    }

    // Perfect match for the next item is even better.
    if next_item_size > 0 && post_residual == next_item_size {
        score -= 5.0;
    }

    // Prefer bins whose residual is close to the current mean residual.
    // The penalty grows as the stream progresses to keep the distribution tight.
    let diff = (post_residual as f64 - mean_residual).abs();
    let time_weight = step_index as f64 / total_items as f64; // 0 .. 1
    score += diff * time_weight;

    // Penalize opening a brand‑new bin when other fitting bins exist.
    if bin_residual == bin_capacity && fitting_bins_count > 1 {
        score += 10.0;
    }

    // If this is the last fitting bin before a new bin would be needed, give a small bonus.
    if fitting_bins_count == 1 {
        score -= 3.0;
    }

    score
}
